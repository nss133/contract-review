  "securityRules": [
    {
      "topic": "separate_facilities",
      "pattern": "^외부주문개발업무에사용되는(?:업무장소(?:[·ㆍ,]|및)전산설비|전산설비(?:[·ㆍ,]|및)업무장소)를내부업무용과분리하여설치(?:[·ㆍ,]|및)운영(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "외부주문개발업무장소·전산설비",
        "action": "분리설치·운영",
        "condition": "내부업무용과분리",
        "modality": "obligation"
      }
    },
    {
      "topic": "protected_data",
      "pattern": "^금융회사와이용자간암호화정보를해독하거나원장등중요데이터를변경(?:하여서는아니된다|해서는안된다|할수없다|하지못한다)$",
      "fields": {
        "object": "금융회사·이용자간암호화정보·원장등중요데이터",
        "action": "해독·변경금지",
        "modality": "prohibition"
      }
    },
    {
      "topic": "financial_info",
      "pattern": "^계좌번호(?:[·ㆍ,]|및)비밀번호등이용자금융정보를무단으로보관하거나유출(?:하여서는아니된다|해서는안된다|할수없다|하지못한다)$",
      "fields": {
        "object": "계좌번호·비밀번호등이용자금융정보",
        "action": "무단보관·유출금지",
        "modality": "prohibition"
      }
    },
    {
      "topic": "security_plan",
      "pattern": "^접근매체(?:위(?:[·ㆍ,]|및)변조|위조(?:[·ㆍ,]|및)변조)[·ㆍ,]해킹(?:[·ㆍ,]|및)개인정보유출에대비한보안대책을수립(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "접근매체위변조·해킹·개인정보유출",
        "action": "보안대책수립",
        "modality": "obligation"
      }
    },
    {
      "topic": "dedicated_connection",
      "pattern": "^금융회사와전자금융보조업자간접속에전용회선을사용(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "금융회사·전자금융보조업자간접속",
        "action": "전용회선사용",
        "modality": "obligation"
      }
    },
    {
      "topic": "dedicated_connection",
      "pattern": "^금융회사와전자금융보조업자간접속에전용회선과동등한보안수준의가상전용회선을사용(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "금융회사·전자금융보조업자간접속",
        "action": "동등보안가상전용회선사용",
        "modality": "obligation"
      }
    },
    {
      "topic": "continuity_plan",
      "pattern": "^정보처리시스템장애등서비스중단에대비(?:한비상대책을수립|하여비상대책을수립)(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "정보처리시스템장애등서비스중단",
        "action": "비상대책수립",
        "modality": "obligation"
      }
    },
    {
      "topic": "security_stages",
      "pattern": "^외부주문의입찰[·ㆍ,]계약[·ㆍ,]수행(?:[·ㆍ,]|및)완료(?:등)?각단계별로금융감독원장이정하는보안관리방안을준수(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "외부주문입찰·계약·수행·완료각단계",
        "action": "보안관리방안준수",
        "condition": "금융감독원장이정하는방안",
        "modality": "obligation"
      }
    },
    {
      "topic": "backup_plan",
      "pattern": "^중요전산자료의백업자료보존(?:[·ㆍ,]|및)백업설비확보를포함한백업대책을수립(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "중요전산자료",
        "action": "백업대책수립",
        "condition": "백업자료보존·백업설비확보",
        "modality": "obligation"
      }
    },
    {
      "topic": "security_inspection",
      "pattern": "^외부주문에대한자체보안성검토(?:[·ㆍ,]|및)정기보안점검(?:실시)?에협조(?:하여야한다|해야한다|한다)$",
      "fields": {
        "object": "외부주문자체보안성검토·정기보안점검",
        "action": "협조",
        "modality": "obligation"
      }
    }
  ],
  "financialPattern": "^(?:자신의|수탁자의|전자금융보조업자의)재무건전성(?:에대한)?연([1-9][0-9]?)회이상평가(?:[·ㆍ,]|및)상시모니터링에필요한자료(?:를제공|제공에협조)(?:하여야한다|해야한다|한다)$"
}
