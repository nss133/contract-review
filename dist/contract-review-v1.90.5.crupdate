\": \"appropriateness\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"successor\": null, \"applicability\": {\"scope\": \"module\", \"requires\": [], \"module\": \"M-EXIT\", \"contract_type\": \"shareholders\", \"department_is_gate\": false, \"signals_role\": \"candidate_only\", \"existing_conditions\": {}}, \"topic\": \"cns_shcommit\", \"requirements\": {\"any_of\": [], \"all_of\": [\"주요주주의 경업·겸직 제한과 필요한 전업 의무의 범위 및 위반 시 효과가 계약 목적에 비추어 합리적인가\"], \"conditional\": []}, \"blockers\": [\"B6\"], \"auto_support\": {\"status\": \"manual\", \"scope\": \"human_judgment\", \"reason\": \"명확성·적정성의 본질적 판단 범위를 유지.\"}}, {\"id\": \"SH-EXIT-03\", \"question\": \"이탈(퇴사·중대한 위반) 시 지분 정산 방식(콜·풋옵션, 매도의무, 정산가격)이 규정되어 있는가\", \"level\": \"clarity\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"successor\": null, \"applicability\": {\"scope\": \"module\", \"requires\": [], \"module\": \"M-EXIT\", \"contract_type\": \"shareholders\", \"department_is_gate\": false, \"signals_role\": \"candidate_only\", \"existing_conditions\": {}}, \"topic\": \"sh_exit_03\", \"requirements\": {\"any_of\": [], \"all_of\": [\"이탈(퇴사·중대한 위반) 시 지분 정산 방식(콜·풋옵션, 매도의무, 정산가격)이 규정되어 있는가\"], \"conditional\": []}, \"blockers\": [\"B6\"], \"auto_support\": {\"status\": \"manual\", \"scope\": \"human_judgment\", \"reason\": \"명확성·적정성의 본질적 판단 범위를 유지.\"}}, {\"id\": \"SH-EXIT-04\", \"question\": \"회사가 이탈주주 주식을 자기주식으로 취득해 정산하는 구조라면 배당가능이익 한도·취득 절차 요건을 충족하는가\", \"level\": \"appropriateness\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"successor\": null, \"applicability\": {\"scope\": \"module\", \"requires\": [], \"module\": \"M-EXIT\", \"contract_type\": \"shareholders\", \"department_is_gate\": false, \"signals_role\": \"candidate_only\", \"existing_conditions\": {}}, \"topic\": \"sh_exit_04\", \"requirements\": {\"any_of\": [], \"all_of\": [\"회사가 이탈주주 주식을 자기주식으로 취득해 정산하는 구조라면 배당가능이익 한도·취득 절차 요건을 충족하는가\"], \"conditional\": []}, \"blockers\": [\"B6\"], \"auto_support\": {\"status\": \"manual\", \"scope\": \"human_judgment\", \"reason\": \"명확성·적정성의 본질적 판단 범위를 유지.\"}}, {\"id\": \"SH-EXIT-05\", \"question\": \"주식·회사 관련 진술 및 보장과 그 위반 시 손해전보(면책·정산) 조항이 규정되어 있는가\", \"level\": \"clarity\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"successor\": null, \"applicability\": {\"scope\": \"module\", \"requires\": [], \"module\": \"M-EXIT\", \"contract_type\": \"shareholders\", \"department_is_gate\": false, \"signals_role\": \"candidate_only\", \"existing_conditions\": {}}, \"topic\": \"sh_exit_05\", \"requirements\": {\"any_of\": [], \"all_of\": [\"주식·회사 관련 진술 및 보장과 그 위반 시 손해전보(면책·정산) 조항이 규정되어 있는가\"], \"conditional\": []}, \"blockers\": [\"B6\"], \"auto_support\": {\"status\": \"manual\", \"scope\": \"human_judgment\", \"reason\": \"명확성·적정성의 본질적 판단 범위를 유지.\"}}], \"inventory\": \"checklist_inventory_v188.json\"}, \"regulatory_scopes\": {\"schema_version\": \"1.0\", \"scopes\": {\"financial_outsourcing\": {\"label\": \"금융업무위탁 규정\", \"module_id\": \"X-FINOUT\", \"check_source_type\": \"outsourcing\", \"source\": {\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제2조 제2항, 제6조\", \"official_url\": \"https://law.go.kr/LSW/admRulLsInfoP.do?admRulSeq=2200000076690\"}, \"states\": {\"applicable\": \"적용\", \"non_applicable\": \"비적용\", \"needs_confirmation\": \"확인 필요\"}, \"questions\": {\"financial_business_purpose\": \"보험회사가 인가받은 금융업을 영위하기 위하여 맡기는 업무인가?\", \"continuous_use\": \"제3자의 용역 또는 시설을 계속적·반복적으로 활용하는가?\", \"simple_backoffice_exclusion\": \"금융업과 직접 관계없는 후선업무의 단순 집행·구매·용역인가?\"}, \"signals\": {\"non_applicable_contract\": [\"보험대리점\", \"보험설계사\", \"GA\", \"모집위탁\", \"모집 위탁\", \"위촉계약\", \"위촉 계약\", \"보험금청구권신탁\", \"신탁계약\", \"투자신탁\"], \"financial_business\": [\"보험 상담\", \"보험상담\", \"보험모집\", \"보험상품 설명\", \"가입 권유\", \"청약 접수\", \"보험계약 관리\", \"보험료 수납\", \"보험금 청구\", \"보험금 지급\", \"보험금 심사\", \"손해사정\", \"민원 접수\", \"고객 상담\", \"대출 상담\"], \"continuous_use\": [\"상시\", \"지속적\", \"계속적\", \"반복적\", \"매월\", \"월별\", \"연간\", \"1년\", \"자동 갱신\", \"유지관리\", \"콜센터\"], \"one_off\": [\"단건\", \"일회성\", \"1회\", \"행사 종료\", \"정산 완료일까지\", \"특정 행사\", \"개최일\"], \"simple_backoffice\": [\"행사대행\", \"행사 대행\", \"행사운영\", \"행사 운영\", \"대관\", \"케이터링\", \"현장 진행\", \"현장 운영\", \"직원연수\", \"직원 연수\", \"사무경리\", \"법률자문\", \"시장조사\", \"인쇄\", \"번역\", \"시설관리\", \"숙박\", \"차량\", \"식사\"]}}}}, \"legal_constraints\": {\"schema_version\": \"1.0\", \"rules\": [{\"id\": \"INS-EVENT-SOLICITATION\", \"label\": \"행사대행 계약에 보험모집 행위가 명시됨\", \"severity\": \"확인\", \"route\": \"insurance_solicitation_compliance\", \"affects_type\": false, \"summary\": \"일반 행사 실행용역으로 보기 어려운 보험상품 설명·가입권유 문언이 함께 검출되었습니다.\", \"reason\": \"이 신호는 금융업무위탁의 양성 근거로 사용하지 않고, 모집 자격과 대가 지급의 적법성을 별도로 확인합니다.\", \"requires\": [\"event\", \"solicitation\"], \"signals\": {\"event\": [\"행사\", \"설명회\", \"세미나\", \"고객 초청\", \"대관\", \"현장 운영\", \"케이터링\"], \"solicitation\": [\"보험모집\", \"보험상품 설명\", \"가입 권유\", \"보험가입 권유\", \"청약 접수\", \"보험 상담\", \"보험상담\"]}, \"scope_effects\": {\"financial_outsourcing\": \"non_applicable\"}, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제83조, 제99조\", \"note\": \"모집 가능 주체와 무자격자에 대한 모집 위탁·대가 지급 금지 확인\"}]}, {\"id\": \"INS-EVENT-SPECIAL-BENEFIT\", \"label\": \"모집 행사에 특별이익 제공 가능성이 명시됨\", \"severity\": \"높음\", \"route\": \"insurance_special_benefit_compliance\", \"affects_type\": false, \"summary\": \"보험모집 문언과 경품·금품·보험료 할인 등 특별이익 신호가 같은 행사 계약에서 검출되었습니다.\", \"reason\": \"계약 유형이나 업무위탁 적용 여부를 바꾸는 신호가 아니라, 보험업법상 금지행위 여부를 별도로 확인할 강한 준법경보입니다.\", \"requires\": [\"event\", \"solicitation\", \"benefit\"], \"signals\": {\"event\": [\"행사\", \"설명회\", \"세미나\", \"고객 초청\", \"대관\", \"현장 운영\", \"케이터링\"], \"solicitation\": [\"보험모집\", \"보험상품 설명\", \"가입 권유\", \"보험가입 권유\", \"청약 접수\", \"보험 상담\", \"보험상담\"], \"benefit\": [\"경품\", \"사은품\", \"금품\", \"상품권\", \"포인트\", \"보험료 대납\", \"보험료 할인\", \"수수료 지급\"]}, \"supersedes\": [\"INS-EVENT-SOLICITATION\"], \"scope_effects\": {\"financial_outsourcing\": \"non_applicable\"}, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제98조\", \"note\": \"보험계약 체결·모집 관련 특별이익 제공 또는 제공 약속 금지\"}, {\"law\": \"보험업법 시행령\", \"article\": \"제46조\", \"note\": \"허용되는 금품의 금액 한도\"}]}]}, \"contract_action_profile\": {\"schema_version\": \"contract-action-v1\", \"updated\": \"2026-08-29\", \"scope\": \"all_absence_checks\", \"policy\": \"법적 검토가치와 계약 문구 조치를 분리한다. 이 파일은 부재알람 항목 전체의 계약반영 필요성과 이행 위치를 명시한 사람 검수 정본이며, 미분류 법령 항목은 계약 필수로 자동 확정하지 않는다.\", \"actions\": {\"ITCL-01\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"중요도 평가를 회사가 수행하되 제공자의 자료 협조는 계약으로 확보할 필요가 있음\"}, \"ITCL-02\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"건전성·안전성 평가는 회사 의무이고 제공자 자료 협조만 계약 통제 대상임\"}, \"ITCL-03\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"업무연속성 계획은 내부통제로 수립하되 제공자 역할은 계약으로 뒷받침할 수 있음\"}, \"ITCL-05\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독보고는 회사 의무이고 기한 준수를 위한 자료·통지 협조가 필요한 항목임\"}, \"ITCL-06\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"제공자 지위·재위탁 등 중대 변경을 회사가 적시에 알 수 있는 계약 통제가 필요함\"}, \"ITCL-07\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"정보처리시스템 설치 지역은 서비스 제공 조건이므로 계약에서 특정할 필요가 있음\"}, \"SH-ANT-01\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"ITSEC-11\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"재외부주문과 업체 변경을 사전에 통제하려면 상대방을 구속하는 계약 문구가 필요함\"}, \"ITSEC-12\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"외주인력 관리의 세부 이행은 운영사항이나 상대방 협조는 계약으로 확보할 필요가 있음\"}, \"SOL-01\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"external_evidence\", \"action_rationale\": \"모집자격 등록은 등록부·증빙으로 확인할 사실이며 계약 문구로 창설되지 않음\"}, \"SOL-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"대외 법정책임과 별개로 당사자 사이 책임배분을 정하는 협상사항임\"}, \"SOL-04\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"회사의 대외책임과 수탁자 구상은 구분되며 구상문구는 위험배분상 권고사항임\"}, \"SOL-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"교육·점검은 내부 운영으로도 입증 가능하고 필요한 협조 범위만 계약화할 사항임\"}, \"PRIV-03\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"기술적·관리적 보호조치는 표준 보안관리약정에서 일괄 확인할 수 있음\"}, \"PRIV-06\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"접근 제한 등 안전성 조치는 표준 보안관리약정에서 확인할 수 있음\"}, \"PRIV-07\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"처리현황 점검·감독 수인 내용은 표준 보안관리약정으로 충족 가능함\"}, \"PRIV-08\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"수탁자 위반 책임은 주계약 또는 보안관리약정에 문서화할 항목임\"}, \"PRIV-13\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"교육·감독에 대한 수탁자 협조는 표준 보안관리약정에서 확인할 수 있음\"}, \"PRIV-17\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"개인신용정보 처리위탁 문서화는 PRIV-01~15의 세부 항목과 표준 보안관리약정 적용으로 통합 판단하며 독립 계약수정 항목으로 노출하지 않음\"}, \"PRIV-19\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"암호화 등 보호조치는 표준 보안관리약정에서 확인할 수 있음\"}, \"PRIV-20\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"교육과 안전처리 내용은 표준 보안관리약정에서 확인할 수 있음\"}, \"PRIV-21\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"개인신용정보 재위탁 제한은 표준 보안관리약정에서 확인할 수 있음\"}, \"REL-02\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"internal_control\", \"action_rationale\": \"대주주 거래 이사회 의결은 회사 내부 승인절차이며 계약 기재 자체가 이행요건은 아님\"}, \"REL-09\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"external_evidence\", \"action_rationale\": \"계열사 여부는 법인·관계회사 자료로 확인할 사실이며 계약상 자기선언만으로 확정되지 않음\"}, \"FIN-SEC-02\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"FIN-SEC-03\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"근저당 계약의 피담보채권과 채권최고액은 담보 범위를 정하는 본질적 문구임\"}, \"FIN-SEC-05\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"FIN-SEC-P03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"근담보 범위의 적정성은 법정 획일사항보다 위험배분·협상 판단에 가까움\"}, \"SP-PAY-01\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"하도급대금 지급기일은 서면 기재와 지급기한 준수를 함께 확인할 핵심 조건임\"}, \"SP-PAY-11\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"연동 또는 미연동 합의는 해당 거래의 서면에 구체화할 사항임\"}, \"CH-02\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"종료 후 고객관리 책임은 운영방식과 위험배분에 따라 정할 협상사항임\"}, \"CH-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"불완전판매·과태료의 대외책임과 내부 구상은 구분되며 계약상 배분은 협상사항임\"}, \"FIN-LOAN-02\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"이자 약정의 내용은 계약조건이지만 특정 약정이 반드시 필요한지는 거래구조에 따라 달라짐\"}, \"FIN-LOAN-04\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"지연손해금 약정은 법정 기준과 별개로 선택 가능한 위험배분 조항임\"}, \"FIN-GUAR-01\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"보증의 효력에 서면과 기명날인·서명이 직접 요구되는 형식요건임\"}, \"INV-MAN-03\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"NDA-15\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"비밀침해 손해배상책임은 법률상 성립 가능하며 별도 문구는 입증·위험배분상 권고임\"}, \"CORE-05\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"internal_control\", \"action_rationale\": \"손해사정 수탁자 평가기준의 마련·선정은 회사 내부 승인·운영 절차임\"}, \"CORE-06\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"법령준수의무는 법에서 직접 발생하고 포괄 준수문구는 계약상 보강수단임\"}, \"CORE-07\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"재위탁 통제의 실효성을 위해 수탁자를 구속하는 사전동의 문구가 필요함\"}, \"CORE-09\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"수탁자 위반의 대외책임과 내부 구상은 구분되며 배상·구상 문구는 위험배분 사항임\"}, \"CORE-10\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"관리·감독은 회사 의무이나 자료요구·감사 협조는 계약으로 확보할 필요가 있음\"}, \"CORE-11\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독보고는 회사 의무이고 개시일정·자료 제공에 대한 수탁자 협조가 필요함\"}, \"CORE-13\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독당국 조치 시 변경협조 문구는 대응 편의를 위한 권고사항임\"}, \"CORE-14\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독기관 검사·자료제출 협조는 실무상 유용하나 모든 계약의 획일적 필수문구는 아님\"}, \"SP-DEL-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"도급 하자구제는 법정 규율이 존재하며 세부 문구는 거래상 필요에 따른 협상사항임\"}, \"SP-DEL-12\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"위임형 선관주의·구제는 법정 의무를 계약에서 구체화하는 선택사항임\"}, \"ITDL-06\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"SLA와 장애 보상은 서비스 위험을 배분하는 실무 협상사항임\"}, \"SETTLE-01\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"화해 대상 분쟁의 특정은 합의 범위와 효력을 정하는 본질적 문구임\"}, \"SETTLE-02\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"상호 양보 내용은 화해의 성립과 효력 범위를 정하는 본질적 문구임\"}, \"SETTLE-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"부제소 합의의 범위는 유효성 위험을 줄이기 위한 협상·명확화 사항임\"}, \"SETTLE-07\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"화해금 지급조건은 거래 이행을 위한 중요 조건이나 법정 획일문구는 아님\"}, \"SH-SHARE-01\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"정관상 승인과 계약상 양도제한은 효력 층위가 달라 정관 확인과 협상이 함께 필요함\"}, \"SH-SHARE-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"우선매수권은 법정 기본권이 아니라 당사자 협상으로 창설하는 권리임\"}, \"SH-SHARE-06\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"동반매도참여권은 소수주주 보호를 위해 선택적으로 설계하는 계약상 권리임\"}, \"SH-SHARE-07\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"동반매도청구권은 지배주주 회수구조에 따라 선택적으로 설계하는 계약상 권리임\"}, \"SH-SHARE-08\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"SH-GOV-04\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"법정 열람권을 넘는 정보접근권은 투자조건에 따라 회사 유불리를 보고 정할 협의사항임\"}, \"SH-FIN-01\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"statutory_duty\", \"action_rationale\": \"주주의 신주인수권은 법률에서 직접 발생하며 계약문구 부재만으로 권리가 사라지지 않음\"}, \"CMN-01\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"당사자 표시는 분쟁 예방을 위한 기본 명확화 사항이나 모든 계약의 획일적 법정문구는 아님\"}, \"CMN-02\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"목적조항은 계약 해석에 유용하지만 거래 실질과 다른 경우의 수정 필요성은 개별 판단사항임\"}, \"CMN-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"부가가치세 부담 표시는 가격 분쟁을 줄이는 명확화 사항이며 적용 여부는 거래 성격에 따름\"}, \"CMN-10\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"종료 시 정산·반환·이관은 업무 성격에 따라 필요한 범위가 달라지는 운영조건임\"}, \"CMN-18\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"제3자 지식재산권 침해 대응은 산출물·라이선스 위험을 배분하는 협상사항임\"}, \"CMN-19\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"분쟁해결 방식과 관할 합의는 절차 편의를 위한 선택적 계약조건임\"}, \"CMN-20\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"양도제한은 상대방 변경 위험을 통제하기 위해 선택적으로 두는 계약상 제한임\"}, \"CRS-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"언어본 우선순위는 복수 언어 계약의 해석 충돌을 줄이는 선택적 명확화 사항임\"}, \"SOL-02\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"해지절차 마련은 회사 내부통제 사항이고 상대방 설명·절차 준수를 위한 계약 협조가 필요함\"}, \"ITDL-02\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"소스코드 인도·에스크로는 유지보수와 공급자 위험에 따라 선택하는 거래조건임\"}, \"ITDL-07\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"오픈소스 고지·책임은 실제 사용 가능성과 라이선스 위험에 따라 구체화할 사항임\"}, \"ITDL-08\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"악성코드·백도어 보증은 개발·납품 위험을 배분하는 선택적 보증사항임\"}, \"PRIV-16\": {\"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"statutory_duty\", \"action_rationale\": \"수탁자 소속직원 간주는 법률에서 직접 발생하므로 계약서에 반복 기재할 필요가 없음\"}, \"ALL-PII-01\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"ALL-PII-02\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"REL-08\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\"}, \"NDA-12\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"반환·파기와 증빙은 정보 성격과 보관 필요에 따라 정하는 종료 후 통제사항임\"}, \"CORE-01\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"적용되는 손해사정 위탁에서는 합의한 업무범위와 계약조건의 계약서 반영·교부가 요구됨\"}, \"SP-DEL-01\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"검사·검수 기준과 보완 절차는 납품·용역의 품질위험을 배분하는 거래조건임\"}, \"SP-DEL-03-2\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"불가항력 후 정산·해지·복구비용은 거래 특성에 따라 선택적으로 정할 사항임\"}, \"SH-GOV-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"사전동의권 대상은 투자자 보호와 경영자율성 사이에서 선택적으로 설계하는 권리임\"}, \"SH-GOV-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"교착해소 방식은 주주구성과 회수전략에 따라 선택하는 계약상 절차임\"}, \"SH-FIN-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"희석방지 조항은 투자조건과 후속 자금조달 계획에 따라 선택하는 권리임\"}, \"SH-FIN-06\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"후속 출자의무는 법정 기본의무가 아니라 자금조달 합의에 따라 창설하는 의무임\"}, \"SH-EXIT-03\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"이탈 시 지분정산은 창업자·투자자 간 위험과 회수구조를 정하는 협상사항임\"}, \"SH-EXIT-05\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"진술·보장과 손해전보는 거래 실사와 책임배분에 따라 설계하는 계약상 구제임\"}, \"CNS-DAMAGE\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"책임의 편면성, 특별·간접손해의 포함 또는 제외, 상한과 고의·중과실 예외, 위약금의 과도성과 중복 부담을 함께 살핀다. 대금 지급지연 이자와 납품·이행지연 지체상금을 구별한다. 이자·상한·지체상금 특약이 없다는 이유만으로 보완을 요구하지 않는다. 하도급 등 별도 적용 규정의 요건을 이 질문으로 대체하지 않는다.\"}, \"CNS-SECRET\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"보호할 정보를 식별할 수 있는지, 목적 외 사용·누설과 제3자·취급자 관리가 적절한지 함께 확인한다. 공지·독자개발·정당취득 정보와 법령에 따른 공개를 고려하고, 영업비밀 등 정보의 성격에 맞는 관리와 종료 후 존속 범위를 검토한다. 정의 조항이 있다는 사실만으로 약정 전체가 적절하다고 판단하지 않는다. 개인정보 처리위탁 의무는 별도로 검토한다.\"}, \"CNS-END\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"중대한 위반·도산·임의해지 등의 사유, 양 당사자의 권리 균형, 시정 기회와 통지 방법을 한 번에 검토한다. 모든 해지사유에 동일한 시정기간을 요구하지 않는다. 특정 약관 규제와 모집위탁 설명 의무는 별도 적용 항목으로 유지한다.\"}, \"CNS-PRICE\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"금액·단가·산식의 특정, 청구·검수 등 지급기준, 지급기한·방법과 정산 주기를 함께 확인한다. 모집·판매 수수료도 같은 질문으로 검토한다. 부가세 표시는 자동 사실확인 결과로 구별하며, 하도급 지급기한이나 화해금 등 특수한 요건은 해당 항목에서 검토한다.\"}, \"CNS-TERM\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"기간의 특정·역전 여부와 갱신조건, 거절 통지기한 및 일방적 갱신권을 함께 검토한다. 갱신 약정이 없는 확정기간 계약에 갱신 조항을 추가하도록 요구하지 않는다.\"}, \"CNS-IP\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"산출물·저작물의 소유 및 이용권을 구별하고, 개발계약에서는 소스코드·프로그램의 저작재산권과 2차적저작물 작성 권한을 함께 살핀다. 소스 인도·에스크로와 제3자 라이선스는 권리 귀속과 다른 의무이므로 해당 항목에서 검토한다.\"}, \"CNS-PRIVSCOPE\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"본문 또는 적용되는 위탁 특약에서 실제 위탁업무를 특정하고 목적 외 처리 및 범위 초과 이용·제3자 제공을 제한하는지 함께 확인한다. 제3자 제공 동의와 위탁은 구별하며, 보안조치·감독·재위탁은 별도 의무로 유지한다.\"}, \"CNS-PRIVSUB\": {\"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"재위탁 허용 범위와 동의를 얻어야 하는 주체·시점을 함께 확인한다. 개인정보 재위탁 동의와 개인신용정보 재위탁의 별도 제한을 서로 대체하지 않는다.\"}, \"CNS-LABOR\": {\"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"직접 지휘·명령 배제, 요청 창구, 인력 배치·근태·노무 권한을 함께 검토한다. 계약 문구만으로 실제 운영의 독립성까지 확인한 것으로 보지 않는다.\"}, \"CNS-SALEDEFECT\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"하자담보책임, 필요한 경우 교환·완전물 급부 및 권리행사기간을 함께 검토한다. 특정물·종류물의 차이를 고려하고 모든 매매에 동일한 교환 약정을 요구하지 않는다. 도급·위임의 하자·불완전이행과 구별한다.\"}, \"CNS-SHCOMMIT\": {\"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"적용 주주, 금지업무·기간·예외 및 전업 의무의 필요성과 위반 효과를 함께 검토한다. 모든 주주에게 동일한 의무를 부과하지 않으며 이탈 시 지분정산은 별도 항목에서 확인한다.\"}}}, \"tag_taxonomy\": {\"profile_version\": \"1.1.0\", \"facets\": {\"topics\": {\"personal_information\": {\"label\": \"개인정보\", \"aliases\": [\"개인정보\", \"개인신용정보\", \"신용정보\"]}, \"subcontracting\": {\"label\": \"재위탁\", \"aliases\": [\"재위탁\", \"재수탁\", \"하도급\"]}, \"confidentiality\": {\"label\": \"비밀유지\", \"aliases\": [\"비밀유지\", \"비밀정보\", \"기밀정보\"]}, \"damages\": {\"label\": \"손해배상\", \"aliases\": [\"손해배상\", \"배상책임\"]}, \"termination\": {\"label\": \"해지·해제\", \"aliases\": [\"해지\", \"해제\"]}, \"intellectual_property\": {\"label\": \"지식재산권\", \"aliases\": [\"지식재산권\", \"지적재산권\", \"저작권\", \"특허권\"]}, \"contract_term\": {\"label\": \"계약기간\", \"aliases\": [\"계약기간\", \"유효기간\", \"존속기간\"]}, \"assignment\": {\"label\": \"양도\", \"aliases\": [\"양도\", \"계약상 지위\", \"권리의무\"]}, \"notice\": {\"label\": \"통지·보고\", \"aliases\": [\"통지\", \"보고\"]}}, \"actors\": {\"trustee\": {\"label\": \"수탁자\", \"aliases\": [\"수탁자\", \"수탁회사\", \"수임인\"]}, \"trustor\": {\"label\": \"위탁자\", \"aliases\": [\"위탁자\", \"위탁회사\", \"위임인\"]},