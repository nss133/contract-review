[\"클라우드\", \"클라우드컴퓨팅서비스\", \"SaaS\", \"AWS\", \"Azure\", \"클라우드 리전\"], \"activation\": \"strong\"}, {\"id\": \"X-COMP\", \"name\": \"공정거래(경쟁제한·거래상지위)\", \"always_on\": false, \"screening_question\": \"경쟁사업자 간 협력·공동 거래조건 설정 또는 거래상지위 남용 가능성이 있는가?\", \"suggest_keywords\": [\"부당한 공동행위\", \"경쟁제한\", \"거래상 지위\", \"공정거래위원회\"], \"activation\": \"strong\"}, {\"id\": \"X-CROSS\", \"name\": \"국외 당사자·준거법·관할\", \"always_on\": false, \"screening_question\": \"계약 상대방이 외국 법인·개인이거나, 계약이 영문으로 작성되었거나, 이행지·결제통화가 국외/외화인가?\", \"suggest_keywords\": [\"준거법\", \"governing law\", \"jurisdiction\", \"arbitration\", \"영문\", \"English\", \"Agreement\", \"해외\", \"국외\", \"외국\", \"원천징수\", \"외화\", \"USD\"], \"activation\": \"confirm\"}, {\"id\": \"X-EFIN\", \"name\": \"전자금융 정보처리시스템 외주\", \"always_on\": false, \"screening_question\": \"전자금융거래를 위한 정보처리시스템의 개발·운영·유지관리 외주인가?\", \"suggest_keywords\": [\"전자금융거래\", \"정보처리시스템\", \"금융거래정보\", \"전산실\", \"전자금융보조업자\"], \"activation\": \"strong\"}, {\"id\": \"X-INSMOD\", \"name\": \"보험모집 규제\", \"always_on\": false, \"screening_question\": \"보험 모집·판매 또는 대리·중개(방카·GA·제휴판매 등) 업무를 위탁·수행하는가?\", \"suggest_keywords\": [\"모집\", \"보험설계사\", \"보험대리점\", \"보험중개사\", \"모집종사자\", \"방카\", \"위탁판매\", \"대리ㆍ중개\"], \"activation\": \"strong\", \"requires_stance\": [\"party\"]}, {\"id\": \"X-IP\", \"name\": \"산출물·지식재산권\", \"always_on\": false, \"screening_question\": \"용역·개발 산출물의 인도, 지식재산권 귀속, 제3자·오픈소스 라이선스가 쟁점인가?\", \"suggest_keywords\": [\"저작재산권\", \"소스코드\", \"산출물\", \"지식재산권\", \"2차적저작물\", \"오픈소스\", \"라이선스\", \"에스크로\", \"임치\"], \"activation\": \"strong\"}, {\"id\": \"X-PII\", \"name\": \"개인(신용)정보 처리·제공\", \"always_on\": false, \"screening_question\": \"이 계약에서 개인정보·개인신용정보를 제공·처리·위탁하는가?\", \"suggest_keywords\": [\"개인정보\", \"신용정보\", \"고객정보\", \"정보주체\", \"개인신용정보\"], \"activation\": \"confirm\"}, {\"id\": \"X-REINS\", \"name\": \"재보험\", \"always_on\": false, \"activation\": \"strong\", \"screening_question\": \"재보험 출재·수재 또는 공동재보험 협약인가?\", \"suggest_keywords\": [\"재보험\", \"출재\", \"수재\", \"공동재보험\"]}, {\"id\": \"X-RELATED\", \"name\": \"대주주·계열사 거래제한\", \"always_on\": false, \"screening_question\": \"계약 상대방이 미래에셋 계열사·대주주·특수관계인이거나, 브랜드(상표) 사용료·그룹 내부거래가 포함되는가?\", \"suggest_keywords\": [\"계열사\", \"계열회사\", \"대주주\", \"특수관계\", \"특수관계인\", \"관계회사\", \"상표 사용\", \"상표사용료\", \"브랜드 수수료\", \"브랜드사용료\", \"그룹\", \"내부거래\", \"신용공여\"], \"activation\": \"confirm\", \"requires_stance\": [\"party\"], \"stance_exempt_if\": [\"affiliate_party\"]}, {\"id\": \"X-SEC\", \"name\": \"담보(질권·저당·양도담보)\", \"always_on\": false, \"screening_question\": \"채권 담보로 질권·저당·양도담보를 설정하는가?\", \"suggest_keywords\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"채권양도\", \"양도담보\"], \"title_signals\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"title_required\": true}, {\"id\": \"X-SUB\", \"name\": \"하도급법(대금·부당특약)\", \"always_on\": false, \"screening_question\": \"원사업자·수급사업자 간 제조·수리·건설·용역위탁으로 하도급법 적용대상에 해당하는가?\", \"suggest_keywords\": [\"하도급\", \"하도급대금\", \"수급사업자\", \"원사업자\", \"준공금\", \"기성금\", \"건설위탁\", \"부당특약\"], \"activation\": \"strong\"}], \"standard_subdocs\": [{\"id\": \"SUBDOC-PII\", \"title\": \"개인(신용)정보 보안관리약정서\", \"ref_signals\": [\"보안관리약정서\", \"보안관리 약정\", \"개인(신용)정보보안관리약정\", \"정보보안관리약정\"], \"covers\": [\"CNS-PRIVSCOPE\", \"PRIV-03\", \"CNS-PRIVSUB\", \"PRIV-06\", \"PRIV-07\", \"PRIV-08\", \"PRIV-13\", \"PRIV-17\", \"PRIV-19\", \"PRIV-20\", \"PRIV-21\"], \"auto_comment\": \"표준 개인(신용)정보 보안관리약정서 적용으로 관련 문서화 항목 반영\"}]}, \"checks\": [{\"id\": \"CMN-01\", \"check\": \"계약 당사자가 법인 명의로 정확히 특정되어 있는가(영업점·부서 명의 아님)\", \"label\": \"계약당사자 법인 특정\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"당사자\", \"계약당사자\", \"갑과 을\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"당사자 표시는 분쟁 예방을 위한 기본 명확화 사항이나 모든 계약의 획일적 법정문구는 아님\", \"contract_action_curated\": true}, {\"id\": \"CMN-02\", \"check\": \"계약의 목적 조항이 수행 업무의 실질(위탁·매매·용역 등 법적 성격)과 일치하게 기재되어 있는가\", \"label\": \"목적조항 실질 부합\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"surface_policy\": \"anomaly_only\", \"triggers\": {\"keywords\": [\"목적\", \"계약의 목적\"]}, \"auto_clear\": {\"any_groups\": [[\"목적\"], [\"위탁\", \"용역\", \"매매\", \"구매\", \"공급\", \"업무\"]]}, \"auto_verdict\": false, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"목적조항은 계약 해석에 유용하지만 거래 실질과 다른 경우의 수정 필요성은 개별 판단사항임\", \"contract_action_curated\": true}, {\"id\": \"CNS-PRICE\", \"check\": \"대가의 금액 또는 산정·정산 방식이 정해져 있는가\", \"label\": \"대가·산정 방식 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"대금\", \"수수료\", \"대가\", \"단가\", \"지급\", \"정산\", \"지급방법\", \"지급시기\", \"산정\", \"지급 기준\", \"환수\"]}, \"absence_check\": true, \"sources\": [], \"decision_question\": \"대가의 금액 또는 산정·정산 방식이 정해져 있는가?\", \"note\": \"확정금액·단가·수수료율·산식·건별 계약단가·개별발주서 방식 중 하나를 확인한다. 월말 정산·지정계좌·청구 후 고정 일수는 필수요소가 아니다. 가격의 경제적 유리함까지 판정하지 않으며 같은 대가의 실제 충돌과 상대방 단독 변경권은 별도로 표시한다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-03\", \"CMN-04\", \"CH-01\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"금액·단가·산식의 특정, 청구·검수 등 지급기준, 지급기한·방법과 정산 주기를 함께 확인한다. 모집·판매 수수료도 같은 질문으로 검토한다. 부가세 표시는 자동 사실확인 결과로 구별하며, 하도급 지급기한이나 화해금 등 특수한 요건은 해당 항목에서 검토한다.\", \"contract_action_curated\": true}, {\"id\": \"CMN-05\", \"check\": \"해당 대가의 부가가치세 처리 방식이 표시되어 있는가\", \"decision_question\": \"해당 대가의 부가가치세 처리 방식이 표시되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"label\": \"부가가치세 처리 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"부가가치세\", \"부가세\", \"VAT\"]}, \"auto_clear\": {\"any_groups\": [[\"부가가치세\", \"부가세\", \"VAT\"], [\"포함\", \"별도\", \"제외\"]]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"note\": \"해당 대가에 연결된 포함·별도·제외·미포함·면세 등 표시를 표·괄호·짧은 문구에서도 확인한다. 서로 다른 대가의 세금 처리 차이는 충돌이 아니며 같은 대가의 모순·미정만 남긴다.\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"부가가치세 부담 표시는 가격 분쟁을 줄이는 명확화 사항이며 적용 여부는 거래 성격에 따름\", \"contract_action_curated\": true}, {\"id\": \"CNS-TERM\", \"check\": \"계약의 효력·기간 또는 종료 기준이 정해져 있는가\", \"label\": \"효력·기간 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"계약기간\", \"유효기간\", \"존속기간\", \"갱신\", \"자동갱신\", \"연장\"]}, \"absence_check\": true, \"sources\": [], \"decision_question\": \"계약의 효력·기간 또는 종료 기준이 정해져 있는가?\", \"note\": \"날짜 범위·기산일과 기간·업무 완료 등 종료 기준 중 하나를 확인한다. 갱신 약정이 없거나 콜론이 없다는 이유로 보류하지 않으며 지급일만 있는 문구는 계약기간으로 보지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-06\", \"CMN-07\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"기간의 특정·역전 여부와 갱신조건, 거절 통지기한 및 일방적 갱신권을 함께 검토한다. 갱신 약정이 없는 확정기간 계약에 갱신 조항을 추가하도록 요구하지 않는다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"contract_term\"], \"required_facets\": [\"topics\"]}, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제44조제2항\", \"quote\": \"제1항에 따른 통지에 “갱신 여부에 대한 의사표시가 지정한 기한 내에 도달하지 않은 경우에 갱신에 대해 승낙한 것으로 본다.”는 내용이 포함되고, 그 통지를 받은 자가 서면에 기재된 날까지 갱신 여부에 대한 의사표시를 상대방에게 통지하지 않은 경우에 이 계약은 갱신된 것으로 본다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"CNS-END\", \"check\": \"해제·해지 사유나 권리가 정해져 있고 특정한 일방 불리 구조가 없는가\", \"label\": \"해제·해지 약정 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"해지\", \"해제\", \"계약의 해지\", \"최고\", \"시정\", \"서면 통지\"]}, \"auto_verdict\": false, \"absence_check\": true, \"sources\": [], \"decision_question\": \"해제·해지 사유나 권리가 정해져 있고 특정한 일방 불리 구조가 없는가?\", \"note\": \"해제·해지 사유 또는 권리를 확인한다. 30일의 시정기간이나 쌍방의 동일한 해지권은 필수요소가 아니다. 상대방만 무사유 즉시 해지할 수 있고 회사는 계속 구속되는 등 현재 문구에서 주체·효과가 확인된 위험만 남긴다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-08\", \"CMN-09\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"중대한 위반·도산·임의해지 등의 사유, 양 당사자의 권리 균형, 시정 기회와 통지 방법을 한 번에 검토한다. 모든 해지사유에 동일한 시정기간을 요구하지 않는다. 특정 약관 규제와 모집위탁 설명 의무는 별도 적용 항목으로 유지한다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"termination\"], \"actions\": [\"terminate\"], \"required_facets\": [\"topics\", \"actions\"]}, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제51조제1항 본문\", \"quote\": \"원사업자 또는 수급사업자는 다음 각 호의 어느 하나에 해당하는 경우에는 서면으로 이 계약의 전부 또는 일부를 해제 또는 해지할 수 있다. 다만, 기성부분에 대해서는 해제하지 아니한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"CMN-10\", \"check\": \"계약 종료 시 기지급 대금 정산·자료 반환·잔존 조항의 처리와 업무 이관(인수인계·데이터 반환파기·전환 지원)이 규정되어 있는가\", \"label\": \"종료 시 정산·반환\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"반환\", \"파기\", \"존속\", \"잔존\", \"이관\", \"인수인계\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"CORE-15(종료 시 업무·자료 이관) 통합(2026-07-29 지식 다이어트) — 위수탁 이관 실질을 문안 병기로 보존(CORE-15 5케이스 전부 quiet, CMN-10 발화 5회)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"종료 시 정산·반환·이관은 업무 성격에 따라 필요한 범위가 달라지는 운영조건임\", \"contract_action_curated\": true}, {\"id\": \"CNS-DAMAGE\", \"check\": \"책임 배분 약정이 있고 특정한 책임 편중·전면 면책 문제가 없는가\", \"label\": \"책임 배분 약정 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"손해배상\", \"배상책임\", \"손해배상의 범위\", \"면책\", \"책임한도\", \"지체상금\", \"위약금\", \"지연이자\", \"지연손해금\"]}, \"auto_verdict\": false, \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제393조\", \"clause\": \"제1항\", \"quote\": \"채무불이행으로 인한 손해배상은 통상의 손해를 그 한도로 한다\", \"verified\": true, \"text\": \"제393조(손해배상의 범위) 제393조(손해배상의 범위) ①채무불이행으로 인한 손해배상은 통상의 손해를 그 한도로 한다. ②특별한 사정으로 인한 손해는 채무자가 그 사정을 알았거나 알 수 있었을 때에 한하여 배상의 책임이 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제393조\", \"clause\": \"제2항\", \"quote\": \"특별한 사정으로 인한 손해는 채무자가 그 사정을 알았거나 알 수 있었을 때에 한하여 배상의 책임이 있다\", \"verified\": true, \"text\": \"제393조(손해배상의 범위) 제393조(손해배상의 범위) ①채무불이행으로 인한 손해배상은 통상의 손해를 그 한도로 한다. ②특별한 사정으로 인한 손해는 채무자가 그 사정을 알았거나 알 수 있었을 때에 한하여 배상의 책임이 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제398조\", \"clause\": \"제1항\", \"quote\": \"당사자는 채무불이행에 관한 손해배상액을 예정할 수 있다\", \"verified\": true, \"text\": \"제398조(배상액의 예정) 제398조(배상액의 예정) ①당사자는 채무불이행에 관한 손해배상액을 예정할 수 있다. ②손해배상의 예정액이 부당히 과다한 경우에는 법원은 적당히 감액할 수 있다. ③손해배상액의 예정은 이행의 청구나 계약의 해제에 영향을 미치지 아니한다. ④위약금의 약정은 손해배상액의 예정으로 추정한다. ⑤당사자가 금전이 아닌 것으로써 손해의 배상에 충당할 것을 예정한 경우에도 전4항의 규정을 준용한다.\", \"status\": \"quote_ok\"}], \"decision_question\": \"책임 배분 약정이 있고 특정한 책임 편중·전면 면책 문제가 없는가?\", \"note\": \"배상·책임·면책·한도·지체상금 등 책임 배분 약정 중 하나를 확인한다. PRIV-08·NDA-15·SP-DEL-06은 적용 범위와 원 근거를 내부 추적하며 일반 책임 조항이 해당 위반을 포괄하면 전용 문구를 요구하지 않는다. 해당 위반의 명시적 배제와 고의·중과실 전면 면책 등 구체적 위험은 유지한다. CORE-09·SOL-04의 법정 연대·소비자책임 구조, CH-03의 과태료 분담과 하도급 특칙은 대체하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-05-2\", \"CMN-11\", \"CMN-12\", \"CMN-14\", \"RISK-06\", \"SP-DEL-02\", \"PRIV-08\", \"NDA-15\", \"SP-DEL-06\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"conditional_obligations\": [{\"id\": \"PRIV-08\", \"scope\": \"personal_information_processing\", \"module\": \"X-PII\", \"question\": \"위탁 문서에 수탁자의 의무 위반 시 손해배상 등 책임에 관한 사항이 포함되어 있는가\", \"exclusion_blocks\": true, \"general_liability_may_cover\": true}, {\"id\": \"NDA-15\", \"scope\": \"module\", \"module\": \"M-NDA\", \"question\": \"비밀정보(영업비밀) 침해로 인한 손해배상책임 조항이 있는가\", \"exclusion_blocks\": true, \"general_liability_may_cover\": true}, {\"id\": \"SP-DEL-06\", \"scope\": \"module\", \"module\": \"M-DELIVERY\", \"question\": \"하자보수에 갈음하거나 보수와 함께 손해배상을 청구할 수 있는 조항이 있는가\", \"exclusion_blocks\": true, \"general_liability_may_cover\": true}], \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"책임의 편면성, 특별·간접손해의 포함 또는 제외, 상한과 고의·중과실 예외, 위약금의 과도성과 중복 부담을 함께 살핀다. 대금 지급지연 이자와 납품·이행지연 지체상금을 구별한다. 이자·상한·지체상금 특약이 없다는 이유만으로 보완을 요구하지 않는다. 하도급 등 별도 적용 규정의 요건을 이 질문으로 대체하지 않는다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"damages\"], \"actions\": [\"compensate\"], \"required_facets\": [\"topics\", \"actions\"]}, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제28조제1항\", \"quote\": \"지급기한의 다음날부터 지급하는 날까지의 일수(이하 \\\"대가지급지연일수\\\"라 한다)에 해당 미지급금액에  지연발생 시점의 금융기관 대출평균금리(한국은행 통계월보상의 금융기관 대출평균금리를 말한다)를 곱하여 산출한 금액을 이자로 지급하여야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}, {\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제47조제1항\", \"quote\": \"원사업자 또는 수급사업자가 이 계약을 위반하여 상대방에게 손해를 입힌 경우 그 손해를 배상할 책임이 있다. 다만, 고의 또는 과실 없음을 증명한 경우에는 그러하지 아니하다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}, {\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제18조제1항 단서\", \"quote\": \"다만, 납부할 금액이 계약금액(제2항에 따라 기성부분 또는 기납부분에 대하여 검사를 거쳐 이를 인수한 경우에는 그 부분에 상당하는 금액을 계약금액에서 공제한 금액을 말한다)의 100분의 30을 초과하는 경우에는 100분의 30으로 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}, {\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제49조제1항\", \"quote\": \"수급사업자가 정당한 사유없이 계약의 이행을 지체한 경우에 원사업자는 지체일수에 전문에서 정한 지체상금요율을 곱하여 산정한 지체상금을 수급사업자에게 청구할 수 있다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"CNS-SECRET\", \"check\": \"비밀정보의 범위와 사용·공개 제한이 약정되어 있는가\", \"label\": \"비밀 범위·사용 제한 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"비밀유지\", \"비밀정보\", \"영업비밀\", \"기밀\", \"비공지\", \"목적외 사용\", \"비밀유지의무\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제2조\", \"clause\": \"제2호(비공지성)\", \"quote\": \"공공연히 알려져 있지 아니하고\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제2조(정의) 이 법에서 사용하는 용어의 뜻은 다음과 같다.\\n1. “부정경쟁행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품임을 표시한 표지(標識)(이하 이 목에서 “타인의 상품표지”라 한다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포(頒布) 또는 수입ㆍ수출하여 타인의 상품과 혼동하게 하는 행위\\n1) 타인의 상품표지가 국내에 널리 인식되기 전부터 그 타인의 상품표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n나. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 표장(標章), 그 밖에 타인의 영업임을 표시하는 표지(상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함하며, 이하 이 목에서 “타인의 영업표지”라 한다)와 동일하거나 유사한 것을 사용하여 타인의 영업상의 시설 또는 활동과 혼동하게 하는 행위\\n1) 타인의 영업표지가 국내에 널리 인식되기 전부터 그 타인의 영업표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n다. 가목 또는 나목의 혼동하게 하는 행위 외에 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지(타인의 영업임을 표시하는 표지에 관하여는 상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함한다. 이하 이 목에서 같다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 타인의 표지의 식별력이나 명성을 손상하는 행위\\n1) 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지가 국내에 널리 인식되기 전부터 그 타인의 표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n3) 그 밖에 비상업적 사용 등 대통령령으로 정하는 정당한 사유에 해당하는 경우\\n라. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 거짓의 원산지의 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 원산지를 오인(誤認)하게 하는 행위\\n마. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 그 상품이 생산ㆍ제조 또는 가공된 지역 외의 곳에서 생산 또는 가공된 듯이 오인하게 하는 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n바. 타인의 상품을 사칭(詐稱)하거나 상품 또는 그 광고에 상품의 품질, 내용, 제조방법, 용도 또는 수량을 오인하게 하는 선전 또는 표지를 하거나 이러한 방법이나 표지로써 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n사. 다음의 어느 하나의 나라에 등록된 상표 또는 이와 유사한 상표에 관한 권리를 가진 자의 대리인이나 대표자 또는 그 행위일 전 1년 이내에 대리인이나 대표자이었던 자가 정당한 사유 없이 해당 상표를 그 상표의 지정상품과 동일하거나 유사한 상품에 사용하거나 그 상표를 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n(1) 「공업소유권의 보호를 위한 파리협약」(이하 “파리협약”이라 한다) 당사국\\n(2) 세계무역기구 회원국\\n(3) 「상표법 조약」의 체약국(締約國)\\n아. 정당한 권원이 없는 자가 다음의 어느 하나의 목적으로 국내에 널리 인식된 타인의 성명, 상호, 상표, 그 밖의 표지와 동일하거나 유사한 도메인이름을 등록ㆍ보유ㆍ이전 또는 사용하는 행위\\n(1) 상표 등 표지에 대하여 정당한 권원이 있는 자 또는 제3자에게 판매하거나 대여할 목적\\n(2) 정당한 권원이 있는 자의 도메인이름의 등록 및 사용을 방해할 목적\\n(3) 그 밖에 상업적 이익을 얻을 목적\\n자. 타인이 제작한 상품의 형태(형상ㆍ모양ㆍ색채ㆍ광택 또는 이들을 결합한 것을 말하며, 시제품 또는 상품소개서상의 형태를 포함한다. 이하 같다)를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위. 다만, 다음의 어느 하나에 해당하는 행위는 제외한다.\\n(1) 상품의 시제품 제작 등 상품의 형태가 갖추어진 날부터 3년이 지난 상품의 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n(2) 타인이 제작한 상품과 동종의 상품(동종의 상품이 없는 경우에는 그 상품과 기능 및 효용이 동일하거나 유사한 상품을 말한다)이 통상적으로 가지는 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n차. 사업제안, 입찰, 공모 등 거래교섭 또는 거래과정에서 경제적 가치를 가지는 타인의 기술적 또는 영업상의 아이디어가 포함된 정보를 그 제공목적에 위반하여 자신 또는 제3자의 영업상 이익을 위하여 부정하게 사용하거나 타인에게 제공하여 사용하게 하는 행위. 다만, 아이디어를 제공받은 자가 제공받을 당시 이미 그 아이디어를 알고 있었거나 그 아이디어가 동종 업계에서 널리 알려진 경우에는 그러하지 아니하다.\\n카. 데이터[「데이터 산업진흥 및 이용촉진에 관한 기본법」 제2조제1호에 따른 데이터 중 업(業)으로서 특정인 또는 특정 다수에게 제공되는 것으로, 전자적 방법으로 상당량 축적ㆍ관리되는 기술상 또는 영업상의 정보(제2호에 따른 영업비밀은 제외한다)를 말한다. 이하 같다]를 부정하게 사용하는 행위로서 다음의 어느 하나에 해당하는 행위\\n1) 접근권한이 없는 자가 절취ㆍ기망ㆍ부정접속 또는 그 밖의 부정한 수단으로 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n2) 데이터 보유자와의 계약관계 등에 따라 데이터에 접근권한이 있는 자가 부정한 이익을 얻거나 데이터 보유자에게 손해를 입힐 목적으로 그 데이터를 사용ㆍ공개하거나 제3자에게 제공하는 행위\\n3) 1) 또는 2)가 개입된 사실을 알고 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n4) 정당한 권한 없이 데이터의 보호를 위하여 적용한 기술적 보호조치를 회피ㆍ제거 또는 변경(이하 “무력화”라 한다)하는 것을 주된 목적으로 하는 기술ㆍ서비스ㆍ장치 또는 그 장치의 부품을 제공ㆍ수입ㆍ수출ㆍ제조ㆍ양도ㆍ대여 또는 전송하거나 이를 양도ㆍ대여하기 위하여 전시하는 행위. 다만, 기술적 보호조치의 연구ㆍ개발을 위하여 기술적 보호조치를 무력화하는 장치 또는 그 부품을 제조하는 경우에는 그러하지 아니하다.\\n타. 국내에 널리 인식되고 경제적 가치를 가지는 타인의 성명, 초상, 음성, 서명 등 그 타인을 식별할 수 있는 표지를 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n파. 그 밖에 타인의 상당한 투자나 노력으로 만들어진 성과 등을 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n2. “영업비밀”이란 공공연히 알려져 있지 아니하고 독립된 경제적 가치를 가지는 것으로서, 비밀로 관리된 생산방법, 판매방법, 그 밖에 영업활동에 유용한 기술상 또는 경영상의 정보를 말한다.\\n3. “영업비밀 침해행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 절취(竊取), 기망(欺罔), 협박, 그 밖의 부정한 수단으로 영업비밀을 취득하는 행위(이하 “부정취득행위”라 한다) 또는 그 취득한 영업비밀을 사용하거나 공개(비밀을 유지하면서 특정인에게 알리는 것을 포함한다. 이하 같다)하는 행위\\n나. 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n다. 영업비밀을 취득한 후에 그 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n라. 계약관계 등에 따라 영업비밀을 비밀로서 유지하여야 할 의무가 있는 자가 부정한 이익을 얻거나 그 영업비밀의 보유자에게 손해를 입힐 목적으로 그 영업비밀을 사용하거나 공개하는 행위\\n마. 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n바. 영업비밀을 취득한 후에 그 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n4. “도메인이름”이란 인터넷상의 숫자로 된 주소에 해당하는 숫자ㆍ문자ㆍ기호 또는 이들의 결합을 말한다.\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제2조\", \"clause\": \"제2호(경제적 가치성)\", \"quote\": \"독립된 경제적 가치를 가지는 것으로서\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제2조(정의) 이 법에서 사용하는 용어의 뜻은 다음과 같다.\\n1. “부정경쟁행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품임을 표시한 표지(標識)(이하 이 목에서 “타인의 상품표지”라 한다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포(頒布) 또는 수입ㆍ수출하여 타인의 상품과 혼동하게 하는 행위\\n1) 타인의 상품표지가 국내에 널리 인식되기 전부터 그 타인의 상품표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n나. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 표장(標章), 그 밖에 타인의 영업임을 표시하는 표지(상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함하며, 이하 이 목에서 “타인의 영업표지”라 한다)와 동일하거나 유사한 것을 사용하여 타인의 영업상의 시설 또는 활동과 혼동하게 하는 행위\\n1) 타인의 영업표지가 국내에 널리 인식되기 전부터 그 타인의 영업표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n다. 가목 또는 나목의 혼동하게 하는 행위 외에 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지(타인의 영업임을 표시하는 표지에 관하여는 상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함한다. 이하 이 목에서 같다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 타인의 표지의 식별력이나 명성을 손상하는 행위\\n1) 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지가 국내에 널리 인식되기 전부터 그 타인의 표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n3) 그 밖에 비상업적 사용 등 대통령령으로 정하는 정당한 사유에 해당하는 경우\\n라. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 거짓의 원산지의 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 원산지를 오인(誤認)하게 하는 행위\\n마. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 그 상품이 생산ㆍ제조 또는 가공된 지역 외의 곳에서 생산 또는 가공된 듯이 오인하게 하는 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n바. 타인의 상품을 사칭(詐稱)하거나 상품 또는 그 광고에 상품의 품질, 내용, 제조방법, 용도 또는 수량을 오인하게 하는 선전 또는 표지를 하거나 이러한 방법이나 표지로써 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n사. 다음의 어느 하나의 나라에 등록된 상표 또는 이와 유사한 상표에 관한 권리를 가진 자의 대리인이나 대표자 또는 그 행위일 전 1년 이내에 대리인이나 대표자이었던 자가 정당한 사유 없이 해당 상표를 그 상표의 지정상품과 동일하거나 유사한 상품에 사용하거나 그 상표를 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n(1) 「공업소유권의 보호를 위한 파리협약」(이하 “파리협약”이라 한다) 당사국\\n(2) 세계무역기구 회원국\\n(3) 「상표법 조약」의 체약국(締約國)\\n아. 정당한 권원이 없는 자가 다음의 어느 하나의 목적으로 국내에 널리 인식된 타인의 성명, 상호, 상표, 그 밖의 표지와 동일하거나 유사한 도메인이름을 등록ㆍ보유ㆍ이전 또는 사용하는 행위\\n(1) 상표 등 표지에 대하여 정당한 권원이 있는 자 또는 제3자에게 판매하거나 대여할 목적\\n(2) 정당한 권원이 있는 자의 도메인이름의 등록 및 사용을 방해할 목적\\n(3) 그 밖에 상업적 이익을 얻을 목적\\n자. 타인이 제작한 상품의 형태(형상ㆍ모양ㆍ색채ㆍ광택 또는 이들을 결합한 것을 말하며, 시제품 또는 상품소개서상의 형태를 포함한다. 이하 같다)를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위. 다만, 다음의 어느 하나에 해당하는 행위는 제외한다.\\n(1) 상품의 시제품 제작 등 상품의 형태가 갖추어진 날부터 3년이 지난 상품의 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n(2) 타인이 제작한 상품과 동종의 상품(동종의 상품이 없는 경우에는 그 상품과 기능 및 효용이 동일하거나 유사한 상품을 말한다)이 통상적으로 가지는 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n차. 사업제안, 입찰, 공모 등 거래교섭 또는 거래과정에서 경제적 가치를 가지는 타인의 기술적 또는 영업상의 아이디어가 포함된 정보를 그 제공목적에 위반하여 자신 또는 제3자의 영업상 이익을 위하여 부정하게 사용하거나 타인에게 제공하여 사용하게 하는 행위. 다만, 아이디어를 제공받은 자가 제공받을 당시 이미 그 아이디어를 알고 있었거나 그 아이디어가 동종 업계에서 널리 알려진 경우에는 그러하지 아니하다.\\n카. 데이터[「데이터 산업진흥 및 이용촉진에 관한 기본법」 제2조제1호에 따른 데이터 중 업(業)으로서 특정인 또는 특정 다수에게 제공되는 것으로, 전자적 방법으로 상당량 축적ㆍ관리되는 기술상 또는 영업상의 정보(제2호에 따른 영업비밀은 제외한다)를 말한다. 이하 같다]를 부정하게 사용하는 행위로서 다음의 어느 하나에 해당하는 행위\\n1) 접근권한이 없는 자가 절취ㆍ기망ㆍ부정접속 또는 그 밖의 부정한 수단으로 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n2) 데이터 보유자와의 계약관계 등에 따라 데이터에 접근권한이 있는 자가 부정한 이익을 얻거나 데이터 보유자에게 손해를 입힐 목적으로 그 데이터를 사용ㆍ공개하거나 제3자에게 제공하는 행위\\n3) 1) 또는 2)가 개입된 사실을 알고 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n4) 정당한 권한 없이 데이터의 보호를 위하여 적용한 기술적 보호조치를 회피ㆍ제거 또는 변경(이하 “무력화”라 한다)하는 것을 주된 목적으로 하는 기술ㆍ서비스ㆍ장치 또는 그 장치의 부품을 제공ㆍ수입ㆍ수출ㆍ제조ㆍ양도ㆍ대여 또는 전송하거나 이를 양도ㆍ대여하기 위하여 전시하는 행위. 다만, 기술적 보호조치의 연구ㆍ개발을 위하여 기술적 보호조치를 무력화하는 장치 또는 그 부품을 제조하는 경우에는 그러하지 아니하다.\\n타. 국내에 널리 인식되고 경제적 가치를 가지는 타인의 성명, 초상, 음성, 서명 등 그 타인을 식별할 수 있는 표지를 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n파. 그 밖에 타인의 상당한 투자나 노력으로 만들어진 성과 등을 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n2. “영업비밀”이란 공공연히 알려져 있지 아니하고 독립된 경제적 가치를 가지는 것으로서, 비밀로 관리된 생산방법, 판매방법, 그 밖에 영업활동에 유용한 기술상 또는 경영상의 정보를 말한다.\\n3. “영업비밀 침해행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 절취(竊取), 기망(欺罔), 협박, 그 밖의 부정한 수단으로 영업비밀을 취득하는 행위(이하 “부정취득행위”라 한다) 또는 그 취득한 영업비밀을 사용하거나 공개(비밀을 유지하면서 특정인에게 알리는 것을 포함한다. 이하 같다)하는 행위\\n나. 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n다. 영업비밀을 취득한 후에 그 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n라. 계약관계 등에 따라 영업비밀을 비밀로서 유지하여야 할 의무가 있는 자가 부정한 이익을 얻거나 그 영업비밀의 보유자에게 손해를 입힐 목적으로 그 영업비밀을 사용하거나 공개하는 행위\\n마. 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n바. 영업비밀을 취득한 후에 그 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n4. “도메인이름”이란 인터넷상의 숫자로 된 주소에 해당하는 숫자ㆍ문자ㆍ기호 또는 이들의 결합을 말한다.\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제2조\", \"clause\": \"제2호(비밀관리성)\", \"quote\": \"비밀로 관리된 생산방법, 판매방법, 그 밖에 영업활동에 유용한 기술상 또는 경영상의 정보를 말한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제2조(정의) 이 법에서 사용하는 용어의 뜻은 다음과 같다.\\n1. “부정경쟁행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품임을 표시한 표지(標識)(이하 이 목에서 “타인의 상품표지”라 한다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포(頒布) 또는 수입ㆍ수출하여 타인의 상품과 혼동하게 하는 행위\\n1) 타인의 상품표지가 국내에 널리 인식되기 전부터 그 타인의 상품표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n나. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 표장(標章), 그 밖에 타인의 영업임을 표시하는 표지(상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함하며, 이하 이 목에서 “타인의 영업표지”라 한다)와 동일하거나 유사한 것을 사용하여 타인의 영업상의 시설 또는 활동과 혼동하게 하는 행위\\n1) 타인의 영업표지가 국내에 널리 인식되기 전부터 그 타인의 영업표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n다. 가목 또는 나목의 혼동하게 하는 행위 외에 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지(타인의 영업임을 표시하는 표지에 관하여는 상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함한다. 이하 이 목에서 같다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 타인의 표지의 식별력이나 명성을 손상하는 행위\\n1) 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지가 국내에 널리 인식되기 전부터 그 타인의 표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n3) 그 밖에 비상업적 사용 등 대통령령으로 정하는 정당한 사유에 해당하는 경우\\n라. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 거짓의 원산지의 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 원산지를 오인(誤認)하게 하는 행위\\n마. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 그 상품이 생산ㆍ제조 또는 가공된 지역 외의 곳에서 생산 또는 가공된 듯이 오인하게 하는 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n바. 타인의 상품을 사칭(詐稱)하거나 상품 또는 그 광고에 상품의 품질, 내용, 제조방법, 용도 또는 수량을 오인하게 하는 선전 또는 표지를 하거나 이러한 방법이나 표지로써 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n사. 다음의 어느 하나의 나라에 등록된 상표 또는 이와 유사한 상표에 관한 권리를 가진 자의 대리인이나 대표자 또는 그 행위일 전 1년 이내에 대리인이나 대표자이었던 자가 정당한 사유 없이 해당 상표를 그 상표의 지정상품과 동일하거나 유사한 상품에 사용하거나 그 상표를 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n(1) 「공업소유권의 보호를 위한 파리협약」(이하 “파리협약”이라 한다) 당사국\\n(2) 세계무역기구 회원국\\n(3) 「상표법 조약」의 체약국(締約國)\\n아. 정당한 권원이 없는 자가 다음의 어느 하나의 목적으로 국내에 널리 인식된 타인의 성명, 상호, 상표, 그 밖의 표지와 동일하거나 유사한 도메인이름을 등록ㆍ보유ㆍ이전 또는 사용하는 행위\\n(1) 상표 등 표지에 대하여 정당한 권원이 있는 자 또는 제3자에게 판매하거나 대여할 목적\\n(2) 정당한 권원이 있는 자의 도메인이름의 등록 및 사용을 방해할 목적\\n(3) 그 밖에 상업적 이익을 얻을 목적\\n자. 타인이 제작한 상품의 형태(형상ㆍ모양ㆍ색채ㆍ광택 또는 이들을 결합한 것을 말하며, 시제품 또는 상품소개서상의 형태를 포함한다. 이하 같다)를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위. 다만, 다음의 어느 하나에 해당하는 행위는 제외한다.\\n(1) 상품의 시제품 제작 등 상품의 형태가 갖추어진 날부터 3년이 지난 상품의 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n(2) 타인이 제작한 상품과 동종의 상품(동종의 상품이 없는 경우에는 그 상품과 기능 및 효용이 동일하거나 유사한 상품을 말한다)이 통상적으로 가지는 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n차. 사업제안, 입찰, 공모 등 거래교섭 또는 거래과정에서 경제적 가치를 가지는 타인의 기술적 또는 영업상의 아이디어가 포함된 정보를 그 제공목적에 위반하여 자신 또는 제3자의 영업상 이익을 위하여 부정하게 사용하거나 타인에게 제공하여 사용하게 하는 행위. 다만, 아이디어를 제공받은 자가 제공받을 당시 이미 그 아이디어를 알고 있었거나 그 아이디어가 동종 업계에서 널리 알려진 경우에는 그러하지 아니하다.\\n카. 데이터[「데이터 산업진흥 및 이용촉진에 관한 기본법」 제2조제1호에 따른 데이터 중 업(業)으로서 특정인 또는 특정 다수에게 제공되는 것으로, 전자적 방법으로 상당량 축적ㆍ관리되는 기술상 또는 영업상의 정보(제2호에 따른 영업비밀은 제외한다)를 말한다. 이하 같다]를 부정하게 사용하는 행위로서 다음의 어느 하나에 해당하는 행위\\n1) 접근권한이 없는 자가 절취ㆍ기망ㆍ부정접속 또는 그 밖의 부정한 수단으로 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n2) 데이터 보유자와의 계약관계 등에 따라 데이터에 접근권한이 있는 자가 부정한 이익을 얻거나 데이터 보유자에게 손해를 입힐 목적으로 그 데이터를 사용ㆍ공개하거나 제3자에게 제공하는 행위\\n3) 1) 또는 2)가 개입된 사실을 알고 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n4) 정당한 권한 없이 데이터의 보호를 위하여 적용한 기술적 보호조치를 회피ㆍ제거 또는 변경(이하 “무력화”라 한다)하는 것을 주된 목적으로 하는 기술ㆍ서비스ㆍ장치 또는 그 장치의 부품을 제공ㆍ수입ㆍ수출ㆍ제조ㆍ양도ㆍ대여 또는 전송하거나 이를 양도ㆍ대여하기 위하여 전시하는 행위. 다만, 기술적 보호조치의 연구ㆍ개발을 위하여 기술적 보호조치를 무력화하는 장치 또는 그 부품을 제조하는 경우에는 그러하지 아니하다.\\n타. 국내에 널리 인식되고 경제적 가치를 가지는 타인의 성명, 초상, 음성, 서명 등 그 타인을 식별할 수 있는 표지를 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n파. 그 밖에 타인의 상당한 투자나 노력으로 만들어진 성과 등을 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n2. “영업비밀”이란 공공연히 알려져 있지 아니하고 독립된 경제적 가치를 가지는 것으로서, 비밀로 관리된 생산방법, 판매방법, 그 밖에 영업활동에 유용한 기술상 또는 경영상의 정보를 말한다.\\n3. “영업비밀 침해행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 절취(竊取), 기망(欺罔), 협박, 그 밖의 부정한 수단으로 영업비밀을 취득하는 행위(이하 “부정취득행위”라 한다) 또는 그 취득한 영업비밀을 사용하거나 공개(비밀을 유지하면서 특정인에게 알리는 것을 포함한다. 이하 같다)하는 행위\\n나. 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n다. 영업비밀을 취득한 후에 그 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n라. 계약관계 등에 따라 영업비밀을 비밀로서 유지하여야 할 의무가 있는 자가 부정한 이익을 얻거나 그 영업비밀의 보유자에게 손해를 입힐 목적으로 그 영업비밀을 사용하거나 공개하는 행위\\n마. 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n바. 영업비밀을 취득한 후에 그 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n4. “도메인이름”이란 인터넷상의 숫자로 된 주소에 해당하는 숫자ㆍ문자ㆍ기호 또는 이들의 결합을 말한다.\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제2조\", \"clause\": \"제3호 라목\", \"quote\": \"계약관계 등에 따라 영업비밀을 비밀로서 유지하여야 할 의무가 있는 자가 부정한 이익을 얻거나 그 영업비밀의 보유자에게 손해를 입힐 목적으로 그 영업비밀을 사용하거나 공개하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제2조(정의) 이 법에서 사용하는 용어의 뜻은 다음과 같다.\\n1. “부정경쟁행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품임을 표시한 표지(標識)(이하 이 목에서 “타인의 상품표지”라 한다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포(頒布) 또는 수입ㆍ수출하여 타인의 상품과 혼동하게 하는 행위\\n1) 타인의 상품표지가 국내에 널리 인식되기 전부터 그 타인의 상품표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n나. 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 표장(標章), 그 밖에 타인의 영업임을 표시하는 표지(상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함하며, 이하 이 목에서 “타인의 영업표지”라 한다)와 동일하거나 유사한 것을 사용하여 타인의 영업상의 시설 또는 활동과 혼동하게 하는 행위\\n1) 타인의 영업표지가 국내에 널리 인식되기 전부터 그 타인의 영업표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n다. 가목 또는 나목의 혼동하게 하는 행위 외에 다음의 어느 하나에 해당하는 정당한 사유 없이 국내에 널리 인식된 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지(타인의 영업임을 표시하는 표지에 관하여는 상품 판매ㆍ서비스 제공방법 또는 간판ㆍ외관ㆍ실내장식 등 영업제공 장소의 전체적인 외관을 포함한다. 이하 이 목에서 같다)와 동일하거나 유사한 것을 사용하거나 이러한 것을 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 타인의 표지의 식별력이나 명성을 손상하는 행위\\n1) 타인의 성명, 상호, 상표, 상품의 용기ㆍ포장, 그 밖에 타인의 상품 또는 영업임을 표시한 표지가 국내에 널리 인식되기 전부터 그 타인의 표지와 동일하거나 유사한 표지를 부정한 목적 없이 계속 사용하는 경우\\n2) 1)에 해당하는 자의 승계인으로서 부정한 목적 없이 계속 사용하는 경우\\n3) 그 밖에 비상업적 사용 등 대통령령으로 정하는 정당한 사유에 해당하는 경우\\n라. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 거짓의 원산지의 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하여 원산지를 오인(誤認)하게 하는 행위\\n마. 상품이나 그 광고에 의하여 또는 공중이 알 수 있는 방법으로 거래상의 서류 또는 통신에 그 상품이 생산ㆍ제조 또는 가공된 지역 외의 곳에서 생산 또는 가공된 듯이 오인하게 하는 표지를 하거나 이러한 표지를 한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n바. 타인의 상품을 사칭(詐稱)하거나 상품 또는 그 광고에 상품의 품질, 내용, 제조방법, 용도 또는 수량을 오인하게 하는 선전 또는 표지를 하거나 이러한 방법이나 표지로써 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n사. 다음의 어느 하나의 나라에 등록된 상표 또는 이와 유사한 상표에 관한 권리를 가진 자의 대리인이나 대표자 또는 그 행위일 전 1년 이내에 대리인이나 대표자이었던 자가 정당한 사유 없이 해당 상표를 그 상표의 지정상품과 동일하거나 유사한 상품에 사용하거나 그 상표를 사용한 상품을 판매ㆍ반포 또는 수입ㆍ수출하는 행위\\n(1) 「공업소유권의 보호를 위한 파리협약」(이하 “파리협약”이라 한다) 당사국\\n(2) 세계무역기구 회원국\\n(3) 「상표법 조약」의 체약국(締約國)\\n아. 정당한 권원이 없는 자가 다음의 어느 하나의 목적으로 국내에 널리 인식된 타인의 성명, 상호, 상표, 그 밖의 표지와 동일하거나 유사한 도메인이름을 등록ㆍ보유ㆍ이전 또는 사용하는 행위\\n(1) 상표 등 표지에 대하여 정당한 권원이 있는 자 또는 제3자에게 판매하거나 대여할 목적\\n(2) 정당한 권원이 있는 자의 도메인이름의 등록 및 사용을 방해할 목적\\n(3) 그 밖에 상업적 이익을 얻을 목적\\n자. 타인이 제작한 상품의 형태(형상ㆍ모양ㆍ색채ㆍ광택 또는 이들을 결합한 것을 말하며, 시제품 또는 상품소개서상의 형태를 포함한다. 이하 같다)를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위. 다만, 다음의 어느 하나에 해당하는 행위는 제외한다.\\n(1) 상품의 시제품 제작 등 상품의 형태가 갖추어진 날부터 3년이 지난 상품의 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n(2) 타인이 제작한 상품과 동종의 상품(동종의 상품이 없는 경우에는 그 상품과 기능 및 효용이 동일하거나 유사한 상품을 말한다)이 통상적으로 가지는 형태를 모방한 상품을 양도ㆍ대여 또는 이를 위한 전시를 하거나 수입ㆍ수출하는 행위\\n차. 사업제안, 입찰, 공모 등 거래교섭 또는 거래과정에서 경제적 가치를 가지는 타인의 기술적 또는 영업상의 아이디어가 포함된 정보를 그 제공목적에 위반하여 자신 또는 제3자의 영업상 이익을 위하여 부정하게 사용하거나 타인에게 제공하여 사용하게 하는 행위. 다만, 아이디어를 제공받은 자가 제공받을 당시 이미 그 아이디어를 알고 있었거나 그 아이디어가 동종 업계에서 널리 알려진 경우에는 그러하지 아니하다.\\n카. 데이터[「데이터 산업진흥 및 이용촉진에 관한 기본법」 제2조제1호에 따른 데이터 중 업(業)으로서 특정인 또는 특정 다수에게 제공되는 것으로, 전자적 방법으로 상당량 축적ㆍ관리되는 기술상 또는 영업상의 정보(제2호에 따른 영업비밀은 제외한다)를 말한다. 이하 같다]를 부정하게 사용하는 행위로서 다음의 어느 하나에 해당하는 행위\\n1) 접근권한이 없는 자가 절취ㆍ기망ㆍ부정접속 또는 그 밖의 부정한 수단으로 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n2) 데이터 보유자와의 계약관계 등에 따라 데이터에 접근권한이 있는 자가 부정한 이익을 얻거나 데이터 보유자에게 손해를 입힐 목적으로 그 데이터를 사용ㆍ공개하거나 제3자에게 제공하는 행위\\n3) 1) 또는 2)가 개입된 사실을 알고 데이터를 취득하거나 그 취득한 데이터를 사용ㆍ공개하는 행위\\n4) 정당한 권한 없이 데이터의 보호를 위하여 적용한 기술적 보호조치를 회피ㆍ제거 또는 변경(이하 “무력화”라 한다)하는 것을 주된 목적으로 하는 기술ㆍ서비스ㆍ장치 또는 그 장치의 부품을 제공ㆍ수입ㆍ수출ㆍ제조ㆍ양도ㆍ대여 또는 전송하거나 이를 양도ㆍ대여하기 위하여 전시하는 행위. 다만, 기술적 보호조치의 연구ㆍ개발을 위하여 기술적 보호조치를 무력화하는 장치 또는 그 부품을 제조하는 경우에는 그러하지 아니하다.\\n타. 국내에 널리 인식되고 경제적 가치를 가지는 타인의 성명, 초상, 음성, 서명 등 그 타인을 식별할 수 있는 표지를 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n파. 그 밖에 타인의 상당한 투자나 노력으로 만들어진 성과 등을 공정한 상거래 관행이나 경쟁질서에 반하는 방법으로 자신의 영업을 위하여 무단으로 사용함으로써 타인의 경제적 이익을 침해하는 행위\\n2. “영업비밀”이란 공공연히 알려져 있지 아니하고 독립된 경제적 가치를 가지는 것으로서, 비밀로 관리된 생산방법, 판매방법, 그 밖에 영업활동에 유용한 기술상 또는 경영상의 정보를 말한다.\\n3. “영업비밀 침해행위”란 다음 각 목의 어느 하나에 해당하는 행위를 말한다.\\n가. 절취(竊取), 기망(欺罔), 협박, 그 밖의 부정한 수단으로 영업비밀을 취득하는 행위(이하 “부정취득행위”라 한다) 또는 그 취득한 영업비밀을 사용하거나 공개(비밀을 유지하면서 특정인에게 알리는 것을 포함한다. 이하 같다)하는 행위\\n나. 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n다. 영업비밀을 취득한 후에 그 영업비밀에 대하여 부정취득행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n라. 계약관계 등에 따라 영업비밀을 비밀로서 유지하여야 할 의무가 있는 자가 부정한 이익을 얻거나 그 영업비밀의 보유자에게 손해를 입힐 목적으로 그 영업비밀을 사용하거나 공개하는 행위\\n마. 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 취득하는 행위 또는 그 취득한 영업비밀을 사용하거나 공개하는 행위\\n바. 영업비밀을 취득한 후에 그 영업비밀이 라목에 따라 공개된 사실 또는 그러한 공개행위가 개입된 사실을 알거나 중대한 과실로 알지 못하고 그 영업비밀을 사용하거나 공개하는 행위\\n4. “도메인이름”이란 인터넷상의 숫자로 된 주소에 해당하는 숫자ㆍ문자ㆍ기호 또는 이들의 결합을 말한다.\", \"status\": \"quote_ok\"}], \"decision_question\": \"비밀정보의 범위와 사용·공개 제한이 약정되어 있는가?\", \"note\": \"보호할 정보 범위와 사용·공개 제한을 함께 확인한다. 목적 외 사용 금지나 사전 동의 없는 공개 금지 등 대체 표현을 인정한다. 존속기간은 기재된 경우 함께 읽되 모든 계약에 동일한 기간·종료일·예외 목록을 요구하지 않는다. 정의나 제목만으로는 통과하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-15\", \"CMN-16\", \"NDA-01\", \"NDA-02\", \"NDA-03\", \"NDA-04\", \"NDA-05\", \"NDA-06\", \"NDA-07\", \"NDA-08\", \"NDA-09\", \"NDA-10\", \"NDA-21\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"보호할 정보를 식별할 수 있는지, 목적 외 사용·누설과 제3자·취급자 관리가 적절한지 함께 확인한다. 공지·독자개발·정당취득 정보와 법령에 따른 공개를 고려하고, 영업비밀 등 정보의 성격에 맞는 관리와 종료 후 존속 범위를 검토한다. 정의 조항이 있다는 사실만으로 약정 전체가 적절하다고 판단하지 않는다. 개인정보 처리위탁 의무는 별도로 검토한다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"confidentiality\"], \"objects\": [\"confidential_information\"], \"required_facets\": [\"topics\", \"objects\"]}, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제40조제1항\", \"quote\": \"원사업자와 수급사업자는 이 계약에서 알게 된 상대방의 업무상 비밀을 상대방의 동의 없이 이용하거나 제3자에게 누설하지 아니한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"CNS-IP\", \"check\": \"계약 산출물의 권리 귀속 또는 회사의 사용권이 약정되어 있는가\", \"label\": \"산출물 권리·사용권 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"지식재산권\", \"저작권\", \"산출물\", \"결과물\", \"저작재산권\", \"소스코드\", \"2차적저작물\", \"권리 귀속\", \"업무상저작물\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"저작권법\", \"article\": \"제45조\", \"clause\": \"제2항\", \"quote\": \"저작재산권의 전부를 양도하는 경우에 특약이 없는 때에는 제22조에 따른 2차적저작물을 작성하여 이용할 권리는 포함되지 아니한 것으로 추정한다. 다만, 프로그램의 경우 특약이 없으면 2차적저작물작성권도 함께 양도된 것으로 추정한다.\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제45조(저작재산권의 양도)\\n①저작재산권은 전부 또는 일부를 양도할 수 있다.\\n②저작재산권의 전부를 양도하는 경우에 특약이 없는 때에는 제22조에 따른 2차적저작물을 작성하여 이용할 권리는 포함되지 아니한 것으로 추정한다. 다만, 프로그램의 경우 특약이 없으면 2차적저작물작성권도 함께 양도된 것으로 추정한다.\", \"status\": \"quote_ok\"}, {\"law\": \"저작권법\", \"article\": \"제9조\", \"clause\": \"본문\", \"quote\": \"법인등의 명의로 공표되는 업무상저작물의 저작자는 계약 또는 근무규칙 등에 다른 정함이 없는 때에는 그 법인등이 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제9조(업무상저작물의 저작자)\\n법인등의 명의로 공표되는 업무상저작물의 저작자는 계약 또는 근무규칙 등에 다른 정함이 없는 때에는 그 법인등이 된다. 다만, 컴퓨터프로그램저작물(이하 \\\"프로그램\\\"이라 한다)의 경우 공표될 것을 요하지 아니한다.\", \"status\": \"quote_ok\"}], \"decision_question\": \"계약 산출물의 권리 귀속 또는 회사의 사용권이 약정되어 있는가?\", \"note\": \"계약 산출물에 관한 회사의 소유·귀속 또는 계약 목적에 필요한 사용허락 중 하나를 확인한다. 소유권을 반드시 취득해야 하는 것으로 보지 않는다. 권리 제목만 있거나 회사의 필요한 사용권을 명시적으로 배제한 경우는 통과하지 않는다. 소스 인도·제3자 라이선스는 별도 의무이다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CMN-17\", \"ITDL-01\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"deliverable_or_software\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"산출물·저작물의 소유 및 이용권을 구별하고, 개발계약에서는 소스코드·프로그램의 저작재산권과 2차적저작물 작성 권한을 함께 살핀다. 소스 인도·에스크로와 제3자 라이선스는 권리 귀속과 다른 의무이므로 해당 항목에서 검토한다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"intellectual_property\"], \"objects\": [\"intellectual_property\", \"deliverable\"], \"required_facets\": [\"topics\", \"objects\"]}, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제56조제1항 본문\", \"quote\": \"해당 계약에 따른 계약목적물에 대한 지식재산권은 발주기관과 계약상대자가 공동으로 소유하며, 별도의 정함이 없는 한 지분은 균등한 것으로 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}, {\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제56조제1항 본문\", \"quote\": \"해당 계약에 따른 계약목적물에 대한 지식재산권은 발주기관과 계약상대자가 공동으로 소유하며, 별도의 정함이 없는 한 지분은 균등한 것으로 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"CMN-18\", \"check\": \"제3자 지식재산권 침해 주장 시 수탁자의 방어·면책 의무 조항이 있는가\", \"label\": \"제3자 IP 침해 면책\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"권리 침해\", \"제3자의 권리\", \"지식재산권 침해\"]}, \"evidence_required_groups\": [[\"지식재산권\", \"지적재산권\", \"저작권\", \"특허\", \"상표\"], [\"침해\"], [\"방어\", \"면책\", \"배상\", \"책임\"]], \"auto_clear\": {\"any_groups\": [[\"제3자\"], [\"권리\", \"지식재산권\", \"저작권\"], [\"침해\"], [\"방어\", \"면책\", \"배상\"]]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"decision_question\": \"제3자 지식재산권 침해 주장 시 수탁자의 방어·면책 의무 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"제3자 지식재산권 침해 대응은 산출물·라이선스 위험을 배분하는 협상사항임\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"curated\", \"topics\": [\"intellectual_property\"], \"objects\": [\"intellectual_property\"], \"required_facets\": [\"topics\", \"objects\"]}, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제25조 본문\", \"quote\": \"용역을 수행함에 있어 제3자의 권리의 대상으로 되어 있는 특허권 등을 사용할 때에는 계약상대자는 그 사용에 관한 일체의 책임을 져야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"CMN-19\", \"check\": \"소송 관할이나 중재 등 분쟁해결 방식이 정해져 있는가\", \"label\": \"분쟁해결 방식 확인\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"관할\", \"분쟁\", \"중재\", \"관할법원\"]}, \"llm_elements\": [\"분쟁해결 방식\", \"관할 법원 또는 중재기관\"], \"decisive_patterns\": [\"전속관할\", \"합의관할\", \"관할법원으로 한다\", \"관할 법원으로 한다\", \"관할로 한다\", \"제1심\", \"대한상사중재원\", \"중재로 해결\"], \"absence_check\": true, \"sources\": [], \"note\": \"법원명 또는 소재지 등 지정 기준이나 중재절차를 확인한다. 법원명 허용 목록·전속 표현을 요구하지 않는다. 제목·공란·추후 협의·양립 불가능한 지정만 미확인 또는 충돌로 표시한다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"decision_question\": \"소송 관할이나 중재 등 분쟁해결 방식이 정해져 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"분쟁해결 방식과 관할 합의는 절차 편의를 위한 선택적 계약조건임\", \"contract_action_curated\": true}, {\"id\": \"CMN-20\", \"check\": \"계약상 지위·권리의무의 사전 서면 동의 없는 양도·이전·담보 제공을 금지하는 조항이 있는가\", \"decision_question\": \"계약상 지위·권리의무의 사전 서면 동의 없는 양도·이전·담보 제공을 금지하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"label\": \"양도·이전 제한\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"양도\", \"이전\", \"담보 제공\", \"승계\"]}, \"evidence_required_groups\": [[\"양도\", \"이전\", \"계약상 지위\", \"권리의무\", \"권리·의무\"]], \"auto_clear\": {\"any_groups\": [[\"양도\", \"이전\", \"담보 제공\"], [\"동의\", \"승인\"]], \"expect\": \"prohibition\"}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"양도제한은 상대방 변경 위험을 통제하기 위해 선택적으로 두는 계약상 제한임\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"curated\", \"topics\": [\"assignment\"], \"actions\": [\"assign\"], \"objects\": [\"contractual_position\"], \"modalities\": [\"prior_written_consent\", \"prohibition\"], \"required_facets\": [\"topics\", \"actions\"]}, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제39조\", \"quote\": \"원사업자와 수급사업자는 이 계약으로부터 발생하는 채권 또는 채무를 제3자에게 양도하거나 담보로 제공하지 아니한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}, {\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제7조제2항\", \"quote\": \"계약담당공무원은 제1항에 의한 채권양도와 관련하여 적정한 용역이행목적 등 필요한 경우에는 채권양도를 제한하는 특약을 정하여 운용할 수 있다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"CMN-21\", \"check\": \"합의에 따른 서면 변경 방식이 정해져 있는가\", \"label\": \"합의·서면 변경\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"계약 변경\", \"계약의 변경\", \"합의\", \"서면\", \"문서로 변경\"]}, \"absence_check\": false, \"sources\": [], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"all_contracts\", \"decision_question\": \"합의에 따른 서면 변경 방식이 정해져 있는가?\", \"note\": \"변경에 관한 합의와 서면 방식을 확인한다. 합의 자체에 상호 동의가 포함되므로 쌍방·상호를 반복 요구하지 않는다. 완전합의 조항은 필수요소가 아니며 단순 협의와 합의는 구별한다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"FIN-ASSET-01\", \"check\": \"여신(신용공여)이 보험업법 자산운용 원칙(안정성·유동성·수익성·공익성)에 부합하는가\", \"label\": \"자산운용 원칙 부합\", \"module\": \"X-ASSET\", \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 보험업법 제104조(자산운용 원칙·선관주의)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"자산운용\", \"신용공여\", \"선량한 관리자\"]}, \"evidence_required_groups\": [[\"자산운용\", \"신용공여\", \"여신\", \"대출\"]], \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제104조\", \"clause\": \"\", \"quote\": \"보험회사는 그 자산을 운용할 때 안정성ㆍ유동성ㆍ수익성 및 공익성이 확보되도록 하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제104조(자산운용의 원칙) 제104조(자산운용의 원칙) ① 보험회사는 그 자산을 운용할 때 안정성ㆍ유동성ㆍ수익성 및 공익성이 확보되도록 하여야 한다. ② 보험회사는 선량한 관리자의 주의로써 그 자산을 운용하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-ASSET-02\", \"check\": \"금지되는 자산운용(투기목적 대출·자기주식 취득 목적 대출·임직원 대출 등)에 해당하지 않는가\", \"label\": \"금지 자산운용 비해당\", \"module\": \"X-ASSET\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 보험업법 제105조(금지되는 자산운용)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"투기\", \"자기주식\", \"임직원 대출\", \"정치자금\"]}, \"evidence_required_groups\": [[\"투기\", \"자기주식\", \"임직원 대출\", \"정치자금\"]], \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제105조\", \"clause\": \"\", \"quote\": \"상품이나 유가증권에 대한 투기를 목적으로 하는 자금의 대출\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제105조(금지 또는 제한되는 자산운용) 제105조(금지 또는 제한되는 자산운용) 보험회사는 그 자산을 다음 각 호의 어느 하나에 해당하는 방법으로 운용하여서는 아니 된다. 1. 대통령령으로 정하는 업무용 부동산이 아닌 부동산(저당권 등 담보권의 실행으로 취득하는 부동산은 제외한다)의 소유 2. 제108조제1항제2호에 따라 설정된 특별계정을 통한 부동산의 소유 3. 상품이나 유가증권에 대한 투기를 목적으로 하는 자금의 대출 4. 직접ㆍ간접을 불문하고 해당 보험회사의 주식을 사도록 하기 위한 대출 5. 직접ㆍ간접을 불문하고 정치자금의 대출 6. 해당 보험회사의 임직원에 대한 대출(보험약관에 따른 대출 및 금융위원회가 정하는 소액대출은 제외한다) 7. 자산운용의 안정성을 크게 해칠 우려가 있는 행위로서 대통령령으로 정하는 행위\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-ASSET-03\", \"check\": \"대주주·동일차주 신용공여가 자산운용 한도(보험업법 제106조)를 초과하지 않는가\", \"label\": \"대주주 신용공여 한도\", \"module\": \"X-ASSET\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(한도) — 보험업법 제106조(신용공여 비율 한도)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"신용공여\", \"동일차주\", \"한도\", \"대주주\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제106조\", \"clause\": \"제1항\", \"quote\": \"동일차주에 대한 신용공여 또는 그 동일차주가 발행한 채권 및 주식 소유의 합계액 가. 일반계정: 총자산의 100분의 12\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제106조(자산운용의 방법 및 비율) 제106조(자산운용의 방법 및 비율) ① 보험회사는 일반계정(제108조제1항제1호 및 제4호의 특별계정을 포함한다. 이하 이 조에서 같다)에 속하는 자산과 제108조제1항제2호에 따른 특별계정(이하 이 조에서 특별계정이라 한다)에 속하는 자산을 운용할 때 다음 각 호의 비율을 초과할 수 없다. 다만, 특별계정의 자산으로서 자산운용의 손실이 일반계정에 영향을 미치는 자산 중 대통령령으로 정하는 자산의 경우에는 일반계정에 포함하여 자산운용비율을 적용한다. <개정 2020.5.19, 2022.12.31> 1. 동일한 개인 또는 법인에 대한 신용공여 가. 일반계정: 총자산의 100분의 3 나. 특별계정: 각 특별계정 자산의 100분의 5 2. 동일한 법인이 발행한 채권 및 주식 소유의 합계액 가. 일반계정: 총자산의 100분의 7 나. 특별계정: 각 특별계정 자산의 100분의 10 3. 동일차주에 대한 신용공여 또는 그 동일차주가 발행한 채권 및 주식 소유의 합계액 가. 일반계정: 총자산의 100분의 12 나. 특별계정: 각 특별계정 자산의 100분의 15 4. 동일한 개인ㆍ법인, 동일차주 또는 대주주(그의 특수관계인을 포함한다. 이하 이 절에서 같다)에 대한 총자산의 100분의 1을 초과하는 거액 신용공여의 합계액 가. 일반계정: 총자산의 100분의 20 나. 특별계정: 각 특별계정 자산의 100분의 20 5. 대주주 및 대통령령으로 정하는 자회사에 대한 신용공여 가. 일반계정: 자기자본의 100분의 40(자기자본의 100분의 40에 해당하는 금액이 총자산의 100분의 2에 해당하는 금액보다 큰 경우에는 총자산의 100분의 2) 나. 특별계정: 각 특별계정 자산의 100분의 2 6. 대주주 및 대통령령으로 정하는 자회사가 발행한 채권 및 주식 소유의 합계액 가. 일반계정: 자기자본의 100분의 60(자기자본의 100분의 60에 해당하는 금액이 총자산의 100분의 3에 해당하는 금액보다 큰 경우에는 총자산의 100분의 3) 나. 특별계정: 각 특별계정 자산의 100분의 3 7. 동일한 자회사에 대한 신용공여 가. 일반계정: 자기자본의 100분의 10 나. 특별계정: 각 특별계정 자산의 100분의 4 8. 부동산의 소유 가. 일반계정: 총자산의 100분의 25 나. 특별계정: 각 특별계정 자산의 100분의 15 9. 「외국환거래법」에 따른 외국환이나 외국부동산의 소유(외화표시 보험에 대하여 지급보험금과 같은 외화로 보유하는 자산의 경우에는 금융위원회가 정하는 바에 따라 책임준비금을 한도로 자산운용비율의 산정 대상에 포함하지 아니한다) 가. 일반계정: 총자산의 100분의 50 나. 특별계정: 각 특별계정 자산의 100분의 50 10. 삭제 <2022.12.31> ② 제1항 각 호에 따른 자산운용비율은 자산운용의 건전성 향상 또는 보험계약자 보호에 필요한 경우에는 대통령령으로 정하는 바에 따라 그 비율의 100분의 50의 범위에서 인하하거나, 발행주체 및 투자수단 등을 구분하여 별도로 정할 수 있다. ③ 제1항에도 불구하고 대통령령으로 정하는 금액 이하의 특별계정에 대하여는 일반계정에 포함하여 자산운용비율을 적용한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-SP-01\", \"check\": \"변액보험 등 특별계정 자산의 투자인 경우 특별계정 구분·구분회계가 전제되어 있는가\", \"label\": \"특별계정 구분회계\", \"module\": \"X-ASSET\", \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 보험업법 제108조(특별계정 자산 구분 회계처리)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"특별계정\", \"변액\", \"구분 회계\", \"준비금\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제108조\", \"clause\": \"제2항\", \"quote\": \"특별계정에 속하는 자산은 다른 특별계정에 속하는 자산 및 그 밖의 자산과 구분하여 회계처리하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제108조(특별계정의 설정ㆍ운용) 제108조(특별계정의 설정ㆍ운용) ① 보험회사는 다음 각 호의 어느 하나에 해당하는 계약에 대하여는 대통령령으로 정하는 바에 따라 그 준비금에 상당하는 자산의 전부 또는 일부를 그 밖의 자산과 구별하여 이용하기 위한 계정(이하 \\\"특별계정\\\"이라 한다)을 각각 설정하여 운용할 수 있다. <개정 2020.12.8> 1. 「소득세법」 제20조의3제1항제2호 각 목 외의 부분에 따른 연금저축계좌를 설정하는 계약 2. 「근로자퇴직급여 보장법」 제29조제2항에 따른 보험계약 및 법률 제10967호 근로자퇴직급여 보장법 전부개정법률 부칙 제2조제1항 본문에 따른 퇴직보험계약 3. 변액보험계약(보험금이 자산운용의 성과에 따라 변동하는 보험계약을 말한다) 4. 그 밖에 금융위원회가 필요하다고 인정하는 보험계약 ② 보험회사는 특별계정에 속하는 자산은 다른 특별계정에 속하는 자산 및 그 밖의 자산과 구분하여 회계처리하여야 한다. <개정 2015.7.24> ③ 보험회사는 특별계정에 속하는 이익을 그 계정상의 보험계약자에게 분배할 수 있다. ④ 특별계정에 속하는 자산의 운용방법 및 평가, 이익의 분배, 자산운용실적의 비교ㆍ공시, 운용전문인력의 확보, 의결권 행사의 제한 등 보험계약자 보호에 필요한 사항은 대통령령으로 정한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"ITCL-01\", \"module\": \"X-CLOUD\", \"check\": \"클라우드 이용업무의 중요도 평가에 필요한 자료 제공 협조 조항이 있는가\", \"label\": \"이용업무 중요도 평가\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"클라우드\", \"중요도 평가\", \"중요업무\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제1항 제1호\", \"quote\": \"다음 각 목의 기준에 따른 이용업무의 중요도 평가\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"cloud_service\", \"decision_question\": \"클라우드 이용업무의 중요도 평가에 필요한 자료 제공 협조 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"중요도 평가를 회사가 수행하되 제공자의 자료 협조는 계약으로 확보할 필요가 있음\", \"contract_action_curated\": true}, {\"id\": \"ITCL-02\", \"module\": \"X-CLOUD\", \"check\": \"클라우드컴퓨팅서비스 제공자의 건전성·안전성 평가에 필요한 자료 제공 협조 조항이 있는가\", \"label\": \"제공자 건전성·안전성 평가\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"클라우드\", \"건전성\", \"안전성\", \"평가\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제1항 제2호\", \"quote\": \"클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"cloud_service\", \"decision_question\": \"클라우드컴퓨팅서비스 제공자의 건전성·안전성 평가에 필요한 자료 제공 협조 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"건전성·안전성 평가는 회사 의무이고 제공자 자료 협조만 계약 통제 대상임\", \"contract_action_curated\": true}, {\"id\": \"ITCL-03\", \"module\": \"X-CLOUD\", \"check\": \"클라우드 이용 관련 업무연속성 계획·안전성 확보조치의 수립·시행이 계약상 뒷받침되는가\", \"label\": \"업무연속성·안전성 확보\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"업무연속성\", \"안전성 확보조치\", \"클라우드\", \"재해복구\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제1항 제3호\", \"quote\": \"클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"cloud_service\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"업무연속성 계획은 내부통제로 수립하되 제공자 역할은 계약으로 뒷받침할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"ITCL-05\", \"module\": \"X-CLOUD\", \"check\": \"클라우드 신규 이용 등 보고 사유에 필요한 자료 제공·통지 협조가 약정되어 있는가\", \"label\": \"감독원장 보고 협조\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"보고\", \"금융감독원\", \"클라우드\", \"3개월\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제4항\", \"quote\": \"다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"cloud_service\", \"decision_question\": \"클라우드 신규 이용 등 보고 사유에 필요한 자료 제공·통지 협조가 약정되어 있는가?\", \"note\": \"클라우드 이용에만 적용하여 보고 자료 제공·통지 협조 약정을 확인한다. 회사의 실제 보고 완료나 계약 문장에 3개월을 반복했는지는 판정하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독보고는 회사 의무이고 기한 준수를 위한 자료·통지 협조가 필요한 항목임\", \"contract_action_curated\": true}, {\"id\": \"ITCL-06\", \"module\": \"X-CLOUD\", \"check\": \"제공자의 합병·분할·계약상 지위 양도·재위탁 등 중대한 변경사항 발생 시 사전 통지 조항이 있는가\", \"label\": \"중대변경 사전통지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"합병\", \"분할\", \"양도\", \"재위탁\", \"중대한 변경\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제4항 제2호\", \"quote\": \"클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"note\": \"법령상 의무는 발생일부터 3개월 내 사후 보고(제14조의2④)이며 계약상 사전 통지는 가중 약정임\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"cloud_service\", \"decision_question\": \"제공자의 합병·분할·계약상 지위 양도·재위탁 등 중대한 변경사항 발생 시 사전 통지 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"제공자 지위·재위탁 등 중대 변경을 회사가 적시에 알 수 있는 계약 통제가 필요함\", \"contract_action_curated\": true}, {\"id\": \"ITCL-07\", \"module\": \"X-CLOUD\", \"check\": \"고유식별정보·개인신용정보를 클라우드로 처리하는 경우 해당 정보처리시스템의 국내 설치(국내 리전)가 계약상 보장되는가\", \"label\": \"국내 리전 설치 보장\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제14조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"국내\", \"국외\", \"리전\", \"고유식별정보\"]}, \"tier\": \"conditional\", \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제14조의2\", \"clause\": \"제7항 단서\", \"quote\": \"고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다\", \"verified\": true, \"text\": \"제14조의2(클라우드컴퓨팅서비스 이용절차 등) ① 금융회사 또는 전자금융업자는 「클라우드컴퓨팅 발전 및 이용자 보호에 관한 법률」 제2조제3호에 따른 클라우드컴퓨팅서비스를 이용하고자 하는 경우 다음 각 호의 절차를 수행하여야 한다.<개정 2018. 12. 21.> 1. 다음 각 목의 기준에 따른 이용업무의 중요도 평가<개정 2022. 11. 23.> 가. 규모, 복잡성 등 클라우드컴퓨팅서비스를 통해 처리되는 업무의 특성<신설 2022. 11. 23.> 나. 클라우드컴퓨팅서비스 제공자로부터 제공받는 서비스가 중단될 경우 미치는 영향<신설 2022. 11. 23.> 다. 전자적 침해행위 발생 시 고객에게 미치는 영향<신설 2022. 11. 23.> 라. 여러 업무를 같은 클라우드컴퓨팅서비스 제공자에게 위탁하는 경우 해당 클라우드컴퓨팅서비스 제공자에 대한 종속 위험<신설 2022. 11. 23.> 마. 클라우드컴퓨팅서비스 이용에 대한 금융회사 또는 전자금융업자의 내부통제 및 법규 준수 역량<신설 2022. 11. 23.> 바. 그 밖에 금융감독원장이 정하여 고시하는 사항<신설 2022. 11. 23.> 2. 클라우드컴퓨팅서비스 제공자의 건전성 및 안전성 등에 대한 평가(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의2>의 평가항목 중 필수항목만 평가할 수 있다.)<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 이용과 관련한 업무 연속성 계획 및 안전성 확보조치의 수립ㆍ시행(단, 제1호의 평가를 통해 비중요업무로 분류된 업무에 대해서는 <별표 2의3> 및 <별표 2의4>의 필수 사항만 수립ㆍ시행할 수 있다.)<개정 2022. 11. 23.> ② 금융회사 또는 전자금융업자는 제1항 각 호에 따른 평가결과, 업무연속성 계획 및 안전성 확보조치에 대하여 제8조의2에 따른 정보보호위원회의 심의ㆍ의결을 거쳐야 한다.<개정 2018. 12. 21., 2022. 11. 23.> ③ 금융회사 또는 전자금융업자는 제1항제2호의 평가를 직접 수행하거나 제37조의6제1항의 침해사고대응기관이 수행한 평가 결과를 활용할 수 있다.<개정 2018. 12. 21, 2022. 11. 23., 2025. 2. 5.> ④ 금융회사 또는 전자금융업자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 날로부터 3개월 이내에 금융감독원장에게 보고하여야 하고, 관련 서류를 최신상태로 유지하여야 한다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> 1. 클라우드컴퓨팅서비스 이용계약을 신규로 체결하거나, 기존 클라우드컴퓨팅서비스 이용계약을 통해 신규 업무를 처리하는 경우<신설 2022. 11. 23., 개정 2025. 2. 5.> 2. 클라우드컴퓨팅서비스 제공자의 합병, 분할, 계약상 지위의 양도, 재위탁 등 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> 3. 클라우드컴퓨팅서비스 제공자가 서비스품질의 유지, 안전성 확보 등과 관련한 중요 계약사항을 이행하지 아니한 경우<개정 2022. 11. 23.> 4. 제1항제2호 또는 제3호에 관한 중대한 변경사항이 발생한 경우<개정 2022. 11. 23.> ⑤ 제4항의 보고에 관한 양식, 첨부서류 등에 관해서는 금융감독원장이 정하는 바에 따른다.<신설 2018. 12. 21., 개정 2022. 11. 23., 2025. 2. 5.> ㅑ ⑥ 금융감독원장은 제4항에 따라 제출한 보고 서류가 누락되거나, 중요도 평가 또는 업무연속성계획ㆍ안전성 확보조치 등이 충분하지 않다고 판단하는 경우에는 금융회사 또는 전자금융업자에 대하여 개선ㆍ보완을 요구할 수 있다.<종전의 제7항에서 이동, 2025. 2. 5.><개정 2018. 12. 21., 2022. 11. 23.> ⑦ 제1항의 절차를 거친 클라우드컴퓨팅서비스 제공자의 정보처리시스템이 위치한 전산실에 대해서는 제11조제1호 및 제2호, 제15조제1항제5호를 적용하지 아니한다. 다만, 금융회사 또는 전자금융업자(전자금융거래의 안전성 및 신뢰성에 중대한 영향을 미치지 않는 외국금융회사의 국내지점, 제50조의2에 따른 국외 사이버몰을 위한 전자지급결제대행업자는 제외한다)가 고유식별정보 또는 개인신용정보를 클라우드컴퓨팅서비스를 통하여 처리하는 경우에는 제11조제2호를 적용하고, 해당 정보처리시스템을 국내에 설치하여야 한다. <단서신설 2018. 12. 21><개정 2022. 11. 23., 2025. 2. 5.> ⑧ 그 밖에 금융회사 또는 전자금융업자의 클라우드컴퓨팅서비스 이용에 대해서는 「금융회사의 정보처리 업무 위탁에 관한 규정」에 따른다.<종전의 제9항에서 이동, 2025. 2. 5.><신설 2018. 12. 21.> #### 제5절 정보보호부문<신설 2025. 2. 5.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"cloud_service\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"정보처리시스템 설치 지역은 서비스 제공 조건이므로 계약에서 특정할 필요가 있음\", \"contract_action_curated\": true}, {\"id\": \"ALL-COMP-01\", \"check\": \"경쟁사업자 간 협력이 가격·거래조건·거래상대방을 공동으로 정하는 부당한 공동행위에 해당하지 않는가\", \"label\": \"부당 공동행위\", \"module\": \"X-COMP\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 공정거래법 제40조 제1항(부당한 공동행위 금지, 합의 자체 무효)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"공동\", \"가격\", \"거래조건\", \"거래상대방\", \"경쟁\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제40조\", \"clause\": \"제1항\", \"quote\": \"다른 사업자와 공동으로 부당하게 경쟁을 제한하는 다음 각 호의 어느 하나에 해당하는 행위를 할 것을 합의\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제40조(부당한 공동행위의 금지) 제40조(부당한 공동행위의 금지) ① 사업자는 계약ㆍ협정ㆍ결의 또는 그 밖의 어떠한 방법으로도 다른 사업자와 공동으로 부당하게 경쟁을 제한하는 다음 각 호의 어느 하나에 해당하는 행위를 할 것을 합의(이하 \\\"부당한 공동행위\\\"라 한다)하거나 다른 사업자로 하여금 이를 하도록 하여서는 아니 된다. 1. 가격을 결정ㆍ유지 또는 변경하는 행위 2. 상품 또는 용역의 거래조건이나, 그 대금 또는 대가의 지급조건을 정하는 행위 3. 상품의 생산ㆍ출고ㆍ수송 또는 거래의 제한이나 용역의 거래를 제한하는 행위 4. 거래지역 또는 거래상대방을 제한하는 행위 5. 생산 또는 용역의 거래를 위한 설비의 신설 또는 증설이나 장비의 도입을 방해하거나 제한하는 행위 6. 상품 또는 용역의 생산ㆍ거래 시에 그 상품 또는 용역의 종류ㆍ규격을 제한하는 행위 7. 영업의 주요 부문을 공동으로 수행ㆍ관리하거나 수행ㆍ관리하기 위한 회사 등을 설립하는 행위 8. 입찰 또는 경매를 할 때 낙찰자, 경락자, 입찰가격, 낙찰가격 또는 경락가격, 그 밖에 대통령령으로 정하는 사항을 결정하는 행위 9. 그 밖의 행위로서 다른 사업자(그 행위를 한 사업자를 포함한다)의 사업활동 또는 사업내용을 방해ㆍ제한하거나 가격, 생산량, 그 밖에 대통령령으로 정하는 정보를 주고받음으로써 일정한 거래분야에서 경쟁을 실질적으로 제한하는 행위 ② 제1항은 부당한 공동행위가 다음 각 호의 어느 하나에 해당하는 목적을 위하여 하는 경우로서 대통령령으로 정하는 요건에 해당하고 공정거래위원회의 인가를 받은 경우에는 적용하지 아니한다. 1. 불황극복을 위한 산업구조조정 2. 연구ㆍ기술개발 3. 거래조건의 합리화 4. 중소기업의 경쟁력향상 ③ 제2항에 따른 인가의 기준ㆍ방법ㆍ절차 및 인가사항변경 등에 관하여 필요한 사항은 대통령령으로 정한다. ④ 부당한 공동행위를 할 것을 약정하는 계약 등은 해당 사업자 간에는 그 효력을 무효로 한다. ⑤ 제1항 각 호의 어느 하나에 해당하는 행위를 하는 둘 이상의 사업자가 다음 각 호의 어느 하나에 해당하는 경우에는 그 사업자들 사이에 공동으로 제1항 각 호의 어느 하나에 해당하는 행위를 할 것을 합의한 것으로 추정한다. 1. 해당 거래분야, 상품ㆍ용역의 특성, 해당 행위의 경제적 이유 및 파급효과, 사업자 간 접촉의 횟수ㆍ양태 등 제반 사정에 비추어 그 행위를 그 사업자들이 공동으로 한 것으로 볼 수 있는 상당한 개연성이 있을 때 2. 제1항 각 호의 행위(제9호의 행위 중 정보를 주고받음으로써 일정한 거래분야에서 경쟁을 실질적으로 제한하는 행위를 제외한다)에 필요한 정보를 주고받은 때 ⑥ 부당한 공동행위에 관한 심사의 기준은 공정거래위원회가 정하여 고시한다.\", \"status\": \"quote_ok\"}, {\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제40조\", \"clause\": \"제4항\", \"quote\": \"부당한 공동행위를 할 것을 약정하는 계약 등은 해당 사업자 간에는 그 효력을 무효로 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제40조(부당한 공동행위의 금지) 제40조(부당한 공동행위의 금지) ① 사업자는 계약ㆍ협정ㆍ결의 또는 그 밖의 어떠한 방법으로도 다른 사업자와 공동으로 부당하게 경쟁을 제한하는 다음 각 호의 어느 하나에 해당하는 행위를 할 것을 합의(이하 \\\"부당한 공동행위\\\"라 한다)하거나 다른 사업자로 하여금 이를 하도록 하여서는 아니 된다. 1. 가격을 결정ㆍ유지 또는 변경하는 행위 2. 상품 또는 용역의 거래조건이나, 그 대금 또는 대가의 지급조건을 정하는 행위 3. 상품의 생산ㆍ출고ㆍ수송 또는 거래의 제한이나 용역의 거래를 제한하는 행위 4. 거래지역 또는 거래상대방을 제한하는 행위 5. 생산 또는 용역의 거래를 위한 설비의 신설 또는 증설이나 장비의 도입을 방해하거나 제한하는 행위 6. 상품 또는 용역의 생산ㆍ거래 시에 그 상품 또는 용역의 종류ㆍ규격을 제한하는 행위 7. 영업의 주요 부문을 공동으로 수행ㆍ관리하거나 수행ㆍ관리하기 위한 회사 등을 설립하는 행위 8. 입찰 또는 경매를 할 때 낙찰자, 경락자, 입찰가격, 낙찰가격 또는 경락가격, 그 밖에 대통령령으로 정하는 사항을 결정하는 행위 9. 그 밖의 행위로서 다른 사업자(그 행위를 한 사업자를 포함한다)의 사업활동 또는 사업내용을 방해ㆍ제한하거나 가격, 생산량, 그 밖에 대통령령으로 정하는 정보를 주고받음으로써 일정한 거래분야에서 경쟁을 실질적으로 제한하는 행위 ② 제1항은 부당한 공동행위가 다음 각 호의 어느 하나에 해당하는 목적을 위하여 하는 경우로서 대통령령으로 정하는 요건에 해당하고 공정거래위원회의 인가를 받은 경우에는 적용하지 아니한다. 1. 불황극복을 위한 산업구조조정 2. 연구ㆍ기술개발 3. 거래조건의 합리화 4. 중소기업의 경쟁력향상 ③ 제2항에 따른 인가의 기준ㆍ방법ㆍ절차 및 인가사항변경 등에 관하여 필요한 사항은 대통령령으로 정한다. ④ 부당한 공동행위를 할 것을 약정하는 계약 등은 해당 사업자 간에는 그 효력을 무효로 한다. ⑤ 제1항 각 호의 어느 하나에 해당하는 행위를 하는 둘 이상의 사업자가 다음 각 호의 어느 하나에 해당하는 경우에는 그 사업자들 사이에 공동으로 제1항 각 호의 어느 하나에 해당하는 행위를 할 것을 합의한 것으로 추정한다. 1. 해당 거래분야, 상품ㆍ용역의 특성, 해당 행위의 경제적 이유 및 파급효과, 사업자 간 접촉의 횟수ㆍ양태 등 제반 사정에 비추어 그 행위를 그 사업자들이 공동으로 한 것으로 볼 수 있는 상당한 개연성이 있을 때 2. 제1항 각 호의 행위(제9호의 행위 중 정보를 주고받음으로써 일정한 거래분야에서 경쟁을 실질적으로 제한하는 행위를 제외한다)에 필요한 정보를 주고받은 때 ⑥ 부당한 공동행위에 관한 심사의 기준은 공정거래위원회가 정하여 고시한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"ALL-COMP-02\", \"check\": \"우월적 지위를 이용해 상대방에게 불리한 조건을 강제하거나 사업활동을 부당 구속하지 않는가\", \"label\": \"우월적 지위 남용\", \"module\": \"X-COMP\", \"severity\": \"권장\", \"severity_basis\": \"강행규정(금지)이나 부당성 판단 필요 — 공정거래법 제45조 제1항(불공정거래행위·거래상지위남용)\", \"norm_type\": \"강행\", \"severity_override\": true, \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"거래상 지위\", \"구속\", \"불이익\", \"강제\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제1항 제6호\", \"quote\": \"자기의 거래상의 지위를 부당하게 이용하여 상대방과 거래하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제45조(불공정거래행위의 금지) 제45조(불공정거래행위의 금지) ① 사업자는 다음 각 호의 어느 하나에 해당하는 행위로서 공정한 거래를 해칠 우려가 있는 행위(이하 \\\"불공정거래행위\\\"라 한다)를 하거나, 계열회사 또는 다른 사업자로 하여금 이를 하도록 하여서는 아니 된다. 1. 부당하게 거래를 거절하는 행위 2. 부당하게 거래의 상대방을 차별하여 취급하는 행위 3. 부당하게 경쟁자를 배제하는 행위 4. 부당하게 경쟁자의 고객을 자기와 거래하도록 유인하는 행위 5. 부당하게 경쟁자의 고객을 자기와 거래하도록 강제하는 행위 6. 자기의 거래상의 지위를 부당하게 이용하여 상대방과 거래하는 행위 7. 거래의 상대방의 사업활동을 부당하게 구속하는 조건으로 거래하는 행위 8. 부당하게 다른 사업자의 사업활동을 방해하는 행위 9. 부당하게 다음 각 목의 어느 하나에 해당하는 행위를 통하여 특수관계인 또는 다른 회사를 지원하는 행위 가. 특수관계인 또는 다른 회사에 가지급금ㆍ대여금ㆍ인력ㆍ부동산ㆍ유가증권ㆍ상품ㆍ용역ㆍ무체재산권 등을 제공하거나 상당히 유리한 조건으로 거래하는 행위 나. 다른 사업자와 직접 상품ㆍ용역을 거래하면 상당히 유리함에도 불구하고 거래상 실질적인 역할이 없는 특수관계인이나 다른 회사를 매개로 거래하는 행위 10. 그 밖의 행위로서 공정한 거래를 해칠 우려가 있는 행위 ② 특수관계인 또는 회사는 다른 사업자로부터 제1항제9호에 해당할 우려가 있음에도 불구하고 해당 지원을 받는 행위를 하여서는 아니 된다. ③ 불공정거래행위의 유형 또는 기준은 대통령령으로 정한다. ④ 공정거래위원회는 제1항을 위반하는 행위를 예방하기 위하여 필요한 경우 사업자가 준수하여야 할 지침을 제정ㆍ고시할 수 있다. ⑤ 사업자 또는 사업자단체는 부당한 고객유인을 방지하기 위하여 자율적으로 규약(이하 \\\"공정경쟁규약\\\"이라 한다)을 정할 수 있다. ⑥ 사업자 또는 사업자단체는 공정거래위원회에 공정경쟁규약이 제1항제4호를 위반하는지에 대한 심사를 요청할 수 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제1항 제7호\", \"quote\": \"거래의 상대방의 사업활동을 부당하게 구속하는 조건으로 거래하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제45조(불공정거래행위의 금지) 제45조(불공정거래행위의 금지) ① 사업자는 다음 각 호의 어느 하나에 해당하는 행위로서 공정한 거래를 해칠 우려가 있는 행위(이하 \\\"불공정거래행위\\\"라 한다)를 하거나, 계열회사 또는 다른 사업자로 하여금 이를 하도록 하여서는 아니 된다. 1. 부당하게 거래를 거절하는 행위 2. 부당하게 거래의 상대방을 차별하여 취급하는 행위 3. 부당하게 경쟁자를 배제하는 행위 4. 부당하게 경쟁자의 고객을 자기와 거래하도록 유인하는 행위 5. 부당하게 경쟁자의 고객을 자기와 거래하도록 강제하는 행위 6. 자기의 거래상의 지위를 부당하게 이용하여 상대방과 거래하는 행위 7. 거래의 상대방의 사업활동을 부당하게 구속하는 조건으로 거래하는 행위 8. 부당하게 다른 사업자의 사업활동을 방해하는 행위 9. 부당하게 다음 각 목의 어느 하나에 해당하는 행위를 통하여 특수관계인 또는 다른 회사를 지원하는 행위 가. 특수관계인 또는 다른 회사에 가지급금ㆍ대여금ㆍ인력ㆍ부동산ㆍ유가증권ㆍ상품ㆍ용역ㆍ무체재산권 등을 제공하거나 상당히 유리한 조건으로 거래하는 행위 나. 다른 사업자와 직접 상품ㆍ용역을 거래하면 상당히 유리함에도 불구하고 거래상 실질적인 역할이 없는 특수관계인이나 다른 회사를 매개로 거래하는 행위 10. 그 밖의 행위로서 공정한 거래를 해칠 우려가 있는 행위 ② 특수관계인 또는 회사는 다른 사업자로부터 제1항제9호에 해당할 우려가 있음에도 불구하고 해당 지원을 받는 행위를 하여서는 아니 된다. ③ 불공정거래행위의 유형 또는 기준은 대통령령으로 정한다. ④ 공정거래위원회는 제1항을 위반하는 행위를 예방하기 위하여 필요한 경우 사업자가 준수하여야 할 지침을 제정ㆍ고시할 수 있다. ⑤ 사업자 또는 사업자단체는 부당한 고객유인을 방지하기 위하여 자율적으로 규약(이하 \\\"공정경쟁규약\\\"이라 한다)을 정할 수 있다. ⑥ 사업자 또는 사업자단체는 공정거래위원회에 공정경쟁규약이 제1항제4호를 위반하는지에 대한 심사를 요청할 수 있다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"CRS-04\", \"module\": \"X-CROSS\", \"check\": \"국외 지급·외화 결제 시 외국환거래 관련 신고·보고 의무와 결제통화·환위험 부담 주체가 계약에 반영되어 있는가\", \"label\": \"외환 신고·결제통화\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님) — 개별 거래유형별 외국환거래법령 신고의무는 별도 확인 필요\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"외화\", \"USD\", \"결제통화\", \"환율\", \"외국환\", \"송금\", \"환위험\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"외국환거래법·외국환거래규정상 자본거래·지급등의 신고·보고 의무가 거래유형에 따라 발생할 수 있음(자본거래 신고·해외직접투자 신고 등). 계약 조항 강제사항이 아니라 이행상 규제라 basis=practice로 두되, 해당 거래유형이 특정되면 외국환거래법령 원문 확인 후 별도 check 승격 검토(현재 조문 미확인 — 거래유형 미특정).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"CRS-05\", \"module\": \"X-CROSS\", \"check\": \"국외 당사자에 대한 대가 지급 시 원천징수(제한세율·조세조약 적용) 부담 주체와 gross-up 여부가 명확한가\", \"label\": \"원천징수·조세부담\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"원천징수\", \"조세조약\", \"gross-up\", \"세금 부담\", \"withholding\", \"제한세율\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"비거주자·외국법인에 대한 국내원천소득(이자·사용료·용역대가 등) 지급 시 법인세법·소득세법상 원천징수 의무 발생 가능, 조세조약상 제한세율 적용은 거주자증명·수익적소유자 요건에 좌우됨. 세부담 주체·gross-up 명시는 실무 표준. 조문 인용은 거래·소득유형 특정 후 원천징수 조항 원문 확인 필요(현재 미특정 — basis=practice).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"CRS-06\", \"module\": \"X-CROSS\", \"check\": \"계약 상대방·이행이 국제 제재(sanctions)·수출통제 대상에 해당하지 않음을 확인하고, 제재 저촉 시 이행거절·해지 등 대응 조항을 두었는가\", \"label\": \"제재·수출통제 해당성\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님) — 대외무역법·전략물자 수출입고시 등 개별 규제는 별도 확인 필요\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"제재\", \"sanctions\", \"수출통제\", \"전략물자\", \"OFAC\", \"금수\", \"수출허가\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"국내법(대외무역법·전략물자 수출입고시)과 외국법(미국 OFAC 제재·EU 제재 등)이 병존 적용될 수 있음. 금융회사는 자금세탁방지·제재 준수 의무(특정금융정보법·검사규정) 별도. 제재 저촉 리스크는 계약 강제조항이 아니라 컴플라이언스 리스크라 basis=practice. 구체 규제 저촉 시 해당 법령 원문 확인 후 승격 검토(현재 조문 미확인).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"ITSEC-01\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"외부주문 개발업무에 사용되는 업무장소·전산설비를 내부 업무용과 분리하여 설치·운영하는 조항이 있는가\", \"label\": \"업무장소·전산설비 분리\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"분리\", \"업무장소\", \"전산설비\", \"개발 장소\", \"개발망\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제1호\", \"quote\": \"외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"외부주문 개발업무에 사용되는 업무장소·전산설비를 내부 업무용과 분리하여 설치·운영하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-02\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경을 금지하는 조항이 있는가\", \"label\": \"암호해독·원장변경 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"암호화정보\", \"해독\", \"원장\", \"데이터 변경 금지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제2호\", \"quote\": \"금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경을 금지하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-03\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"계좌번호·비밀번호 등 이용자 금융정보의 무단보관·유출 금지 조항이 있는가\", \"label\": \"금융정보 무단보관·유출 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"계좌번호\", \"비밀번호\", \"금융정보\", \"무단보관\", \"유출 금지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제3호\", \"quote\": \"계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"계좌번호·비밀번호 등 이용자 금융정보의 무단보관·유출 금지 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-04\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"접근매체 위·변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 조항이 있는가\", \"label\": \"접근매체·해킹 보안대책\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"보안대책\", \"해킹\", \"접근매체\", \"위변조\", \"정보유출\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제4호\", \"quote\": \"접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"접근매체 위·변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-05\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"금융회사와 전자금융보조업자 간 접속에 전용회선(동등 보안수준의 가상 전용회선 포함)을 사용하는 조항이 있는가\", \"label\": \"전용회선 사용\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"전용회선\", \"회선\", \"망 분리\", \"접속\", \"VPN\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제5호\", \"quote\": \"금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"금융회사와 전자금융보조업자 간 접속에 전용회선(동등 보안수준의 가상 전용회선 포함)을 사용하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-06\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 조항이 있는가\", \"label\": \"서비스중단 비상대책\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"비상대책\", \"장애\", \"서비스 중단\", \"복구\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제6호\", \"quote\": \"정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-07\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"외부주문의 입찰·계약·수행·완료 등 각 단계별 보안관리방안(금융감독원장이 정하는 방안)을 따르도록 하는 조항이 있는가\", \"label\": \"단계별 보안관리방안\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"단계별\", \"보안관리방안\", \"입찰\", \"계약\", \"수행\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제7호\", \"quote\": \"외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"외부주문의 입찰·계약·수행·완료 등 각 단계별 보안관리방안(금융감독원장이 정하는 방안)을 따르도록 하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-08\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"중요 전산자료의 백업자료 보존·백업설비 확보 등 백업대책 수립 조항이 있는가\", \"label\": \"백업대책 수립\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"internal_control\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"백업\", \"백업설비\", \"전산자료\", \"업무지속성\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제8호\", \"quote\": \"업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"중요 전산자료의 백업자료 보존·백업설비 확보 등 백업대책 수립 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-09\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"수탁자의 재무건전성 평가·모니터링에 필요한 자료 제공 협조가 약정되어 있는가\", \"label\": \"수탁자 재무건전성 평가\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"monitoring_evidence\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"재무건전성\", \"평가\", \"모니터링\", \"도산\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제10호\", \"quote\": \"전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"수탁자의 재무건전성 평가·모니터링에 필요한 자료 제공 협조가 약정되어 있는가?\", \"note\": \"전자금융거래를 위한 외주에서 수탁자의 재무건전성 평가·모니터링에 관한 협조 약정을 확인한다. 회사의 연 1회 평가·실제 모니터링 이행 여부를 계약검토에서 확인하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"ITSEC-10\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"수탁자가 제공하는 서비스의 품질수준 평가에 협조하는 약정이 있는가\", \"label\": \"서비스 품질수준 평가\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"monitoring_evidence\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"품질수준\", \"서비스 수준\", \"평가\", \"SLA\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제11호\", \"quote\": \"전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"수탁자가 제공하는 서비스의 품질수준 평가에 협조하는 약정이 있는가?\", \"note\": \"전자금융거래를 위한 외주에서 서비스 품질 평가 협조 약정을 확인한다. 실제 평가 완료나 연 1회 문구의 반복을 요구하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"ITSEC-11\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"재외부주문 계약 체결·재수탁업체 변경에 사전 동의를 받도록 약정되어 있는가\", \"label\": \"재외부주문 사전통제\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"cooperation_control\", \"contract_requirement\": \"express\", \"triggers\": {\"keywords\": [\"재위탁\", \"외부주문\", \"사전 동의\", \"계약업체 변경\", \"재하도급\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제12호\", \"quote\": \"전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"재외부주문 계약 체결·재수탁업체 변경에 사전 동의를 받도록 약정되어 있는가?\", \"note\": \"재외부주문 사전 동의 통제를 확인한다. 재수탁자 교체도 해당 통제에 포함되는지 읽고, 교체에 대해서만 자유로운 변경을 허용하는 반대 약정은 남긴다. 일반 보안조치만으로 재위탁 통제를 확인하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"text_effect\": \"required_present\", \"action_rationale\": \"재외부주문과 업체 변경을 사전에 통제하려면 상대방을 구속하는 계약 문구가 필요함\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"curated\", \"topics\": [\"subcontracting\"], \"actors\": [\"trustee\"], \"actions\": [\"subcontract\"], \"modalities\": [\"prior_consent\", \"prohibition\"], \"required_facets\": [\"topics\", \"actions\", \"modalities\"]}}, {\"id\": \"ITSEC-12\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"업무수행인력의 사전 신원조회(또는 신원보증) 및 인력변경 시 인수인계 등 외주인력 관리방안 조항이 있는가\", \"label\": \"외주인력 관리방안\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"cooperation_control\", \"contract_requirement\": \"derived\", \"triggers\": {\"keywords\": [\"신원조회\", \"신원보증\", \"인수인계\", \"외주인력\", \"투입인력\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제13호\", \"quote\": \"업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"업무수행인력의 사전 신원조회(또는 신원보증) 및 인력변경 시 인수인계 등 외주인력 관리방안 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"text_effect\": \"conditional\", \"action_rationale\": \"외주인력 관리의 세부 이행은 운영사항이나 상대방 협조는 계약으로 확보할 필요가 있음\", \"contract_action_curated\": true}, {\"id\": \"ITSEC-13\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"외부주문 업무의 보안점검·보안성검토 또는 관련 요구에 협조하는 약정이 있는가\", \"label\": \"보안성검토·정기점검\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"monitoring_evidence\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"보안성검토\", \"보안점검\", \"취약점\", \"점검\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제1항 제14호\", \"quote\": \"외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"외부주문 업무의 보안점검·보안성검토 또는 관련 요구에 협조하는 약정이 있는가?\", \"note\": \"전자금융 외주업무의 보안점검·보안성검토·현황 확인에 관한 권리 또는 협조 약정을 확인한다. 실제 점검 수행과 매년 점검 실적은 확인하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"ITSEC-14\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"재위탁 구조라면 재수탁업자의 금융거래정보 변경이 위탁회사·원수탁업자의 개별 지시에 따르도록 하는 조항이 있는가\", \"label\": \"재수탁자 정보변경 지시\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재위탁\", \"개별 지시\", \"금융거래정보\", \"재수탁\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제4항 제1호\", \"quote\": \"재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"재위탁 구조라면 재수탁업자의 금융거래정보 변경이 위탁회사·원수탁업자의 개별 지시에 따르도록 하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"ITSEC-15\", \"module\": \"X-EFIN\", \"tier\": \"conditional\", \"check\": \"재위탁 시 금융거래정보를 위탁회사 전산실 또는 적용 가능한 예외 요건을 갖춘 장소에 보관하도록 약정되어 있는가\", \"label\": \"금융정보 전산실내 보관\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 전자금융감독규정 제60조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"전산실\", \"금융거래정보\", \"보관\", \"재수탁\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"전자금융감독규정\", \"article\": \"제60조\", \"clause\": \"제4항 제2호\", \"quote\": \"위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함\", \"verified\": true, \"text\": \"제60조(외부주문등에 대한 기준) ① 금융회사 또는 전자금융업자는 전자금융거래를 위한 외부주문등의 경우에는 다음 각 호의 사항을 준수하여야 한다.<개정 2013. 12. 3.> 1. 외부주문등에 의한 정보처리시스템의 개발업무에 사용되는 업무장소 및 전산설비는 내부 업무용과 분리하여 설치ㆍ운영<개정 2015. 2. 3.> 2. 금융회사와 이용자 간 암호화정보 해독 및 원장 등 중요 데이터 변경 금지<개정 2013. 12. 3.> 3. 계좌번호, 비밀번호 등 이용자 금융정보 무단보관 및 유출 금지 4. 접근매체 위ㆍ변조, 해킹, 개인정보유출 등에 대비한 보안대책 수립 5. 금융회사와 전자금융보조업자 간의 접속은 전용회선(전용회선과 동등한 보안수준을 갖춘 가상의 전용회선을 포함한다)을 사용<개정 2013. 12. 3., 2016. 10. 5.> 6. 정보처리시스템 장애 등 서비스 중단에 대비한 비상대책 수립 7. 외부주문등의 입찰ㆍ계약ㆍ수행ㆍ완료 등 각 단계별로 금융감독원장이 정하는 보안관리방안을 따를 것<개정 2015. 2. 3.> 8. 업무지속성을 위한 중요 전산자료의 백업(backup)자료 보존 및 백업설비 확보 등 백업대책 수립 9. 정보관리의 취약점을 최소화하고 보안유지를 위한 내부통제방안을 수립ㆍ운용하고, 통제는 제8조제1항제2호의 조직에서 수행<개정 2015. 2. 3.> 10. 전자금융보조업자에 대한 재무건전성을 연1회 이상 평가하여 재무상태 악화에 따른 도산에 대비하고 전자금융보조업자의 주요 경영활동에 대해 상시 모니터링을 실시 11. 전자금융보조업자가 제공하는 서비스의 품질수준을 연1회 이상 평가할 것 12. 전자금융보조업자가 사전 동의 없이 다시 외부주문등 계약을 체결하거나 계약업체를 변경하지 못하도록 하고, 사전 동의시 해당 계약서에 제7호의 사항을 기재하도록 통제<개정 2016. 6. 30.> 13. 업무수행인력에 대하여 사전 신원조회 실시(이 경우 신원보증보험 증권 징구로 갈음할 수 있다) 또는 대표자의 신원보증서 징구, 인력변경시 인수인계에 관한 사항 등을 포함한 업무수행인력 관리방안 수립<개정 2018. 12. 21.> 14. 외부주문등은 자체 보안성검토 및 정기(금융감독원장이 정하는 중요 점검사항에 대해서는 매일) 보안점검 실시<개정 2015. 2. 3.> ② 금융회사 또는 전자금융업자는 제1항제10호 및 제11호의 평가결과를 금융감독원장에게 보고하여야 한다.<개정 2013. 12. 3.> ③ 금융감독원장은 제2항의 규정에 따른 평가결과 보고를 접수하고, 그 평가실시 여부를 제58조제2항의 규정에 따른 정보기술부문 실태평가에 반영할 수 있다. ④ 법 제40조제6항 단서에서 \\\"금융위원회가 인정하는 경우\\\"란 전자금융거래정보의 보호와 관련된 전산장비ㆍ소프트웨어에 대한 개발ㆍ운영 및 유지관리 업무를 재위탁하는 경우로서 다음 각 호의 사항을 준수하는 경우를 말한다. 1. 재수탁업자가 재위탁된 업무를 처리함에 있어 금융거래 정보의 변경이 필요한 경우에는 위탁회사 또는 원수탁업자의 개별적 지시에 따라야 하며, 위탁회사 또는 원수탁업자는 변경된 정보가 지시 내용에 부합하는지 여부를 확인하여야 함 2. 위탁업무와 관련된 이용자의 금융거래정보는 위탁회사의 전산실 내에 두어야 함. 다만, 재수탁업자가 이용자의 이용자 정보를 어떠한 경우에도 알지 못하도록 위탁회사 또는 원수탁업자가 금융거래정보를 처리하여 제공한 경우에는 위탁회사의 관리ㆍ통제 하에 재수탁회사 등 제3의 장소로 이전 가능함 ⑤ 금융회사 또는 전자금융업자는 제14조의2제1항제2호에 따른 평가를 위하여 제37조의6제1항 각 호의 어느 하나에 해당하는 기관에 지원을 요청할 수 있다. [본항신설 2015. 2. 3.] [시행일 : 2015. 4. 16.] 제60조제1항제1호ㆍ7호ㆍ14호 및 제4항\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"electronic_finance_outsourcing\", \"decision_question\": \"재위탁 시 금융거래정보를 위탁회사 전산실 또는 적용 가능한 예외 요건을 갖춘 장소에 보관하도록 약정되어 있는가?\", \"note\": \"재위탁되는 금융거래정보의 위탁회사 전산실 보관 또는 실제 적용 가능한 허용 예외의 조건을 확인한다. 단순 개인정보의 전송수단·암호화 문구로 저장장소를 대신하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"SOL-02\", \"module\": \"X-INSMOD\", \"check\": \"보험업법 등에 따른 위탁계약 해지 절차를 마련하고 그 해지 절차와 사유를 위탁계약서에 반영·설명하도록 되어 있는가\", \"label\": \"위탁계약 해지절차 마련\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"등록\", \"말소\", \"취소\", \"자격\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"보험권 표준내부통제기준\", \"article\": \"제37조\", \"clause\": \"제8항\", \"quote\": \"회사는 보험업법 등에 따른 위탁계약 해지 절차를 마련해야 하며, 그 해지 절차와 사유를 위탁계약서에 반영하고 모집종사자에게 설명하여야 한다\", \"verified\": true, \"source_type\": \"self_regulation\", \"text\": \"제37조(모집업무 위탁관리 관련 내부통제체계) ① 회사는 모집업무(보험계약의 체결을 중개하거나 대리하는 것을 말한다. 이하 같다)와 관련하여 법령을 준수하고, 경영을 건전하게 하며, 거래질서를 해치는 일이 없도록 관리하기 위하여 회사의 임직원과 모집종사자가 직무를 수행할 때 준수해야 할 기준 및 절차를 별도로 정할 수 있다.\\n② 회사는 모집업무 위탁관리업무를 효율적으로 수행할 수 있도록 내부통제 체계를 구축·운영하여야 한다.\\n③ 회사는 모집종사자와의 위탁계약 체결 전에 모집종사자의 보험업법 상 등록요건 및 재무상태 등을 심사‧평가하여 위탁계약 체결 여부 등에 반영하는 절차를 마련하여야 한다.\\n④ 회사는 모집종사자와 위탁계약 체결 전에 모집종사자에게 적용되는 법령 및 규정을 모집종사자에게 설명하여야 한다.\\n⑤ 회사는 모집종사자에 의한 금융사고(수수료등 환수 불이행 등)에 대비하여 영업보증금 제출 또는 그에 준하는 이행을 담보하기 위한 조치를 취하여야 한다.\\n⑥ 회사는 모집종사자의 모집업무 위탁계약에 명시된 업무 수행에 대한 수수료 지급기준과 환수기준을 마련하고 이를 위탁계약의 내용에 포함하여야 한다.\\n⑦ 회사는 모집종사자의 위탁업무 수행에 관한 평가기준을 수립·운영하고 평가결과가 미흡한 모집종사자에게는 필요한 조치를 취하여야 한다.\\n⑧ 회사는 보험업법 등에 따른 위탁계약 해지 절차를 마련해야 하며, 그 해지 절차와 사유를 위탁계약서에 반영하고 모집종사자에게 설명하여야 한다.\\n⑨ 회사는 모집종사자와 위탁계약을 해지하는 경우 해당 모집종사자가 모집한 계약의 담당을 다른 모집종사자에게 즉시 이관하여 관리하여야 한다.\\n⑩ 회사는 임직원 및 모집종사자 모집과 관련한 법령 및 내부통제기준 등의 내규를 위반할 경우 이를 제재하기 위한 기준 및 절차를 마련해야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"자율규제(보험권 표준내부통제기준 제37조)는 위탁계약 해지 절차·사유의 계약서 반영을 요구\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"insurance_sales_outsourcing\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"해지절차 마련은 회사 내부통제 사항이고 상대방 설명·절차 준수를 위한 계약 협조가 필요함\", \"contract_action_curated\": true}, {\"id\": \"SOL-04\", \"module\": \"X-INSMOD\", \"check\": \"수탁자의 대리·중개 행위로 금융소비자에게 발생한 손해에 대해 회사가 배상책임을 지는 구조를 전제로 한 책임 조항과, 회사가 배상한 경우 수탁자에 대한 구상 조항이 있는가\", \"label\": \"대리·중개 배상책임 구조\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융소비자 보호에 관한 법률 제45조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"배상책임\", \"대리\", \"중개\", \"모집\", \"구상\", \"구상권\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"금융소비자 보호에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제1항 본문\", \"quote\": \"대리ㆍ중개 업무를 할 때 금융소비자에게 손해를 발생시킨 경우에는 그 손해를 배상할 책임이 있다\", \"verified\": true, \"text\": \"제45조(금융상품직접판매업자의 손해배상책임) 제45조(금융상품직접판매업자의 손해배상책임) ① 금융상품직접판매업자는 금융상품계약체결등의 업무를 대리ㆍ중개한 금융상품판매대리ㆍ중개업자(제25조제1항제2호 단서에서 정하는 바에 따라 대리ㆍ중개하는 제3자를 포함하고, 「보험업법」 제2조제11호에 따른 보험중개사는 제외한다) 또는 「보험업법」 제83조제1항제4호에 해당하는 임원 또는 직원(이하 이 조에서 \\\"금융상품판매대리ㆍ중개업자등\\\"이라 한다)이 대리ㆍ중개 업무를 할 때 금융소비자에게 손해를 발생시킨 경우에는 그 손해를 배상할 책임이 있다. 다만, 금융상품직접판매업자가 금융상품판매대리ㆍ중개업자등의 선임과 그 업무 감독에 대하여 적절한 주의를 하였고 손해를 방지하기 위하여 노력한 경우에는 그러하지 아니하다. ② 제1항 본문에 따른 금융상품직접판매업자의 손해배상책임은 금융상품판매대리ㆍ중개업자등에 대한 금융상품직접판매업자의 구상권 행사를 방해하지 아니한다.\", \"status\": \"quote_ok\"}, {\"law\": \"금융소비자 보호에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제2항\", \"quote\": \"제1항 본문에 따른 금융상품직접판매업자의 손해배상책임은 금융상품판매대리ㆍ중개업자등에 대한 금융상품직접판매업자의 구상권 행사를 방해하지 아니한다\", \"verified\": true, \"text\": \"제45조(금융상품직접판매업자의 손해배상책임) 제45조(금융상품직접판매업자의 손해배상책임) ① 금융상품직접판매업자는 금융상품계약체결등의 업무를 대리ㆍ중개한 금융상품판매대리ㆍ중개업자(제25조제1항제2호 단서에서 정하는 바에 따라 대리ㆍ중개하는 제3자를 포함하고, 「보험업법」 제2조제11호에 따른 보험중개사는 제외한다) 또는 「보험업법」 제83조제1항제4호에 해당하는 임원 또는 직원(이하 이 조에서 \\\"금융상품판매대리ㆍ중개업자등\\\"이라 한다)이 대리ㆍ중개 업무를 할 때 금융소비자에게 손해를 발생시킨 경우에는 그 손해를 배상할 책임이 있다. 다만, 금융상품직접판매업자가 금융상품판매대리ㆍ중개업자등의 선임과 그 업무 감독에 대하여 적절한 주의를 하였고 손해를 방지하기 위하여 노력한 경우에는 그러하지 아니하다. ② 제1항 본문에 따른 금융상품직접판매업자의 손해배상책임은 금융상품판매대리ㆍ중개업자등에 대한 금융상품직접판매업자의 구상권 행사를 방해하지 아니한다.\", \"status\": \"quote_ok\"}], \"note\": \"구 보험업법 제102조는 2020. 3. 24. 삭제 — 금소법 제45조로 이관(보험중개사는 적용 제외). SOL-06(소비자 배상 구상권, §45②) 통합(2026-07-29 지식 다이어트) — 배상책임 구조 판정 시 구상 문구를 같이 보는 것이 실무, RISK-02(횡단 구상)도 존치라 이중 안전망\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"insurance_sales_outsourcing\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"회사의 대외책임과 수탁자 구상은 구분되며 구상문구는 위험배분상 권고사항임\", \"contract_action_curated\": true}, {\"id\": \"SOL-05\", \"module\": \"X-INSMOD\", \"check\": \"관련 모집 업무에 대한 교육·점검·관리 약정이 있는가\", \"label\": \"교육·점검 약정 확인\", \"severity\": \"권장\", \"severity_basis\": \"면책요건임(선임·감독 주의 시 책임 배제) — 금융소비자 보호에 관한 법률 제45조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"교육\", \"점검\", \"감독\", \"선임\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"금융소비자 보호에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제1항 단서\", \"quote\": \"다만, 금융상품직접판매업자가 금융상품판매대리ㆍ중개업자등의 선임과 그 업무 감독에 대하여 적절한 주의를 하였고 손해를 방지하기 위하여 노력한 경우에는 그러하지 아니하다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제45조(금융상품직접판매업자의 손해배상책임) 제45조(금융상품직접판매업자의 손해배상책임) ① 금융상품직접판매업자는 금융상품계약체결등의 업무를 대리ㆍ중개한 금융상품판매대리ㆍ중개업자(제25조제1항제2호 단서에서 정하는 바에 따라 대리ㆍ중개하는 제3자를 포함하고, 「보험업법」 제2조제11호에 따른 보험중개사는 제외한다) 또는 「보험업법」 제83조제1항제4호에 해당하는 임원 또는 직원(이하 이 조에서 \\\"금융상품판매대리ㆍ중개업자등\\\"이라 한다)이 대리ㆍ중개 업무를 할 때 금융소비자에게 손해를 발생시킨 경우에는 그 손해를 배상할 책임이 있다. 다만, 금융상품직접판매업자가 금융상품판매대리ㆍ중개업자등의 선임과 그 업무 감독에 대하여 적절한 주의를 하였고 손해를 방지하기 위하여 노력한 경우에는 그러하지 아니하다. ② 제1항 본문에 따른 금융상품직접판매업자의 손해배상책임은 금융상품판매대리ㆍ중개업자등에 대한 금융상품직접판매업자의 구상권 행사를 방해하지 아니한다.\", \"status\": \"quote_ok\"}, {\"law\": \"보험권 표준내부통제기준\", \"article\": \"제38조\", \"clause\": \"제1항\", \"quote\": \"회사는 모집종사자의 위탁업무 수행에 관한 평가기준을 수립·운영하도록 해야 한다\", \"verified\": true, \"source_type\": \"self_regulation\", \"text\": \"제38조(모집종사자 위탁업무 평가) ① 회사는 모집종사자의 위탁업무 수행에 관한 평가기준을 수립·운영하도록 해야 한다.\\n② 회사는 모집종사자의 위탁업무 수행에 관한 법령 준수 여부, 거래질서 건전성, 소비자보호 및 회사의 경영목표 등을 고려하여 평가기준을 수립해야 한다.\\n③ 제2항의 모집종사자 위탁업무 평가와 관련하여 금융감독원 등 공신력이 있는 외부기관의 평가항목·지표 및 제도가 있는 경우에는 해당 평가기준, 지표 및 등급 등을 활용하여 평가기준을 수립할 수 있다.\\n④ 회사는 모집종사자 위탁업무 평가결과를 검토하여 문제점이 있거나 필요하다고 판단되는 경우 적절한 조치사항이 실행되도록 해야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"insurance_sales_outsourcing\", \"decision_question\": \"관련 모집 업무에 대한 교육·점검·관리 약정이 있는가?\", \"note\": \"모집 업무 관련 교육·점검·관리 중 확인되는 약정을 인정한다. 기록보존의 정확한 문구나 실제 선임·감독 이행 및 법적 면책 성립을 판정하지 않는다. 개인정보 교육만으로 모집 업무 감독 전체를 확인하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"교육·점검은 내부 운영으로도 입증 가능하고 필요한 협조 범위만 계약화할 사항임\", \"contract_action_curated\": true}, {\"id\": \"ITDL-02\", \"module\": \"X-IP\", \"check\": \"소스코드·산출물 인도 또는 소스코드 에스크로·임치 약정이 있는가\", \"label\": \"소스코드 인도·에스크로\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"소스코드\", \"에스크로\", \"임치\", \"형상관리\", \"산출물 인도\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"deliverable_or_software\", \"decision_question\": \"소스코드·산출물 인도 또는 소스코드 에스크로·임치 약정이 있는가?\", \"note\": \"관련 산출물·소스코드의 인도 또는 에스크로·임치 약정을 대체 가능한 방식으로 확인한다. 모든 거래에 소스코드 직접 인도와 에스크로를 동시에 요구하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"소스코드 인도·에스크로는 유지보수와 공급자 위험에 따라 선택하는 거래조건임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제57조제1항\", \"quote\": \"계약상대자는 제56조제3항에 따른 계약목적물의 사용을 보장하고, 지식재산권을 보호하기 위해서 계약상대자의 사업수행에 따른 계약목적물의 \\\"기술자료\\\"를 제3의 기관(이하 \\\"임치기관\\\"이라 한다)에 임치하여야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"ITDL-07\", \"module\": \"X-IP\", \"check\": \"산출물에 사용된 제3자 소프트웨어·오픈소스의 라이선스 목록 고지와 라이선스 준수·책임 조항이 있는가\", \"label\": \"오픈소스 라이선스 준수\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"오픈소스\", \"라이선스\", \"제3자 소프트웨어\", \"GPL\", \"상용 소프트웨어\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"deliverable_or_software\", \"decision_question\": \"산출물에 사용된 제3자 소프트웨어·오픈소스의 라이선스 목록 고지와 라이선스 준수·책임 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"오픈소스 고지·책임은 실제 사용 가능성과 라이선스 위험에 따라 구체화할 사항임\", \"contract_action_curated\": true}, {\"id\": \"CNS-PRIVSCOPE\", \"evidence_required_groups\": [[\"개인정보\", \"개인신용정보\", \"정보주체\"], [\"위탁\", \"수탁\", \"처리업무\"]], \"module\": \"X-PII\", \"check\": \"개인정보 위탁업무의 목적·범위와 그 범위를 벗어난 처리·이용·제공 금지가 위탁 문서에 명확히 반영되어 있는가\", \"label\": \"개인정보 위탁 범위·목적 제한\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 제26조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"개인정보\", \"처리위탁\", \"개인정보 처리\", \"특약\", \"위탁 문서\", \"법정 기재\", \"목적 외\", \"목적외\", \"처리 금지\", \"위탁업무의 목적\", \"위탁업무의 범위\", \"처리 목적\", \"범위를 초과\", \"제3자 제공\", \"제3자에게 제공\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제1항\", \"quote\": \"개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제1항 제1호\", \"quote\": \"위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제1항 제1호\", \"quote\": \"위탁업무의 목적 및 범위\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제5항\", \"quote\": \"수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}], \"note\": \"본문 또는 적용되는 위탁 특약에서 실제 위탁업무를 특정하고 목적 외 처리 및 범위 초과 이용·제3자 제공을 제한하는지 함께 확인한다. 제3자 제공 동의와 위탁은 구별하며, 보안조치·감독·재위탁은 별도 의무로 유지한다.\", \"decision_question\": \"개인정보 위탁업무의 목적·범위와 그 범위를 벗어난 처리·이용·제공 금지가 위탁 문서에 명확히 반영되어 있는가?\", \"pass_guidance\": \"위 설명의 검토 관점에 비추어 본건에서 수정이 불필요하면 선택\", \"opinion_guidance\": \"본건에서 수정·추가 확인이 필요한 내용을 의견으로 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v2\", \"legacy_check_ids\": [\"PRIV-01\", \"PRIV-02\", \"PRIV-04\", \"PRIV-14\"], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"본문 또는 적용되는 위탁 특약에서 실제 위탁업무를 특정하고 목적 외 처리 및 범위 초과 이용·제3자 제공을 제한하는지 함께 확인한다. 제3자 제공 동의와 위탁은 구별하며, 보안조치·감독·재위탁은 별도 의무로 유지한다.\", \"contract_action_curated\": true}, {\"id\": \"PRIV-03\", \"module\": \"X-PII\", \"check\": \"위탁 문서에 개인정보의 기술적·관리적 보호조치에 관한 사항이 포함되어 있는가\", \"label\": \"기술적·관리적 보호조치\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 제26조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"기술적\", \"관리적\", \"보호조치\", \"안전성 확보\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제1항 제2호\", \"quote\": \"개인정보의 기술적ㆍ관리적 보호조치에 관한 사항\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"위탁 문서에 개인정보의 기술적·관리적 보호조치에 관한 사항이 포함되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"기술적·관리적 보호조치는 표준 보안관리약정에서 일괄 확인할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"CNS-PRIVSUB\", \"evidence_required_groups\": [[\"재위탁\", \"재수탁\", \"다시 위탁\"]], \"module\": \"X-PII\", \"check\": \"개인정보 재위탁을 제한하거나 위탁자의 사전 동의를 받도록 약정되어 있는가\", \"label\": \"개인정보 재위탁 통제\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 시행령 제28조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재위탁\", \"재위탁 제한\", \"다시 위탁\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제1항 제2호\", \"quote\": \"재위탁 제한에 관한 사항\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제6항\", \"quote\": \"수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}], \"decision_question\": \"개인정보 재위탁을 제한하거나 위탁자의 사전 동의를 받도록 약정되어 있는가?\", \"note\": \"개인정보 재위탁의 금지 또는 위탁자의 사전 동의 조건을 확인한다. 개인신용정보의 별도 재위탁 제한(PRIV-21)을 단순 동의 문구로 대체하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"PRIV-05\", \"PRIV-15\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"재위탁 허용 범위와 동의를 얻어야 하는 주체·시점을 함께 확인한다. 개인정보 재위탁 동의와 개인신용정보 재위탁의 별도 제한을 서로 대체하지 않는다.\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"candidate\", \"topics\": [\"subcontracting\", \"personal_information\"], \"actions\": [\"subcontract\"], \"modalities\": [\"prior_consent\"], \"required_facets\": [\"topics\", \"actions\"]}}, {\"id\": \"PRIV-06\", \"module\": \"X-PII\", \"check\": \"위탁 문서에 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항이 포함되어 있는가\", \"label\": \"접근 제한 안전성 조치\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 시행령 제28조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"접근 제한\", \"접근권한\", \"접근통제\", \"안전성 확보\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제1항 제3호\", \"quote\": \"개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"위탁 문서에 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항이 포함되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"접근 제한 등 안전성 조치는 표준 보안관리약정에서 확인할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-07\", \"module\": \"X-PII\", \"check\": \"위탁 문서에 개인정보 관리 현황 점검 등 감독에 관한 사항이 포함되어 있는가\", \"label\": \"개인정보 관리 감독\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 시행령 제28조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"현황 점검\", \"감독\", \"점검\", \"관리 현황\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제1항 제4호\", \"quote\": \"위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"위탁 문서에 개인정보 관리 현황 점검 등 감독에 관한 사항이 포함되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"처리현황 점검·감독 수인 내용은 표준 보안관리약정으로 충족 가능함\", \"contract_action_curated\": true}, {\"id\": \"CNS-PRIVNOTICE\", \"module\": \"X-PII\", \"check\": \"위탁업무 내용과 수탁자의 공개 방식·책임이 약정되어 있는가\", \"label\": \"개인정보 위탁 사실 공개\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 제26조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"공개\", \"홈페이지\", \"게재\", \"지속적으로 게재\", \"인터넷\", \"게시\", \"간행물\", \"신문\", \"사업장\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제2항\", \"quote\": \"정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제2항\", \"quote\": \"위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제3항\", \"quote\": \"인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}], \"decision_question\": \"위탁업무 내용과 수탁자의 공개 방식·책임이 약정되어 있는가?\", \"note\": \"위탁업무·수탁자를 공개하는 대상과 방식·책임 약정을 확인한다. 실제 홈페이지 게재를 확인하지 않으며 홈페이지 외 계약에 정한 공개수단도 읽는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"PRIV-09\", \"PRIV-10\"], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\"}, {\"id\": \"PRIV-12\", \"module\": \"X-PII\", \"check\": \"홍보·판매 권유 업무 위탁 시 업무 내용과 수탁자를 정보주체에게 알리도록 약정되어 있는가\", \"label\": \"홍보·판매 위탁 통지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 제26조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"홍보\", \"판매 권유\", \"마케팅\", \"텔레마케팅\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제3항\", \"quote\": \"위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제4항\", \"quote\": \"법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"홍보·판매 권유 업무 위탁 시 업무 내용과 수탁자를 정보주체에게 알리도록 약정되어 있는가?\", \"note\": \"홍보·판매 권유 업무 위탁에 적용하며 업무 내용·수탁자를 정보주체에게 알리도록 한 계약상 절차를 확인한다. 실제 발송 이력은 확인하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"PRIV-13\", \"module\": \"X-PII\", \"check\": \"위탁자의 수탁자 교육 실시와 처리 현황 점검 등 감독 수인 의무 조항이 있는가\", \"label\": \"수탁자 교육·점검 감독\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 개인정보 보호법 제26조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"교육\", \"감독\", \"점검\", \"실태점검\"]}, \"auto_clear\": {\"any_groups\": [[\"교육\"], [\"감독\", \"점검\", \"실태점검\"], [\"수탁자\", \"개인정보\"]]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제4항\", \"quote\": \"수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}, {\"law\": \"개인정보 보호법 시행령\", \"article\": \"제28조\", \"clause\": \"제6항\", \"quote\": \"위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다\", \"verified\": true, \"text\": \"제28조(개인정보의 처리 업무 위탁 시 조치) 제28조(개인정보의 처리 업무 위탁 시 조치) ① 법 제26조제1항제3호에서 \\\"대통령령으로 정한 사항\\\"이란 다음 각 호의 사항을 말한다. 1. 위탁업무의 목적 및 범위 2. 재위탁 제한에 관한 사항 3. 개인정보에 대한 접근 제한 등 안전성 확보 조치에 관한 사항 4. 위탁업무와 관련하여 보유하고 있는 개인정보의 관리 현황 점검 등 감독에 관한 사항 5. 법 제26조제2항에 따른 수탁자(이하 \\\"수탁자\\\"라 한다)가 준수하여야 할 의무를 위반한 경우의 손해배상 등 책임에 관한 사항 ② 법 제26조제2항에서 \\\"대통령령으로 정하는 방법\\\"이란 개인정보 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)가 위탁자의 인터넷 홈페이지에 위탁하는 업무의 내용과 수탁자를 지속적으로 게재하는 방법을 말한다. ③ 제2항에 따라 인터넷 홈페이지에 게재할 수 없는 경우에는 다음 각 호의 어느 하나 이상의 방법으로 위탁하는 업무의 내용과 수탁자를 공개하여야 한다. <개정 2023.9.12> 1. 위탁자의 사업장등의 보기 쉬운 장소에 게시하는 방법 2. 관보(위탁자가 공공기관인 경우만 해당한다)나 위탁자의 사업장등이 있는 시ㆍ도 이상의 지역을 주된 보급지역으로 하는 「신문 등의 진흥에 관한 법률」 제2조제1호가목ㆍ다목 및 같은 조 제2호에 따른 일반일간신문, 일반주간신문 또는 인터넷신문에 싣는 방법 3. 같은 제목으로 연 2회 이상 발행하여 정보주체에게 배포하는 간행물ㆍ소식지ㆍ홍보지 또는 청구서 등에 지속적으로 싣는 방법 4. 재화나 서비스를 제공하기 위하여 위탁자와 정보주체가 작성한 계약서 등에 실어 정보주체에게 발급하는 방법 ④ 법 제26조제3항 전단에서 \\\"대통령령으로 정하는 방법\\\"이란 서면등의 방법을 말한다. <개정 2023.9.12> ⑤ 위탁자가 과실 없이 제4항에 따른 방법으로 위탁하는 업무의 내용과 수탁자를 정보주체에게 알릴 수 없는 경우에는 해당 사항을 인터넷 홈페이지에 30일 이상 게재하여야 한다. 다만, 인터넷 홈페이지를 운영하지 아니하는 위탁자의 경우에는 사업장등의 보기 쉬운 장소에 30일 이상 게시하여야 한다. ⑥ 위탁자는 수탁자가 개인정보 처리 업무를 수행하는 경우에 법 또는 이 영에 따라 개인정보처리자가 준수하여야 할 사항과 법 제26조제1항 각 호의 사항을 준수하는지를 같은 조 제4항에 따라 감독하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"위탁자의 수탁자 교육 실시와 처리 현황 점검 등 감독 수인 의무 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"교육·감독에 대한 수탁자 협조는 표준 보안관리약정에서 확인할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-16\", \"module\": \"X-PII\", \"check\": \"수탁자가 위탁받은 업무 관련 개인정보 처리 과정에서 법 위반으로 발생시킨 손해배상책임에 대하여 수탁자를 개인정보처리자의 소속 직원으로 간주하는 규정이 반영되어 있는가\", \"label\": \"수탁자 소속직원 간주\", \"severity\": \"참고\", \"severity_basis\": \"간주규정임 — 개인정보 보호법 제26조\", \"norm_type\": \"간주\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"구상\", \"손해배상\", \"소속 직원\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제26조\", \"clause\": \"제7항\", \"quote\": \"수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다\", \"verified\": true, \"text\": \"제26조(업무위탁에 따른 개인정보의 처리 제한) 제26조(업무위탁에 따른 개인정보의 처리 제한) ① 개인정보처리자가 제3자에게 개인정보의 처리 업무를 위탁하는 경우에는 다음 각 호의 내용이 포함된 문서로 하여야 한다. <개정 2023.3.14> 1. 위탁업무 수행 목적 외 개인정보의 처리 금지에 관한 사항 2. 개인정보의 기술적ㆍ관리적 보호조치에 관한 사항 3. 그 밖에 개인정보의 안전한 관리를 위하여 대통령령으로 정한 사항 ② 제1항에 따라 개인정보의 처리 업무를 위탁하는 개인정보처리자(이하 \\\"위탁자\\\"라 한다)는 위탁하는 업무의 내용과 개인정보 처리 업무를 위탁받아 처리하는 자(개인정보 처리 업무를 위탁받아 처리하는 자로부터 위탁받은 업무를 다시 위탁받은 제3자를 포함하며, 이하 \\\"수탁자\\\"라 한다)를 정보주체가 언제든지 쉽게 확인할 수 있도록 대통령령으로 정하는 방법에 따라 공개하여야 한다. <개정 2023.3.14> ③ 위탁자가 재화 또는 서비스를 홍보하거나 판매를 권유하는 업무를 위탁하는 경우에는 대통령령으로 정하는 방법에 따라 위탁하는 업무의 내용과 수탁자를 정보주체에게 알려야 한다. 위탁하는 업무의 내용이나 수탁자가 변경된 경우에도 또한 같다. ④ 위탁자는 업무 위탁으로 인하여 정보주체의 개인정보가 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손되지 아니하도록 수탁자를 교육하고, 처리 현황 점검 등 대통령령으로 정하는 바에 따라 수탁자가 개인정보를 안전하게 처리하는지를 감독하여야 한다. <개정 2015.7.24> ⑤ 수탁자는 개인정보처리자로부터 위탁받은 해당 업무 범위를 초과하여 개인정보를 이용하거나 제3자에게 제공하여서는 아니 된다. ⑥ 수탁자는 위탁받은 개인정보의 처리 업무를 제3자에게 다시 위탁하려는 경우에는 위탁자의 동의를 받아야 한다. <신설 2023.3.14> ⑦ 수탁자가 위탁받은 업무와 관련하여 개인정보를 처리하는 과정에서 이 법을 위반하여 발생한 손해배상책임에 대하여는 수탁자를 개인정보처리자의 소속 직원으로 본다. <개정 2023.3.14> ⑧ 수탁자에 관하여는 제15조부터 제18조까지, 제21조, 제22조, 제22조의2, 제23조, 제24조, 제24조의2, 제25조, 제25조의2, 제27조, 제28조, 제28조의2부터 제28조의5까지, 제28조의7부터 제28조의11까지, 제29조, 제30조, 제30조의2, 제31조, 제33조, 제34조, 제34조의2, 제35조, 제35조의2, 제36조, 제37조, 제37조의2, 제38조, 제59조, 제63조, 제63조의2 및 제64조의2를 준용한다. 이 경우 \\\"개인정보처리자\\\"는 \\\"수탁자\\\"로 본다. <개정 2023.3.14>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"statutory_duty\", \"action_rationale\": \"수탁자 소속직원 간주는 법률에서 직접 발생하므로 계약서에 반복 기재할 필요가 없음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-17\", \"module\": \"X-PII\", \"check\": \"개인신용정보 처리위탁에 개인정보 보호법 제26조 제1항부터 제3항까지의 문서화·공개·통지 요건이 반영되어 있는가\", \"label\": \"개인신용정보 위탁 요건\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 신용정보의 이용 및 보호에 관한 법률 제17조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"surface_policy\": \"aggregate_only\", \"triggers\": {\"keywords\": [\"개인신용정보\", \"신용정보\", \"처리위탁\"]}, \"absence_check\": true, \"absence_precondition\": [\"신용정보\", \"개인신용정보\"], \"sources\": [{\"law\": \"신용정보의 이용 및 보호에 관한 법률\", \"article\": \"제17조\", \"clause\": \"제1항\", \"quote\": \"개인신용정보의 처리 위탁에 대해서는 「개인정보 보호법」 제26조제1항부터 제3항까지의 규정을 준용한다\", \"verified\": true, \"text\": \"제17조(처리의 위탁) 제17조(처리의 위탁) ① 신용정보회사등은 제3자에게 신용정보의 처리 업무를 위탁할 수 있다. 이 경우 개인신용정보의 처리 위탁에 대해서는 「개인정보 보호법」 제26조제1항부터 제3항까지의 규정을 준용한다. <개정 2020.2.4> ② 신용정보회사등은 신용정보의 처리를 위탁할 수 있으며 이에 따라 위탁을 받은 자(이하 \\\"수탁자\\\"라 한다)의 위탁받은 업무의 처리에 관하여는 제19조부터 제21조까지, 제22조의4부터 제22조의7까지, 제22조의9, 제40조, 제43조, 제43조의2, 제45조, 제45조의2 및 제45조의3(해당 조문에 대한 벌칙 및 과태료규정을 포함한다)을 준용한다. <개정 2015.3.11, 2020.2.4> ③ 제2항에 따라 신용정보의 처리를 위탁하려는 신용정보회사등으로서 대통령령으로 정하는 자는 제공하는 신용정보의 범위 등을 대통령령으로 정하는 바에 따라 금융위원회에 알려야 한다. ④ 신용정보회사등은 제2항에 따라 신용정보의 처리를 위탁하기 위하여 수탁자에게 개인신용정보를 제공하는 경우 특정 신용정보주체를 식별할 수 있는 정보는 대통령령으로 정하는 바에 따라 암호화 등의 보호 조치를 하여야 한다. <신설 2015.3.11> ⑤ 신용정보회사등은 수탁자에게 신용정보를 제공한 경우 신용정보를 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손당하지 아니하도록 대통령령으로 정하는 바에 따라 수탁자를 교육하여야 하고 수탁자의 안전한 신용정보 처리에 관한 사항을 위탁계약에 반영하여야 한다. <신설 2015.3.11, 2020.2.4> ⑥ 수탁자가 개인신용정보를 이용하거나 제3자에게 제공하는 경우에는 「개인정보 보호법」 제26조제5항에 따른다. <개정 2020.2.4> ⑦ 수탁자는 제2항에 따라 위탁받은 업무를 제3자에게 재위탁하여서는 아니 된다. 다만, 신용정보의 보호 및 안전한 처리를 저해하지 아니하는 범위에서 금융위원회가 인정하는 경우에는 그러하지 아니하다. <신설 2015.3.11>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"개인신용정보 처리위탁 문서화는 PRIV-01~15의 세부 항목과 표준 보안관리약정 적용으로 통합 판단하며 독립 계약수정 항목으로 노출하지 않음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-19\", \"module\": \"X-PII\", \"check\": \"수탁자에게 개인신용정보 제공 시 식별정보의 암호화 등 보호조치 조항이 있는가\", \"label\": \"식별정보 암호화 조치\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 신용정보의 이용 및 보호에 관한 법률 제17조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"암호화\", \"식별\", \"보호조치\", \"비식별\"]}, \"absence_check\": true, \"absence_precondition\": [\"신용정보\", \"개인신용정보\"], \"sources\": [{\"law\": \"신용정보의 이용 및 보호에 관한 법률\", \"article\": \"제17조\", \"clause\": \"제4항\", \"quote\": \"특정 신용정보주체를 식별할 수 있는 정보는 대통령령으로 정하는 바에 따라 암호화 등의 보호 조치를 하여야 한다\", \"verified\": true, \"text\": \"제17조(처리의 위탁) 제17조(처리의 위탁) ① 신용정보회사등은 제3자에게 신용정보의 처리 업무를 위탁할 수 있다. 이 경우 개인신용정보의 처리 위탁에 대해서는 「개인정보 보호법」 제26조제1항부터 제3항까지의 규정을 준용한다. <개정 2020.2.4> ② 신용정보회사등은 신용정보의 처리를 위탁할 수 있으며 이에 따라 위탁을 받은 자(이하 \\\"수탁자\\\"라 한다)의 위탁받은 업무의 처리에 관하여는 제19조부터 제21조까지, 제22조의4부터 제22조의7까지, 제22조의9, 제40조, 제43조, 제43조의2, 제45조, 제45조의2 및 제45조의3(해당 조문에 대한 벌칙 및 과태료규정을 포함한다)을 준용한다. <개정 2015.3.11, 2020.2.4> ③ 제2항에 따라 신용정보의 처리를 위탁하려는 신용정보회사등으로서 대통령령으로 정하는 자는 제공하는 신용정보의 범위 등을 대통령령으로 정하는 바에 따라 금융위원회에 알려야 한다. ④ 신용정보회사등은 제2항에 따라 신용정보의 처리를 위탁하기 위하여 수탁자에게 개인신용정보를 제공하는 경우 특정 신용정보주체를 식별할 수 있는 정보는 대통령령으로 정하는 바에 따라 암호화 등의 보호 조치를 하여야 한다. <신설 2015.3.11> ⑤ 신용정보회사등은 수탁자에게 신용정보를 제공한 경우 신용정보를 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손당하지 아니하도록 대통령령으로 정하는 바에 따라 수탁자를 교육하여야 하고 수탁자의 안전한 신용정보 처리에 관한 사항을 위탁계약에 반영하여야 한다. <신설 2015.3.11, 2020.2.4> ⑥ 수탁자가 개인신용정보를 이용하거나 제3자에게 제공하는 경우에는 「개인정보 보호법」 제26조제5항에 따른다. <개정 2020.2.4> ⑦ 수탁자는 제2항에 따라 위탁받은 업무를 제3자에게 재위탁하여서는 아니 된다. 다만, 신용정보의 보호 및 안전한 처리를 저해하지 아니하는 범위에서 금융위원회가 인정하는 경우에는 그러하지 아니하다. <신설 2015.3.11>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"수탁자에게 개인신용정보 제공 시 식별정보의 암호화 등 보호조치 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"암호화 등 보호조치는 표준 보안관리약정에서 확인할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-20\", \"module\": \"X-PII\", \"check\": \"수탁자 교육 의무와 수탁자의 안전한 신용정보 처리에 관한 사항이 위탁계약에 반영되어 있는가\", \"label\": \"신용정보 교육·안전처리\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 신용정보의 이용 및 보호에 관한 법률 제17조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"교육\", \"신용정보\", \"위탁계약\", \"안전한 처리\"]}, \"absence_check\": true, \"absence_precondition\": [\"신용정보\", \"개인신용정보\"], \"sources\": [{\"law\": \"신용정보의 이용 및 보호에 관한 법률\", \"article\": \"제17조\", \"clause\": \"제5항\", \"quote\": \"수탁자를 교육하여야 하고 수탁자의 안전한 신용정보 처리에 관한 사항을 위탁계약에 반영하여야 한다\", \"verified\": true, \"text\": \"제17조(처리의 위탁) 제17조(처리의 위탁) ① 신용정보회사등은 제3자에게 신용정보의 처리 업무를 위탁할 수 있다. 이 경우 개인신용정보의 처리 위탁에 대해서는 「개인정보 보호법」 제26조제1항부터 제3항까지의 규정을 준용한다. <개정 2020.2.4> ② 신용정보회사등은 신용정보의 처리를 위탁할 수 있으며 이에 따라 위탁을 받은 자(이하 \\\"수탁자\\\"라 한다)의 위탁받은 업무의 처리에 관하여는 제19조부터 제21조까지, 제22조의4부터 제22조의7까지, 제22조의9, 제40조, 제43조, 제43조의2, 제45조, 제45조의2 및 제45조의3(해당 조문에 대한 벌칙 및 과태료규정을 포함한다)을 준용한다. <개정 2015.3.11, 2020.2.4> ③ 제2항에 따라 신용정보의 처리를 위탁하려는 신용정보회사등으로서 대통령령으로 정하는 자는 제공하는 신용정보의 범위 등을 대통령령으로 정하는 바에 따라 금융위원회에 알려야 한다. ④ 신용정보회사등은 제2항에 따라 신용정보의 처리를 위탁하기 위하여 수탁자에게 개인신용정보를 제공하는 경우 특정 신용정보주체를 식별할 수 있는 정보는 대통령령으로 정하는 바에 따라 암호화 등의 보호 조치를 하여야 한다. <신설 2015.3.11> ⑤ 신용정보회사등은 수탁자에게 신용정보를 제공한 경우 신용정보를 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손당하지 아니하도록 대통령령으로 정하는 바에 따라 수탁자를 교육하여야 하고 수탁자의 안전한 신용정보 처리에 관한 사항을 위탁계약에 반영하여야 한다. <신설 2015.3.11, 2020.2.4> ⑥ 수탁자가 개인신용정보를 이용하거나 제3자에게 제공하는 경우에는 「개인정보 보호법」 제26조제5항에 따른다. <개정 2020.2.4> ⑦ 수탁자는 제2항에 따라 위탁받은 업무를 제3자에게 재위탁하여서는 아니 된다. 다만, 신용정보의 보호 및 안전한 처리를 저해하지 아니하는 범위에서 금융위원회가 인정하는 경우에는 그러하지 아니하다. <신설 2015.3.11>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"수탁자 교육 의무와 수탁자의 안전한 신용정보 처리에 관한 사항이 위탁계약에 반영되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"교육과 안전처리 내용은 표준 보안관리약정에서 확인할 수 있음\", \"contract_action_curated\": true}, {\"id\": \"PRIV-21\", \"module\": \"X-PII\", \"check\": \"신용정보 처리 업무의 재위탁 금지(금융위원회 인정 시 예외) 조항이 있는가\", \"label\": \"신용정보 재위탁 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 신용정보의 이용 및 보호에 관한 법률 제17조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재위탁\", \"신용정보\", \"금융위원회가 인정\"]}, \"absence_check\": true, \"absence_precondition\": [\"신용정보\", \"개인신용정보\"], \"sources\": [{\"law\": \"신용정보의 이용 및 보호에 관한 법률\", \"article\": \"제17조\", \"clause\": \"제7항\", \"quote\": \"수탁자는 제2항에 따라 위탁받은 업무를 제3자에게 재위탁하여서는 아니 된다. 다만, 신용정보의 보호 및 안전한 처리를 저해하지 아니하는 범위에서 금융위원회가 인정하는 경우에는 그러하지 아니하다\", \"verified\": true, \"text\": \"제17조(처리의 위탁) 제17조(처리의 위탁) ① 신용정보회사등은 제3자에게 신용정보의 처리 업무를 위탁할 수 있다. 이 경우 개인신용정보의 처리 위탁에 대해서는 「개인정보 보호법」 제26조제1항부터 제3항까지의 규정을 준용한다. <개정 2020.2.4> ② 신용정보회사등은 신용정보의 처리를 위탁할 수 있으며 이에 따라 위탁을 받은 자(이하 \\\"수탁자\\\"라 한다)의 위탁받은 업무의 처리에 관하여는 제19조부터 제21조까지, 제22조의4부터 제22조의7까지, 제22조의9, 제40조, 제43조, 제43조의2, 제45조, 제45조의2 및 제45조의3(해당 조문에 대한 벌칙 및 과태료규정을 포함한다)을 준용한다. <개정 2015.3.11, 2020.2.4> ③ 제2항에 따라 신용정보의 처리를 위탁하려는 신용정보회사등으로서 대통령령으로 정하는 자는 제공하는 신용정보의 범위 등을 대통령령으로 정하는 바에 따라 금융위원회에 알려야 한다. ④ 신용정보회사등은 제2항에 따라 신용정보의 처리를 위탁하기 위하여 수탁자에게 개인신용정보를 제공하는 경우 특정 신용정보주체를 식별할 수 있는 정보는 대통령령으로 정하는 바에 따라 암호화 등의 보호 조치를 하여야 한다. <신설 2015.3.11> ⑤ 신용정보회사등은 수탁자에게 신용정보를 제공한 경우 신용정보를 분실ㆍ도난ㆍ유출ㆍ위조ㆍ변조 또는 훼손당하지 아니하도록 대통령령으로 정하는 바에 따라 수탁자를 교육하여야 하고 수탁자의 안전한 신용정보 처리에 관한 사항을 위탁계약에 반영하여야 한다. <신설 2015.3.11, 2020.2.4> ⑥ 수탁자가 개인신용정보를 이용하거나 제3자에게 제공하는 경우에는 「개인정보 보호법」 제26조제5항에 따른다. <개정 2020.2.4> ⑦ 수탁자는 제2항에 따라 위탁받은 업무를 제3자에게 재위탁하여서는 아니 된다. 다만, 신용정보의 보호 및 안전한 처리를 저해하지 아니하는 범위에서 금융위원회가 인정하는 경우에는 그러하지 아니하다. <신설 2015.3.11>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"신용정보 처리 업무의 재위탁 금지(금융위원회 인정 시 예외) 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"standard_subdoc\", \"action_rationale\": \"개인신용정보 재위탁 제한은 표준 보안관리약정에서 확인할 수 있음\", \"contract_action_curated\": true, \"tag_signature\": {\"status\": \"curated\", \"topics\": [\"subcontracting\", \"personal_information\"], \"actors\": [\"trustee\"], \"actions\": [\"subcontract\"], \"objects\": [\"personal_information\"], \"modalities\": [\"prohibition\"], \"required_facets\": [\"topics\", \"actions\", \"modalities\"]}}, {\"id\": \"ALL-PII-01\", \"module\": \"X-PII\", \"check\": \"개인정보를 독립적으로 이용하는 제3자에게 제공하는 계약에서 적법한 제공에 필요한 당사자 의무와 제공 범위·목적·책임이 규정되어 있는가\", \"label\": \"제3자 제공 근거·동의\", \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 개인정보 보호법 제17조 제1항(제3자 제공은 동의 등 법적근거 필요)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"relationship_scope\": [\"third_party_provision\", \"mixed\"], \"implementation_channel\": \"contract\", \"triggers\": {\"keywords\": [\"개인정보\", \"제3자 제공\", \"정보제공\", \"동의\"]}, \"evidence_required_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"제3자 제공\", \"제3자에게 제공\", \"개인정보를 제공\", \"정보제공\", \"제공받\"]], \"absence_check\": true, \"absence_precondition_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"제3자 제공\", \"제3자에게 제공\", \"개인정보를 제공\", \"정보제공\", \"제공받\"]], \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제17조\", \"clause\": \"제1항\", \"quote\": \"정보주체의 개인정보를 제3자에게 제공(공유를 포함한다. 이하 같다)할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제17조(개인정보의 제공) 제17조(개인정보의 제공) ① 개인정보처리자는 다음 각 호의 어느 하나에 해당되는 경우에는 정보주체의 개인정보를 제3자에게 제공(공유를 포함한다. 이하 같다)할 수 있다. <개정 2020.2.4, 2023.3.14> 1. 정보주체의 동의를 받은 경우 2. 제15조제1항제2호, 제3호 및 제5호부터 제7호까지에 따라 개인정보를 수집한 목적 범위에서 개인정보를 제공하는 경우 ② 개인정보처리자는 제1항제1호에 따른 동의를 받을 때에는 다음 각 호의 사항을 정보주체에게 알려야 한다. 다음 각 호의 어느 하나의 사항을 변경하는 경우에도 이를 알리고 동의를 받아야 한다. 1. 개인정보를 제공받는 자 2. 개인정보를 제공받는 자의 개인정보 이용 목적 3. 제공하는 개인정보의 항목 4. 개인정보를 제공받는 자의 개인정보 보유 및 이용 기간 5. 동의를 거부할 권리가 있다는 사실 및 동의 거부에 따른 불이익이 있는 경우에는 그 불이익의 내용 ③ 삭제 <2023.3.14> ④ 개인정보처리자는 당초 수집 목적과 합리적으로 관련된 범위에서 정보주체에게 불이익이 발생하는지 여부, 암호화 등 안전성 확보에 필요한 조치를 하였는지 여부 등을 고려하여 대통령령으로 정하는 바에 따라 정보주체의 동의 없이 개인정보를 제공할 수 있다. <신설 2020.2.4>\", \"status\": \"quote_ok\"}], \"note\": \"처리위탁과 구별되는 제3자 제공의 약정상 의무·범위·책임을 검토한다. 실제 동의 취득이나 증빙 확보 실적은 검사하지 않는다.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}, {\"id\": \"ALL-PII-02\", \"module\": \"X-PII\", \"check\": \"개인정보 제공 동의가 필요한 거래에서 고지·동의 처리의 담당 주체와 필요한 협조 의무가 계약에 규정되어 있는가\", \"label\": \"개인정보 법정 고지\", \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 개인정보 보호법 제17조 제2항(동의 시 각 호 사항 고지 의무)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"relationship_scope\": [\"third_party_provision\", \"mixed\"], \"implementation_channel\": \"contract\", \"triggers\": {\"keywords\": [\"이용목적\", \"제공 항목\", \"보유기간\", \"고지\"]}, \"evidence_required_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"제3자 제공\", \"제3자에게 제공\", \"개인정보를 제공\", \"정보제공\", \"제공받\"]], \"absence_check\": true, \"absence_precondition_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"제3자 제공\", \"제3자에게 제공\", \"개인정보를 제공\", \"정보제공\", \"제공받\"]], \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제17조\", \"clause\": \"제2항\", \"quote\": \"다음 각 호의 사항을 정보주체에게 알려야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제17조(개인정보의 제공) 제17조(개인정보의 제공) ① 개인정보처리자는 다음 각 호의 어느 하나에 해당되는 경우에는 정보주체의 개인정보를 제3자에게 제공(공유를 포함한다. 이하 같다)할 수 있다. <개정 2020.2.4, 2023.3.14> 1. 정보주체의 동의를 받은 경우 2. 제15조제1항제2호, 제3호 및 제5호부터 제7호까지에 따라 개인정보를 수집한 목적 범위에서 개인정보를 제공하는 경우 ② 개인정보처리자는 제1항제1호에 따른 동의를 받을 때에는 다음 각 호의 사항을 정보주체에게 알려야 한다. 다음 각 호의 어느 하나의 사항을 변경하는 경우에도 이를 알리고 동의를 받아야 한다. 1. 개인정보를 제공받는 자 2. 개인정보를 제공받는 자의 개인정보 이용 목적 3. 제공하는 개인정보의 항목 4. 개인정보를 제공받는 자의 개인정보 보유 및 이용 기간 5. 동의를 거부할 권리가 있다는 사실 및 동의 거부에 따른 불이익이 있는 경우에는 그 불이익의 내용 ③ 삭제 <2023.3.14> ④ 개인정보처리자는 당초 수집 목적과 합리적으로 관련된 범위에서 정보주체에게 불이익이 발생하는지 여부, 암호화 등 안전성 확보에 필요한 조치를 하였는지 여부 등을 고려하여 대통령령으로 정하는 바에 따라 정보주체의 동의 없이 개인정보를 제공할 수 있다. <신설 2020.2.4>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"personal_information_processing\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}, {\"id\": \"ALL-PII-03\", \"module\": \"X-PII\", \"check\": \"개인정보의 목적 외 이용·제공을 제한하는 약정이 있는가\", \"label\": \"제공정보 목적 외 이용 제한\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 개인정보 보호법 제18조 제1항(목적 외 이용·제공 제한)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"relationship_scope\": [\"third_party_provision\", \"mixed\"], \"implementation_channel\": \"contract_or_internal_control\", \"triggers\": {\"keywords\": [\"목적 외\", \"이용 제한\", \"제공 제한\"]}, \"evidence_required_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"목적\", \"업무\", \"임의 제공\", \"제3자\"]], \"absence_check\": false, \"absence_precondition_groups\": [[\"개인정보\", \"개인신용정보\", \"고객정보\", \"정보주체\"], [\"제3자 제공\", \"제3자에게 제공\", \"개인정보를 제공\", \"정보제공\", \"제공받\"]], \"sources\": [{\"law\": \"개인정보 보호법\", \"article\": \"제18조\", \"clause\": \"제1항\", \"quote\": \"제17조제1항 및 제28조의8제1항에 따른 범위를 초과하여 제3자에게 제공하여서는 아니 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제18조(개인정보의 목적 외 이용ㆍ제공 제한) 제18조(개인정보의 목적 외 이용ㆍ제공 제한) ① 개인정보처리자는 개인정보를 제15조제1항에 따른 범위를 초과하여 이용하거나 제17조제1항 및 제28조의8제1항에 따른 범위를 초과하여 제3자에게 제공하여서는 아니 된다. <개정 2020.2.4, 2023.3.14> ② 제1항에도 불구하고 개인정보처리자는 다음 각 호의 어느 하나에 해당하는 경우에는 정보주체 또는 제3자의 이익을 부당하게 침해할 우려가 있을 때를 제외하고는 개인정보를 목적 외의 용도로 이용하거나 이를 제3자에게 제공할 수 있다. 다만, 제5호부터 제9호까지에 따른 경우는 공공기관의 경우로 한정한다. <개정 2020.2.4, 2023.3.14> 1. 정보주체로부터 별도의 동의를 받은 경우 2. 다른 법률에 특별한 규정이 있는 경우 3. 명백히 정보주체 또는 제3자의 급박한 생명, 신체, 재산의 이익을 위하여 필요하다고 인정되는 경우 4. 삭제 <2020.2.4> 5. 개인정보를 목적 외의 용도로 이용하거나 이를 제3자에게 제공하지 아니하면 다른 법률에서 정하는 소관 업무를 수행할 수 없는 경우로서 보호위원회의 심의ㆍ의결을 거친 경우 6. 조약, 그 밖의 국제협정의 이행을 위하여 외국정부 또는 국제기구에 제공하기 위하여 필요한 경우 7. 범죄의 수사와 공소의 제기 및 유지를 위하여 필요한 경우 8. 법원의 재판업무 수행을 위하여 필요한 경우 9. 형(刑) 및 감호, 보호처분의 집행을 위하여 필요한 경우 10. 공중위생 등 공공의 안전과 안녕을 위하여 긴급히 필요한 경우 ③ 개인정보처리자는 제2항제1호에 따른 동의를 받을 때에는 다음 각 호의 사항을 정보주체에게 알려야 한다. 다음 각 호의 어느 하나의 사항을 변경하는 경우에도 이를 알리고 동의를 받아야 한다. 1. 개인정보를 제공받는 자 2. 개인정보의 이용 목적(제공 시에는 제공받는 자의 이용 목적을 말한다) 3. 이용 또는 제공하는 개인정보의 항목 4. 개인정보의 보유 및 이용 기간(제공 시에는 제공받는 자의 보유 및 이용 기간을 말한다) 5. 동의를 거부할 권리가 있다는 사실 및 동의 거부에 따른 불이익이 있는 경우에는 그 불이익의 내용 ④ 공공기관은 제2항제2호부터 제6호까지, 제8호부터 제10호까지에 따라 개인정보를 목적 외의 용도로 이용하거나 이를 제3자에게 제공하는 경우에는 그 이용 또는 제공의 법적 근거, 목적 및 범위 등에 관하여 필요한 사항을 보호위원회가 고시로 정하는 바에 따라 관보 또는 인터넷 홈페이지 등에 게재하여야 한다. <개정 2013.3.23, 2014.11.19, 2017.7.26, 2020.2.4, 2023.3.14> ⑤ 개인정보처리자는 제2항 각 호의 어느 하나의 경우에 해당하여 개인정보를 목적 외의 용도로 제3자에게 제공하는 경우에는 개인정보를 제공받는 자에게 이용 목적, 이용 방법, 그 밖에 필요한 사항에 대하여 제한을 하거나, 개인정보의 안전성 확보를 위하여 필요한 조치를 마련하도록 요청하여야 한다. 이 경우 요청을 받은 자는 개인정보의 안전성 확보를 위하여 필요한 조치를 하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"본건 개인정보에 관한 목적 외 이용·제공 제한을 확인한다. 위탁·제공 명칭이나 금지라는 어미의 정확한 반복을 요구하지 않고 업무 목적에 한정하는 표현도 인정한다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"personal_information_processing\", \"decision_question\": \"개인정보의 목적 외 이용·제공을 제한하는 약정이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"ALL-REINS-01\", \"check\": \"재보험 출재 시 원보험계약의 효력과 분리(원계약 무영향)가 전제되어 있는가\", \"label\": \"재보험 원계약 분리\", \"module\": \"X-REINS\", \"severity\": \"참고\", \"severity_basis\": \"선언규정 — 상법 제661조(재보험은 원보험계약 효력에 무영향)\", \"norm_type\": \"선언\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재보험\", \"출재\", \"원보험\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제661조\", \"clause\": \"\", \"quote\": \"이 재보험계약은 원보험계약의 효력에 영향을 미치지 아니한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제661조(재보험) 제661조(재보험) 보험자는 보험사고로 인하여 부담할 책임에 대하여 다른 보험자와 재보험계약을 체결할 수 있다. 이 재보험계약은 원보험계약의 효력에 영향을 미치지 아니한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"재보험 출재 시 원보험계약의 효력과 분리(원계약 무영향)가 전제되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"REL-01\", \"module\": \"X-RELATED\", \"check\": \"계약 상대방이 보험회사의 대주주(그 특수관계인 포함)인 경우, 자산 무상양도 또는 뚜렷하게 불리한 조건의 매매·교환·신용공여·재보험거래에 해당하지 않는가\", \"label\": \"대주주 불리조건거래 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(금지)임 — 보험업법 제111조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"대주주\", \"특수관계인\", \"무상 양도\", \"무상양도\", \"불리한 조건\", \"신용공여\", \"재보험\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제111조\", \"clause\": \"제1항 제2호\", \"quote\": \"자산을 대통령령으로 정하는 바에 따라 무상으로 양도하거나 일반적인 거래 조건에 비추어 해당 보험회사에 뚜렷하게 불리한 조건으로 자산에 대하여 매매ㆍ교환ㆍ신용공여 또는 재보험계약을 하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제111조(대주주와의 거래제한 등) 제111조(대주주와의 거래제한 등) ① 보험회사는 직접 또는 간접으로 그 보험회사의 대주주(그의 특수관계인인 보험회사의 자회사는 제외한다. 이하 이 항에서 같다)와 다음 각 호의 행위를 하여서는 아니 된다. <개정 2015.7.24> 1. 대주주가 다른 회사에 출자하는 것을 지원하기 위한 신용공여 2. 자산을 대통령령으로 정하는 바에 따라 무상으로 양도하거나 일반적인 거래 조건에 비추어 해당 보험회사에 뚜렷하게 불리한 조건으로 자산에 대하여 매매ㆍ교환ㆍ신용공여 또는 재보험계약을 하는 행위 ② 보험회사는 그 보험회사의 대주주에 대하여 대통령령으로 정하는 금액 이상의 신용공여를 하거나 그 보험회사의 대주주가 발행한 채권 또는 주식을 대통령령으로 정하는 금액 이상으로 취득하려는 경우에는 미리 이사회의 의결을 거쳐야 한다. 이 경우 이사회는 재적이사 전원의 찬성으로 의결하여야 한다. ③ 보험회사는 그 보험회사의 대주주와 다음 각 호의 어느 하나에 해당하는 행위를 하였을 때에는 7일 이내에 그 사실을 금융위원회에 보고하고 인터넷 홈페이지 등을 이용하여 공시하여야 한다. 1. 대통령령으로 정하는 금액 이상의 신용공여 2. 해당 보험회사의 대주주가 발행한 채권 또는 주식을 대통령령으로 정하는 금액 이상으로 취득하는 행위 3. 해당 보험회사의 대주주가 발행한 주식에 대한 의결권을 행사하는 행위 ④ 보험회사는 해당 보험회사의 대주주에 대한 신용공여나 그 보험회사의 대주주가 발행한 채권 또는 주식의 취득에 관한 사항을 대통령령으로 정하는 바에 따라 분기별로 금융위원회에 보고하고, 인터넷 홈페이지 등을 이용하여 공시하여야 한다. ⑤ 보험회사의 대주주는 해당 보험회사의 이익에 반하여 대주주 개인의 이익을 위하여 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니 된다. <개정 2015.7.31> 1. 부당한 영향력을 행사하기 위하여 해당 보험회사에 대하여 외부에 공개되지 아니한 자료 또는 정보의 제공을 요구하는 행위. 다만, 「금융회사의 지배구조에 관한 법률」 제33조제7항(제58조에 따라 준용되는 경우를 포함한다)에 해당하는 경우는 제외한다. 2. 경제적 이익 등 반대급부를 제공하는 조건으로 다른 주주 또는 출자자와 담합(談合)하여 해당 보험회사의 인사 또는 경영에 부당한 영향력을 행사하는 행위 3. 제106조제1항제4호 및 제5호에서 정한 비율을 초과하여 보험회사로부터 신용공여를 받는 행위 4. 제106조제1항제6호에서 정한 비율을 초과하여 보험회사에게 대주주의 채권 및 주식을 소유하게 하는 행위 5. 그 밖에 보험회사의 이익에 반하여 대주주 개인의 이익을 위한 행위로서 대통령령으로 정하는 행위 ⑥ 금융위원회는 보험회사의 대주주(회사만 해당한다)의 부채가 자산을 초과하는 등 재무구조가 부실하여 보험회사의 경영건전성을 뚜렷하게 해칠 우려가 있는 경우로서 대통령령으로 정하는 경우에는 그 보험회사에 대하여 다음 각 호의 조치를 할 수 있다. 1. 대주주에 대한 신규 신용공여 금지 2. 대주주가 발행한 유가증권의 신규 취득 금지 3. 그 밖에 대주주에 대한 자금지원 성격의 거래제한 등 대통령령으로 정하는 조치\", \"status\": \"quote_ok\"}], \"note\": \"보험업법 §111①은 보험회사가 직접·간접으로 대주주와 '하여서는 아니 된다'는 강행 금지규정. 위반 시 §196 과징금(신용공여액·자산장부가액 이하)·§200 벌칙 병과 가능(§111② 이사회 미의결·§111③④ 미보고·미공시는 §209 과태료). '뚜렷하게 불리한 조건' 판정을 위해 정상가격 대비 비교근거 확보 필요. [2026-07-28 정정] 스냅샷 절단 row(§111이 ①1호·②만 275자로 수록된 seed)를 원문으로 오신하여 본 체크를 ①1호(출자지원 신용공여)로 일시 축소·verified 하향했으나(34fe719), 현행 원문(법령ID 001532, 시행 2025-01-31)·원본 DB 재확인 결과 §111은 ①(1·2호)·②·③·④·⑤·⑥의 완전한 조문이고 ①2호 문언이 본 quote와 verbatim 일치 — 오경보로 확인되어 원상복구(verified:true 복원).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"REL-04\", \"module\": \"X-RELATED\", \"check\": \"자회사와의 거래인 경우, 자산 무상양도·불리조건 매매·자회사 주식담보 신용공여·자회사 임직원 대출 등 §116 금지행위에 해당하지 않는가\", \"label\": \"자회사 금지행위 해당성\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(금지)임 — 보험업법 제116조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"자회사\", \"무상 양도\", \"무상양도\", \"불리한 조건\", \"주식 담보\", \"임직원 대출\", \"신용공여\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"보험업법\", \"article\": \"제116조\", \"clause\": \"제1호\", \"quote\": \"자산을 대통령령으로 정하는 바에 따라 무상으로 양도하거나 일반적인 거래 조건에 비추어 해당 보험회사에 뚜렷하게 불리한 조건으로 매매ㆍ교환ㆍ신용공여 또는 재보험계약을 하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제116조(자회사와의 금지행위) 제116조(자회사와의 금지행위) 보험회사는 자회사와 다음 각 호의 행위를 하여서는 아니 된다. 1. 자산을 대통령령으로 정하는 바에 따라 무상으로 양도하거나 일반적인 거래 조건에 비추어 해당 보험회사에 뚜렷하게 불리한 조건으로 매매ㆍ교환ㆍ신용공여 또는 재보험계약을 하는 행위 2. 자회사가 소유하는 주식을 담보로 하는 신용공여 및 자회사가 다른 회사에 출자하는 것을 지원하기 위한 신용공여 3. 자회사 임직원에 대한 대출(보험약관에 따른 대출과 금융위원회가 정하는 소액대출은 제외한다)\", \"status\": \"quote_ok\"}], \"note\": \"§116은 보험회사가 자회사와 '하여서는 아니 된다'는 강행 금지(제1호 불리조건거래·제2호 자회사주식담보/출자지원 신용공여·제3호 자회사 임직원 대출). 위반 시 §209 과태료. 계약 상대방이 자회사(§115 소유 자회사)이면 발동.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"REL-05\", \"module\": \"X-RELATED\", \"check\": \"계약 상대방 계열사의 임원이 우리 회사 이사·주요주주 등을 겸직하는 등 상법 §398 자기거래에 해당하는 경우, 사전 이사회 승인(이사 2/3 이상)과 거래 공정성 요건을 반영하였는가\", \"label\": \"이사 자기거래 이사회승인\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제398조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이사\", \"주요주주\", \"겸직\", \"자기거래\", \"이사회 승인\", \"이사회의 승인\", \"특수관계\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제398조\", \"quote\": \"다음 각 호의 어느 하나에 해당하는 자가 자기 또는 제3자의 계산으로 회사와 거래를 하기 위하여는 미리 이사회에서 해당 거래에 관한 중요사실을 밝히고 이사회의 승인을 받아야 한다. 이 경우 이사회의 승인은 이사 3분의 2 이상의 수로써 하여야 하고, 그 거래의 내용과 절차는 공정하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제398조(이사 등과 회사 간의 거래) 제398조(이사 등과 회사 간의 거래) 다음 각 호의 어느 하나에 해당하는 자가 자기 또는 제3자의 계산으로 회사와 거래를 하기 위하여는 미리 이사회에서 해당 거래에 관한 중요사실을 밝히고 이사회의 승인을 받아야 한다. 이 경우 이사회의 승인은 이사 3분의 2 이상의 수로써 하여야 하고, 그 거래의 내용과 절차는 공정하여야 한다. 1. 이사 또는 제542조의8제2항제6호에 따른 주요주주 2. 제1호의 자의 배우자 및 직계존비속 3. 제1호의 자의 배우자의 직계존비속 4. 제1호부터 제3호까지의 자가 단독 또는 공동으로 의결권 있는 발행주식 총수의 100분의 50 이상을 가진 회사 및 그 자회사 5. 제1호부터 제3호까지의 자가 제4호의 회사와 합하여 의결권 있는 발행주식총수의 100분의 50 이상을 가진 회사\", \"status\": \"quote_ok\"}], \"note\": \"§398은 이사·주요주주 및 그 특수관계 회사(발행주식 50% 이상 지배회사·자회사 포함, 제4호·제5호)가 회사와 거래 시 '미리 이사회 승인(이사 2/3 이상)'을 요구하는 강행규정. 계열사 거래에서 상대방이 우리 회사 이사·주요주주가 지배하는 회사이면 자기거래 규제 발동. 승인 없는 거래는 상대적 무효(선의 제3자 대항 불가), 이사 손해배상책임(§399)·책임감면 배제(§400②).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"REL-06\", \"module\": \"X-RELATED\", \"check\": \"계열사 지원(가지급금·대여·인력·부동산·용역 등 상당히 유리한 조건 제공, 또는 실질역할 없는 회사 매개거래)에 해당하여 공정거래법상 부당지원 리스크가 없는가\", \"label\": \"부당지원행위 리스크\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(금지)임 — 독점규제 및 공정거래에 관한 법률 제45조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"계열사\", \"계열회사\", \"지원\", \"상당히 유리한 조건\", \"가지급금\", \"대여금\", \"인력 지원\", \"통행세\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제45조\", \"clause\": \"제1항 제9호\", \"quote\": \"특수관계인 또는 다른 회사에 가지급금ㆍ대여금ㆍ인력ㆍ부동산ㆍ유가증권ㆍ상품ㆍ용역ㆍ무체재산권 등을 제공하거나 상당히 유리한 조건으로 거래하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제45조(불공정거래행위의 금지) 제45조(불공정거래행위의 금지) ① 사업자는 다음 각 호의 어느 하나에 해당하는 행위로서 공정한 거래를 해칠 우려가 있는 행위(이하 \\\"불공정거래행위\\\"라 한다)를 하거나, 계열회사 또는 다른 사업자로 하여금 이를 하도록 하여서는 아니 된다. 1. 부당하게 거래를 거절하는 행위 2. 부당하게 거래의 상대방을 차별하여 취급하는 행위 3. 부당하게 경쟁자를 배제하는 행위 4. 부당하게 경쟁자의 고객을 자기와 거래하도록 유인하는 행위 5. 부당하게 경쟁자의 고객을 자기와 거래하도록 강제하는 행위 6. 자기의 거래상의 지위를 부당하게 이용하여 상대방과 거래하는 행위 7. 거래의 상대방의 사업활동을 부당하게 구속하는 조건으로 거래하는 행위 8. 부당하게 다른 사업자의 사업활동을 방해하는 행위 9. 부당하게 다음 각 목의 어느 하나에 해당하는 행위를 통하여 특수관계인 또는 다른 회사를 지원하는 행위 가. 특수관계인 또는 다른 회사에 가지급금ㆍ대여금ㆍ인력ㆍ부동산ㆍ유가증권ㆍ상품ㆍ용역ㆍ무체재산권 등을 제공하거나 상당히 유리한 조건으로 거래하는 행위 나. 다른 사업자와 직접 상품ㆍ용역을 거래하면 상당히 유리함에도 불구하고 거래상 실질적인 역할이 없는 특수관계인이나 다른 회사를 매개로 거래하는 행위 10. 그 밖의 행위로서 공정한 거래를 해칠 우려가 있는 행위 ② 특수관계인 또는 회사는 다른 사업자로부터 제1항제9호에 해당할 우려가 있음에도 불구하고 해당 지원을 받는 행위를 하여서는 아니 된다. ③ 불공정거래행위의 유형 또는 기준은 대통령령으로 정한다. ④ 공정거래위원회는 제1항을 위반하는 행위를 예방하기 위하여 필요한 경우 사업자가 준수하여야 할 지침을 제정ㆍ고시할 수 있다. ⑤ 사업자 또는 사업자단체는 부당한 고객유인을 방지하기 위하여 자율적으로 규약(이하 \\\"공정경쟁규약\\\"이라 한다)을 정할 수 있다. ⑥ 사업자 또는 사업자단체는 공정거래위원회에 공정경쟁규약이 제1항제4호를 위반하는지에 대한 심사를 요청할 수 있다.\", \"status\": \"quote_ok\"}], \"note\": \"§45①제9호(부당지원)는 '하여서는 아니 된다' 강행 금지. 나목은 실질역할 없는 계열사 매개거래(이른바 통행세). §50② 과징금(매출액 10% 이내)·§124 벌칙. 상표사용료·용역 단가가 정상가격 대비 상당히 유리·불리한지 비교근거로 판정. 위반 시 지원객체(§45②)도 수령 금지.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"REL-07\", \"module\": \"X-RELATED\", \"check\": \"공시대상기업집단 소속 회사가 동일인·친족(특수관계인) 지분 요건 계열회사와 상당히 유리한 조건 또는 비교없는 상당규모 거래로 특수관계인에게 부당이익을 귀속시키는 사익편취에 해당하지 않는가\", \"label\": \"사익편취(특수관계인 이익제공)\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(금지)임 — 독점규제 및 공정거래에 관한 법률 제47조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"공시대상기업집단\", \"특수관계인\", \"부당한 이익\", \"사익편취\", \"상당한 규모\", \"계열회사\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"독점규제 및 공정거래에 관한 법률\", \"article\": \"제47조\", \"clause\": \"제1항\", \"quote\": \"공시대상기업집단(동일인이 자연인인 기업집단으로 한정한다)에 속하는 국내 회사는 특수관계인(동일인 및 그 친족으로 한정한다. 이하 이 조에서 같다), 동일인이 단독으로 또는 다른 특수관계인과 합하여 발행주식총수의 100분의 20 이상의 주식을 소유한 국내 계열회사 또는 그 계열회사가 단독으로 발행주식총수의 100분의 50을 초과하는 주식을 소유한 국내 계열회사와 다음 각 호의 어느 하나에 해당하는 행위를 통하여 특수관계인에게 부당한 이익을 귀속시키는 행위를 하여서는 아니 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제47조(특수관계인에 대한 부당한 이익제공 등 금지)\\n① 공시대상기업집단(동일인이 자연인인 기업집단으로 한정한다)에 속하는 국내 회사는 특수관계인(동일인 및 그 친족으로 한정한다. 이하 이 조에서 같다), 동일인이 단독으로 또는 다른 특수관계인과 합하여 발행주식총수의 100분의 20 이상의 주식을 소유한 국내 계열회사 또는 그 계열회사가 단독으로 발행주식총수의 100분의 50을 초과하는 주식을 소유한 국내 계열회사와 다음 각 호의 어느 하나에 해당하는 행위를 통하여 특수관계인에게 부당한 이익을 귀속시키는 행위를 하여서는 아니 된다. 이 경우 다음 각 호에 해당하는 행위의 유형 및 기준은 대통령령으로 정한다.\\n1.  정상적인 거래에서 적용되거나 적용될 것으로 판단되는 조건보다 상당히 유리한 조건으로 거래하는 행위\\n2.  회사가 직접 또는 자신이 지배하고 있는 회사를 통하여 수행할 경우 회사에 상당한 이익이 될 사업기회를 제공하는 행위\\n3.  특수관계인과 현금이나 그 밖의 금융상품을 상당히 유리한 조건으로 거래하는 행위\\n4.  사업능력, 재무상태, 신용도, 기술력, 품질, 가격 또는 거래조건 등에 대한 합리적인 고려나 다른 사업자와의 비교 없이 상당한 규모로 거래하는 행위\\n② 기업의 효율성 증대, 보안성, 긴급성 등 거래의 목적을 달성하기 위하여 불가피한 경우로서 대통령령으로 정하는 거래에는 제1항제4호를 적용하지 아니한다.\\n③ 제1항에 따른 거래 또는 사업기회 제공의 상대방은 제1항 각 호의 어느 하나에 해당할 우려가 있음에도 불구하고 해당 거래를 하거나 사업기회를 제공받는 행위를 하여서는 아니 된다.\\n④ 특수관계인은 누구에게든지 제1항 또는 제3항에 해당하는 행위를 하도록 지시하거나 해당 행위에 관여해서는 아니 된다.\", \"status\": \"quote_ok\"}], \"note\": \"§47은 §45 부당지원과 별개 규율(사익편취) — 공시대상기업집단·동일인이 자연인인 경우에 한정. 미래에셋금융그룹의 기업집단 지정·동일인 요건 해당성 별도 확인 필요(그룹 지배구조 사실관계 의존). 상당규모 거래(제4호)는 §47②·시행령 예외(효율성·보안성·긴급성) 검토. §50② 과징금·§124 벌칙, 특수관계인 관여 지시 금지(§47④).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"REL-08\", \"module\": \"X-RELATED\", \"check\": \"계열사·특수관계인 거래의 대가와 산정 기준이 계약서 또는 적용 부속자료에 명확히 규정되어 있는가\", \"label\": \"정상가격 산정근거 확보\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"상표사용료\", \"브랜드 수수료\", \"정상가격\", \"비교견적\", \"산정 근거\", \"단가\", \"시장가\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"§111·§116(불리조건)·§45제9호(상당히 유리)·§47(상당히 유리)의 위법성 판정이 모두 '정상거래조건 대비'로 이뤄지므로, 정상가격 비교근거 확보는 위 강행규정 방어의 실무 전제. 법령이 직접 계약서 기재를 강제하는 것은 아니라 basis=practice. 대규모내부거래는 공정거래법 §26 이사회 의결·공시 별도(공시대상기업집단 소속 시).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}, {\"id\": \"FIN-SEC-02\", \"check\": \"지명채권 질권 설정에 필요한 통지·승낙의 이행 주체와 협력 의무가 계약에 규정되어 있는가\", \"label\": \"채권질권 대항요건\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"party_roles\": [\"질권자\", \"담보권자\", \"저당권자\", \"양도담보권자\", \"채권자\"], \"subject_roles\": [\"질권자\", \"담보권자\", \"설정자\", \"질권설정자\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(대항요건) — 민법 제349조(질권설정 통지·승낙 없으면 제3채무자·제3자 대항 불가)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"예금질권\", \"근질권\", \"채권질권\", \"제3채무자\", \"통지\", \"승낙\"]}, \"absence_check\": true, \"absence_precondition\": [\"질권을 설정\", \"근질권을 설정\", \"채권질권을 설정\", \"예금질권을 설정\", \"입질\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제349조\", \"clause\": \"제1항\", \"quote\": \"제삼채무자에게 질권설정의 사실을 통지하거나 제삼채무자가 이를 승낙함이 아니면 이로써 제삼채무자 기타 제삼자에게 대항하지 못한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제349조(지명채권에 대한 질권의 대항요건) 제349조(지명채권에 대한 질권의 대항요건) ①지명채권을 목적으로 한 질권의 설정은 설정자가 제450조의 규정에 의하여 제삼채무자에게 질권설정의 사실을 통지하거나 제삼채무자가 이를 승낙함이 아니면 이로써 제삼채무자 기타 제삼자에게 대항하지 못한다. ②제451조의 규정은 전항의 경우에 준용한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"지명채권 질권 설정에 필요한 통지·승낙의 이행 주체와 협력 의무가 계약에 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}, {\"id\": \"FIN-SEC-03\", \"check\": \"저당권(근저당) 설정 시 피담보채권과 채권최고액이 특정되어 있는가\", \"label\": \"근저당 채권최고액\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"저당\", \"근저당\"], \"party_roles\": [\"질권자\", \"담보권자\", \"저당권자\", \"양도담보권자\", \"채권자\"], \"subject_roles\": [\"저당권자\", \"담보권자\", \"설정자\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 민법 제357조(근저당은 채무 최고액 확정 필요)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"저당권\", \"근저당\", \"채권최고액\", \"피담보채권\"]}, \"evidence_required_groups\": [[\"채권최고액\", \"채무최고액\"]], \"auto_clear\": {\"any_groups\": [[\"채권최고액\", \"채무최고액\"]]}, \"absence_check\": true, \"absence_precondition\": [\"저당권을 설정\", \"근저당권을 설정\", \"근저당을 설정\", \"채권최고액\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제357조\", \"clause\": \"제1항\", \"quote\": \"저당권은 그 담보할 채무의 최고액만을 정하고 채무의 확정을 장래에 보류하여 이를 설정할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제357조(근저당) 제357조(근저당) ①저당권은 그 담보할 채무의 최고액만을 정하고 채무의 확정을 장래에 보류하여 이를 설정할 수 있다. 이 경우에는 그 확정될 때까지의 채무의 소멸 또는 이전은 저당권에 영향을 미치지 아니한다. ②전항의 경우에는 채무의 이자는 최고액 중에 산입한 것으로 본다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제356조\", \"clause\": \"\", \"quote\": \"채무의 담보로 제공한 부동산에 대하여 다른 채권자보다 자기채권의 우선변제를 받을 권리\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제356조(저당권의 내용) 제356조(저당권의 내용) 저당권자는 채무자 또는 제삼자가 점유를 이전하지 아니하고 채무의 담보로 제공한 부동산에 대하여 다른 채권자보다 자기채권의 우선변제를 받을 권리가 있다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"근저당 계약의 피담보채권과 채권최고액은 담보 범위를 정하는 본질적 문구임\", \"contract_action_curated\": true}, {\"id\": \"FIN-SEC-P01\", \"check\": \"변제기 전에 담보물의 소유권을 채권자에게 이전하거나 법정 절차 외의 방법으로 처분하도록 하는 유질(流質) 약정이 없는가\", \"label\": \"유질계약 금지 위반 여부\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"party_roles\": [\"담보제공자\", \"설정자\", \"질권설정자\", \"채무자\", \"물상보증인\"], \"subject_roles\": [\"질권자\", \"담보권자\", \"설정자\", \"질권설정자\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 민법 제339조(유질계약의 금지). 위반 약정은 무효이므로 담보제공자 보호의 핵심\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"유질\", \"변제에 갈음\", \"소유권을 취득\", \"임의처분\", \"임의 처분\", \"귀속정산\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제339조\", \"clause\": \"\", \"quote\": \"질권설정자는 채무변제기전의 계약으로 질권자에게 변제에 갈음하여 질물의 소유권을 취득하게 하거나 법률에 정한 방법에 의하지 아니하고 질물을 처분할 것을 약정하지 못한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제339조(유질계약의 금지)\\n질권설정자는 채무변제기전의 계약으로 질권자에게 변제에 갈음하여 질물의 소유권을 취득하게 하거나 법률에 정한 방법에 의하지 아니하고 질물을 처분할 것을 약정하지 못한다.\", \"status\": \"quote_ok\"}], \"note\": \"부재알람 아님(absence_check:false) — 조항이 '없어야 정상'인 금지형 항목이라 매칭될 때만 표면화\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-SEC-P02\", \"check\": \"타인의 채무를 담보하는 경우(물상보증) 채무자에 대한 구상권이 제한·포기되지 않는가\", \"label\": \"물상보증 구상권 보전\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"party_roles\": [\"담보제공자\", \"설정자\", \"질권설정자\", \"물상보증인\"], \"subject_roles\": [\"설정자\", \"질권설정자\", \"물상보증인\", \"담보제공자\"], \"severity\": \"권장\", \"severity_basis\": \"임의규정 — 민법 제341조(물상보증인의 구상권). 법정 구상권이나 약정으로 배제·제한될 수 있어 확인 필요\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"물상보증\", \"구상권\", \"타인의 채무\", \"제3자 담보\", \"구상\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제341조\", \"clause\": \"\", \"quote\": \"타인의 채무를 담보하기 위한 질권설정자가 그 채무를 변제하거나 질권의 실행으로 인하여 질물의 소유권을 잃은 때에는 보증채무에 관한 규정에 의하여 채무자에 대한 구상권이 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제341조(물상보증인의 구상권)\\n타인의 채무를 담보하기 위한 질권설정자가 그 채무를 변제하거나 질권의 실행으로 인하여 질물의 소유권을 잃은 때에는 보증채무에 관한 규정에 의하여 채무자에 대한 구상권이 있다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-SEC-P03\", \"check\": \"근담보(근질권·근저당)인 경우 피담보채무의 범위와 채권최고액이 특정되어 과도하게 포괄적이지 않은가\", \"label\": \"피담보채무 범위·최고액 특정\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"party_roles\": [\"담보제공자\", \"설정자\", \"질권설정자\", \"채무자\", \"물상보증인\"], \"subject_roles\": [\"저당권자\", \"담보권자\", \"설정자\"], \"severity\": \"권장\", \"severity_basis\": \"임의규정 — 민법 제357조 제1항(근저당은 담보할 채무의 최고액을 정하여 설정). 최고액·범위가 불특정하면 담보제공자의 부담이 무한정 확대\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"채권최고액\", \"최고액\", \"피담보채무\", \"피담보채권\", \"근질권\", \"근저당\", \"장래의 채무\"]}, \"absence_check\": true, \"absence_precondition\": [\"근질권\", \"근저당\", \"최고액\", \"장래의 채무\", \"장래 발생\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제357조\", \"clause\": \"제1항\", \"quote\": \"저당권은 그 담보할 채무의 최고액만을 정하고 채무의 확정을 장래에 보류하여 이를 설정할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제357조(근저당) 제357조(근저당) ①저당권은 그 담보할 채무의 최고액만을 정하고 채무의 확정을 장래에 보류하여 이를 설정할 수 있다. 이 경우에는 그 확정될 때까지의 채무의 소멸 또는 이전은 저당권에 영향을 미치지 아니한다. ②전항의 경우에는 채무의 이자는 최고액 중에 산입한 것으로 본다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"근담보 범위의 적정성은 법정 획일사항보다 위험배분·협상 판단에 가까움\", \"contract_action_curated\": true}, {\"id\": \"FIN-SEC-P04\", \"check\": \"담보제공자의 목적물 사용·처분 제한이 담보 보전에 필요한 범위를 넘어 과도하지 않은가\", \"label\": \"처분 제한 범위 적정성\", \"module\": \"X-SEC\", \"requires_doc_title\": [\"질권\", \"근질권\", \"저당\", \"근저당\", \"양도담보\", \"담보설정\", \"담보 설정\", \"담보권\", \"담보제공\", \"담보 제공\"], \"party_roles\": [\"담보제공자\", \"설정자\", \"질권설정자\", \"채무자\", \"물상보증인\"], \"subject_roles\": [\"설정자\", \"질권설정자\", \"담보제공자\"], \"severity\": \"참고\", \"severity_basis\": \"선언규정 — 민법 제352조(질권설정자의 권리처분제한)가 정하는 범위는 \\\"질권자의 이익을 해하는 변경\\\"까지이며, 그를 넘는 포괄적 제한은 약정 사항이므로 개별 검토\", \"norm_type\": \"선언\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"처분제한\", \"처분 제한\", \"현상변경\", \"현상 변경\", \"사용·수익\", \"사용수익\", \"담보목적물\", \"목적물의 처분\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제352조\", \"clause\": \"\", \"quote\": \"질권설정자는 질권자의 동의없이 질권의 목적된 권리를 소멸하게 하거나 질권자의 이익을 해하는 변경을 할 수 없다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제352조(질권설정자의 권리처분제한)\\n질권설정자는 질권자의 동의없이 질권의 목적된 권리를 소멸하게 하거나 질권자의 이익을 해하는 변경을 할 수 없다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-01\", \"module\": \"X-SUB\", \"check\": \"하도급대금 지급기일이 목적물등의 수령일(용역은 수행 완료일)부터 60일 이내로 정해져 있는가\", \"label\": \"지급기일 60일 이내\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지급기일\", \"60일\", \"대금 지급\", \"하도급대금\", \"지급 기한\"]}, \"auto_clear\": {\"any_groups\": [[\"지급기일\", \"지급 기한\", \"하도급대금\"], [\"60일\", \"육십일\"]]}, \"absence_check\": true, \"tier\": \"conditional\", \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제1항\", \"quote\": \"부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상(원사업자→수급사업자 제조·수리·건설·용역위탁, 사업자 규모 요건 충족)에 해당하는 경우 강행. 일반 매매·비적용 거래에는 임의 조정 가능\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"하도급대금 지급기일은 서면 기재와 지급기한 준수를 함께 확인할 핵심 조건임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제36조제1항 단서\", \"quote\": \"다만, 하도급대금의 지급기일은 용역수행 완료일부터 60일을 초과하지 아니한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-PAY-02\", \"module\": \"X-SUB\", \"check\": \"지급기일 미정 또는 60일 초과 약정 시 수령일 기산 간주 규정과의 정합이 확인되는가\", \"decision_question\": \"하도급대금 지급기일이 법정 간주 규정과 충돌하지 않아 수정이 불필요한가?\", \"pass_guidance\": \"지급기일이 적법하거나 간주 규정 적용이 명확하면 선택\", \"opinion_guidance\": \"지급기일이 없거나 60일을 초과해 보완이 필요하면 선택\", \"label\": \"지급기일 미정·초과 간주\", \"severity\": \"참고\", \"severity_basis\": \"간주규정임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"간주\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지급기일\", \"수령일\", \"지급기일로 본다\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제2항\", \"quote\": \"하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 60일 초과 지급기일 약정은 무효화되고 60일 기산 지급기일로 간주됨\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-03\", \"module\": \"X-SUB\", \"check\": \"발주자로부터 준공금·기성금을 수령한 경우 15일 이내 하도급대금(기성부분 상당액)을 지급하도록 규정되어 있는가\", \"label\": \"준공·기성금 15일 지급\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"준공금\", \"기성금\", \"15일\", \"기성부분\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제3항\", \"quote\": \"그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-04\", \"module\": \"X-SUB\", \"check\": \"원사업자가 발주자로부터 받은 현금비율 미만으로 하도급대금을 지급하지 못하도록 하는 조항이 있는가\", \"label\": \"현금비율 하회 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"현금비율\", \"현금 지급\", \"지급 비율\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제4항\", \"quote\": \"원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제36조제3항\", \"quote\": \"원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 용역수행과 관련하여 받은 현금비율 이상으로 지급한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-PAY-05\", \"module\": \"X-SUB\", \"check\": \"대금을 어음으로 지급하는 경우 발주자로부터 받은 어음 지급기간을 초과하지 않고 할인료를 교부일에 지급하도록 규정되어 있는가\", \"label\": \"어음지급 할인료\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"어음\", \"할인료\", \"어음대체결제\", \"만기\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제6항\", \"quote\": \"어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제5항\", \"quote\": \"발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-06\", \"module\": \"X-SUB\", \"check\": \"목적물 수령일부터 60일 초과 지급 시 공정거래위원회 고시 이율에 따른 지연이자를 지급하도록 규정되어 있는가\", \"label\": \"60일 초과 지연이자\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지연이자\", \"초과기간\", \"공정거래위원회 고시\", \"연체\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조\", \"clause\": \"제8항\", \"quote\": \"그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다\", \"verified\": true, \"text\": \"제13조(하도급대금의 지급 등)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우에는 목적물등의 수령일(건설위탁의 경우에는 인수일을, 용역위탁의 경우에는 수급사업자가 위탁받은 용역의 수행을 마친 날을, 납품등이 잦아 원사업자와 수급사업자가 월 1회 이상 세금계산서의 발행일을 정한 경우에는 그 정한 날을 말한다. 이하 같다)부터 60일 이내의 가능한 짧은 기한으로 정한 지급기일까지 하도급대금을 지급하여야 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다.\\n1.  원사업자와 수급사업자가 대등한 지위에서 지급기일을 정한 것으로 인정되는 경우\\n2.  해당 업종의 특수성과 경제여건에 비추어 그 지급기일이 정당한 것으로 인정되는 경우\\n② 하도급대금의 지급기일이 정하여져 있지 아니한 경우에는 목적물등의 수령일을 하도급대금의 지급기일로 보고, 목적물등의 수령일부터 60일이 지난 후에 하도급대금의 지급기일을 정한 경우(제1항 단서에 해당되는 경우는 제외한다)에는 목적물등의 수령일부터 60일이 되는 날을 하도급대금의 지급기일로 본다.\\n③ 원사업자는 수급사업자에게 제조등의 위탁을 한 경우 원사업자가 발주자로부터 제조ㆍ수리ㆍ시공 또는 용역수행행위의 완료에 따라 준공금 등을 받았을 때에는 하도급대금을, 제조ㆍ수리ㆍ시공 또는 용역수행행위의 진척에 따라 기성금 등을 받았을 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행한 부분에 상당하는 금액을 그 준공금이나 기성금 등을 지급받은 날부터 15일(하도급대금의 지급기일이 그 전에 도래하는 경우에는 그 지급기일) 이내에 수급사업자에게 지급하여야 한다.\\n④ 원사업자가 수급사업자에게 하도급대금을 지급할 때에는 원사업자가 발주자로부터 해당 제조등의 위탁과 관련하여 받은 현금비율 미만으로 지급하여서는 아니 된다.\\n⑤ 원사업자가 하도급대금을 어음으로 지급하는 경우에는 해당 제조등의 위탁과 관련하여 발주자로부터 원사업자가 받은 어음의 지급기간(발행일부터 만기일까지)을 초과하는 어음을 지급하여서는 아니 된다.\\n⑥ 원사업자가 하도급대금을 어음으로 지급하는 경우에 그 어음은 법률에 근거하여 설립된 금융기관에서 할인이 가능한 것이어야 하며, 어음을 교부한 날부터 어음의 만기일까지의 기간에 대한 할인료를 어음을 교부하는 날에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일(제1항 단서에 따라 지급기일이 정하여진 경우에는 그 지급기일을, 발주자로부터 준공금이나 기성금 등을 받은 경우에는 제3항에서 정한 기일을 말한다. 이하 이 조에서 같다) 이내에 어음을 교부하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 어음의 만기일까지의 기간에 대한 할인료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑦ 원사업자는 하도급대금을 어음대체결제수단을 이용하여 지급하는 경우에는 지급일(기업구매전용카드의 경우는 카드결제 승인일을, 외상매출채권 담보대출의 경우는 납품등의 명세 전송일을, 구매론의 경우는 구매자금 결제일을 말한다. 이하 같다)부터 하도급대금 상환기일까지의 기간에 대한 수수료(대출이자를 포함한다. 이하 같다)를 지급일에 수급사업자에게 지급하여야 한다. 다만, 목적물등의 수령일부터 60일 이내에 어음대체결제수단을 이용하여 지급하는 경우에는 목적물등의 수령일부터 60일이 지난 날 이후부터 하도급대금 상환기일까지의 기간에 대한 수수료를 목적물등의 수령일부터 60일 이내에 수급사업자에게 지급하여야 한다.\\n⑧ 원사업자가 하도급대금을 목적물등의 수령일부터 60일이 지난 후에 지급하는 경우에는 그 초과기간에 대하여 연 100분의 40 이내에서 「은행법」에 따른 은행이 적용하는 연체금리 등 경제사정을 고려하여 공정거래위원회가 정하여 고시하는 이율에 따른 이자를 지급하여야 한다.\\n⑨ 제6항에서 적용하는 할인율은 연 100분의 40 이내에서 법률에 근거하여 설립된 금융기관에서 적용되는 상업어음할인율을 고려하여 공정거래위원회가 정하여 고시한다.\\n⑩ 제7항에서 적용하는 수수료율은 원사업자가 금융기관(「여신전문금융업법」 제2조제2호의2에 따른 신용카드업자를 포함한다)과 체결한 어음대체결제수단의 약정상 수수료율로 한다.\\n⑪ 제1항부터 제10항까지의 규정은 「중견기업 성장촉진 및 경쟁력 강화에 관한 특별법」 제2조제1호에 따른 중견기업으로 연간매출액이 대통령령으로 정하는 금액(제1호의 회사와 거래하는 경우에는 3천억원으로 한다) 미만인 중견기업이 다음 각 호의 어느 하나에 해당하는 자로부터 제조등의 위탁을 받은 경우에도 적용한다. 이 경우 제조등의 위탁을 한 자는 제1항부터 제10항까지, 제19조, 제20조, 제23조제2항, 제24조의4제1항, 제24조의5제6항, 제25조제1항 및 제3항, 제25조의2, 제25조의3제1항, 제25조의5제1항, 제26조제2항, 제30조제1항, 제33조, 제35조제1항을 적용할 때에는 원사업자로 보고, 제조등의 위탁을 받은 중견기업은 제1항부터 제10항까지, 제19조, 제21조, 제23조제2항, 제24조의4제1항, 제25조의2, 제33조를 적용할 때에는 수급사업자로 본다.\\n1.  「독점규제 및 공정거래에 관한 법률」 제31조제1항에 따른 상호출자제한기업집단에 속하는 회사\\n2.  제1호에 따른 회사가 아닌 사업자로서 연간매출액이 대통령령으로 정하는 금액을 초과하는 사업자\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 공통 CMN-05-2(일반 지연이자 약정)와 달리 법정 지연이자율(공정위 고시)이 적용됨\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-07\", \"module\": \"X-SUB\", \"check\": \"일률적 단가인하·부당 할당·차별 등 부당한 하도급대금 결정을 금지하는 취지가 계약에 반영되어 있는가\", \"label\": \"부당한 대금결정 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제4조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"단가 인하\", \"부당한 대금\", \"대금 결정\", \"일률적\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제4조\", \"clause\": \"제1항\", \"quote\": \"부당하게 목적물등과 같거나 유사한 것에 대하여 일반적으로 지급되는 대가보다 낮은 수준으로 하도급대금을 결정\", \"verified\": true, \"text\": \"제4조(부당한 하도급대금의 결정 금지)\\n① 원사업자는 수급사업자에게 제조등의 위탁을 하는 경우 부당하게 목적물등과 같거나 유사한 것에 대하여 일반적으로 지급되는 대가보다 낮은 수준으로 하도급대금을 결정(이하 \\\"부당한 하도급대금의 결정\\\"이라 한다)하거나 하도급받도록 강요하여서는 아니 된다.\\n② 다음 각 호의 어느 하나에 해당하는 원사업자의 행위는 부당한 하도급대금의 결정으로 본다.\\n1.  정당한 사유 없이 일률적인 비율로 단가를 인하하여 하도급대금을 결정하는 행위\\n2.  협조요청 등 어떠한 명목으로든 일방적으로 일정 금액을 할당한 후 그 금액을 빼고 하도급대금을 결정하는 행위\\n3.  정당한 사유 없이 특정 수급사업자를 차별 취급하여 하도급대금을 결정하는 행위\\n4.  수급사업자에게 발주량 등 거래조건에 대하여 착오를 일으키게 하거나 다른 사업자의 견적 또는 거짓 견적을 내보이는 등의 방법으로 수급사업자를 속이고 이를 이용하여 하도급대금을 결정하는 행위\\n5.  원사업자가 일방적으로 낮은 단가에 의하여 하도급대금을 결정하는 행위\\n6.  수의계약(隨意契約)으로 하도급계약을 체결할 때 정당한 사유 없이 대통령령으로 정하는 바에 따른 직접공사비 항목의 값을 합한 금액보다 낮은 금액으로 하도급대금을 결정하는 행위\\n7.  경쟁입찰에 의하여 하도급계약을 체결할 때 정당한 사유 없이 최저가로 입찰한 금액보다 낮은 금액으로 하도급대금을 결정하는 행위\\n8.  계속적 거래계약에서 원사업자의 경영적자, 판매가격 인하 등 수급사업자의 책임으로 돌릴 수 없는 사유로 수급사업자에게 불리하게 하도급대금을 결정하는 행위\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 제4조 제2항 각 호(일률 단가인하·부당 할당·차별·기망 등)는 부당대금결정으로 간주됨\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제29조제1항\", \"quote\": \"원사업자는 용역과 같거나 유사한 것에 대해 통상 지급되는 대가보다 낮은 수준으로 대금이 부당하게 결정되도록 수급사업자에게 강요하지 아니 한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-PAY-08\", \"module\": \"X-SUB\", \"check\": \"설계변경·목적물 시기변동·경제상황 변동으로 발주자로부터 증액받은 경우 그 내용·비율에 따라 하도급대금을 증액하도록 규정되어 있는가\", \"label\": \"설계변경 대금증액\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제16조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"설계변경\", \"대금 조정\", \"증액\", \"계약금액 변경\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제16조\", \"clause\": \"제1항\", \"quote\": \"그가 발주자로부터 증액받은 계약금액의 내용과 비율에 따라 하도급대금을 증액하여야 한다\", \"verified\": true, \"text\": \"제16조(설계변경 등에 따른 하도급대금의 조정)\\n① 원사업자는 제조등의 위탁을 한 후에 다음 각 호의 경우에 모두 해당하는 때에는 그가 발주자로부터 증액받은 계약금액의 내용과 비율에 따라 하도급대금을 증액하여야 한다. 다만, 원사업자가 발주자로부터 계약금액을 감액받은 경우에는 그 내용과 비율에 따라 하도급대금을 감액할 수 있다.\\n1.  설계변경, 목적물등의 납품등 시기의 변동 또는 경제상황의 변동 등을 이유로 계약금액이 증액되는 경우\\n2.  제1호와 같은 이유로 목적물등의 완성 또는 완료에 추가비용이 들 경우\\n② 제1항에 따라 하도급대금을 증액 또는 감액할 경우, 원사업자는 발주자로부터 계약금액을 증액 또는 감액받은 날부터 15일 이내에 발주자로부터 증액 또는 감액받은 사유와 내용을 해당 수급사업자에게 통지하여야 한다. 다만, 발주자가 그 사유와 내용을 해당 수급사업자에게 직접 통지한 경우에는 그러하지 아니하다.\\n③ 제1항에 따른 하도급대금의 증액 또는 감액은 원사업자가 발주자로부터 계약금액을 증액 또는 감액받은 날부터 30일 이내에 하여야 한다.\\n④ 원사업자가 제1항의 계약금액 증액에 따라 발주자로부터 추가금액을 지급받은 날부터 15일이 지난 후에 추가 하도급대금을 지급하는 경우의 이자에 관하여는 제13조제8항을 준용하고, 추가 하도급대금을 어음 또는 어음대체결제수단을 이용하여 지급하는 경우의 어음할인료ㆍ수수료의 지급 및 어음할인율ㆍ수수료율에 관하여는 제13조제6항ㆍ제7항ㆍ제9항 및 제10항을 준용한다. 이 경우 \\\"목적물등의 수령일부터 60일\\\"은 \\\"추가금액을 받은 날부터 15일\\\"로 본다.\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 감액받은 경우 그 내용·비율에 따라 감액 가능(제16조 제1항 단서)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제31조제1항 본문\", \"quote\": \"원사업자는 용역수행을 위탁 후 다음 각 호의 경우에 모두 해당하는 때에는 그가 발주자로부터 증액 받은 계약금액의 내용과 비율에 따라 대금을 증액한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-PAY-09\", \"module\": \"X-SUB\", \"check\": \"건설위탁의 경우 계약체결일부터 30일 이내 공사대금 지급보증을 하도록 규정되어 있는가(면제사유 해당 시 제외)\", \"label\": \"공사대금 지급보증\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제13조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지급보증\", \"공사대금\", \"계약이행 보증\", \"건설위탁\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제13조의2\", \"clause\": \"제1항\", \"quote\": \"건설위탁의 경우 원사업자는 계약체결일부터 30일 이내에 수급사업자에게 다음 각 호의 구분에 따라 해당 금액의 공사대금 지급을 보증\", \"verified\": true, \"text\": \"제13조의2(건설하도급 계약이행 및 대금지급 보증)\\n① 건설위탁의 경우 원사업자는 계약체결일부터 30일 이내에 수급사업자에게 다음 각 호의 구분에 따라 해당 금액의 공사대금 지급을 보증(지급수단이 어음인 경우에는 만기일까지를, 어음대체결제수단인 경우에는 하도급대금 상환기일까지를 보증기간으로 한다)하고, 수급사업자는 원사업자에게 계약금액의 100분의 10에 해당하는 금액의 계약이행을 보증하여야 한다. 다만, 원사업자의 재무구조와 공사의 규모 등을 고려하여 보증이 필요하지 아니하거나 보증이 적합하지 아니하다고 인정되는 경우로서 대통령령으로 정하는 경우에는 그러하지 아니하다.\\n1.  공사기간이 4개월 이하인 경우: 계약금액에서 선급금을 뺀 금액\\n2.  공사기간이 4개월을 초과하는 경우로서 기성부분에 대한 대가의 지급 주기가 2개월 이내인 경우: 보증금액 = (하도급계약금액 - 계약상 선급금) ÷ 공사기간(개월 수) × 4\\n3.  공사기간이 4개월을 초과하는 경우로서 기성부분에 대한 대가의 지급 주기가 2개월을 초과하는 경우: 보증금액 = (하도급계약금액 - 계약상 선급금) ÷ 공사기간(개월 수) × 기성부분에 대한 대가의 지급주기(개월수) × 2\\n② 원사업자는 제1항 각 호 외의 부분 단서에 따른 공사대금 지급의 보증이 필요하지 아니하거나 적합하지 아니하다고 인정된 사유가 소멸한 경우에는 그 사유가 소멸한 날부터 30일 이내에 제1항에 따른 공사대금 지급보증을 하여야 한다. 다만, 계약의 잔여기간, 위탁사무의 기성률, 잔여대금의 금액 등을 고려하여 보증이 필요하지 아니하다고 인정되는 경우로서 대통령령으로 정하는 경우에는 그러하지 아니하다.\\n③ 다음 각 호의 어느 하나에 해당하는 자와 건설공사에 관하여 장기계속계약(총액으로 입찰하여 각 회계연도 예산의 범위에서 낙찰된 금액의 일부에 대하여 연차별로 계약을 체결하는 계약으로서 「국가를 당사자로 하는 계약에 관한 법률」 제21조 또는 「지방자치단체를 당사자로 하는 계약에 관한 법률」 제24조에 따른 장기계속계약을 말한다. 이하 이 조에서 \\\"장기계속건설계약\\\"이라 한다)을 체결한 원사업자가 해당 건설공사를 장기계속건설하도급계약을 통하여 건설위탁하는 경우 원사업자는 최초의 장기계속건설하도급계약 체결일부터 30일 이내에 수급사업자에게 제1항 각 호 외의 부분 본문에 따라 공사대금 지급을 보증하고, 수급사업자는 원사업자에게 최초 장기계속건설하도급계약 시 약정한 총 공사금액의 100분의 10에 해당하는 금액으로 계약이행을 보증하여야 한다.\\n1.  국가 또는 지방자치단체\\n2.  「공공기관의 운영에 관한 법률」에 따른 공기업, 준정부기관 또는 「지방공기업법」에 따른 지방공사, 지방공단\\n④ 제3항에 따라 수급사업자로부터 계약이행 보증을 받은 원사업자는 장기계속건설계약의 연차별 계약의 이행이 완료되어 이에 해당하는 계약보증금을 같은 항 각 호의 어느 하나에 해당하는 자로부터 반환받을 수 있는 날부터 30일 이내에 수급사업자에게 해당 수급사업자가 이행을 완료한 연차별 장기계속건설하도급계약에 해당하는 하도급 계약이행보증금을 반환하여야 한다. 이 경우 이행이 완료된 부분에 해당하는 계약이행 보증의 효력은 상실되는 것으로 본다.\\n⑤ 제1항부터 제3항까지의 규정에 따른 원사업자와 수급사업자 간의 보증은 현금(체신관서 또는 「은행법」에 따른 은행이 발행한 자기앞수표를 포함한다)의 지급 또는 다음 각 호의 어느 하나의 기관이 발행하는 보증서의 교부에 의하여 한다.\\n1.  「건설산업기본법」에 따른 각 공제조합\\n2.  「보험업법」에 따른 보험회사\\n3.  「신용보증기금법」에 따른 신용보증기금\\n4.  「은행법」에 따른 금융기관\\n5.  그 밖에 대통령령으로 정하는 보증기관\\n⑥ 제5항에 따른 기관은 다음 각 호의 어느 하나에 해당하는 사유로 수급사업자가 보증약관상 필요한 청구서류를 갖추어 보증금 지급을 요청한 경우 30일 이내에 제1항의 보증금액을 수급사업자에게 지급하여야 한다. 다만, 보증금 지급요건 충족 여부, 지급액에 대한 이견 등 대통령령으로 정하는 불가피한 사유가 있는 경우 보증기관은 수급사업자에게 통지하고 대통령령으로 정하는 기간 동안 보증금 지급을 보류할 수 있다.\\n1.  원사업자가 당좌거래정지 또는 금융거래정지로 하도급대금을 지급할 수 없는 경우\\n2.  원사업자의 부도ㆍ파산ㆍ폐업 또는 회사회생절차 개시 신청 등으로 하도급대금을 지급할 수 없는 경우\\n3.  원사업자의 해당 사업에 관한 면허ㆍ등록 등이 취소ㆍ말소되거나 영업정지 등으로 하도급대금을 지급할 수 없는 경우\\n4.  원사업자가 제13조에 따라 지급하여야 할 하도급대금을 2회 이상 수급사업자에게 지급하지 아니한 경우\\n5.  그 밖에 원사업자가 제1호부터 제4호까지에 준하는 지급불능 등 대통령령으로 정하는 사유로 인하여 하도급대금을 지급할 수 없는 경우\\n⑦ 원사업자는 제5항에 따라 지급보증서를 교부할 때 그 공사기간 중에 건설위탁하는 모든 공사에 대한 공사대금의 지급보증이나 1회계연도에 건설위탁하는 모든 공사에 대한 공사대금의 지급보증을 하나의 지급보증서의 교부에 의하여 할 수 있다.\\n⑧ 제1항부터 제7항까지에서 규정한 것 외에 하도급계약 이행보증 및 하도급대금 지급보증에 관하여 필요한 사항은 대통령령으로 정한다.\\n⑨ 원사업자가 제1항 각 호 외의 부분 본문, 제2항 본문 또는 제3항 각 호 외의 부분에 따른 공사대금 지급보증을 하지 아니하는 경우에는 수급사업자는 계약이행을 보증하지 아니할 수 있다.\\n⑩ 제1항 또는 제3항에 따른 수급사업자의 계약이행 보증에 대한 원사업자의 청구권은 해당 원사업자가 제1항부터 제3항까지의 규정에 따른 공사대금 지급을 보증한 후가 아니면 이를 행사할 수 없다. 다만, 제1항 각 호 외의 부분 단서 또는 제2항 단서에 따라 공사대금 지급을 보증하지 아니하는 경우에는 그러하지 아니하다.\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률 시행령\", \"article\": \"제8조\", \"clause\": \"제1항 제1호\", \"quote\": \"원사업자가 수급사업자에게 건설위탁을 하는 경우로서 1건 공사의 공사금액이 1천만원 이하인 경우\", \"verified\": true, \"text\": \"제8조(건설하도급 계약이행 및 대금지급 보증)\\n① 법 제13조의2제1항 각 호 외의 부분 단서에서 \\\"대통령령으로 정하는 경우\\\"란 다음 각 호의 어느 하나에 해당하는 경우를 말한다.\\n1.  원사업자가 수급사업자에게 건설위탁을 하는 경우로서 1건 공사의 공사금액이 1천만원 이하인 경우\\n2.  삭제\\n3.  하도급계약 체결일부터 30일 이내에 법 제14조제1항제2호에 따른 합의를 한 경우\\n4.  하도급대금의 지급을 전자적으로 관리하기 위하여 운영되고 있는 시스템(이하 \\\"하도급대금지급관리시스템\\\"이라 한다)을 활용하여 발주자가 원사업자 명의의 계좌를 거치지 아니하고 수급사업자에게 하도급대금을 지급하는 경우\\n② 법 제13조의2제5항제5호에서 \\\"대통령령으로 정하는 보증기관\\\"이란 다음 각 호의 자를 말한다.\\n1.  「전기공사공제조합법」에 따른 전기공사공제조합\\n2.  「정보통신공사업법」에 따른 정보통신공제조합\\n3.  「주택도시기금법」에 따른 주택도시보증공사\\n4.  「소방산업의 진흥에 관한 법률」에 따른 소방산업공제조합\\n5.  그 밖에 다른 법령에 따라 보증업무를 담당할 수 있는 기관 중에서 공정거래위원회가 정하여 고시하는 기관\\n③ 법 제13조의2제6항 각 호 외의 부분 단서에서 \\\"보증금 지급요건 충족 여부, 지급액에 대한 이견 등 대통령령으로 정하는 불가피한 사유가 있는 경우\\\"란 다음 각 호의 어느 하나에 해당하는 경우를 말한다.\\n1.  보증기간 동안의 원사업자 및 수급사업자의 계약이행 여부가 불명확하여 자료보완이 필요하다고 인정하는 경우\\n2.  지급하여야 할 기성금(명칭을 불문하고 계약이행에 따른 대가로 지급되는 것을 말한다)에 대하여 원사업자와 수급사업자 사이에 이견이 있는 경우\\n④ 법 제13조의2제6항 각 호 외의 부분 단서에서 \\\"대통령령으로 정하는 기간\\\"이란 30일을 말한다. 다만, 수급사업자와 합의한 경우 15일의 범위에서 한 차례만 그 기간을 연장할 수 있다.\\n⑤ 법 제13조의2제6항제5호에서 \\\"제1호부터 제4호까지에 준하는 지급불능 등 대통령령으로 정하는 사유로 인하여 하도급대금을 지급할 수 없는 경우\\\"란 다음 각 호의 어느 하나에 해당하여 하도급대금을 지급할 수 없는 경우를 말한다.\\n1.  원사업자가 「기업구조조정 촉진법」 제5조제2항에 따라 관리절차의 개시를 신청한 경우\\n2.  발주자에 대한 원사업자의 공사대금채권에 대하여 제3채권자가 압류ㆍ가압류를 하였거나 원사업자가 해당 공사대금채권을 제3자에게 양도한 경우\\n3.  법 제2조제14항에 따른 신용카드업자 또는 금융기관이 수급사업자에게 상환청구를 할 수 있는 어음대체결제수단으로 하도급대금을 지급한 후 원사업자가 해당 신용카드업자 또는 금융기관에 하도급대금을 결제하지 아니한 경우\\n4.  원사업자가 수급사업자에게 하도급대금으로 지급한 어음이 부도로 처리된 경우\\n5.  원사업자가 수급사업자로부터 지급기일 이후 2회 이상 하도급대금 지급에 관한 최고를 받고도 이를 이행하지 아니한 경우\\n⑥ 제1항제4호에 따라 대금지급 보증의무 면제대상이 되는 하도급대금지급관리시스템의 종류는 공정거래위원회가 정하여 고시한다.\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 중 건설위탁에 한함. 보증 면제사유(공사금액 1천만원 이하 등)의 실체는 시행령 제8조에 위임됨\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-PAY-10\", \"module\": \"X-SUB\", \"check\": \"원사업자 지급불능·2회분 이상 미지급 등 사유 발생 시 발주자의 하도급대금 직접지급 요건·효과 조항이 있는가\", \"label\": \"발주자 직접지급\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제14조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"직접 지급\", \"직접지급\", \"발주자\", \"지급정지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제14조\", \"clause\": \"제1항\", \"quote\": \"수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행을 한 부분에 상당하는 하도급대금을 그 수급사업자에게 직접 지급하여야 한다\", \"verified\": true, \"text\": \"제14조(하도급대금의 직접 지급)\\n① 발주자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 때에는 수급사업자가 제조ㆍ수리ㆍ시공 또는 용역수행을 한 부분에 상당하는 하도급대금을 그 수급사업자에게 직접 지급하여야 한다.\\n1.  원사업자의 지급정지ㆍ파산, 그 밖에 이와 유사한 사유가 있거나 사업에 관한 허가ㆍ인가ㆍ면허ㆍ등록 등이 취소되어 원사업자가 하도급대금을 지급할 수 없게 된 경우로서 수급사업자가 하도급대금의 직접 지급을 요청한 때\\n2.  발주자가 하도급대금을 직접 수급사업자에게 지급하기로 발주자ㆍ원사업자 및 수급사업자 간에 합의한 때\\n3.  원사업자가 제13조제1항 또는 제3항에 따라 지급하여야 하는 하도급대금의 2회분 이상을 해당 수급사업자에게 지급하지 아니한 경우로서 수급사업자가 하도급대금의 직접 지급을 요청한 때\\n4.  원사업자가 제13조의2제1항 또는 제2항에 따른 하도급대금 지급보증 의무를 이행하지 아니한 경우로서 수급사업자가 하도급대금의 직접 지급을 요청한 때\\n② 제1항에 따른 사유가 발생한 경우 원사업자에 대한 발주자의 대금지급채무와 수급사업자에 대한 원사업자의 하도급대금 지급채무는 그 범위에서 소멸한 것으로 본다.\\n③ 원사업자가 발주자에게 해당 하도급 계약과 관련된 수급사업자의 임금, 자재대금 등의 지급 지체 사실(원사업자의 귀책사유로 그 지급 지체가 발생한 경우는 제외한다)을 입증할 수 있는 서류를 첨부하여 해당 하도급대금의 직접 지급 중지를 요청한 경우, 발주자는 제1항에도 불구하고 그 하도급대금을 직접 지급하여서는 아니 된다.\\n④ 제1항에 따라 발주자가 해당 수급사업자에게 하도급대금을 직접 지급할 때에 발주자가 원사업자에게 이미 지급한 하도급금액은 빼고 지급한다.\\n⑤ 제1항에 따라 수급사업자가 발주자로부터 하도급대금을 직접 받기 위하여 기성부분의 확인 등이 필요한 경우 원사업자는 지체 없이 이에 필요한 조치를 이행하여야 한다.\\n⑥ 제1항에 따라 하도급대금을 직접 지급하는 경우의 지급 방법 및 절차 등에 관하여 필요한 사항은 대통령령으로 정한다.\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률 시행령\", \"article\": \"제9조\", \"clause\": \"제3항\", \"quote\": \"발주자는 원사업자에 대한 대금지급의무의 범위에서 하도급대금 직접 지급 의무를 부담한다\", \"verified\": true, \"text\": \"제9조(하도급대금의 직접 지급)\\n① 법 제14조제1항에 따른 수급사업자의 직접지급 요청은 그 의사표시가 발주자에게 도달한 때부터 효력이 발생하며, 그 의사표시가 도달되었다는 사실은 수급사업자가 증명하여야 한다.\\n② 발주자는 하도급대금을 직접 지급할 때에 「민사집행법」 제248조제1항 등의 공탁사유가 있는 경우에는 해당 법령에 따라 공탁(供託)할 수 있다.\\n③ 발주자는 원사업자에 대한 대금지급의무의 범위에서 하도급대금 직접 지급 의무를 부담한다.\\n④ 하도급대금의 직접 지급 요건을 갖추고, 그 수급사업자가 제조ㆍ수리ㆍ시공한 분(分)에 대한 하도급대금이 확정된 경우, 발주자는 도급계약의 내용에 따라 수급사업자에게 하도급대금을 지급하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 직접지급 의무의 범위·절차 실체는 시행령 제9조에 위임됨(원사업자 대금지급채무는 그 범위에서 소멸 — 제14조 제2항)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제37조제1항 본문\", \"quote\": \"발주자는 다음 각 호의 어느 하나에 해당하는 사유가 발생한 경우에 수급사업자가 수행한 부분에 해당하는 하도급대금을 수급사업자에게 직접 지급한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-PAY-11\", \"module\": \"X-SUB\", \"check\": \"주요 원재료가 있는 하도급 거래에서 연동 조항(연동표) 또는 미연동 합의(취지·사유 서면 명기) 중 하나가 있는가\", \"label\": \"하도급대금 연동제\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무·금지)임 — 하도급거래 공정화에 관한 법률 제3조(연동 사항 기재의무·미연동 합의 서면 명기·탈법행위 금지, 2023년 신설 연동제)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"연동\", \"연동표\", \"미연동\"]}, \"absence_check\": true, \"tier\": \"conditional\", \"absence_precondition\": [\"주요 원재료\", \"원자재\"], \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조\", \"clause\": \"제2항 제3호\", \"quote\": \"주요 원재료, 조정요건, 기준 지표 및 산식 등 하도급대금 연동에 관한 사항\", \"verified\": false, \"text\": \"제3조(서면의 발급 및 서류의 보존)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우 및 제조등의 위탁을 한 이후에 해당 계약내역에 없는 제조등의 위탁 또는 계약내역을 변경하는 위탁(이하 이 항에서 \\\"추가ㆍ변경위탁\\\"이라 한다)을 하는 경우에는 제2항의 사항을 적은 서면(「전자문서 및 전자거래 기본법」 제2조제1호에 따른 전자문서를 포함한다. 이하 이 조에서 같다)을 다음 각 호의 구분에 따른 기한까지 수급사업자에게 발급하여야 한다.\\n1. 제조위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 물품 납품을 위한 작업을 시작하기 전\\n2. 수리위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 수리행위를 시작하기 전\\n3. 건설위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 계약공사를 착공하기 전\\n4. 용역위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 용역수행행위를 시작하기 전\\n② 제1항의 서면에는 다음 각 호의 사항을 적고 원사업자와 수급사업자가 서명[「전자서명법」 제2조제2호에 따른 전자서명(서명자의 실지명의를 확인할 수 있는 것을 말한다)을 포함한다. 이하 이 조에서 같다] 또는 기명날인하여야 한다.\\n1. 하도급대금과 그 지급방법 등 하도급계약의 내용\\n2. 제16조의2제1항에 따른 하도급대금의 조정요건, 방법 및 절차\\n3. 하도급대금 연동의 대상 목적물등의 명칭, 주요 원재료, 조정요건, 기준 지표 및 산식 등 하도급대금 연동에 관한 사항으로서 대통령령으로 정하는 사항\\n4. 그 밖에 서면에 적어야 할 사항으로서 대통령령으로 정하는 사항\\n③ 원사업자는 제2항제3호에 따른 사항을 적을 때 수급사업자의 이익에 반하는 불공정한 내용이 되지 아니하도록 수급사업자와 성실히 협의하여야 한다.\\n④ 다음 각 호의 어느 하나에 해당하는 경우에는 원사업자는 서면에 제2항제3호에 따른 사항을 적지 아니할 수 있다. 다만, 제4호의 경우에는 원사업자와 수급사업자가 그 취지와 사유를 서면에 분명하게 적어야 한다.\\n1. 원사업자가 「중소기업기본법」 제2조제2항에 따른 소기업에 해당하는 경우\\n2. 하도급거래 기간이 90일 이내의 범위에서 대통령령으로 정하는 기간 이내인 경우\\n3. 하도급대금이 1억 원 이하의 범위에서 대통령령으로 정하는 금액 이하인 경우\\n4. 원사업자와 수급사업자가 하도급대금 연동을 하지 아니하기로 합의한 경우\\n⑤ 원사업자는 하도급대금 연동과 관련하여 하도급거래에 관한 거래상 지위를 남용하거나 거짓 또는 그 밖의 부정한 방법으로 이 조의 적용을 피하려는 행위를 하여서는 아니 된다.\\n⑥ 원사업자는 제2항에도 불구하고 위탁시점에 확정하기 곤란한 사항에 대하여는 재해ㆍ사고로 인한 긴급복구공사를 하는 경우 등 정당한 사유가 있는 경우에는 해당 사항을 적지 아니한 서면을 발급할 수 있다. 이 경우 해당 사항이 정하여지지 아니한 이유와 그 사항을 정하게 되는 예정기일을 서면에 적어야 한다.\\n⑦ 원사업자는 제6항에 따라 일부 사항을 적지 아니한 서면을 발급한 경우에는 해당 사항이 확정되는 때에 지체 없이 그 사항을 적은 새로운 서면을 발급하여야 한다.\\n⑧ 원사업자가 제조등의 위탁을 하면서 제2항의 사항을 적은 서면(제6항에 따라 일부 사항을 적지 아니한 서면을 포함한다)을 발급하지 아니한 경우에는 수급사업자는 위탁받은 작업의 내용, 하도급대금 등 대통령령으로 정하는 사항을 원사업자에게 서면으로 통지하여 위탁내용의 확인을 요청할 수 있다.\\n⑨ 원사업자는 제8항의 통지를 받은 날부터 15일 이내에 그 내용에 대한 인정 또는 부인(否認)의 의사를 수급사업자에게 서면으로 회신을 발송하여야 하며, 이 기간 내에 회신을 발송하지 아니한 경우에는 원래 수급사업자가 통지한 내용대로 위탁이 있었던 것으로 추정한다. 다만, 천재나 그 밖의 사변으로 회신이 불가능한 경우에는 그러하지 아니하다.\\n⑩ 제8항의 통지에는 수급사업자가, 제9항의 회신에는 원사업자가  서명 또는 기명날인하여야 한다.\\n⑪ 제8항의 통지 및 제9항의 회신과 관련하여 필요한 사항은 대통령령으로 정한다.\\n⑫ 원사업자와 수급사업자는 대통령령으로 정하는 바에 따라 하도급거래에 관한 서류를 보존하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조\", \"clause\": \"제4항\", \"verified\": false, \"text\": \"제3조(서면의 발급 및 서류의 보존)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우 및 제조등의 위탁을 한 이후에 해당 계약내역에 없는 제조등의 위탁 또는 계약내역을 변경하는 위탁(이하 이 항에서 \\\"추가ㆍ변경위탁\\\"이라 한다)을 하는 경우에는 제2항의 사항을 적은 서면(「전자문서 및 전자거래 기본법」 제2조제1호에 따른 전자문서를 포함한다. 이하 이 조에서 같다)을 다음 각 호의 구분에 따른 기한까지 수급사업자에게 발급하여야 한다.\\n1. 제조위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 물품 납품을 위한 작업을 시작하기 전\\n2. 수리위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 수리행위를 시작하기 전\\n3. 건설위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 계약공사를 착공하기 전\\n4. 용역위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 용역수행행위를 시작하기 전\\n② 제1항의 서면에는 다음 각 호의 사항을 적고 원사업자와 수급사업자가 서명[「전자서명법」 제2조제2호에 따른 전자서명(서명자의 실지명의를 확인할 수 있는 것을 말한다)을 포함한다. 이하 이 조에서 같다] 또는 기명날인하여야 한다.\\n1. 하도급대금과 그 지급방법 등 하도급계약의 내용\\n2. 제16조의2제1항에 따른 하도급대금의 조정요건, 방법 및 절차\\n3. 하도급대금 연동의 대상 목적물등의 명칭, 주요 원재료, 조정요건, 기준 지표 및 산식 등 하도급대금 연동에 관한 사항으로서 대통령령으로 정하는 사항\\n4. 그 밖에 서면에 적어야 할 사항으로서 대통령령으로 정하는 사항\\n③ 원사업자는 제2항제3호에 따른 사항을 적을 때 수급사업자의 이익에 반하는 불공정한 내용이 되지 아니하도록 수급사업자와 성실히 협의하여야 한다.\\n④ 다음 각 호의 어느 하나에 해당하는 경우에는 원사업자는 서면에 제2항제3호에 따른 사항을 적지 아니할 수 있다. 다만, 제4호의 경우에는 원사업자와 수급사업자가 그 취지와 사유를 서면에 분명하게 적어야 한다.\\n1. 원사업자가 「중소기업기본법」 제2조제2항에 따른 소기업에 해당하는 경우\\n2. 하도급거래 기간이 90일 이내의 범위에서 대통령령으로 정하는 기간 이내인 경우\\n3. 하도급대금이 1억 원 이하의 범위에서 대통령령으로 정하는 금액 이하인 경우\\n4. 원사업자와 수급사업자가 하도급대금 연동을 하지 아니하기로 합의한 경우\\n⑤ 원사업자는 하도급대금 연동과 관련하여 하도급거래에 관한 거래상 지위를 남용하거나 거짓 또는 그 밖의 부정한 방법으로 이 조의 적용을 피하려는 행위를 하여서는 아니 된다.\\n⑥ 원사업자는 제2항에도 불구하고 위탁시점에 확정하기 곤란한 사항에 대하여는 재해ㆍ사고로 인한 긴급복구공사를 하는 경우 등 정당한 사유가 있는 경우에는 해당 사항을 적지 아니한 서면을 발급할 수 있다. 이 경우 해당 사항이 정하여지지 아니한 이유와 그 사항을 정하게 되는 예정기일을 서면에 적어야 한다.\\n⑦ 원사업자는 제6항에 따라 일부 사항을 적지 아니한 서면을 발급한 경우에는 해당 사항이 확정되는 때에 지체 없이 그 사항을 적은 새로운 서면을 발급하여야 한다.\\n⑧ 원사업자가 제조등의 위탁을 하면서 제2항의 사항을 적은 서면(제6항에 따라 일부 사항을 적지 아니한 서면을 포함한다)을 발급하지 아니한 경우에는 수급사업자는 위탁받은 작업의 내용, 하도급대금 등 대통령령으로 정하는 사항을 원사업자에게 서면으로 통지하여 위탁내용의 확인을 요청할 수 있다.\\n⑨ 원사업자는 제8항의 통지를 받은 날부터 15일 이내에 그 내용에 대한 인정 또는 부인(否認)의 의사를 수급사업자에게 서면으로 회신을 발송하여야 하며, 이 기간 내에 회신을 발송하지 아니한 경우에는 원래 수급사업자가 통지한 내용대로 위탁이 있었던 것으로 추정한다. 다만, 천재나 그 밖의 사변으로 회신이 불가능한 경우에는 그러하지 아니하다.\\n⑩ 제8항의 통지에는 수급사업자가, 제9항의 회신에는 원사업자가  서명 또는 기명날인하여야 한다.\\n⑪ 제8항의 통지 및 제9항의 회신과 관련하여 필요한 사항은 대통령령으로 정한다.\\n⑫ 원사업자와 수급사업자는 대통령령으로 정하는 바에 따라 하도급거래에 관한 서류를 보존하여야 한다.\", \"status\": \"no_quote\"}, {\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조\", \"clause\": \"제5항\", \"verified\": false, \"text\": \"제3조(서면의 발급 및 서류의 보존)\\n① 원사업자가 수급사업자에게 제조등의 위탁을 하는 경우 및 제조등의 위탁을 한 이후에 해당 계약내역에 없는 제조등의 위탁 또는 계약내역을 변경하는 위탁(이하 이 항에서 \\\"추가ㆍ변경위탁\\\"이라 한다)을 하는 경우에는 제2항의 사항을 적은 서면(「전자문서 및 전자거래 기본법」 제2조제1호에 따른 전자문서를 포함한다. 이하 이 조에서 같다)을 다음 각 호의 구분에 따른 기한까지 수급사업자에게 발급하여야 한다.\\n1. 제조위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 물품 납품을 위한 작업을 시작하기 전\\n2. 수리위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 수리행위를 시작하기 전\\n3. 건설위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 계약공사를 착공하기 전\\n4. 용역위탁의 경우: 수급사업자가 제조등의 위탁 및 추가ㆍ변경위탁에 따른 용역수행행위를 시작하기 전\\n② 제1항의 서면에는 다음 각 호의 사항을 적고 원사업자와 수급사업자가 서명[「전자서명법」 제2조제2호에 따른 전자서명(서명자의 실지명의를 확인할 수 있는 것을 말한다)을 포함한다. 이하 이 조에서 같다] 또는 기명날인하여야 한다.\\n1. 하도급대금과 그 지급방법 등 하도급계약의 내용\\n2. 제16조의2제1항에 따른 하도급대금의 조정요건, 방법 및 절차\\n3. 하도급대금 연동의 대상 목적물등의 명칭, 주요 원재료, 조정요건, 기준 지표 및 산식 등 하도급대금 연동에 관한 사항으로서 대통령령으로 정하는 사항\\n4. 그 밖에 서면에 적어야 할 사항으로서 대통령령으로 정하는 사항\\n③ 원사업자는 제2항제3호에 따른 사항을 적을 때 수급사업자의 이익에 반하는 불공정한 내용이 되지 아니하도록 수급사업자와 성실히 협의하여야 한다.\\n④ 다음 각 호의 어느 하나에 해당하는 경우에는 원사업자는 서면에 제2항제3호에 따른 사항을 적지 아니할 수 있다. 다만, 제4호의 경우에는 원사업자와 수급사업자가 그 취지와 사유를 서면에 분명하게 적어야 한다.\\n1. 원사업자가 「중소기업기본법」 제2조제2항에 따른 소기업에 해당하는 경우\\n2. 하도급거래 기간이 90일 이내의 범위에서 대통령령으로 정하는 기간 이내인 경우\\n3. 하도급대금이 1억 원 이하의 범위에서 대통령령으로 정하는 금액 이하인 경우\\n4. 원사업자와 수급사업자가 하도급대금 연동을 하지 아니하기로 합의한 경우\\n⑤ 원사업자는 하도급대금 연동과 관련하여 하도급거래에 관한 거래상 지위를 남용하거나 거짓 또는 그 밖의 부정한 방법으로 이 조의 적용을 피하려는 행위를 하여서는 아니 된다.\\n⑥ 원사업자는 제2항에도 불구하고 위탁시점에 확정하기 곤란한 사항에 대하여는 재해ㆍ사고로 인한 긴급복구공사를 하는 경우 등 정당한 사유가 있는 경우에는 해당 사항을 적지 아니한 서면을 발급할 수 있다. 이 경우 해당 사항이 정하여지지 아니한 이유와 그 사항을 정하게 되는 예정기일을 서면에 적어야 한다.\\n⑦ 원사업자는 제6항에 따라 일부 사항을 적지 아니한 서면을 발급한 경우에는 해당 사항이 확정되는 때에 지체 없이 그 사항을 적은 새로운 서면을 발급하여야 한다.\\n⑧ 원사업자가 제조등의 위탁을 하면서 제2항의 사항을 적은 서면(제6항에 따라 일부 사항을 적지 아니한 서면을 포함한다)을 발급하지 아니한 경우에는 수급사업자는 위탁받은 작업의 내용, 하도급대금 등 대통령령으로 정하는 사항을 원사업자에게 서면으로 통지하여 위탁내용의 확인을 요청할 수 있다.\\n⑨ 원사업자는 제8항의 통지를 받은 날부터 15일 이내에 그 내용에 대한 인정 또는 부인(否認)의 의사를 수급사업자에게 서면으로 회신을 발송하여야 하며, 이 기간 내에 회신을 발송하지 아니한 경우에는 원래 수급사업자가 통지한 내용대로 위탁이 있었던 것으로 추정한다. 다만, 천재나 그 밖의 사변으로 회신이 불가능한 경우에는 그러하지 아니하다.\\n⑩ 제8항의 통지에는 수급사업자가, 제9항의 회신에는 원사업자가  서명 또는 기명날인하여야 한다.\\n⑪ 제8항의 통지 및 제9항의 회신과 관련하여 필요한 사항은 대통령령으로 정한다.\\n⑫ 원사업자와 수급사업자는 대통령령으로 정하는 바에 따라 하도급거래에 관한 서류를 보존하여야 한다.\", \"status\": \"no_quote\"}], \"note\": \"하도급법 적용대상 해당 시. 연동 기재의무의 예외(제3조 제4항) — 소기업 원사업자·단기(90일 이내 대통령령 기간)·소액(1억원 이하 대통령령 금액)·미연동 합의. 다만 미연동 합의(제4호)는 그 취지와 사유를 서면에 분명하게 적어야 유효하므로 check는 \\\"연동 조항 또는 미연동 합의 중 하나\\\"를 봄\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"연동 또는 미연동 합의는 해당 거래의 서면에 구체화할 사항임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제33조제1항 본문\", \"quote\": \"원사업자와 수급사업자는 다음 각 호의 어느 하나에 해당하는 경우를 제외하고, 주요 원재료에 대해 하도급대금 연동을 한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}, {\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제33조제4항\", \"quote\": \"제1항 제4호에 따라 하도급대금 연동을 하지 않은 경우, 원사업자와 수급사업자는 그 취지와 사유를 계약서에 분명하게 적어야 한다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}]}, \"types\": [{\"meta\": {\"type_id\": \"alliance\", \"type_name\": \"제휴·업무협약\", \"detect_keywords\": [\"제휴\", \"업무협약\", \"협약서\", \"MOU\", \"양해각서\", \"공동개발\", \"공동사업\", \"공동마케팅\", \"상품제공\", \"위탁판매\", \"멤버십\", \"파트너십\", \"재보험\", \"출재\", \"후원\", \"후원계약\", \"후원약정\"], \"modules\": [{\"id\": \"M-CORE\", \"name\": \"제휴 공통\", \"always_on\": true, \"screening_question\": \"둘 이상의 사업자 간 제휴·협력을 내용으로 하는가?\", \"suggest_keywords\": [\"제휴\", \"협약\", \"공동\"]}]}, \"checks\": [{\"id\": \"ALL-CORE-01\", \"check\": \"제휴 당사자의 역할·분담과 협력 범위가 구체적으로 특정되어 있는가\", \"label\": \"제휴 역할·범위 특정\", \"module\": \"M-CORE\", \"severity\": \"참고\", \"severity_basis\": \"실무 항목 — 법령상 강제 아님, 제휴 실효성·분쟁예방 차원\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"역할\", \"분담\", \"협력 범위\", \"상호\"]}, \"absence_check\": false, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"ALL-CORE-02\", \"check\": \"협약(MOU)의 법적 구속력 유무(구속력 있는 조항과 없는 조항)가 명확한가\", \"label\": \"MOU 구속력 명확화\", \"module\": \"M-CORE\", \"severity\": \"참고\", \"severity_basis\": \"실무 항목 — MOU는 구속력 배제 특약 가능, 의사 명확화가 분쟁예방 핵심\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"구속력\", \"MOU\", \"양해각서\", \"법적 효력\"]}, \"evidence_required_groups\": [[\"법적 구속력\", \"구속력\", \"법적 효력\"]], \"absence_check\": false, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}]}, {\"meta\": {\"type_id\": \"channel\", \"type_name\": \"판매·모집채널\", \"detect_keywords\": [\"위탁판매\", \"판매대리\", \"상품제공\", \"모집\", \"GA\", \"방카\", \"방카슈랑스\", \"퇴직연금\", \"법인보험대리점\", \"설계사\", \"모집수수료\", \"판매채널\", \"제휴판매\", \"위촉\", \"보험대리점\"], \"modules\": [{\"id\": \"M-CH\", \"name\": \"채널 기본\", \"always_on\": true, \"screening_question\": null, \"suggest_keywords\": []}]}, \"checks\": [{\"id\": \"CH-02\", \"module\": \"M-CH\", \"check\": \"계약 해지·종료 시 기존 계약자 관리(이관·유지관리 책임)와 고객보호 조치가 규정되어 있는가\", \"label\": \"해지 시 고객보호·이관\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목 — 채널 종료 시 고객 방치(고아계약)가 민원·감독 리스크로 직결(practice 도출규칙 override)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"해지\", \"종료\", \"이관\", \"유지관리\", \"계약자 보호\", \"인수인계\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"채널 부실·폐업 시 보유계약의 유지관리 주체와 고객 통지 절차 확인.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"종료 후 고객관리 책임은 운영방식과 위험배분에 따라 정할 협상사항임\", \"contract_action_curated\": true}, {\"id\": \"CH-03\", \"module\": \"M-CH\", \"check\": \"채널의 부실·귀책으로 인한 손해(불완전판매 배상·과태료 구상)의 분담·구상 구조가 규정되어 있는가\", \"label\": \"채널 귀책 구상\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목(§102 원문 미대조) — 리스크: 회사가 보험업법 §102로 모집조직 위반 손해를 1차 배상하는 구조에서 채널 귀책 구상장치 부재 시 회사가 배상·과태료를 최종 부담(회수 불능) 직결(severity_override: risk)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"구상\", \"배상\", \"귀책\", \"불완전판매\", \"손해배상\", \"면책\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"회사가 1차 배상 후 채널에 구상하는 구조의 실효성(담보·보증과 연계)을 확인. §102 원문 확인 후 statute 승격 후보.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"불완전판매·과태료의 대외책임과 내부 구상은 구분되며 계약상 배분은 협상사항임\", \"contract_action_curated\": true}]}, {\"meta\": {\"type_id\": \"finance\", \"type_name\": \"금융·여신\", \"detect_keywords\": [\"대출\", \"대출약정\", \"여신\", \"융자\", \"담보\", \"근질권\", \"질권\", \"저당\", \"근저당\", \"채권양수도\", \"ABL\", \"리파이낸싱\", \"PF\", \"이행보증\", \"보증보험\", \"대주\", \"소비대차\", \"신용공여\"], \"modules\": [{\"id\": \"M-LOAN\", \"name\": \"여신·대출\", \"always_on\": true, \"screening_question\": \"금전 대여(대출·여신)를 내용으로 하는가?\", \"suggest_keywords\": [\"대출\", \"여신\", \"융자\", \"대주\", \"소비대차\"]}, {\"id\": \"M-GUAR\", \"name\": \"보증·이행보증\", \"always_on\": false, \"screening_question\": \"보증(연대보증·이행보증)이 포함되는가?\", \"suggest_keywords\": [\"보증\", \"연대보증\", \"이행보증\", \"보증보험\"]}]}, \"checks\": [{\"id\": \"FIN-LOAN-01\", \"check\": \"대출원금(대여금액)과 인도(실행) 방법이 특정되어 있는가\", \"label\": \"대출원금·실행방법\", \"module\": \"M-LOAN\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"소비대차 성립요건 서술(선언) — 민법 제598조. 리스크: 회사=대주 지위에서 대여채권의 금액·실행범위 미특정은 회수 시 채권 특정 곤란으로 직결(severity_override: risk)\", \"norm_type\": \"선언\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"대출금\", \"대여금\", \"대출원금\", \"실행\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제598조\", \"clause\": \"\", \"quote\": \"금전 기타 대체물의 소유권을 상대방에게 이전할 것을 약정하고 상대방은 그와 같은 종류, 품질 및 수량으로 반환할 것을 약정\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제598조(소비대차의 의의) 제598조(소비대차의 의의) 소비대차는 당사자 일방이 금전 기타 대체물의 소유권을 상대방에게 이전할 것을 약정하고 상대방은 그와 같은 종류, 품질 및 수량으로 반환할 것을 약정함으로써 그 효력이 생긴다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-LOAN-02\", \"check\": \"이자율과 이자 기산일(인도일 기준)이 명시되어 있는가\", \"label\": \"이자율·기산일\", \"module\": \"M-LOAN\", \"severity\": \"권장\", \"severity_basis\": \"이자약정은 임의규정 — 민법 제600조(이자있는 소비대차의 기산)\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이자\", \"이자율\", \"이율\"]}, \"absence_check\": true, \"absence_precondition\": [\"이자\", \"이자율\", \"이율\", \"유이자\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제600조\", \"clause\": \"\", \"quote\": \"이자있는 소비대차는 차주가 목적물의 인도를 받은 때로부터 이자를 계산하여야 하며\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제600조(이자계산의 시기) 제600조(이자계산의 시기) 이자있는 소비대차는 차주가 목적물의 인도를 받은 때로부터 이자를 계산하여야 하며 차주가 그 책임있는 사유로 수령을 지체할 때에는 대주가 이행을 제공한 때로부터 이자를 계산하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"이자 약정의 내용은 계약조건이지만 특정 약정이 반드시 필요한지는 거래구조에 따라 달라짐\", \"contract_action_curated\": true}, {\"id\": \"FIN-LOAN-03\", \"check\": \"약정이자율이 이자제한법상 최고이자율(연 25% 이내 대통령령)을 초과하지 않는가\", \"label\": \"최고이자율 준수\", \"module\": \"M-LOAN\", \"severity\": \"필수\", \"severity_basis\": \"강행규정 — 이자제한법 제2조(최고이자율 초과분 무효). 단 법인 여신 등 적용제외 확인 필요\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이자율\", \"이율\", \"연체이자\", \"지연손해금\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"이자제한법\", \"article\": \"제2조\", \"clause\": \"제1항·제3항\", \"quote\": \"최고이자율은 연 25퍼센트를 초과하지 아니하는 범위 안에서 대통령령으로 정한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제2조(이자의 최고한도)\\n①금전대차에 관한 계약상의 최고이자율은 연 25퍼센트를 초과하지 아니하는 범위 안에서 대통령령으로 정한다.\\n②제1항에 따른 최고이자율은 약정한 때의 이자율을 말한다.\\n③계약상의 이자로서 제1항에서 정한 최고이자율을 초과하는 부분은 무효로 한다.\\n④채무자가 최고이자율을 초과하는 이자를 임의로 지급한 경우에는 초과 지급된 이자 상당금액은 원본에 충당되고, 원본이 소멸한 때에는 그 반환을 청구할 수 있다.\\n⑤대차원금이 10만원 미만인 대차의 이자에 관하여는 제1항을 적용하지 아니한다.\", \"status\": \"quote_ok\"}], \"note\": \"대차원금 10만원 미만·법인 대상 여신 등 적용범위 확인 필요(이자제한법 제2조 제5항·대부업법 등)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-LOAN-04\", \"check\": \"지연손해금(연체이자)의 이율 또는 산정방법이 정해져 있는가\", \"label\": \"지연손해금 이율\", \"module\": \"M-LOAN\", \"severity\": \"권장\", \"severity_basis\": \"금전채무 지연손해는 약정이율 우선 적용 — 민법 제397조(약정 없으면 법정이율)\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지연손해금\", \"연체이자\", \"지연배상\", \"연체료\"]}, \"absence_check\": true, \"absence_precondition\": [\"지연손해금\", \"연체이자\", \"지연배상\", \"연체료\", \"연체\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제397조\", \"clause\": \"제1항\", \"quote\": \"금전채무불이행의 손해배상액은 법정이율에 의한다. 그러나 법령의 제한에 위반하지 아니한 약정이율이 있으면 그 이율에 의한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제397조(금전채무불이행에 대한 특칙) 제397조(금전채무불이행에 대한 특칙) ①금전채무불이행의 손해배상액은 법정이율에 의한다. 그러나 법령의 제한에 위반하지 아니한 약정이율이 있으면 그 이율에 의한다. ②전항의 손해배상에 관하여는 채권자는 손해의 증명을 요하지 아니하고 채무자는 과실없음을 항변하지 못한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"지연손해금 약정은 법정 기준과 별개로 선택 가능한 위험배분 조항임\", \"contract_action_curated\": true}, {\"id\": \"FIN-GUAR-01\", \"check\": \"보증(연대보증)이 보증인의 기명날인·서명 있는 서면으로 표시되어 있는가\", \"label\": \"보증 서면방식\", \"module\": \"M-GUAR\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(효력요건) — 민법 제428조의2(서면 아닌 보증은 무효, 전자적 형태 무효)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"보증\", \"연대보증\", \"보증인\", \"보증서\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제428조의2\", \"clause\": \"제1항\", \"quote\": \"보증은 그 의사가 보증인의 기명날인 또는 서명이 있는 서면으로 표시되어야 효력이 발생한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제428조의2(보증의 방식) 제428조의2(보증의 방식) ① 보증은 그 의사가 보증인의 기명날인 또는 서명이 있는 서면으로 표시되어야 효력이 발생한다. 다만, 보증의 의사가 전자적 형태로 표시된 경우에는 효력이 없다. ② 보증채무를 보증인에게 불리하게 변경하는 경우에도 제1항과 같다. ③ 보증인이 보증채무를 이행한 경우에는 그 한도에서 제1항과 제2항에 따른 방식의 하자를 이유로 보증의 무효를 주장할 수 없다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"보증의 효력에 서면과 기명날인·서명이 직접 요구되는 형식요건임\", \"contract_action_curated\": true}, {\"id\": \"FIN-GUAR-02\", \"check\": \"연대보증인 경우 최고·검색의 항변권 배제가 명확히 규정되어 있는가\", \"label\": \"연대보증 항변권 배제\", \"module\": \"M-GUAR\", \"severity\": \"권장\", \"severity_basis\": \"임의규정 — 민법 제437조(연대보증은 최고·검색 항변 배제, 단서). 계약상 연대 여부 명확화 필요\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"연대보증\", \"최고\", \"검색\", \"항변\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제437조\", \"clause\": \"\", \"quote\": \"보증인이 주채무자와 연대하여 채무를 부담한 때에는 그러하지 아니하다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제437조(보증인의 최고, 검색의 항변) 제437조(보증인의 최고, 검색의 항변) 채권자가 보증인에게 채무의 이행을 청구한 때에는 보증인은 주채무자의 변제자력이 있는 사실 및 그 집행이 용이할 것을 증명하여 먼저 주채무자에게 청구할 것과 그 재산에 대하여 집행할 것을 항변할 수 있다. 그러나 보증인이 주채무자와 연대하여 채무를 부담한 때에는 그러하지 아니하다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"FIN-GUAR-03\", \"check\": \"보증인의 구상권(수탁보증인·공동보증인) 관련 사항이 정리되어 있는가\", \"label\": \"보증인 구상권\", \"module\": \"M-GUAR\", \"severity\": \"참고\", \"severity_basis\": \"임의규정 — 민법 제441조(수탁보증인 구상권). 채권자 관점에선 확인 정도\", \"norm_type\": \"임의\", \"severity_override\": true, \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"구상권\", \"구상\", \"수탁보증\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제441조\", \"clause\": \"제1항\", \"quote\": \"보증인이 된 자가 과실없이 변제 기타의 출재로 주채무를 소멸하게 한 때에는 주채무자에 대하여 구상권이 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제441조(수탁보증인의 구상권) 제441조(수탁보증인의 구상권) ①주채무자의 부탁으로 보증인이 된 자가 과실없이 변제 기타의 출재로 주채무를 소멸하게 한 때에는 주채무자에 대하여 구상권이 있다. ②제425조제2항의 규정은 전항의 경우에 준용한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}]}, {\"meta\": {\"type_id\": \"investment\", \"type_name\": \"투자\", \"detect_keywords\": [\"투자\", \"펀드\", \"사모펀드\", \"집합투자\", \"수익증권\", \"출자\", \"조합\", \"투자신탁\", \"투자일임\", \"신탁계약\", \"capital call\", \"캐피탈콜\", \"Capital Call\", \"변액펀드\", \"블라인드\", \"PEF\", \"메자닌\", \"리츠\", \"ISDA\", \"CSA\", \"장외파생\", \"증거금\"], \"nature_signals\": [\"신탁계약\", \"신탁재산\", \"신탁업자\", \"수익증권\", \"집합투자업자\", \"신탁원본\", \"수익자총회\"], \"suppresses\": [\"outsourcing\"], \"modules\": [{\"id\": \"M-FUND\", \"name\": \"집합투자·펀드\", \"always_on\": true, \"screening_question\": \"펀드(집합투자기구)에 대한 투자·출자를 내용으로 하는가?\", \"suggest_keywords\": [\"펀드\", \"집합투자\", \"수익증권\", \"사모\", \"투자신탁\"]}, {\"id\": \"M-MANDATE\", \"name\": \"투자일임·자산운용위탁\", \"always_on\": false, \"screening_question\": \"자산운용사에 투자일임(운용 위탁)을 맡기는가?\", \"suggest_keywords\": [\"투자일임\", \"일임\", \"운용 위탁\", \"변액펀드\"]}, {\"id\": \"M-PARTNER\", \"name\": \"출자·조합(LP/GP)\", \"always_on\": false, \"screening_question\": \"조합(합자조합 등)에 유한책임사원(LP)으로 출자하는가?\", \"suggest_keywords\": [\"출자\", \"조합\", \"LP\", \"업무집행조합원\", \"capital call\", \"캐피탈콜\"]}, {\"id\": \"M-BENEF\", \"name\": \"수익자 지위·보호\", \"always_on\": false, \"screening_question\": \"당사가 투자신탁의 수익자로서 신탁계약(또는 그 변경)을 검토하는가?\", \"suggest_keywords\": [\"수익자\", \"수익증권\", \"수익권\", \"집합투자규약\", \"투자신탁\", \"수익자총회\"], \"requires_stance\": [\"beneficiary\"]}]}, \"checks\": [{\"id\": \"INV-FUND-01\", \"check\": \"투자 대상 집합투자기구(펀드)의 형태·집합투자규약(신탁계약·정관·조합계약)이 특정되어 있는가\", \"label\": \"펀드 형태·규약 특정\", \"module\": \"M-FUND\", \"severity\": \"참고\", \"severity_basis\": \"선언규정 — 자본시장법 제9조 제18항·제22항(집합투자기구 형태·집합투자규약 정의)\", \"norm_type\": \"선언\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"집합투자기구\", \"펀드\", \"투자신탁\", \"집합투자규약\", \"신탁계약\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제9조\", \"clause\": \"제18항\", \"quote\": \"집합투자를 수행하기 위한 기구로서 다음 각 호의 것을 말한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제9조(그 밖의 용어의 정의) 제9조(그 밖의 용어의 정의) ① 이 법에서 \\\"대주주\\\"란 「금융회사의 지배구조에 관한 법률」 제2조제6호에 따른 주주를 말한다. 이 경우 \\\"금융회사\\\"는 \\\"법인\\\"으로 본다. <개정 2015.7.31> ② 이 법에서 \\\"임원\\\"이란 이사 및 감사를 말한다. ③ 이 법에서 \\\"사외이사\\\"란 상시적인 업무에 종사하지 아니하는 사람으로서 「금융회사의 지배구조에 관한 법률」 제17조에 따라 선임되는 이사를 말한다. <개정 2015.7.31> ④ 이 법에서 \\\"투자권유\\\"란 특정 투자자를 상대로 금융투자상품의 매매 또는 투자자문계약ㆍ투자일임계약ㆍ신탁계약(관리형신탁계약 및 투자성 없는 신탁계약을 제외한다)의 체결을 권유하는 것을 말한다. <개정 2013.5.28> ⑤ 이 법에서 \\\"전문투자자\\\"란 금융투자상품에 관한 전문성 구비 여부, 소유자산규모 등에 비추어 투자에 따른 위험감수능력이 있는 투자자로서 다음 각 호의 어느 하나에 해당하는 자를 말한다. 다만, 전문투자자 중 대통령령으로 정하는 자가 일반투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우 금융투자업자는 정당한 사유가 있는 경우를 제외하고는 이에 동의하여야 하며, 금융투자업자가 동의한 경우에는 해당 투자자는 일반투자자로 본다. <개정 2009.2.3> 1. 국가 2. 한국은행 3. 대통령령으로 정하는 금융기관 4. 주권상장법인. 다만, 금융투자업자와 장외파생상품 거래를 하는 경우에는 전문투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우에 한한다. 5. 그 밖에 대통령령으로 정하는 자 ⑥ 이 법에서 \\\"일반투자자\\\"란 전문투자자가 아닌 투자자를 말한다. ⑦ 이 법에서 \\\"모집\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 새로 발행되는 증권의 취득의 청약을 권유하는 것을 말한다. ⑧ 이 법에서 \\\"사모\\\"란 새로 발행되는 증권의 취득의 청약을 권유하는 것으로서 모집에 해당하지 아니하는 것을 말한다. ⑨ 이 법에서 \\\"매출\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 이미 발행된 증권의 매도의 청약을 하거나 매수의 청약을 권유하는 것을 말한다. ⑩ 이 법에서 \\\"발행인\\\"이란 증권을 발행하였거나 발행하고자 하는 자를 말한다. 다만, 증권예탁증권을 발행함에 있어서는 그 기초가 되는 증권을 발행하였거나 발행하고자 하는 자를 말한다. ⑪ 이 법에서 \\\"인수\\\"란 제삼자에게 증권을 취득시킬 목적으로 다음 각 호의 어느 하나에 해당하는 행위를 하거나 그 행위를 전제로 발행인 또는 매출인을 위하여 증권의 모집ㆍ사모ㆍ매출을 하는 것을 말한다. <개정 2013.5.28> 1. 그 증권의 전부 또는 일부를 취득하거나 취득하는 것을 내용으로 하는 계약을 체결하는 것 2. 그 증권의 전부 또는 일부에 대하여 이를 취득하는 자가 없는 때에 그 나머지를 취득하는 것을 내용으로 하는 계약을 체결하는 것 ⑫ 이 법에서 \\\"인수인\\\"이란 증권을 모집ㆍ사모ㆍ매출하는 경우 인수를 하는 자를 말한다. <개정 2013.5.28> ⑬ 이 법에서 \\\"주선인\\\"이란 제11항에 따른 행위 외에 발행인 또는 매출인을 위하여 해당 증권의 모집ㆍ사모ㆍ매출을 하거나 그 밖에 직접 또는 간접으로 증권의 모집ㆍ사모ㆍ매출을 분담하는 자를 말한다. <개정 2013.5.28> ⑭ 이 법에서 \\\"매출인\\\"이란 증권의 소유자로서 스스로 또는 인수인이나 주선인을 통하여 그 증권을 매출하였거나 매출하려는 자를 말한다. <개정 2013.5.28> ⑮ 이 법에서 \\\"상장법인\\\", \\\"비상장법인\\\", \\\"주권상장법인\\\" 및 \\\"주권비상장법인\\\"이란 각각 다음 각 호의 자를 말한다. <개정 2009.2.3> 1. 상장법인 : 증권시장에 상장된 증권(이하 \\\"상장증권\\\"이라 한다)을 발행한 법인 2. 비상장법인 : 상장법인을 제외한 법인 3. 주권상장법인 : 다음 각 목의 어느 하나에 해당하는 법인 가. 증권시장에 상장된 주권을 발행한 법인 나. 주권과 관련된 증권예탁증권이 증권시장에 상장된 경우에는 그 주권을 발행한 법인 4. 주권비상장법인 : 주권상장법인을 제외한 법인 ⑯ 이 법에서 \\\"외국법인등\\\"이란 다음 각 호의 어느 하나에 해당하는 자를 말한다. 1. 외국 정부 2. 외국 지방자치단체 3. 외국 공공단체 4. 외국 법령에 따라 설립된 외국 기업 5. 대통령령으로 정하는 국제기구 6. 그 밖에 외국에 있는 법인 등으로서 대통령령으로 정하는 자 ⑰ 이 법에서 \\\"금융투자업관계기관\\\"이란 다음 각 호의 자를 말한다. <개정 2009.2.3, 2013.4.5, 2013.5.28> 1. 제283조에 따라 설립된 한국금융투자협회(이하 \\\"협회\\\"라 한다) 2. 제294조에 따라 설립된 한국예탁결제원(이하 \\\"예탁결제원\\\"이라 한다) 2의2. 제323조의3에 따라 인가를 받은 자(이하 \\\"금융투자상품거래청산회사\\\"라 한다) 3. 제324조제1항에 따라 인가를 받은 자(이하 \\\"증권금융회사\\\"라 한다) 3의2. 제335조의3에 따라 인가를 받은 자(이하 \\\"신용평가회사\\\"라 한다) 4. 제336조에 따른 종합금융회사 5. 제355조제1항에 따라 인가를 받은 자(이하 \\\"자금중개회사\\\"라 한다) 6. 제360조제1항에 따라 인가를 받은 자(이하 \\\"단기금융회사\\\"라 한다) 7. 제365조제1항에 따라 등록한 자(이하 \\\"명의개서대행회사\\\"라 한다) 8. 제370조에 따라 설립된 금융투자 관계 단체 ⑱ 이 법에서 \\\"집합투자기구\\\"란 집합투자를 수행하기 위한 기구로서 다음 각 호의 것을 말한다. <개정 2013.5.28> 1. 집합투자업자인 위탁자가 신탁업자에게 신탁한 재산을 신탁업자로 하여금 그 집합투자업자의 지시에 따라 투자ㆍ운용하게 하는 신탁 형태의 집합투자기구(이하 \\\"투자신탁\\\"이라 한다) 2. 「상법」에 따른 주식회사 형태의 집합투자기구(이하 \\\"투자회사\\\"라 한다) 3. 「상법」에 따른 유한회사 형태의 집합투자기구(이하 \\\"투자유한회사\\\"라 한다) 4. 「상법」에 따른 합자회사 형태의 집합투자기구(이하 \\\"투자합자회사\\\"라 한다) 4의2. 「상법」에 따른 유한책임회사 형태의 집합투자기구(이하 \\\"투자유한책임회사\\\"라 한다) 5. 「상법」에 따른 합자조합 형태의 집합투자기구(이하 \\\"투자합자조합\\\"이라 한다) 6. 「상법」에 따른 익명조합 형태의 집합투자기구(이하 \\\"투자익명조합\\\"이라 한다) 7. 삭제 <2015.7.24> ⑲ 이 법에서 \\\"사모집합투자기구\\\"란 집합투자증권을 사모로만 발행하는 집합투자기구로서 대통령령으로 정하는 투자자의 총수가 대통령령으로 정하는 방법에 따라 산출한 100인 이하인 것을 말하며, 다음 각 호와 같이 구분한다. <개정 2015.7.24, 2021.4.20> 1. 제249조의11제6항에 해당하는 자만을 사원으로 하는 투자합자회사인 사모집합투자기구(이하 \\\"기관전용 사모집합투자기구\\\"라 한다) 2. 기관전용 사모집합투자기구를 제외한 사모집합투자기구(이하 \\\"일반 사모집합투자기구\\\"라 한다) ⑳ 이 법에서 \\\"집합투자재산\\\"이란 집합투자기구의 재산으로서 투자신탁재산, 투자회사재산, 투자유한회사재산, 투자합자회사재산, 투자유한책임회사재산, 투자합자조합재산 및 투자익명조합재산을 말한다. <개정 2013.5.28> ㉑ 이 법에서 \\\"집합투자증권\\\"이란 집합투자기구에 대한 출자지분(투자신탁의 경우에는 수익권을 말한다)이 표시된 것을 말한다. ㉒ 이 법에서 \\\"집합투자규약\\\"이란 집합투자기구의 조직, 운영 및 투자자의 권리ㆍ의무를 정한 것으로서 투자신탁의 신탁계약, 투자회사ㆍ투자유한회사ㆍ투자합자회사ㆍ투자유한책임회사의 정관 및 투자합자조합ㆍ투자익명조합의 조합계약을 말한다. <개정 2013.5.28> ㉓ 이 법에서 \\\"집합투자자총회\\\"란 집합투자기구의 투자자 전원으로 구성된 의사결정기관으로서 수익자총회, 주주총회, 사원총회, 조합원총회 및 익명조합원총회를 말한다. ㉔ 이 법에서 \\\"신탁\\\"이란 「신탁법」 제2조의 신탁을 말한다. <개정 2011.7.25> ㉕ 이 법에서 \\\"금융투자상품거래청산업\\\"이란 금융투자업자 및 대통령령으로 정하는 자(이하 \\\"청산대상업자\\\"라 한다)를 상대방으로 하여 청산대상업자가 대통령령으로 정하는 금융투자상품의 거래(이하 \\\"청산대상거래\\\"라 한다)를 함에 따라 발생하는 채무를 채무인수, 경개(更改), 그 밖의 방법으로 부담하는 것을 영업으로 하는 것을 말한다. <신설 2013.4.5> ㉖ 이 법에서 \\\"신용평가업\\\"이란 다음 각 호의 어느 하나에 해당하는 것에 대한 신용상태를 평가(이하 \\\"신용평가\\\"라 한다)하여 그 결과에 대하여 기호, 숫자 등을 사용하여 표시한 등급(이하 \\\"신용등급\\\"이라 한다)을 부여하고 그 신용등급을 발행인, 인수인, 투자자, 그 밖의 이해관계자에게 제공하거나 열람하게 하는 행위를 영업으로 하는 것을 말한다. <신설 2013.5.28> 1. 금융투자상품 2. 기업ㆍ집합투자기구, 그 밖에 대통령령으로 정하는 자 ㉗ 이 법에서 \\\"온라인소액투자중개업자\\\"란 온라인상에서 누구의 명의로 하든지 타인의 계산으로 다음 각 호의 자가, 대통령령으로 정하는 방법으로 발행하는 채무증권, 지분증권, 투자계약증권의 모집 또는 사모에 관한 중개(이하 \\\"온라인소액투자중개\\\"라 한다)를 영업으로 하는 투자중개업자를 말한다. <신설 2015.7.24, 2021.12.28> 1. 「중소기업창업 지원법」 제2조제3호에 따른 창업기업 중 대통령령으로 정하는 자 2. 그 밖에 대통령령으로 정하는 요건에 부합하는 자 ㉘ 이 법에서 \\\"일반 사모집합투자업\\\"이란 집합투자업 중 일반 사모집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2015.7.24, 2021.4.20> ㉙ 이 법에서 \\\"일반 사모집합투자업자\\\"란 집합투자업자 중 일반 사모집합투자업을 영위하는 자를 말한다. <신설 2015.7.24, 2021.4.20> ㉚ 이 법에서 \\\"기업성장집합투자업\\\"이란 집합투자업 중 제229조제6호에 따른 기업성장집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2025.9.16> ㉛ 이 법에서 \\\"기업성장집합투자업자\\\"란 집합투자업자 중 기업성장집합투자업을 영위하는 자를 말한다. <신설 2025.9.16>\", \"status\": \"quote_ok\"}, {\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제9조\", \"clause\": \"제22항\", \"quote\": \"집합투자기구의 조직, 운영 및 투자자의 권리ㆍ의무를 정한 것으로서 투자신탁의 신탁계약, 투자회사ㆍ투자유한회사ㆍ투자합자회사ㆍ투자유한책임회사의 정관 및 투자합자조합ㆍ투자익명조합의 조합계약을 말한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제9조(그 밖의 용어의 정의) 제9조(그 밖의 용어의 정의) ① 이 법에서 \\\"대주주\\\"란 「금융회사의 지배구조에 관한 법률」 제2조제6호에 따른 주주를 말한다. 이 경우 \\\"금융회사\\\"는 \\\"법인\\\"으로 본다. <개정 2015.7.31> ② 이 법에서 \\\"임원\\\"이란 이사 및 감사를 말한다. ③ 이 법에서 \\\"사외이사\\\"란 상시적인 업무에 종사하지 아니하는 사람으로서 「금융회사의 지배구조에 관한 법률」 제17조에 따라 선임되는 이사를 말한다. <개정 2015.7.31> ④ 이 법에서 \\\"투자권유\\\"란 특정 투자자를 상대로 금융투자상품의 매매 또는 투자자문계약ㆍ투자일임계약ㆍ신탁계약(관리형신탁계약 및 투자성 없는 신탁계약을 제외한다)의 체결을 권유하는 것을 말한다. <개정 2013.5.28> ⑤ 이 법에서 \\\"전문투자자\\\"란 금융투자상품에 관한 전문성 구비 여부, 소유자산규모 등에 비추어 투자에 따른 위험감수능력이 있는 투자자로서 다음 각 호의 어느 하나에 해당하는 자를 말한다. 다만, 전문투자자 중 대통령령으로 정하는 자가 일반투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우 금융투자업자는 정당한 사유가 있는 경우를 제외하고는 이에 동의하여야 하며, 금융투자업자가 동의한 경우에는 해당 투자자는 일반투자자로 본다. <개정 2009.2.3> 1. 국가 2. 한국은행 3. 대통령령으로 정하는 금융기관 4. 주권상장법인. 다만, 금융투자업자와 장외파생상품 거래를 하는 경우에는 전문투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우에 한한다. 5. 그 밖에 대통령령으로 정하는 자 ⑥ 이 법에서 \\\"일반투자자\\\"란 전문투자자가 아닌 투자자를 말한다. ⑦ 이 법에서 \\\"모집\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 새로 발행되는 증권의 취득의 청약을 권유하는 것을 말한다. ⑧ 이 법에서 \\\"사모\\\"란 새로 발행되는 증권의 취득의 청약을 권유하는 것으로서 모집에 해당하지 아니하는 것을 말한다. ⑨ 이 법에서 \\\"매출\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 이미 발행된 증권의 매도의 청약을 하거나 매수의 청약을 권유하는 것을 말한다. ⑩ 이 법에서 \\\"발행인\\\"이란 증권을 발행하였거나 발행하고자 하는 자를 말한다. 다만, 증권예탁증권을 발행함에 있어서는 그 기초가 되는 증권을 발행하였거나 발행하고자 하는 자를 말한다. ⑪ 이 법에서 \\\"인수\\\"란 제삼자에게 증권을 취득시킬 목적으로 다음 각 호의 어느 하나에 해당하는 행위를 하거나 그 행위를 전제로 발행인 또는 매출인을 위하여 증권의 모집ㆍ사모ㆍ매출을 하는 것을 말한다. <개정 2013.5.28> 1. 그 증권의 전부 또는 일부를 취득하거나 취득하는 것을 내용으로 하는 계약을 체결하는 것 2. 그 증권의 전부 또는 일부에 대하여 이를 취득하는 자가 없는 때에 그 나머지를 취득하는 것을 내용으로 하는 계약을 체결하는 것 ⑫ 이 법에서 \\\"인수인\\\"이란 증권을 모집ㆍ사모ㆍ매출하는 경우 인수를 하는 자를 말한다. <개정 2013.5.28> ⑬ 이 법에서 \\\"주선인\\\"이란 제11항에 따른 행위 외에 발행인 또는 매출인을 위하여 해당 증권의 모집ㆍ사모ㆍ매출을 하거나 그 밖에 직접 또는 간접으로 증권의 모집ㆍ사모ㆍ매출을 분담하는 자를 말한다. <개정 2013.5.28> ⑭ 이 법에서 \\\"매출인\\\"이란 증권의 소유자로서 스스로 또는 인수인이나 주선인을 통하여 그 증권을 매출하였거나 매출하려는 자를 말한다. <개정 2013.5.28> ⑮ 이 법에서 \\\"상장법인\\\", \\\"비상장법인\\\", \\\"주권상장법인\\\" 및 \\\"주권비상장법인\\\"이란 각각 다음 각 호의 자를 말한다. <개정 2009.2.3> 1. 상장법인 : 증권시장에 상장된 증권(이하 \\\"상장증권\\\"이라 한다)을 발행한 법인 2. 비상장법인 : 상장법인을 제외한 법인 3. 주권상장법인 : 다음 각 목의 어느 하나에 해당하는 법인 가. 증권시장에 상장된 주권을 발행한 법인 나. 주권과 관련된 증권예탁증권이 증권시장에 상장된 경우에는 그 주권을 발행한 법인 4. 주권비상장법인 : 주권상장법인을 제외한 법인 ⑯ 이 법에서 \\\"외국법인등\\\"이란 다음 각 호의 어느 하나에 해당하는 자를 말한다. 1. 외국 정부 2. 외국 지방자치단체 3. 외국 공공단체 4. 외국 법령에 따라 설립된 외국 기업 5. 대통령령으로 정하는 국제기구 6. 그 밖에 외국에 있는 법인 등으로서 대통령령으로 정하는 자 ⑰ 이 법에서 \\\"금융투자업관계기관\\\"이란 다음 각 호의 자를 말한다. <개정 2009.2.3, 2013.4.5, 2013.5.28> 1. 제283조에 따라 설립된 한국금융투자협회(이하 \\\"협회\\\"라 한다) 2. 제294조에 따라 설립된 한국예탁결제원(이하 \\\"예탁결제원\\\"이라 한다) 2의2. 제323조의3에 따라 인가를 받은 자(이하 \\\"금융투자상품거래청산회사\\\"라 한다) 3. 제324조제1항에 따라 인가를 받은 자(이하 \\\"증권금융회사\\\"라 한다) 3의2. 제335조의3에 따라 인가를 받은 자(이하 \\\"신용평가회사\\\"라 한다) 4. 제336조에 따른 종합금융회사 5. 제355조제1항에 따라 인가를 받은 자(이하 \\\"자금중개회사\\\"라 한다) 6. 제360조제1항에 따라 인가를 받은 자(이하 \\\"단기금융회사\\\"라 한다) 7. 제365조제1항에 따라 등록한 자(이하 \\\"명의개서대행회사\\\"라 한다) 8. 제370조에 따라 설립된 금융투자 관계 단체 ⑱ 이 법에서 \\\"집합투자기구\\\"란 집합투자를 수행하기 위한 기구로서 다음 각 호의 것을 말한다. <개정 2013.5.28> 1. 집합투자업자인 위탁자가 신탁업자에게 신탁한 재산을 신탁업자로 하여금 그 집합투자업자의 지시에 따라 투자ㆍ운용하게 하는 신탁 형태의 집합투자기구(이하 \\\"투자신탁\\\"이라 한다) 2. 「상법」에 따른 주식회사 형태의 집합투자기구(이하 \\\"투자회사\\\"라 한다) 3. 「상법」에 따른 유한회사 형태의 집합투자기구(이하 \\\"투자유한회사\\\"라 한다) 4. 「상법」에 따른 합자회사 형태의 집합투자기구(이하 \\\"투자합자회사\\\"라 한다) 4의2. 「상법」에 따른 유한책임회사 형태의 집합투자기구(이하 \\\"투자유한책임회사\\\"라 한다) 5. 「상법」에 따른 합자조합 형태의 집합투자기구(이하 \\\"투자합자조합\\\"이라 한다) 6. 「상법」에 따른 익명조합 형태의 집합투자기구(이하 \\\"투자익명조합\\\"이라 한다) 7. 삭제 <2015.7.24> ⑲ 이 법에서 \\\"사모집합투자기구\\\"란 집합투자증권을 사모로만 발행하는 집합투자기구로서 대통령령으로 정하는 투자자의 총수가 대통령령으로 정하는 방법에 따라 산출한 100인 이하인 것을 말하며, 다음 각 호와 같이 구분한다. <개정 2015.7.24, 2021.4.20> 1. 제249조의11제6항에 해당하는 자만을 사원으로 하는 투자합자회사인 사모집합투자기구(이하 \\\"기관전용 사모집합투자기구\\\"라 한다) 2. 기관전용 사모집합투자기구를 제외한 사모집합투자기구(이하 \\\"일반 사모집합투자기구\\\"라 한다) ⑳ 이 법에서 \\\"집합투자재산\\\"이란 집합투자기구의 재산으로서 투자신탁재산, 투자회사재산, 투자유한회사재산, 투자합자회사재산, 투자유한책임회사재산, 투자합자조합재산 및 투자익명조합재산을 말한다. <개정 2013.5.28> ㉑ 이 법에서 \\\"집합투자증권\\\"이란 집합투자기구에 대한 출자지분(투자신탁의 경우에는 수익권을 말한다)이 표시된 것을 말한다. ㉒ 이 법에서 \\\"집합투자규약\\\"이란 집합투자기구의 조직, 운영 및 투자자의 권리ㆍ의무를 정한 것으로서 투자신탁의 신탁계약, 투자회사ㆍ투자유한회사ㆍ투자합자회사ㆍ투자유한책임회사의 정관 및 투자합자조합ㆍ투자익명조합의 조합계약을 말한다. <개정 2013.5.28> ㉓ 이 법에서 \\\"집합투자자총회\\\"란 집합투자기구의 투자자 전원으로 구성된 의사결정기관으로서 수익자총회, 주주총회, 사원총회, 조합원총회 및 익명조합원총회를 말한다. ㉔ 이 법에서 \\\"신탁\\\"이란 「신탁법」 제2조의 신탁을 말한다. <개정 2011.7.25> ㉕ 이 법에서 \\\"금융투자상품거래청산업\\\"이란 금융투자업자 및 대통령령으로 정하는 자(이하 \\\"청산대상업자\\\"라 한다)를 상대방으로 하여 청산대상업자가 대통령령으로 정하는 금융투자상품의 거래(이하 \\\"청산대상거래\\\"라 한다)를 함에 따라 발생하는 채무를 채무인수, 경개(更改), 그 밖의 방법으로 부담하는 것을 영업으로 하는 것을 말한다. <신설 2013.4.5> ㉖ 이 법에서 \\\"신용평가업\\\"이란 다음 각 호의 어느 하나에 해당하는 것에 대한 신용상태를 평가(이하 \\\"신용평가\\\"라 한다)하여 그 결과에 대하여 기호, 숫자 등을 사용하여 표시한 등급(이하 \\\"신용등급\\\"이라 한다)을 부여하고 그 신용등급을 발행인, 인수인, 투자자, 그 밖의 이해관계자에게 제공하거나 열람하게 하는 행위를 영업으로 하는 것을 말한다. <신설 2013.5.28> 1. 금융투자상품 2. 기업ㆍ집합투자기구, 그 밖에 대통령령으로 정하는 자 ㉗ 이 법에서 \\\"온라인소액투자중개업자\\\"란 온라인상에서 누구의 명의로 하든지 타인의 계산으로 다음 각 호의 자가, 대통령령으로 정하는 방법으로 발행하는 채무증권, 지분증권, 투자계약증권의 모집 또는 사모에 관한 중개(이하 \\\"온라인소액투자중개\\\"라 한다)를 영업으로 하는 투자중개업자를 말한다. <신설 2015.7.24, 2021.12.28> 1. 「중소기업창업 지원법」 제2조제3호에 따른 창업기업 중 대통령령으로 정하는 자 2. 그 밖에 대통령령으로 정하는 요건에 부합하는 자 ㉘ 이 법에서 \\\"일반 사모집합투자업\\\"이란 집합투자업 중 일반 사모집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2015.7.24, 2021.4.20> ㉙ 이 법에서 \\\"일반 사모집합투자업자\\\"란 집합투자업자 중 일반 사모집합투자업을 영위하는 자를 말한다. <신설 2015.7.24, 2021.4.20> ㉚ 이 법에서 \\\"기업성장집합투자업\\\"이란 집합투자업 중 제229조제6호에 따른 기업성장집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2025.9.16> ㉛ 이 법에서 \\\"기업성장집합투자업자\\\"란 집합투자업자 중 기업성장집합투자업을 영위하는 자를 말한다. <신설 2025.9.16>\", \"status\": \"quote_ok\"}], \"note\": \"제9조 제22항 quote — 2026-07-28 축약 오인용 발견으로 현행 원문 교체·검수 하향 — 재검수 필요\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-FUND-02\", \"check\": \"사모집합투자기구인 경우 사모 요건(투자자 총수 제한 등)에 부합하는가\", \"label\": \"사모 요건 부합\", \"module\": \"M-FUND\", \"severity\": \"참고\", \"severity_basis\": \"선언규정이며 수범자가 집합투자업자·판매회사임 — 자본시장법 제9조 제19항(사모집합투자기구 정의). 수익자 입장에서는 반영 여부 확인 수준\", \"norm_type\": \"선언\", \"severity_override\": true, \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"사모\", \"사모펀드\", \"사모집합투자\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제9조\", \"clause\": \"제19항\", \"quote\": \"집합투자증권을 사모로만 발행하는 집합투자기구\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제9조(그 밖의 용어의 정의) 제9조(그 밖의 용어의 정의) ① 이 법에서 \\\"대주주\\\"란 「금융회사의 지배구조에 관한 법률」 제2조제6호에 따른 주주를 말한다. 이 경우 \\\"금융회사\\\"는 \\\"법인\\\"으로 본다. <개정 2015.7.31> ② 이 법에서 \\\"임원\\\"이란 이사 및 감사를 말한다. ③ 이 법에서 \\\"사외이사\\\"란 상시적인 업무에 종사하지 아니하는 사람으로서 「금융회사의 지배구조에 관한 법률」 제17조에 따라 선임되는 이사를 말한다. <개정 2015.7.31> ④ 이 법에서 \\\"투자권유\\\"란 특정 투자자를 상대로 금융투자상품의 매매 또는 투자자문계약ㆍ투자일임계약ㆍ신탁계약(관리형신탁계약 및 투자성 없는 신탁계약을 제외한다)의 체결을 권유하는 것을 말한다. <개정 2013.5.28> ⑤ 이 법에서 \\\"전문투자자\\\"란 금융투자상품에 관한 전문성 구비 여부, 소유자산규모 등에 비추어 투자에 따른 위험감수능력이 있는 투자자로서 다음 각 호의 어느 하나에 해당하는 자를 말한다. 다만, 전문투자자 중 대통령령으로 정하는 자가 일반투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우 금융투자업자는 정당한 사유가 있는 경우를 제외하고는 이에 동의하여야 하며, 금융투자업자가 동의한 경우에는 해당 투자자는 일반투자자로 본다. <개정 2009.2.3> 1. 국가 2. 한국은행 3. 대통령령으로 정하는 금융기관 4. 주권상장법인. 다만, 금융투자업자와 장외파생상품 거래를 하는 경우에는 전문투자자와 같은 대우를 받겠다는 의사를 금융투자업자에게 서면으로 통지하는 경우에 한한다. 5. 그 밖에 대통령령으로 정하는 자 ⑥ 이 법에서 \\\"일반투자자\\\"란 전문투자자가 아닌 투자자를 말한다. ⑦ 이 법에서 \\\"모집\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 새로 발행되는 증권의 취득의 청약을 권유하는 것을 말한다. ⑧ 이 법에서 \\\"사모\\\"란 새로 발행되는 증권의 취득의 청약을 권유하는 것으로서 모집에 해당하지 아니하는 것을 말한다. ⑨ 이 법에서 \\\"매출\\\"이란 대통령령으로 정하는 방법에 따라 산출한 50인 이상의 투자자에게 이미 발행된 증권의 매도의 청약을 하거나 매수의 청약을 권유하는 것을 말한다. ⑩ 이 법에서 \\\"발행인\\\"이란 증권을 발행하였거나 발행하고자 하는 자를 말한다. 다만, 증권예탁증권을 발행함에 있어서는 그 기초가 되는 증권을 발행하였거나 발행하고자 하는 자를 말한다. ⑪ 이 법에서 \\\"인수\\\"란 제삼자에게 증권을 취득시킬 목적으로 다음 각 호의 어느 하나에 해당하는 행위를 하거나 그 행위를 전제로 발행인 또는 매출인을 위하여 증권의 모집ㆍ사모ㆍ매출을 하는 것을 말한다. <개정 2013.5.28> 1. 그 증권의 전부 또는 일부를 취득하거나 취득하는 것을 내용으로 하는 계약을 체결하는 것 2. 그 증권의 전부 또는 일부에 대하여 이를 취득하는 자가 없는 때에 그 나머지를 취득하는 것을 내용으로 하는 계약을 체결하는 것 ⑫ 이 법에서 \\\"인수인\\\"이란 증권을 모집ㆍ사모ㆍ매출하는 경우 인수를 하는 자를 말한다. <개정 2013.5.28> ⑬ 이 법에서 \\\"주선인\\\"이란 제11항에 따른 행위 외에 발행인 또는 매출인을 위하여 해당 증권의 모집ㆍ사모ㆍ매출을 하거나 그 밖에 직접 또는 간접으로 증권의 모집ㆍ사모ㆍ매출을 분담하는 자를 말한다. <개정 2013.5.28> ⑭ 이 법에서 \\\"매출인\\\"이란 증권의 소유자로서 스스로 또는 인수인이나 주선인을 통하여 그 증권을 매출하였거나 매출하려는 자를 말한다. <개정 2013.5.28> ⑮ 이 법에서 \\\"상장법인\\\", \\\"비상장법인\\\", \\\"주권상장법인\\\" 및 \\\"주권비상장법인\\\"이란 각각 다음 각 호의 자를 말한다. <개정 2009.2.3> 1. 상장법인 : 증권시장에 상장된 증권(이하 \\\"상장증권\\\"이라 한다)을 발행한 법인 2. 비상장법인 : 상장법인을 제외한 법인 3. 주권상장법인 : 다음 각 목의 어느 하나에 해당하는 법인 가. 증권시장에 상장된 주권을 발행한 법인 나. 주권과 관련된 증권예탁증권이 증권시장에 상장된 경우에는 그 주권을 발행한 법인 4. 주권비상장법인 : 주권상장법인을 제외한 법인 ⑯ 이 법에서 \\\"외국법인등\\\"이란 다음 각 호의 어느 하나에 해당하는 자를 말한다. 1. 외국 정부 2. 외국 지방자치단체 3. 외국 공공단체 4. 외국 법령에 따라 설립된 외국 기업 5. 대통령령으로 정하는 국제기구 6. 그 밖에 외국에 있는 법인 등으로서 대통령령으로 정하는 자 ⑰ 이 법에서 \\\"금융투자업관계기관\\\"이란 다음 각 호의 자를 말한다. <개정 2009.2.3, 2013.4.5, 2013.5.28> 1. 제283조에 따라 설립된 한국금융투자협회(이하 \\\"협회\\\"라 한다) 2. 제294조에 따라 설립된 한국예탁결제원(이하 \\\"예탁결제원\\\"이라 한다) 2의2. 제323조의3에 따라 인가를 받은 자(이하 \\\"금융투자상품거래청산회사\\\"라 한다) 3. 제324조제1항에 따라 인가를 받은 자(이하 \\\"증권금융회사\\\"라 한다) 3의2. 제335조의3에 따라 인가를 받은 자(이하 \\\"신용평가회사\\\"라 한다) 4. 제336조에 따른 종합금융회사 5. 제355조제1항에 따라 인가를 받은 자(이하 \\\"자금중개회사\\\"라 한다) 6. 제360조제1항에 따라 인가를 받은 자(이하 \\\"단기금융회사\\\"라 한다) 7. 제365조제1항에 따라 등록한 자(이하 \\\"명의개서대행회사\\\"라 한다) 8. 제370조에 따라 설립된 금융투자 관계 단체 ⑱ 이 법에서 \\\"집합투자기구\\\"란 집합투자를 수행하기 위한 기구로서 다음 각 호의 것을 말한다. <개정 2013.5.28> 1. 집합투자업자인 위탁자가 신탁업자에게 신탁한 재산을 신탁업자로 하여금 그 집합투자업자의 지시에 따라 투자ㆍ운용하게 하는 신탁 형태의 집합투자기구(이하 \\\"투자신탁\\\"이라 한다) 2. 「상법」에 따른 주식회사 형태의 집합투자기구(이하 \\\"투자회사\\\"라 한다) 3. 「상법」에 따른 유한회사 형태의 집합투자기구(이하 \\\"투자유한회사\\\"라 한다) 4. 「상법」에 따른 합자회사 형태의 집합투자기구(이하 \\\"투자합자회사\\\"라 한다) 4의2. 「상법」에 따른 유한책임회사 형태의 집합투자기구(이하 \\\"투자유한책임회사\\\"라 한다) 5. 「상법」에 따른 합자조합 형태의 집합투자기구(이하 \\\"투자합자조합\\\"이라 한다) 6. 「상법」에 따른 익명조합 형태의 집합투자기구(이하 \\\"투자익명조합\\\"이라 한다) 7. 삭제 <2015.7.24> ⑲ 이 법에서 \\\"사모집합투자기구\\\"란 집합투자증권을 사모로만 발행하는 집합투자기구로서 대통령령으로 정하는 투자자의 총수가 대통령령으로 정하는 방법에 따라 산출한 100인 이하인 것을 말하며, 다음 각 호와 같이 구분한다. <개정 2015.7.24, 2021.4.20> 1. 제249조의11제6항에 해당하는 자만을 사원으로 하는 투자합자회사인 사모집합투자기구(이하 \\\"기관전용 사모집합투자기구\\\"라 한다) 2. 기관전용 사모집합투자기구를 제외한 사모집합투자기구(이하 \\\"일반 사모집합투자기구\\\"라 한다) ⑳ 이 법에서 \\\"집합투자재산\\\"이란 집합투자기구의 재산으로서 투자신탁재산, 투자회사재산, 투자유한회사재산, 투자합자회사재산, 투자유한책임회사재산, 투자합자조합재산 및 투자익명조합재산을 말한다. <개정 2013.5.28> ㉑ 이 법에서 \\\"집합투자증권\\\"이란 집합투자기구에 대한 출자지분(투자신탁의 경우에는 수익권을 말한다)이 표시된 것을 말한다. ㉒ 이 법에서 \\\"집합투자규약\\\"이란 집합투자기구의 조직, 운영 및 투자자의 권리ㆍ의무를 정한 것으로서 투자신탁의 신탁계약, 투자회사ㆍ투자유한회사ㆍ투자합자회사ㆍ투자유한책임회사의 정관 및 투자합자조합ㆍ투자익명조합의 조합계약을 말한다. <개정 2013.5.28> ㉓ 이 법에서 \\\"집합투자자총회\\\"란 집합투자기구의 투자자 전원으로 구성된 의사결정기관으로서 수익자총회, 주주총회, 사원총회, 조합원총회 및 익명조합원총회를 말한다. ㉔ 이 법에서 \\\"신탁\\\"이란 「신탁법」 제2조의 신탁을 말한다. <개정 2011.7.25> ㉕ 이 법에서 \\\"금융투자상품거래청산업\\\"이란 금융투자업자 및 대통령령으로 정하는 자(이하 \\\"청산대상업자\\\"라 한다)를 상대방으로 하여 청산대상업자가 대통령령으로 정하는 금융투자상품의 거래(이하 \\\"청산대상거래\\\"라 한다)를 함에 따라 발생하는 채무를 채무인수, 경개(更改), 그 밖의 방법으로 부담하는 것을 영업으로 하는 것을 말한다. <신설 2013.4.5> ㉖ 이 법에서 \\\"신용평가업\\\"이란 다음 각 호의 어느 하나에 해당하는 것에 대한 신용상태를 평가(이하 \\\"신용평가\\\"라 한다)하여 그 결과에 대하여 기호, 숫자 등을 사용하여 표시한 등급(이하 \\\"신용등급\\\"이라 한다)을 부여하고 그 신용등급을 발행인, 인수인, 투자자, 그 밖의 이해관계자에게 제공하거나 열람하게 하는 행위를 영업으로 하는 것을 말한다. <신설 2013.5.28> 1. 금융투자상품 2. 기업ㆍ집합투자기구, 그 밖에 대통령령으로 정하는 자 ㉗ 이 법에서 \\\"온라인소액투자중개업자\\\"란 온라인상에서 누구의 명의로 하든지 타인의 계산으로 다음 각 호의 자가, 대통령령으로 정하는 방법으로 발행하는 채무증권, 지분증권, 투자계약증권의 모집 또는 사모에 관한 중개(이하 \\\"온라인소액투자중개\\\"라 한다)를 영업으로 하는 투자중개업자를 말한다. <신설 2015.7.24, 2021.12.28> 1. 「중소기업창업 지원법」 제2조제3호에 따른 창업기업 중 대통령령으로 정하는 자 2. 그 밖에 대통령령으로 정하는 요건에 부합하는 자 ㉘ 이 법에서 \\\"일반 사모집합투자업\\\"이란 집합투자업 중 일반 사모집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2015.7.24, 2021.4.20> ㉙ 이 법에서 \\\"일반 사모집합투자업자\\\"란 집합투자업자 중 일반 사모집합투자업을 영위하는 자를 말한다. <신설 2015.7.24, 2021.4.20> ㉚ 이 법에서 \\\"기업성장집합투자업\\\"이란 집합투자업 중 제229조제6호에 따른 기업성장집합투자기구를 통한 집합투자를 영업으로 하는 것을 말한다. <신설 2025.9.16> ㉛ 이 법에서 \\\"기업성장집합투자업자\\\"란 집합투자업자 중 기업성장집합투자업을 영위하는 자를 말한다. <신설 2025.9.16>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-MAN-01\", \"check\": \"투자일임업자가 선량한 관리자의 주의로 일임재산을 운용하도록(선관·충실의무) 규정되어 있는가\", \"label\": \"투자일임 선관·충실의무\", \"module\": \"M-MANDATE\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(의무) — 자본시장법 제96조(투자일임업자 선관·충실의무)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"statutory_duty\", \"contract_requirement\": \"none\", \"triggers\": {\"keywords\": [\"투자일임\", \"선관\", \"충실의무\", \"운용\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제96조\", \"clause\": \"제1항\", \"quote\": \"투자일임업자는 투자자에 대하여 선량한 관리자의 주의로써 투자일임재산을 운용하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제96조(선관의무 및 충실의무) 제96조(선관의무 및 충실의무) ① 투자자문업자는 투자자에 대하여 선량한 관리자의 주의로써 투자자문에 응하여야 하며, 투자일임업자는 투자자에 대하여 선량한 관리자의 주의로써 투자일임재산을 운용하여야 한다. ② 투자자문업자 및 투자일임업자는 투자자의 이익을 보호하기 위하여 해당 업무를 충실하게 수행하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"투자일임업자가 선량한 관리자의 주의로 일임재산을 운용하도록(선관·충실의무) 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"INV-MAN-02\", \"check\": \"이해상충(고유재산 거래·자기이익 도모 등) 불건전 영업행위 금지가 반영되어 있는가\", \"label\": \"이해상충 영업행위 금지\", \"module\": \"M-MANDATE\", \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 자본시장법 제98조(투자일임 불건전 영업행위 금지)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이해상충\", \"고유재산\", \"불건전\", \"자기거래\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제98조\", \"clause\": \"제2항 제6호\", \"quote\": \"투자일임재산으로 투자일임업자 또는 그 이해관계인의 고유재산과 거래하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제98조(불건전 영업행위의 금지) 제98조(불건전 영업행위의 금지) ① 투자자문업자 또는 투자일임업자는 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니 된다. 다만, 투자자 보호 및 건전한 거래질서를 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 할 수 있다. <개정 2013.5.28> 1. 투자자로부터 금전ㆍ증권, 그 밖의 재산의 보관ㆍ예탁을 받는 행위 2. 투자자에게 금전ㆍ증권, 그 밖의 재산을 대여하거나 투자자에 대한 제삼자의 금전ㆍ증권, 그 밖의 재산의 대여를 중개ㆍ주선 또는 대리하는 행위 3. 투자권유자문인력 또는 투자운용인력이 아닌 자에게 투자자문업 또는 투자일임업을 수행하게 하는 행위 4. 계약으로 정한 수수료 외의 대가를 추가로 받는 행위 5. 투자자문에 응하거나 투자일임재산을 운용하는 경우 금융투자상품등의 가격에 중대한 영향을 미칠 수 있는 투자판단에 관한 자문 또는 매매 의사를 결정한 후 이를 실행하기 전에 그 금융투자상품등을 자기의 계산으로 매매하거나 제삼자에게 매매를 권유하는 행위 ② 투자일임업자는 투자일임재산을 운용함에 있어서 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니 된다. 다만, 투자자 보호 및 건전한 거래질서를 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 할 수 있다. <개정 2013.5.28> 1. 정당한 사유 없이 투자자의 운용방법의 변경 또는 계약의 해지 요구에 응하지 아니하는 행위 2. 자기 또는 관계인수인이 인수한 증권을 투자일임재산으로 매수하는 행위 3. 자기 또는 관계인수인이 대통령령으로 정하는 인수업무를 담당한 법인의 특정증권등(제172조제1항의 특정증권등을 말한다. 이하 이 호에서 같다)에 대하여 인위적인 시세(제176조제2항제1호의 시세를 말한다)를 형성하기 위하여 투자일임재산으로 그 특정증권등을 매매하는 행위 4. 특정 투자자의 이익을 해하면서 자기 또는 제삼자의 이익을 도모하는 행위 5. 투자일임재산으로 자기가 운용하는 다른 투자일임재산, 집합투자재산 또는 신탁재산과 거래하는 행위 6. 투자일임재산으로 투자일임업자 또는 그 이해관계인의 고유재산과 거래하는 행위 7. 투자자의 동의 없이 투자일임재산으로 투자일임업자 또는 그 이해관계인이 발행한 증권에 투자하는 행위 8. 투자일임재산을 각각의 투자자별로 운용하지 아니하고 여러 투자자의 자산을 집합하여 운용하는 행위 9. 투자자로부터 다음 각 목의 행위를 위임받는 행위 가. 투자일임재산을 예탁하는 투자매매업자ㆍ투자중개업자, 그 밖의 금융기관을 지정하거나 변경하는 행위 나. 투자일임재산을 예탁하거나 인출하는 행위 다. 투자일임재산에 속하는 증권의 의결권, 그 밖의 권리를 행사하는 행위 10. 그 밖에 투자자 보호 또는 건전한 거래질서를 해할 우려가 있는 행위로서 대통령령으로 정하는 행위\", \"status\": \"quote_ok\"}, {\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제98조\", \"clause\": \"제2항 제4호\", \"quote\": \"특정 투자자의 이익을 해하면서 자기 또는 제삼자의 이익을 도모하는 행위\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제98조(불건전 영업행위의 금지) 제98조(불건전 영업행위의 금지) ① 투자자문업자 또는 투자일임업자는 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니 된다. 다만, 투자자 보호 및 건전한 거래질서를 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 할 수 있다. <개정 2013.5.28> 1. 투자자로부터 금전ㆍ증권, 그 밖의 재산의 보관ㆍ예탁을 받는 행위 2. 투자자에게 금전ㆍ증권, 그 밖의 재산을 대여하거나 투자자에 대한 제삼자의 금전ㆍ증권, 그 밖의 재산의 대여를 중개ㆍ주선 또는 대리하는 행위 3. 투자권유자문인력 또는 투자운용인력이 아닌 자에게 투자자문업 또는 투자일임업을 수행하게 하는 행위 4. 계약으로 정한 수수료 외의 대가를 추가로 받는 행위 5. 투자자문에 응하거나 투자일임재산을 운용하는 경우 금융투자상품등의 가격에 중대한 영향을 미칠 수 있는 투자판단에 관한 자문 또는 매매 의사를 결정한 후 이를 실행하기 전에 그 금융투자상품등을 자기의 계산으로 매매하거나 제삼자에게 매매를 권유하는 행위 ② 투자일임업자는 투자일임재산을 운용함에 있어서 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니 된다. 다만, 투자자 보호 및 건전한 거래질서를 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 할 수 있다. <개정 2013.5.28> 1. 정당한 사유 없이 투자자의 운용방법의 변경 또는 계약의 해지 요구에 응하지 아니하는 행위 2. 자기 또는 관계인수인이 인수한 증권을 투자일임재산으로 매수하는 행위 3. 자기 또는 관계인수인이 대통령령으로 정하는 인수업무를 담당한 법인의 특정증권등(제172조제1항의 특정증권등을 말한다. 이하 이 호에서 같다)에 대하여 인위적인 시세(제176조제2항제1호의 시세를 말한다)를 형성하기 위하여 투자일임재산으로 그 특정증권등을 매매하는 행위 4. 특정 투자자의 이익을 해하면서 자기 또는 제삼자의 이익을 도모하는 행위 5. 투자일임재산으로 자기가 운용하는 다른 투자일임재산, 집합투자재산 또는 신탁재산과 거래하는 행위 6. 투자일임재산으로 투자일임업자 또는 그 이해관계인의 고유재산과 거래하는 행위 7. 투자자의 동의 없이 투자일임재산으로 투자일임업자 또는 그 이해관계인이 발행한 증권에 투자하는 행위 8. 투자일임재산을 각각의 투자자별로 운용하지 아니하고 여러 투자자의 자산을 집합하여 운용하는 행위 9. 투자자로부터 다음 각 목의 행위를 위임받는 행위 가. 투자일임재산을 예탁하는 투자매매업자ㆍ투자중개업자, 그 밖의 금융기관을 지정하거나 변경하는 행위 나. 투자일임재산을 예탁하거나 인출하는 행위 다. 투자일임재산에 속하는 증권의 의결권, 그 밖의 권리를 행사하는 행위 10. 그 밖에 투자자 보호 또는 건전한 거래질서를 해할 우려가 있는 행위로서 대통령령으로 정하는 행위\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-PART-01\", \"check\": \"조합(합자조합) 출자 시 유한책임사원(LP)의 책임이 출자가액 한도로 제한되는가\", \"label\": \"LP 유한책임 제한\", \"module\": \"M-PARTNER\", \"severity\": \"필수\", \"severity_basis\": \"선언규정(책임 한정) — 상법 제86조의2(유한책임조합원은 출자가액 한도 책임)\", \"norm_type\": \"선언\", \"severity_override\": true, \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"합자조합\", \"유한책임\", \"출자가액\", \"LP\", \"조합원\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제86조의2\", \"clause\": \"\", \"quote\": \"출자가액을 한도로 하여 유한책임을 지는 조합원이 상호출자하여 공동사업을 경영할 것을 약정\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제86조의2(의의) 제86조의2(의의) 합자조합은 조합의 업무집행자로서 조합의 채무에 대하여 무한책임을 지는 조합원과 출자가액을 한도로 하여 유한책임을 지는 조합원이 상호출자하여 공동사업을 경영할 것을 약정함으로써 그 효력이 생긴다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-PART-02\", \"check\": \"추가출자(Capital Call) 요구의 요건·한도·불이행 효과가 명확한가\", \"label\": \"추가출자 요건·효과\", \"module\": \"M-PARTNER\", \"severity\": \"필수\", \"severity_basis\": \"실무 항목이나 출자자(LP) 리스크 직결 — 법령 근거 없음. 리스크: 회사=LP 지위에서 캐피탈콜 요건·한도·디폴트효과 미비 시 예측불가 추가출자 노출 또는 기출자분 몰취 손실 직결(severity_override: risk)\", \"norm_type\": \"실무\", \"severity_override\": true, \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"capital call\", \"캐피탈콜\", \"추가출자\", \"출자요청\", \"디폴트\"]}, \"absence_check\": false, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-01\", \"check\": \"신탁계약 변경 중 수익자총회 결의가 필요한 사항을 구별하고 필요한 결의를 계약 변경의 효력 조건으로 두고 있는가\", \"label\": \"변경 시 수익자총회 결의\", \"module\": \"M-BENEF\", \"fund_scope\": [\"public\"], \"subject_roles\": [\"집합투자업자\", \"위탁회사\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(의무) — 자본시장법 제188조 제2항 후단(수익자 이익 관련 중요사항 변경은 미리 수익자총회 결의)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"변경\", \"수익자총회\", \"보수\", \"수수료\", \"신탁업자\", \"신탁계약기간\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제188조\", \"clause\": \"제2항\", \"quote\": \"이 경우 신탁계약 중 다음 각 호의 어느 하나에 해당하는 사항을 변경하는 경우에는 미리 제190조제5항 본문에 따른 수익자총회의 결의를 거쳐야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제188조(신탁계약의 체결 등) 제188조(신탁계약의 체결 등) ① 투자신탁을 설정하고자 하는 집합투자업자는 다음 각 호의 사항이 기재된 신탁계약서에 의하여 신탁업자와 신탁계약을 체결하여야 한다. <개정 2016.3.22> 1. 집합투자업자 및 신탁업자의 상호 2. 신탁원본의 가액 및 제189조제1항 및 제3항에 따라 발행하는 투자신탁의 수익권(이하 \\\"수익증권\\\"이라 한다)의 총좌수에 관한 사항 3. 투자신탁재산의 운용 및 관리에 관한 사항 4. 이익분배 및 환매에 관한 사항 5. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 계산방법과 지급시기ㆍ방법에 관한 사항. 다만, 집합투자업자가 기준가격 산정업무를 위탁하는 경우에는 그 수수료는 해당 투자신탁재산에서 부담한다는 내용을 포함하여야 한다. 6. 수익자총회에 관한 사항 7. 공시 및 보고서에 관한 사항 8. 그 밖에 수익자 보호를 위하여 필요한 사항으로서 대통령령으로 정하는 사항 ② 투자신탁을 설정한 집합투자업자는 신탁계약을 변경하고자 하는 경우에는 신탁업자와 변경계약을 체결하여야 한다. 이 경우 신탁계약 중 다음 각 호의 어느 하나에 해당하는 사항을 변경하는 경우에는 미리 제190조제5항 본문에 따른 수익자총회의 결의를 거쳐야 한다. <개정 2013.5.28> 1. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 인상 2. 신탁업자의 변경(합병ㆍ분할ㆍ분할합병, 그 밖에 대통령령으로 정하는 사유로 변경되는 경우를 제외한다) 3. 신탁계약기간의 변경(투자신탁을 설정할 당시에 그 기간변경이 신탁계약서에 명시되어 있는 경우는 제외한다) 4. 그 밖에 수익자의 이익과 관련된 중요한 사항으로서 대통령령으로 정하는 사항 ③ 투자신탁을 설정한 집합투자업자는 제2항에 따라 신탁계약을 변경한 경우에는 인터넷 홈페이지 등을 이용하여 공시하여야 하며, 제2항 후단에 따라 신탁계약을 변경한 경우에는 공시 외에 이를 수익자에게 통지하여야 한다. ④ 집합투자업자는 제1항에 따라 투자신탁을 설정하는 경우(그 투자신탁을 추가로 설정하는 경우를 포함한다) 신탁업자에게 해당 신탁계약에서 정한 신탁원본 전액을 금전으로 납입하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"계약 변경의 결의 필요성 및 효력 조건이라는 구조를 검토한다. 수익자총회가 실제로 개최·의결되었는지 확인하는 운영 점검은 제외한다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"decision_question\": \"신탁계약 변경 중 수익자총회 결의가 필요한 사항을 구별하고 필요한 결의를 계약 변경의 효력 조건으로 두고 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\"}, {\"id\": \"INV-BEN-02\", \"check\": \"수익자총회 결의를 요하는 변경에 반대할 경우, 수익증권매수청구권(결의일부터 20일 내, 비용 부담 없음)이 보장되어 있는가\", \"label\": \"반대수익자 매수청구권\", \"module\": \"M-BENEF\", \"fund_scope\": [\"public\"], \"subject_roles\": [\"수익자\", \"집합투자업자\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(권리 보장·비용전가 금지) — 자본시장법 제191조 제1항·제2항(반대수익자의 수익증권매수청구권)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"매수청구\", \"반대\", \"수익증권 매수\", \"매수를 청구\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제191조\", \"clause\": \"제1항 제1호\", \"quote\": \"반대(수익자총회 전에 해당 집합투자업자에게 서면으로 그 결의에 반대하는 의사를 통지한 경우로 한정한다)하는 수익자가 그 수익자총회의 결의일부터 20일 이내에 수익증권의 매수를 청구하는 경우\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제191조(반대수익자의 수익증권매수청구권) 제191조(반대수익자의 수익증권매수청구권) ① 투자신탁의 수익자는 다음 각 호의 어느 하나에 해당하는 경우 집합투자업자에게 수익증권의 수를 기재한 서면으로 자기가 소유하고 있는 수익증권의 매수를 청구할 수 있다. <개정 2013.5.28> 1. 제188조제2항 각 호 외의 부분 후단에 따른 신탁계약의 변경 또는 제193조제2항에 따른 투자신탁의 합병에 대한 수익자총회의 결의에 반대(수익자총회 전에 해당 집합투자업자에게 서면으로 그 결의에 반대하는 의사를 통지한 경우로 한정한다)하는 수익자가 그 수익자총회의 결의일부터 20일 이내에 수익증권의 매수를 청구하는 경우 2. 제193조제2항 각 호 외의 부분 단서에 따른 투자신탁의 합병에 반대하는 수익자가 대통령령으로 정하는 방법에 따라 수익증권의 매수를 청구하는 경우 ② 투자신탁을 설정한 집합투자업자는 제1항에 따른 청구가 있는 경우 해당 수익자에게 수익증권의 매수에 따른 수수료, 그 밖의 비용을 부담시켜서는 아니 된다. ③ 투자신탁을 설정한 집합투자업자는 제1항에 따른 청구가 있는 경우에는 매수청구기간이 만료된 날부터 15일 이내에 그 투자신탁재산으로 대통령령으로 정하는 방법에 따라 그 수익증권을 매수하여야 한다. 다만, 매수자금이 부족하여 매수에 응할 수 없는 경우에는 금융위원회의 승인을 받아 수익증권의 매수를 연기할 수 있다. <개정 2008.2.29> ④ 투자신탁을 설정한 집합투자업자는 제3항 본문에 따라 수익증권을 매수한 경우에는 지체 없이 그 수익증권을 소각(消却)하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제191조\", \"clause\": \"제2항\", \"quote\": \"해당 수익자에게 수익증권의 매수에 따른 수수료, 그 밖의 비용을 부담시켜서는 아니 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제191조(반대수익자의 수익증권매수청구권) 제191조(반대수익자의 수익증권매수청구권) ① 투자신탁의 수익자는 다음 각 호의 어느 하나에 해당하는 경우 집합투자업자에게 수익증권의 수를 기재한 서면으로 자기가 소유하고 있는 수익증권의 매수를 청구할 수 있다. <개정 2013.5.28> 1. 제188조제2항 각 호 외의 부분 후단에 따른 신탁계약의 변경 또는 제193조제2항에 따른 투자신탁의 합병에 대한 수익자총회의 결의에 반대(수익자총회 전에 해당 집합투자업자에게 서면으로 그 결의에 반대하는 의사를 통지한 경우로 한정한다)하는 수익자가 그 수익자총회의 결의일부터 20일 이내에 수익증권의 매수를 청구하는 경우 2. 제193조제2항 각 호 외의 부분 단서에 따른 투자신탁의 합병에 반대하는 수익자가 대통령령으로 정하는 방법에 따라 수익증권의 매수를 청구하는 경우 ② 투자신탁을 설정한 집합투자업자는 제1항에 따른 청구가 있는 경우 해당 수익자에게 수익증권의 매수에 따른 수수료, 그 밖의 비용을 부담시켜서는 아니 된다. ③ 투자신탁을 설정한 집합투자업자는 제1항에 따른 청구가 있는 경우에는 매수청구기간이 만료된 날부터 15일 이내에 그 투자신탁재산으로 대통령령으로 정하는 방법에 따라 그 수익증권을 매수하여야 한다. 다만, 매수자금이 부족하여 매수에 응할 수 없는 경우에는 금융위원회의 승인을 받아 수익증권의 매수를 연기할 수 있다. <개정 2008.2.29> ④ 투자신탁을 설정한 집합투자업자는 제3항 본문에 따라 수익증권을 매수한 경우에는 지체 없이 그 수익증권을 소각(消却)하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-03\", \"check\": \"집합투자업자의 선관주의·충실의무(투자자 이익 보호)를 배제·완화하는 면책조항이 없는가\", \"label\": \"운용사 면책조항 과도 여부\", \"module\": \"M-BENEF\", \"subject_roles\": [\"집합투자업자\", \"위탁회사\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(의무) — 자본시장법 제79조(집합투자업자의 선관의무·충실의무). 이를 배제하는 약정은 수익자에게 불리\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"면책\", \"책임을 지지 아니\", \"선량한 관리자\", \"충실\", \"고의 또는 중과실\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제79조\", \"clause\": \"제1항\", \"quote\": \"집합투자업자는 투자자에 대하여 선량한 관리자의 주의로써 집합투자재산을 운용하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제79조(선관의무 및 충실의무) 제79조(선관의무 및 충실의무) ① 집합투자업자는 투자자에 대하여 선량한 관리자의 주의로써 집합투자재산을 운용하여야 한다. ② 집합투자업자는 투자자의 이익을 보호하기 위하여 해당 업무를 충실하게 수행하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제79조\", \"clause\": \"제2항\", \"quote\": \"집합투자업자는 투자자의 이익을 보호하기 위하여 해당 업무를 충실하게 수행하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제79조(선관의무 및 충실의무) 제79조(선관의무 및 충실의무) ① 집합투자업자는 투자자에 대하여 선량한 관리자의 주의로써 집합투자재산을 운용하여야 한다. ② 집합투자업자는 투자자의 이익을 보호하기 위하여 해당 업무를 충실하게 수행하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-04\", \"check\": \"신탁계약 변경 시 수익자에 대한 공시·통지 절차가 확보되어 있는가\", \"label\": \"변경 공시·통지\", \"module\": \"M-BENEF\", \"fund_scope\": [\"public\"], \"subject_roles\": [\"집합투자업자\", \"위탁회사\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(의무) — 자본시장법 제188조 제3항(변경 시 공시, 총회 결의사항 변경 시 수익자 통지)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"공시\", \"통지\", \"인터넷 홈페이지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제188조\", \"clause\": \"제3항\", \"quote\": \"인터넷 홈페이지 등을 이용하여 공시하여야 하며, 제2항 후단에 따라 신탁계약을 변경한 경우에는 공시 외에 이를 수익자에게 통지하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제188조(신탁계약의 체결 등) 제188조(신탁계약의 체결 등) ① 투자신탁을 설정하고자 하는 집합투자업자는 다음 각 호의 사항이 기재된 신탁계약서에 의하여 신탁업자와 신탁계약을 체결하여야 한다. <개정 2016.3.22> 1. 집합투자업자 및 신탁업자의 상호 2. 신탁원본의 가액 및 제189조제1항 및 제3항에 따라 발행하는 투자신탁의 수익권(이하 \\\"수익증권\\\"이라 한다)의 총좌수에 관한 사항 3. 투자신탁재산의 운용 및 관리에 관한 사항 4. 이익분배 및 환매에 관한 사항 5. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 계산방법과 지급시기ㆍ방법에 관한 사항. 다만, 집합투자업자가 기준가격 산정업무를 위탁하는 경우에는 그 수수료는 해당 투자신탁재산에서 부담한다는 내용을 포함하여야 한다. 6. 수익자총회에 관한 사항 7. 공시 및 보고서에 관한 사항 8. 그 밖에 수익자 보호를 위하여 필요한 사항으로서 대통령령으로 정하는 사항 ② 투자신탁을 설정한 집합투자업자는 신탁계약을 변경하고자 하는 경우에는 신탁업자와 변경계약을 체결하여야 한다. 이 경우 신탁계약 중 다음 각 호의 어느 하나에 해당하는 사항을 변경하는 경우에는 미리 제190조제5항 본문에 따른 수익자총회의 결의를 거쳐야 한다. <개정 2013.5.28> 1. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 인상 2. 신탁업자의 변경(합병ㆍ분할ㆍ분할합병, 그 밖에 대통령령으로 정하는 사유로 변경되는 경우를 제외한다) 3. 신탁계약기간의 변경(투자신탁을 설정할 당시에 그 기간변경이 신탁계약서에 명시되어 있는 경우는 제외한다) 4. 그 밖에 수익자의 이익과 관련된 중요한 사항으로서 대통령령으로 정하는 사항 ③ 투자신탁을 설정한 집합투자업자는 제2항에 따라 신탁계약을 변경한 경우에는 인터넷 홈페이지 등을 이용하여 공시하여야 하며, 제2항 후단에 따라 신탁계약을 변경한 경우에는 공시 외에 이를 수익자에게 통지하여야 한다. ④ 집합투자업자는 제1항에 따라 투자신탁을 설정하는 경우(그 투자신탁을 추가로 설정하는 경우를 포함한다) 신탁업자에게 해당 신탁계약에서 정한 신탁원본 전액을 금전으로 납입하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"신탁계약 변경 시 수익자에 대한 공시·통지 절차가 확보되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"INV-BEN-05\", \"check\": \"이익분배·환매(환매기간·환매수수료·환매연기 사유)에 관한 사항이 수익자에게 불리하지 않게 정해져 있는가\", \"label\": \"이익분배·환매 조건\", \"module\": \"M-BENEF\", \"severity\": \"권장\", \"severity_basis\": \"선언규정 — 자본시장법 제188조 제1항 제4호(신탁계약 필수 기재사항으로 이익분배·환매를 규정). 기재 자체는 강행이나 내용의 유·불리는 개별 판단\", \"norm_type\": \"선언\", \"severity_override\": true, \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"환매\", \"이익분배\", \"환매수수료\", \"환매연기\", \"분배금\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제188조\", \"clause\": \"제1항 제4호\", \"quote\": \"이익분배 및 환매에 관한 사항\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제188조(신탁계약의 체결 등) 제188조(신탁계약의 체결 등) ① 투자신탁을 설정하고자 하는 집합투자업자는 다음 각 호의 사항이 기재된 신탁계약서에 의하여 신탁업자와 신탁계약을 체결하여야 한다. <개정 2016.3.22> 1. 집합투자업자 및 신탁업자의 상호 2. 신탁원본의 가액 및 제189조제1항 및 제3항에 따라 발행하는 투자신탁의 수익권(이하 \\\"수익증권\\\"이라 한다)의 총좌수에 관한 사항 3. 투자신탁재산의 운용 및 관리에 관한 사항 4. 이익분배 및 환매에 관한 사항 5. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 계산방법과 지급시기ㆍ방법에 관한 사항. 다만, 집합투자업자가 기준가격 산정업무를 위탁하는 경우에는 그 수수료는 해당 투자신탁재산에서 부담한다는 내용을 포함하여야 한다. 6. 수익자총회에 관한 사항 7. 공시 및 보고서에 관한 사항 8. 그 밖에 수익자 보호를 위하여 필요한 사항으로서 대통령령으로 정하는 사항 ② 투자신탁을 설정한 집합투자업자는 신탁계약을 변경하고자 하는 경우에는 신탁업자와 변경계약을 체결하여야 한다. 이 경우 신탁계약 중 다음 각 호의 어느 하나에 해당하는 사항을 변경하는 경우에는 미리 제190조제5항 본문에 따른 수익자총회의 결의를 거쳐야 한다. <개정 2013.5.28> 1. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 인상 2. 신탁업자의 변경(합병ㆍ분할ㆍ분할합병, 그 밖에 대통령령으로 정하는 사유로 변경되는 경우를 제외한다) 3. 신탁계약기간의 변경(투자신탁을 설정할 당시에 그 기간변경이 신탁계약서에 명시되어 있는 경우는 제외한다) 4. 그 밖에 수익자의 이익과 관련된 중요한 사항으로서 대통령령으로 정하는 사항 ③ 투자신탁을 설정한 집합투자업자는 제2항에 따라 신탁계약을 변경한 경우에는 인터넷 홈페이지 등을 이용하여 공시하여야 하며, 제2항 후단에 따라 신탁계약을 변경한 경우에는 공시 외에 이를 수익자에게 통지하여야 한다. ④ 집합투자업자는 제1항에 따라 투자신탁을 설정하는 경우(그 투자신탁을 추가로 설정하는 경우를 포함한다) 신탁업자에게 해당 신탁계약에서 정한 신탁원본 전액을 금전으로 납입하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"부동산펀드는 환매금지형이 다수 — 환매 조항 부재 자체가 이상은 아니며 폐쇄형 여부·중도해지 가능성 확인이 요점\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-06\", \"check\": \"집합투자업자·신탁업자가 받는 보수·수수료의 계산방법과 지급시기·방법이 명확히 특정되어 있는가\", \"label\": \"보수·수수료 산정 명확성\", \"module\": \"M-BENEF\", \"subject_roles\": [\"집합투자업자\", \"신탁업자\", \"위탁회사\", \"수탁회사\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(의무) — 자본시장법 제188조 제1항 제5호(보수·수수료 계산방법·지급시기·방법 기재 의무)\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"보수\", \"수수료\", \"계산방법\", \"지급시기\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제188조\", \"clause\": \"제1항 제5호\", \"quote\": \"집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 계산방법과 지급시기ㆍ방법에 관한 사항\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제188조(신탁계약의 체결 등) 제188조(신탁계약의 체결 등) ① 투자신탁을 설정하고자 하는 집합투자업자는 다음 각 호의 사항이 기재된 신탁계약서에 의하여 신탁업자와 신탁계약을 체결하여야 한다. <개정 2016.3.22> 1. 집합투자업자 및 신탁업자의 상호 2. 신탁원본의 가액 및 제189조제1항 및 제3항에 따라 발행하는 투자신탁의 수익권(이하 \\\"수익증권\\\"이라 한다)의 총좌수에 관한 사항 3. 투자신탁재산의 운용 및 관리에 관한 사항 4. 이익분배 및 환매에 관한 사항 5. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 계산방법과 지급시기ㆍ방법에 관한 사항. 다만, 집합투자업자가 기준가격 산정업무를 위탁하는 경우에는 그 수수료는 해당 투자신탁재산에서 부담한다는 내용을 포함하여야 한다. 6. 수익자총회에 관한 사항 7. 공시 및 보고서에 관한 사항 8. 그 밖에 수익자 보호를 위하여 필요한 사항으로서 대통령령으로 정하는 사항 ② 투자신탁을 설정한 집합투자업자는 신탁계약을 변경하고자 하는 경우에는 신탁업자와 변경계약을 체결하여야 한다. 이 경우 신탁계약 중 다음 각 호의 어느 하나에 해당하는 사항을 변경하는 경우에는 미리 제190조제5항 본문에 따른 수익자총회의 결의를 거쳐야 한다. <개정 2013.5.28> 1. 집합투자업자ㆍ신탁업자 등이 받는 보수, 그 밖의 수수료의 인상 2. 신탁업자의 변경(합병ㆍ분할ㆍ분할합병, 그 밖에 대통령령으로 정하는 사유로 변경되는 경우를 제외한다) 3. 신탁계약기간의 변경(투자신탁을 설정할 당시에 그 기간변경이 신탁계약서에 명시되어 있는 경우는 제외한다) 4. 그 밖에 수익자의 이익과 관련된 중요한 사항으로서 대통령령으로 정하는 사항 ③ 투자신탁을 설정한 집합투자업자는 제2항에 따라 신탁계약을 변경한 경우에는 인터넷 홈페이지 등을 이용하여 공시하여야 하며, 제2항 후단에 따라 신탁계약을 변경한 경우에는 공시 외에 이를 수익자에게 통지하여야 한다. ④ 집합투자업자는 제1항에 따라 투자신탁을 설정하는 경우(그 투자신탁을 추가로 설정하는 경우를 포함한다) 신탁업자에게 해당 신탁계약에서 정한 신탁원본 전액을 금전으로 납입하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-07\", \"check\": \"집합투자규약에서 정한 방법으로 전체 투자자에게 통지하는 절차가 마련되어 있는가(사모는 공시·공고를 이 통지로 갈음)\", \"label\": \"규약상 투자자 통지 절차\", \"module\": \"M-BENEF\", \"fund_scope\": [\"private\"], \"subject_roles\": [\"집합투자업자\", \"위탁회사\"], \"severity\": \"권장\", \"severity_basis\": \"임의규정(갈음 요건) — 자본시장법 제249조의8 제6항. 사모는 총회·공시 의무가 배제되므로 규약상 통지가 실질적 정보접근 수단이 됨\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"통지\", \"집합투자규약\", \"전체 투자자\", \"규약에서 정한\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제249조의8\", \"clause\": \"제6항\", \"quote\": \"집합투자규약에서 정한 방법으로 전체 투자자에게 통지한 경우에는 이 법 또는 「상법」에 따라 공시 또는 공고한 것으로 본다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제249조의8(일반 사모집합투자기구에 대한 특례) 제249조의8(일반 사모집합투자기구에 대한 특례) ① 제76조제2항부터 제6항까지, 제81조부터 제83조까지, 제88조, 제89조(제186조제2항에서 준용하는 경우를 포함한다), 제90조(제186조제2항에서 준용하는 경우를 포함한다), 제91조제3항(제186조제2항에서 준용하는 경우를 포함한다), 제93조, 제94조제1항부터 제4항까지, 같은 조 제6항, 제182조, 제183조제1항, 제186조(제87조를 준용하는 경우는 제외한다), 제188조제2항ㆍ제3항, 제189조제2항, 제195조, 제196조제5항(제208조제3항, 제216조제2항, 제217조의3제3항, 제222조제2항 및 제227조제2항에서 준용하는 경우를 포함한다), 제197조, 제198조제2항ㆍ제3항, 제199조, 제200조, 제207조제5항, 제208조제1항(제216조제2항, 제222조제2항 및 제227조제2항에서 준용하는 경우를 포함한다), 제211조제1항, 제213조제5항, 제216조제1항, 제217조의2제5항, 제217조의3제1항, 제217조의6제1항, 제218조제3항, 제222조제1항, 제224조제3항, 제227조제1항, 제229조, 제230조, 제235조, 제237조, 제238조제7항ㆍ제8항, 제239조제1항제3호, 같은 조 제2항부터 제5항까지, 제240조제3항부터 제8항까지, 같은 조 제10항, 제241조, 제247조제1항부터 제4항까지, 같은 조 제5항제1호부터 제3호까지, 같은 항 제6호ㆍ제7호, 같은 조 제6항ㆍ제7항, 제248조 및 제253조는 일반 사모집합투자기구에는 적용하지 아니한다. <개정 2020.3.24, 2021.4.20> ② 제1항에도 불구하고 일반투자자를 대상으로 하는 일반 사모집합투자기구에는 다음 각 호의 조항을 적용한다. 다만, 제5호의 경우 다른 사모집합투자기구에 투자하는 집합투자기구로서 일반투자자를 대상으로 하는 일반 사모집합투자기구 등 대통령령으로 정하는 집합투자기구는 일반투자자로 본다. <신설 2021.4.20> 1. 제76조제2항. 다만, 제92조제1항제1호 및 제2호(제186조제2항에서 준용하는 경우를 포함한다)에 따른 통지를 받은 경우로 한정한다. 2. 제88조. 다만, 전문투자자에 대해서는 자산운용보고서를 교부하지 아니할 수 있다. 3. 제230조제5항 4. 제240조제3항부터 제10항까지의 규정. 다만, 투자자 전원의 동의를 얻은 경우 및 투자자의 이익을 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 적용하지 아니한다. 5. 제247조(집합투자재산을 보관ㆍ관리하는 신탁업자가 제42조제1항에 따라 다른 신탁업자에게 업무를 위탁한 경우에는 당사자 간 합의가 있는 경우를 제외하고 위탁한 신탁업자가 제247조를 이행하여야 한다). 이 경우 \\\"투자설명서\\\"는 \\\"핵심상품설명서\\\"로, \\\"3영업일\\\"은 \\\"3영업일 또는 집합투자업자가 3영업일 이내에 요구를 이행하기 곤란한 불가피한 사유가 있는 경우로서 일반 사모집합투자기구의 집합투자재산을 보관ㆍ관리하는 신탁업자와 이행을 위한 기간을 따로 합의한 경우에는 그 기간\\\"으로 각각 본다. ③ 일반 사모집합투자기구의 투자자는 그 집합투자증권을 적격투자자가 아닌 자에게 양도해서는 아니 된다. <개정 2021.4.20> ④ 일반 사모집합투자기구의 투자자(투자신탁의 경우 그 투자신탁재산을 운용하는 일반 사모집합투자업자를 말한다)는 제188조제4항, 제194조제7항(제196조제6항에서 준용하는 경우를 포함한다), 제207조제4항, 제213조제4항, 제217조의2제4항, 제218조제2항 및 제224조제2항에도 불구하고 객관적인 가치평가가 가능하고 다른 투자자의 이익을 해칠 우려가 없는 경우에는 대통령령으로 정하는 방법에 따라 증권, 부동산 또는 실물자산 등 금전 외의 자산으로 납입할 수 있다. <개정 2021.4.20> ⑤ 집합투자자총회 및 그와 관련된 사항은 일반 사모집합투자기구에는 적용하지 아니한다. 다만, 제1항에도 불구하고 일반투자자를 대상으로 하는 일반 사모집합투자기구의 경우에는 제237조를 적용하며, 이 경우 집합투자자총회 결의일은 환매를 연기한 날부터 3개월 이내로 한다. <개정 2021.4.20> ⑥ 일반 사모집합투자기구인 투자신탁이나 투자익명조합의 집합투자업자 또는 일반 사모집합투자기구인 투자회사등이 이 법 또는 「상법」에 따라 투자자에게 공시 또는 공고하여야 하는 사항에 대하여 집합투자규약에서 정한 방법으로 전체 투자자에게 통지한 경우에는 이 법 또는 「상법」에 따라 공시 또는 공고한 것으로 본다. <개정 2021.4.20> ⑦ 일반 사모집합투자기구인 투자회사는 일반 사모집합투자업자인 법인이사 1명을 두며, 「상법」 제383조제1항에도 불구하고 이사의 수를 1명 또는 2명으로 할 수 있다. <개정 2021.4.20> ⑧ 일반 사모집합투자기구는 집합투자규약에 따라 투자자에 대한 손익의 분배 또는 손익의 순위 등에 관한 사항을 정할 수 있다. <개정 2021.4.20> ⑨ 제7조제6항제3호에도 불구하고 일반 사모집합투자업자가 자신이 운용하는 일반 사모집합투자기구의 집합투자증권을 판매하는 경우에는 제71조제5호부터 제7호까지(제7호의 경우 같은 호에 따른 대통령령으로 정하는 행위 중 대통령령으로 정하는 것으로 한정한다), 제74조 및 제76조제1항을 준용한다. 이 경우 제74조 및 제76조제1항 중 \\\"투자매매업자 또는 투자중개업자는\\\"은 \\\"자신이 운용하는 일반 사모집합투자기구의 집합투자증권을 판매하는 일반 사모집합투자업자는\\\"으로 본다. <개정 2021.4.20>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"집합투자규약에서 정한 방법으로 전체 투자자에게 통지하는 절차가 마련되어 있는가(사모는 공시·공고를 이 통지로 갈음)?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\"}, {\"id\": \"INV-BEN-08\", \"check\": \"수익증권 양도가 적격투자자에 한정된다는 제한이 반영되어 있는가(사모 수익증권의 양도 상대방 제한)\", \"label\": \"적격투자자 양도 제한\", \"module\": \"M-BENEF\", \"fund_scope\": [\"private\"], \"subject_roles\": [\"수익자\", \"투자자\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지) — 자본시장법 제249조의8 제3항(일반 사모집합투자기구의 투자자는 적격투자자가 아닌 자에게 양도 금지). 당사가 보유분을 처분할 때 직접 적용되는 제약\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"양도\", \"적격투자자\", \"수익증권의 양도\", \"전자등록\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제249조의8\", \"clause\": \"제3항\", \"quote\": \"일반 사모집합투자기구의 투자자는 그 집합투자증권을 적격투자자가 아닌 자에게 양도해서는 아니 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제249조의8(일반 사모집합투자기구에 대한 특례) 제249조의8(일반 사모집합투자기구에 대한 특례) ① 제76조제2항부터 제6항까지, 제81조부터 제83조까지, 제88조, 제89조(제186조제2항에서 준용하는 경우를 포함한다), 제90조(제186조제2항에서 준용하는 경우를 포함한다), 제91조제3항(제186조제2항에서 준용하는 경우를 포함한다), 제93조, 제94조제1항부터 제4항까지, 같은 조 제6항, 제182조, 제183조제1항, 제186조(제87조를 준용하는 경우는 제외한다), 제188조제2항ㆍ제3항, 제189조제2항, 제195조, 제196조제5항(제208조제3항, 제216조제2항, 제217조의3제3항, 제222조제2항 및 제227조제2항에서 준용하는 경우를 포함한다), 제197조, 제198조제2항ㆍ제3항, 제199조, 제200조, 제207조제5항, 제208조제1항(제216조제2항, 제222조제2항 및 제227조제2항에서 준용하는 경우를 포함한다), 제211조제1항, 제213조제5항, 제216조제1항, 제217조의2제5항, 제217조의3제1항, 제217조의6제1항, 제218조제3항, 제222조제1항, 제224조제3항, 제227조제1항, 제229조, 제230조, 제235조, 제237조, 제238조제7항ㆍ제8항, 제239조제1항제3호, 같은 조 제2항부터 제5항까지, 제240조제3항부터 제8항까지, 같은 조 제10항, 제241조, 제247조제1항부터 제4항까지, 같은 조 제5항제1호부터 제3호까지, 같은 항 제6호ㆍ제7호, 같은 조 제6항ㆍ제7항, 제248조 및 제253조는 일반 사모집합투자기구에는 적용하지 아니한다. <개정 2020.3.24, 2021.4.20> ② 제1항에도 불구하고 일반투자자를 대상으로 하는 일반 사모집합투자기구에는 다음 각 호의 조항을 적용한다. 다만, 제5호의 경우 다른 사모집합투자기구에 투자하는 집합투자기구로서 일반투자자를 대상으로 하는 일반 사모집합투자기구 등 대통령령으로 정하는 집합투자기구는 일반투자자로 본다. <신설 2021.4.20> 1. 제76조제2항. 다만, 제92조제1항제1호 및 제2호(제186조제2항에서 준용하는 경우를 포함한다)에 따른 통지를 받은 경우로 한정한다. 2. 제88조. 다만, 전문투자자에 대해서는 자산운용보고서를 교부하지 아니할 수 있다. 3. 제230조제5항 4. 제240조제3항부터 제10항까지의 규정. 다만, 투자자 전원의 동의를 얻은 경우 및 투자자의 이익을 해할 우려가 없는 경우로서 대통령령으로 정하는 경우에는 이를 적용하지 아니한다. 5. 제247조(집합투자재산을 보관ㆍ관리하는 신탁업자가 제42조제1항에 따라 다른 신탁업자에게 업무를 위탁한 경우에는 당사자 간 합의가 있는 경우를 제외하고 위탁한 신탁업자가 제247조를 이행하여야 한다). 이 경우 \\\"투자설명서\\\"는 \\\"핵심상품설명서\\\"로, \\\"3영업일\\\"은 \\\"3영업일 또는 집합투자업자가 3영업일 이내에 요구를 이행하기 곤란한 불가피한 사유가 있는 경우로서 일반 사모집합투자기구의 집합투자재산을 보관ㆍ관리하는 신탁업자와 이행을 위한 기간을 따로 합의한 경우에는 그 기간\\\"으로 각각 본다. ③ 일반 사모집합투자기구의 투자자는 그 집합투자증권을 적격투자자가 아닌 자에게 양도해서는 아니 된다. <개정 2021.4.20> ④ 일반 사모집합투자기구의 투자자(투자신탁의 경우 그 투자신탁재산을 운용하는 일반 사모집합투자업자를 말한다)는 제188조제4항, 제194조제7항(제196조제6항에서 준용하는 경우를 포함한다), 제207조제4항, 제213조제4항, 제217조의2제4항, 제218조제2항 및 제224조제2항에도 불구하고 객관적인 가치평가가 가능하고 다른 투자자의 이익을 해칠 우려가 없는 경우에는 대통령령으로 정하는 방법에 따라 증권, 부동산 또는 실물자산 등 금전 외의 자산으로 납입할 수 있다. <개정 2021.4.20> ⑤ 집합투자자총회 및 그와 관련된 사항은 일반 사모집합투자기구에는 적용하지 아니한다. 다만, 제1항에도 불구하고 일반투자자를 대상으로 하는 일반 사모집합투자기구의 경우에는 제237조를 적용하며, 이 경우 집합투자자총회 결의일은 환매를 연기한 날부터 3개월 이내로 한다. <개정 2021.4.20> ⑥ 일반 사모집합투자기구인 투자신탁이나 투자익명조합의 집합투자업자 또는 일반 사모집합투자기구인 투자회사등이 이 법 또는 「상법」에 따라 투자자에게 공시 또는 공고하여야 하는 사항에 대하여 집합투자규약에서 정한 방법으로 전체 투자자에게 통지한 경우에는 이 법 또는 「상법」에 따라 공시 또는 공고한 것으로 본다. <개정 2021.4.20> ⑦ 일반 사모집합투자기구인 투자회사는 일반 사모집합투자업자인 법인이사 1명을 두며, 「상법」 제383조제1항에도 불구하고 이사의 수를 1명 또는 2명으로 할 수 있다. <개정 2021.4.20> ⑧ 일반 사모집합투자기구는 집합투자규약에 따라 투자자에 대한 손익의 분배 또는 손익의 순위 등에 관한 사항을 정할 수 있다. <개정 2021.4.20> ⑨ 제7조제6항제3호에도 불구하고 일반 사모집합투자업자가 자신이 운용하는 일반 사모집합투자기구의 집합투자증권을 판매하는 경우에는 제71조제5호부터 제7호까지(제7호의 경우 같은 호에 따른 대통령령으로 정하는 행위 중 대통령령으로 정하는 것으로 한정한다), 제74조 및 제76조제1항을 준용한다. 이 경우 제74조 및 제76조제1항 중 \\\"투자매매업자 또는 투자중개업자는\\\"은 \\\"자신이 운용하는 일반 사모집합투자기구의 집합투자증권을 판매하는 일반 사모집합투자업자는\\\"으로 본다. <개정 2021.4.20>\", \"status\": \"quote_ok\"}], \"note\": \"2026-08-05 사용자 검토 사례의 '수익증권의 양도 및 질권설정' 조항에 실제로 대응하는 항목 — 담보 대항요건 체크(FIN-SEC 계열) 대신 이 관점이 맞음\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-BEN-09\", \"check\": \"신탁업자(수탁회사)가 집합투자업자의 계열회사가 아니며, 신탁재산을 고유재산과 분별하여 관리하도록 되어 있는가\", \"label\": \"수탁 독립성·분별관리\", \"module\": \"M-BENEF\", \"subject_roles\": [\"신탁업자\", \"수탁회사\"], \"severity\": \"필수\", \"severity_basis\": \"강행규정(금지·의무) — 자본시장법 제246조 제1항(신탁업자는 집합투자업자의 계열회사 금지)·제2항(분별관리). §249-8 배제 목록에 없어 사모에도 적용\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"신탁업자\", \"계열회사\", \"분별하여\", \"고유재산\", \"보관·관리\", \"예탁\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제246조\", \"clause\": \"제1항\", \"quote\": \"집합투자재산을 보관ㆍ관리하는 신탁업자는 다음 각 호의 어느 하나에 해당하는 자의 계열회사여서는 아니 된다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제246조(신탁업자의 업무제한 등) 제246조(신탁업자의 업무제한 등) ① 집합투자재산을 보관ㆍ관리하는 신탁업자는 다음 각 호의 어느 하나에 해당하는 자의 계열회사여서는 아니 된다. <개정 2013.5.28> 1. 해당 집합투자기구(투자회사ㆍ투자유한회사ㆍ투자합자회사 및 투자유한책임회사로 한정한다) 2. 그 집합투자재산을 운용하는 집합투자업자 ② 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산을 자신의 고유재산, 다른 집합투자재산 또는 제삼자로부터 보관을 위탁받은 재산과 구분하여 관리하여야 한다. 이 경우 집합투자재산이라는 사실과 위탁자를 명기하여야 한다. ③ 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산 중 증권, 그 밖에 대통령령으로 정하는 것을 자신의 고유재산과 구분하여 집합투자기구별로 예탁결제원에 예탁하여야 한다. 다만, 해당 증권의 유통 가능성, 다른 법령에 따른 유통방법이 있는지 여부, 예탁의 실행 가능성 등을 고려하여 대통령령으로 정하는 경우에는 그러하지 아니하다. <개정 2013.5.28> ④ 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산을 운용하는 집합투자업자가 제80조에 따라 그 신탁업자에 대하여 자산의 취득ㆍ처분 등의 이행 또는 보관ㆍ관리 등에 필요한 지시를 하는 경우 대통령령으로 정하는 방법에 따라 이를 각각의 집합투자기구별로 이행하여야 한다. ⑤ 집합투자재산을 보관ㆍ관리하는 신탁업자는 자신이 보관ㆍ관리하는 집합투자재산을 자신의 고유재산, 다른 집합투자재산 또는 제삼자로부터 보관을 위탁받은 재산과 거래하여서는 아니 된다. 다만, 집합투자재산을 효율적으로 운용하기 위하여 필요한 경우로서 대통령령으로 정하는 경우에는 그러하지 아니하다. <신설 2009.2.3, 2013.5.28> ⑥ 집합투자재산을 보관ㆍ관리하는 신탁업자는 자신이 보관ㆍ관리하는 집합투자재산을 그 이해관계인의 고유재산과 거래하여서는 아니 된다. <신설 2009.2.3> ⑦ 집합투자재산을 보관ㆍ관리하는 신탁업자는 그 집합투자기구의 집합투자재산에 관한 정보를 자기의 고유재산의 운용, 자기가 운용하는 집합투자재산의 운용 또는 자기가 판매하는 집합투자증권의 판매를 위하여 이용하여서는 아니 된다. <신설 2009.2.3>\", \"status\": \"quote_ok\"}, {\"law\": \"자본시장과 금융투자업에 관한 법률\", \"article\": \"제246조\", \"clause\": \"제2항\", \"quote\": \"집합투자재산을 자신의 고유재산, 다른 집합투자재산 또는 제삼자로부터 보관을 위탁받은 재산과 구분하여 관리하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제246조(신탁업자의 업무제한 등) 제246조(신탁업자의 업무제한 등) ① 집합투자재산을 보관ㆍ관리하는 신탁업자는 다음 각 호의 어느 하나에 해당하는 자의 계열회사여서는 아니 된다. <개정 2013.5.28> 1. 해당 집합투자기구(투자회사ㆍ투자유한회사ㆍ투자합자회사 및 투자유한책임회사로 한정한다) 2. 그 집합투자재산을 운용하는 집합투자업자 ② 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산을 자신의 고유재산, 다른 집합투자재산 또는 제삼자로부터 보관을 위탁받은 재산과 구분하여 관리하여야 한다. 이 경우 집합투자재산이라는 사실과 위탁자를 명기하여야 한다. ③ 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산 중 증권, 그 밖에 대통령령으로 정하는 것을 자신의 고유재산과 구분하여 집합투자기구별로 예탁결제원에 예탁하여야 한다. 다만, 해당 증권의 유통 가능성, 다른 법령에 따른 유통방법이 있는지 여부, 예탁의 실행 가능성 등을 고려하여 대통령령으로 정하는 경우에는 그러하지 아니하다. <개정 2013.5.28> ④ 집합투자재산을 보관ㆍ관리하는 신탁업자는 집합투자재산을 운용하는 집합투자업자가 제80조에 따라 그 신탁업자에 대하여 자산의 취득ㆍ처분 등의 이행 또는 보관ㆍ관리 등에 필요한 지시를 하는 경우 대통령령으로 정하는 방법에 따라 이를 각각의 집합투자기구별로 이행하여야 한다. ⑤ 집합투자재산을 보관ㆍ관리하는 신탁업자는 자신이 보관ㆍ관리하는 집합투자재산을 자신의 고유재산, 다른 집합투자재산 또는 제삼자로부터 보관을 위탁받은 재산과 거래하여서는 아니 된다. 다만, 집합투자재산을 효율적으로 운용하기 위하여 필요한 경우로서 대통령령으로 정하는 경우에는 그러하지 아니하다. <신설 2009.2.3, 2013.5.28> ⑥ 집합투자재산을 보관ㆍ관리하는 신탁업자는 자신이 보관ㆍ관리하는 집합투자재산을 그 이해관계인의 고유재산과 거래하여서는 아니 된다. <신설 2009.2.3> ⑦ 집합투자재산을 보관ㆍ관리하는 신탁업자는 그 집합투자기구의 집합투자재산에 관한 정보를 자기의 고유재산의 운용, 자기가 운용하는 집합투자재산의 운용 또는 자기가 판매하는 집합투자증권의 판매를 위하여 이용하여서는 아니 된다. <신설 2009.2.3>\", \"status\": \"quote_ok\"}], \"note\": \"수익자 원본 보호의 실질 장치 — 총회가 없는 사모에서 특히 중요. 공모·사모 공통 적용(§249-8 배제 목록 미포함)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"INV-MAN-03\", \"module\": \"M-MANDATE\", \"check\": \"투자일임재산의 분별관리(고유재산과 분리보관)와 신탁업자 예탁 등 재산보호 장치가 규정되어 있는가\", \"label\": \"일임재산 분별관리·보호\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"실무 항목이나 회사=위임자 원본손실 방어 직결 — 일임재산이 운용사 고유재산과 분리·예탁되지 않으면 운용사 도산 시 회사 자산이 도산재단에 혼입되어 회수 불능. 자본시장법상 분별관리 의무의 계약 반영 여부(원문 미대조)로 practice(severity_override: risk)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"분별관리\", \"고유재산\", \"예탁\", \"신탁업자\", \"재산보관\", \"분리보관\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"INV-MAN-01(선관·충실)·INV-MAN-02(이해상충)는 운용행위 규제이나, 운용사 도산 국면에서 회사 원본을 지키는 것은 분별관리·예탁. 원본손실 방어 관점 신규 제안. 자본시장법 분별관리·투자자예탁 조문 원문 대조 후 statute 승격 후보. \", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"투자일임재산의 분별관리(고유재산과 분리보관)와 신탁업자 예탁 등 재산보호 장치가 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}]}, {\"meta\": {\"type_id\": \"nda\", \"type_name\": \"정보·비밀보호(NDA·정보제공)\", \"detect_keywords\": [\"비밀유지\", \"비밀정보\", \"영업비밀\", \"기밀\", \"NDA\", \"비공개\", \"비밀보장\", \"기밀유지협약\", \"정보제공 계약\", \"본인확인\", \"개인정보처리위탁\"], \"modules\": [{\"id\": \"M-NDA\", \"name\": \"비밀유지 기본\", \"always_on\": true, \"screening_question\": null, \"suggest_keywords\": []}]}, \"checks\": [{\"id\": \"NDA-12\", \"module\": \"M-NDA\", \"check\": \"계약 종료 또는 요청 시 비밀정보의 반환·파기 의무가 약정되어 있는가\", \"label\": \"반환·파기 의무\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"반환\", \"파기\", \"폐기\", \"사본\", \"반납\", \"파기확인서\", \"증빙\", \"파기 사실 확인\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"종료 또는 요청 등 계약에서 정한 사유에 따라 비밀정보를 반환·파기하는 의무를 확인한다. 파기확인서 등 증빙 방식은 약정된 경우 함께 읽되 반드시 같은 양식의 증빙을 요구하지 않는다. 실제 반환·파기 완료는 확인하지 않는다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"계약 종료 또는 요청 시 비밀정보의 반환·파기 의무가 약정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"반환·파기와 증빙은 정보 성격과 보관 필요에 따라 정하는 종료 후 통제사항임\", \"contract_action_curated\": true}, {\"id\": \"NDA-14\", \"module\": \"M-NDA\", \"check\": \"법정 구제수단(침해금지·예방청구, 손해액 추정, 징벌적 배상, 신용회복조치, 비밀유지명령)을 제한·배제하는 문언이 없는가\", \"label\": \"법정 구제수단 보전\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 부정경쟁방지 및 영업비밀보호에 관한 법률 제10조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"금지청구\", \"침해금지\", \"예방\", \"가처분\", \"침해행위의 금지\", \"손해액 추정\", \"이익액\", \"징벌적\", \"5배\", \"배액\", \"신용회복\", \"신용 실추\", \"비밀유지명령\", \"열람 제한\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제10조\", \"clause\": \"제1항\", \"quote\": \"영업비밀의 보유자는 영업비밀 침해행위를 하거나 하려는 자에 대하여 그 행위에 의하여 영업상의 이익이 침해되거나 침해될 우려가 있는 경우에는 법원에 그 행위의 금지 또는 예방을 청구할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제10조(영업비밀 침해행위에 대한 금지청구권 등)\\n① 영업비밀의 보유자는 영업비밀 침해행위를 하거나 하려는 자에 대하여 그 행위에 의하여 영업상의 이익이 침해되거나 침해될 우려가 있는 경우에는 법원에 그 행위의 금지 또는 예방을 청구할 수 있다.\\n② 영업비밀 보유자가 제1항에 따른 청구를 할 때에는 침해행위를 조성한 물건의 폐기, 침해행위에 제공된 설비의 제거, 그 밖에 침해행위의 금지 또는 예방을 위하여 필요한 조치를 함께 청구할 수 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제14조의2\", \"clause\": \"제2항\", \"quote\": \"영업상의 이익을 침해한 자가 그 침해행위에 의하여 이익을 받은 것이 있으면 그 이익액을 영업상의 이익을 침해당한 자의 손해액으로 추정한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제14조의2(손해액의 추정 등)\\n① 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자가 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 영업상의 이익을 침해한 자가 그 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위(이하 이 항에서 \\\"부정경쟁행위등침해행위\\\"라 한다)를 하게 한 물건을 양도하였을 때에는 다음 각 호에 해당하는 금액의 합계액을 손해액으로 할 수 있다.\\n1.  그 물건의 양도수량(영업상의 이익을 침해당한 자가 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 사정이 있는 경우에는 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 수량을 뺀 수량) 중 영업상의 이익을 침해당한 자가 생산할 수 있었던 물건의 수량에서 실제 판매한 물건의 수량을 뺀 수량을 넘지 아니하는 수량에 영업상의 이익을 침해당한 자가 그 부정경쟁행위등침해행위가 없었다면 판매할 수 있었던 물건의 단위수량당 이익액을 곱한 금액\\n2.  그 물건의 양도수량 중 영업상의 이익을 침해당한 자가 생산할 수 있었던 물건의 수량에서 실제 판매한 물건의 수량을 뺀 수량을 넘는 수량 또는 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 수량이 있는 경우 이들 수량에 대해서는 영업상의 이익을 침해당한 자가 부정경쟁행위등침해행위가 없었으면 합리적으로 받을 수 있는 금액\\n② 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자가 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 영업상의 이익을 침해한 자가 그 침해행위에 의하여 이익을 받은 것이 있으면 그 이익액을 영업상의 이익을 침해당한 자의 손해액으로 추정한다.\\n③ 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자는 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 부정경쟁행위 또는 제3조의2제1항이나 제2항을 위반한 행위의 대상이 된 상품 등에 사용된 상표 등 표지의 사용 또는 영업비밀 침해행위의 대상이 된 영업비밀의 사용에 대하여 통상 받을 수 있는 금액에 상당하는 금액을 자기의 손해액으로 하여 손해배상을 청구할 수 있다.\\n④ 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 인한 손해액이 제3항에 따른 금액을 초과하면 그 초과액에 대하여도 손해배상을 청구할 수 있다. 이 경우 그 영업상의 이익을 침해한 자에게 고의 또는 중대한 과실이 없으면 법원은 손해배상 금액을 산정할 때 이를 고려할 수 있다.\\n⑤ 법원은 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위에 관한 소송에서 손해가 발생된 것은 인정되나 그 손해액을 입증하기 위하여 필요한 사실을 입증하는 것이 해당 사실의 성질상 극히 곤란한 경우에는 제1항부터 제4항까지의 규정에도 불구하고 변론 전체의 취지와 증거조사의 결과에 기초하여 상당한 손해액을 인정할 수 있다.\\n⑥ 법원은 제2조제1호차목의 행위 및 영업비밀 침해행위가 고의적인 것으로 인정되는 경우에는 제5조 또는 제11조에도 불구하고 제1항부터 제5항까지의 규정에 따라 손해로 인정된 금액의 5배를 넘지 아니하는 범위에서 배상액을 정할 수 있다.\\n⑦ 제6항에 따른 배상액을 판단할 때에는 다음 각 호의 사항을 고려하여야 한다.\\n1.  침해행위를 한 자의 우월적 지위 여부\\n2.  고의 또는 손해 발생의 우려를 인식한 정도\\n3.  침해행위로 인하여 영업비밀 보유자가 입은 피해규모\\n4.  침해행위로 인하여 침해한 자가 얻은 경제적 이익\\n5.  침해행위의 기간ㆍ횟수 등\\n6.  침해행위에 따른 벌금\\n7.  침해행위를 한 자의 재산상태\\n8.  침해행위를 한 자의 피해구제 노력의 정도\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제14조의2\", \"clause\": \"제6항\", \"quote\": \"영업비밀 침해행위가 고의적인 것으로 인정되는 경우에는 제5조 또는 제11조에도 불구하고 제1항부터 제5항까지의 규정에 따라 손해로 인정된 금액의 5배를 넘지 아니하는 범위에서 배상액을 정할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제14조의2(손해액의 추정 등)\\n① 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자가 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 영업상의 이익을 침해한 자가 그 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위(이하 이 항에서 \\\"부정경쟁행위등침해행위\\\"라 한다)를 하게 한 물건을 양도하였을 때에는 다음 각 호에 해당하는 금액의 합계액을 손해액으로 할 수 있다.\\n1.  그 물건의 양도수량(영업상의 이익을 침해당한 자가 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 사정이 있는 경우에는 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 수량을 뺀 수량) 중 영업상의 이익을 침해당한 자가 생산할 수 있었던 물건의 수량에서 실제 판매한 물건의 수량을 뺀 수량을 넘지 아니하는 수량에 영업상의 이익을 침해당한 자가 그 부정경쟁행위등침해행위가 없었다면 판매할 수 있었던 물건의 단위수량당 이익액을 곱한 금액\\n2.  그 물건의 양도수량 중 영업상의 이익을 침해당한 자가 생산할 수 있었던 물건의 수량에서 실제 판매한 물건의 수량을 뺀 수량을 넘는 수량 또는 그 부정경쟁행위등침해행위 외의 사유로 판매할 수 없었던 수량이 있는 경우 이들 수량에 대해서는 영업상의 이익을 침해당한 자가 부정경쟁행위등침해행위가 없었으면 합리적으로 받을 수 있는 금액\\n② 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자가 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 영업상의 이익을 침해한 자가 그 침해행위에 의하여 이익을 받은 것이 있으면 그 이익액을 영업상의 이익을 침해당한 자의 손해액으로 추정한다.\\n③ 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 영업상의 이익을 침해당한 자는 제5조 또는 제11조에 따른 손해배상을 청구하는 경우 부정경쟁행위 또는 제3조의2제1항이나 제2항을 위반한 행위의 대상이 된 상품 등에 사용된 상표 등 표지의 사용 또는 영업비밀 침해행위의 대상이 된 영업비밀의 사용에 대하여 통상 받을 수 있는 금액에 상당하는 금액을 자기의 손해액으로 하여 손해배상을 청구할 수 있다.\\n④ 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 인한 손해액이 제3항에 따른 금액을 초과하면 그 초과액에 대하여도 손해배상을 청구할 수 있다. 이 경우 그 영업상의 이익을 침해한 자에게 고의 또는 중대한 과실이 없으면 법원은 손해배상 금액을 산정할 때 이를 고려할 수 있다.\\n⑤ 법원은 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위에 관한 소송에서 손해가 발생된 것은 인정되나 그 손해액을 입증하기 위하여 필요한 사실을 입증하는 것이 해당 사실의 성질상 극히 곤란한 경우에는 제1항부터 제4항까지의 규정에도 불구하고 변론 전체의 취지와 증거조사의 결과에 기초하여 상당한 손해액을 인정할 수 있다.\\n⑥ 법원은 제2조제1호차목의 행위 및 영업비밀 침해행위가 고의적인 것으로 인정되는 경우에는 제5조 또는 제11조에도 불구하고 제1항부터 제5항까지의 규정에 따라 손해로 인정된 금액의 5배를 넘지 아니하는 범위에서 배상액을 정할 수 있다.\\n⑦ 제6항에 따른 배상액을 판단할 때에는 다음 각 호의 사항을 고려하여야 한다.\\n1.  침해행위를 한 자의 우월적 지위 여부\\n2.  고의 또는 손해 발생의 우려를 인식한 정도\\n3.  침해행위로 인하여 영업비밀 보유자가 입은 피해규모\\n4.  침해행위로 인하여 침해한 자가 얻은 경제적 이익\\n5.  침해행위의 기간ㆍ횟수 등\\n6.  침해행위에 따른 벌금\\n7.  침해행위를 한 자의 재산상태\\n8.  침해행위를 한 자의 피해구제 노력의 정도\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제12조\", \"quote\": \"영업비밀 보유자의 청구에 의하여 제11조에 따른 손해배상을 갈음하거나 손해배상과 함께 영업상의 신용을 회복하는 데에 필요한 조치를 명할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제12조(영업비밀 보유자의 신용회복)\\n법원은 고의 또는 과실에 의한 영업비밀 침해행위로 영업비밀 보유자의 영업상의 신용을 실추시킨 자에게는 영업비밀 보유자의 청구에 의하여 제11조에 따른 손해배상을 갈음하거나 손해배상과 함께 영업상의 신용을 회복하는 데에 필요한 조치를 명할 수 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"부정경쟁방지 및 영업비밀보호에 관한 법률\", \"article\": \"제14조의4\", \"clause\": \"제1항\", \"quote\": \"해당 소송의 계속적인 수행 외의 목적으로 사용하거나 그 영업비밀에 관계된 이 항에 따른 명령을 받은 자 외의 자에게 공개하지 아니할 것을 명할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제14조의4(비밀유지명령)\\n① 법원은 부정경쟁행위, 제3조의2제1항이나 제2항을 위반한 행위 또는 영업비밀 침해행위로 인한 영업상 이익의 침해에 관한 소송에서 그 당사자가 보유한 영업비밀에 대하여 다음 각 호의 사유를 모두 소명한 경우에는 그 당사자의 신청에 따라 결정으로 다른 당사자(법인인 경우에는 그 대표자), 당사자를 위하여 소송을 대리하는 자, 그 밖에 해당 소송으로 인하여 영업비밀을 알게 된 자에게 그 영업비밀을 해당 소송의 계속적인 수행 외의 목적으로 사용하거나 그 영업비밀에 관계된 이 항에 따른 명령을 받은 자 외의 자에게 공개하지 아니할 것을 명할 수 있다. 다만, 그 신청 시점까지 다른 당사자(법인인 경우에는 그 대표자), 당사자를 위하여 소송을 대리하는 자, 그 밖에 해당 소송으로 인하여 영업비밀을 알게 된 자가 제1호에 규정된 준비서면의 열람이나 증거 조사 외의 방법으로 그 영업비밀을 이미 취득하고 있는 경우에는 그러하지 아니하다.\\n1.  이미 제출하였거나 제출하여야 할 준비서면 또는 이미 조사하였거나 조사하여야 할 증거 또는 제14조의7에 따라 송부된 조사기록에 영업비밀이 포함되어 있다는 것\\n2.  제1호의 영업비밀이 해당 소송 수행 외의 목적으로 사용되거나 공개되면 당사자의 영업에 지장을 줄 우려가 있어 이를 방지하기 위하여 영업비밀의 사용 또는 공개를 제한할 필요가 있다는 것\\n② 제1항에 따른 명령(이하 \\\"비밀유지명령\\\"이라 한다)의 신청은 다음 각 호의 사항을 적은 서면으로 하여야 한다.\\n1.  비밀유지명령을 받을 자\\n2.  비밀유지명령의 대상이 될 영업비밀을 특정하기에 충분한 사실\\n3.  제1항 각 호의 사유에 해당하는 사실\\n③ 법원은 비밀유지명령이 결정된 경우에는 그 결정서를 비밀유지명령을 받은 자에게 송달하여야 한다.\\n④ 비밀유지명령은 제3항의 결정서가 비밀유지명령을 받은 자에게 송달된 때부터 효력이 발생한다.\\n⑤ 비밀유지명령의 신청을 기각 또는 각하한 재판에 대하여는 즉시항고를 할 수 있다.\", \"status\": \"quote_ok\"}], \"note\": \"법정 구제권 5종(§10 금지·예방청구, §14조의2② 손해액 추정, §14조의2⑥ 5배 징벌배상, §12 신용회복, §14조의4 비밀유지명령) — 계약서에서 판정할 실질은 '배제 조항 유무' 하나. NDA-16·17·18·19 통합(2026-07-29 지식 다이어트, 각 근거는 sources 병기)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}]}, {\"meta\": {\"type_id\": \"outsourcing\", \"type_name\": \"업무위탁\", \"detect_keywords\": [\"위탁\", \"수탁\", \"위수탁\", \"업무위탁\", \"대행\", \"위탁운영\", \"사무처리\", \"콜센터\", \"접수심사\", \"위임계약\", \"위탁계약서\", \"파견\"], \"modules\": [{\"id\": \"M-DISPATCH\", \"name\": \"도급·파견 경계\", \"always_on\": false, \"screening_question\": \"수탁자 인력이 위탁자 사업장에 상주하며 지휘를 받는가?\", \"suggest_keywords\": [\"상주\", \"파견\", \"근무 장소\", \"지휘\", \"감독\"]}]}, \"checks\": [{\"id\": \"CORE-01\", \"module\": \"X-FINOUT\", \"check\": \"위수탁 당사자 간 합의한 업무범위 등 계약조건이 위탁계약서에 반드시 반영·교부되도록 되어 있는가\", \"label\": \"합의 업무범위 계약서 반영\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"위탁업무\", \"업무의 범위\", \"위탁의 범위\", \"위탁 대상\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"손해사정 업무위탁 및 손해사정사 선임 등에 관한 모범규준\", \"article\": \"제5조\", \"clause\": \"제5항 제1호\", \"quote\": \"보험회사는 손해사정 위수탁 당사자 간 합의한 업무범위 등 계약조건을 반드시 반영하여 손해사정업무 위탁계약서를 작성하고 교부하여야 한다\", \"verified\": true, \"source_type\": \"self_regulation\", \"text\": \"제5조(위탁손해사정사 위탁 절차) ① 보험회사의 위탁 절차는 위탁 대상 업무설정, 위탁 대상 보험사고 및 상품 설정, 업체 현황 조사, 후보선정, 비교평가, 후보당사자 의견 청취, 계약체결, 보험업감독규정 제9-21조의2에 따른 예탁보증여부 및 인허가보증보험 가입여부 확인, 결과‧평가요소의 안내 등 모든 위탁 관련 업무를 포함한다.\\n② 보험회사는 손해사정사 또는 손해사정업자가 제출한 손해사정 업무 결과 등 객관적인 평가자료에 근거하여 그 업무에 소요되는 필요 비용을 고려한 합리적인 위탁수수료 산정‧지급체계를 설계하여야 하고, 자회사와 비자회사 위탁손해사정사를 불합리한 방식으로 차별하여서는 아니된다.\\n③ 보험회사는 손해사정에 관한 업무를 자회사인 위탁손해사정사에게 일정 비율을 초과하여 위탁한 경우에는 제1항에 따른 위탁절차와 동 위탁절차에 따른 위탁결과 등을 연1회 이사회에 보고하고 홈페이지에 공시하여야 한다.\\n④ 제3항의 일정비율은 각 보험회사의 직전년도 전체 손해사정업무 중 위탁된 손해사정업무가 차지하는 비율의 100분의 50을 말하고, 동 위탁 건수 산정 대상이 되는 업무 범위는 보험업법 제188조 손해사정사의 업무를 의미한다.\\n⑤ 보험회사는 위탁 계약 체결 및 이행과 관련하여 손해사정사 또는 손해사정업자에게 보험회사에 유리한 손해사정을 강요할 수 없고, 손해사정의 공정성을 보호하기 위하여 다음 각 호의 원칙을 준수하여야 한다.\\n1. 보험회사는 손해사정 위수탁 당사자 간 합의한 업무범위 등 계약조건을 반드시 반영하여 손해사정업무 위탁계약서를 작성하고 교부하여야 한다.\\n2. 보험회사는 손해사정 위탁계약서상 계약사항을 이행하지 않거나 위탁계약서에 정한 업무 외의 업무를 강요할 수 없다.\\n3. 보험회사는 위탁손해사정사 선정을 위한 입찰 전후로 “예정 가격”을 1개 사례에 대해서만 형식적으로 조사하거나, 시장 평균 대비 과도하게 낮추어 조사하는 등 예정 가격을 낮추도록 유도할 수 없다.\\n4. 보험회사는 보험업감독규정 제9-21조에 따른 보정요청 등 정당한 사유 없이 손해사정서상 결정된 보험금 지급 금액을 임의 변경하여 지급할 수 없다. 다만, 배상책임보험의 사고 당사자 간 합의에 따른 조정 등은 제외한다.\\n5. 보험회사의 자체 의료자문 결과를 손해사정서 작성 전에 위탁손해사정사에게 송부하거나, 보험금 합의 및 제한 요건/기준을 설정하는 등 손해사정 결과에 영향력을 행사 할 수 없다.\\n⑥ 보험회사는 다음 각 호의 경우를 제외하고는 위탁계약에 따라 수수료를 지급하여야 한다.\\n1. 조사 중단, 미결 등 손해사정사 또는 손해사정업자가 위탁계약서에서 정한 사항을 준수하지 못하는 경우\\n2. 손해사정사 또는 손해사정업자가 보험업법 제189조, 보험업법시행령 제99조, 보험업감독규정 제9-14조 등을 위반하는 경우\\n3. 손해사정사 또는 손해사정업자가 보험계약자와 분쟁을 야기하거나, 손해사정 미이행 및 불완전 이행을 고의 또는 중과실로 초래한 경우\\n⑦ 보험회사, 보험협회, 손해사정사 또는 손해사정업자 단체는 위탁실무의 공정성과 관련된 사안을 논의하기 위하여 손해사정 협의체를 구성 및 운영할 수 있다.\", \"status\": \"quote_ok\"}], \"note\": \"자율규제(손해사정 업무위탁 모범규준)는 손해사정 위탁에 한해 업무범위 계약서 반영 의무를 부과 — 일반 위탁의 참고 근거\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"financial_outsourcing\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"적용되는 손해사정 위탁에서는 합의한 업무범위와 계약조건의 계약서 반영·교부가 요구됨\", \"contract_action_curated\": true}, {\"id\": \"CORE-02\", \"module\": \"X-FINOUT\", \"check\": \"위탁 업무가 인가받은 금융업 또는 다른 금융업의 본질적 요소를 포함하지 않는가\", \"label\": \"본질적 요소 불포함\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"본질적 요소\", \"위탁업무의 범위\", \"인가\"]}, \"evidence_required_groups\": [[\"본질적 요소\", \"핵심업무\", \"본질적 업무\"], [\"인가\", \"금융업\"]], \"absence_check\": false, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제1항 제1호\", \"quote\": \"인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"note\": \"본질적 요소의 범위는 제3조 제2항 별표 2 — 별표는 DB 미수록(원문 미확인)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"financial_outsourcing\"}, {\"id\": \"CORE-03\", \"module\": \"X-FINOUT\", \"check\": \"본질적 요소를 포함하는 업무라면 제3조 제1항 제1호 가목·나목의 예외에 해당하는 근거가 확인되는가\", \"label\": \"본질적 요소 예외 근거\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"본질적 요소\", \"금융위원회가 인정\", \"예외\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제1항 제1호 단서\", \"quote\": \"다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"financial_outsourcing\"}, {\"id\": \"CORE-04\", \"module\": \"X-FINOUT\", \"check\": \"위탁 업무가 관련 법령에서 금융기관이 직접 수행하도록 의무를 부여한 업무에 해당하지 않는가\", \"label\": \"직접수행 의무 업무 배제\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"법령상 의무\", \"직접 수행\", \"의무를 부여\"]}, \"evidence_required_groups\": [[\"직접 수행\", \"직접수행\", \"금융기관이 수행\", \"의무를 부여\"]], \"absence_check\": false, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제1항 제2호\", \"quote\": \"관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"financial_outsourcing\"}, {\"id\": \"CORE-06\", \"module\": \"X-FINOUT\", \"check\": \"위탁업무 처리가 금융실명법 등 관련 법령에 저촉되지 않도록 하는 법령 준수 조항이 있는가\", \"label\": \"금융실명법 등 법령준수\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"금융실명\", \"관련 법령\", \"법령 준수\", \"컴플라이언스\"]}, \"evidence_required_groups\": [[\"금융실명\", \"실명거래\", \"실명법\"]], \"absence_check\": true, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제3항 제5호\", \"quote\": \"「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"financial_outsourcing\", \"decision_question\": \"위탁업무 처리가 금융실명법 등 관련 법령에 저촉되지 않도록 하는 법령 준수 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"법령준수의무는 법에서 직접 발생하고 포괄 준수문구는 계약상 보강수단임\", \"contract_action_curated\": true}, {\"id\": \"CORE-07\", \"module\": \"X-FINOUT\", \"check\": \"수탁자가 위탁자의 사전 동의 없이 재위탁하지 못하도록 하는 조항이 있는가\", \"label\": \"재위탁 사전동의\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"임의 서술이나 위탁자 동의는 강행적 전제임 — 금융기관의 업무위탁 등에 관한 규정 제3조 (PRIV-15·IT-09와 정합)\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"implementation_channel\": \"cooperation_control\", \"contract_requirement\": \"derived\", \"triggers\": {\"keywords\": [\"재위탁\", \"재수탁\", \"사전 동의\", \"제3자에게 위탁\"]}, \"llm_elements\": [\"재위탁 제한 또는 금지\", \"위탁자의 사전 동의\"], \"absence_check\": true, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제4항\", \"quote\": \"제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"note\": \"임의 서술이나 위탁자 동의는 강행적 전제이며 제2조·제3조·제4항 내지 제6항 준용 — 무단 재위탁은 감독규정 위반. PRIV-15·IT-09와 정합 위해 필수\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"financial_outsourcing\", \"decision_question\": \"수탁자가 위탁자의 사전 동의 없이 재위탁하지 못하도록 하는 조항이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"text_effect\": \"conditional\", \"action_rationale\": \"재위탁 통제의 실효성을 위해 수탁자를 구속하는 사전동의 문구가 필요함\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제16조제1항\", \"quote\": \"수급사업자는 이 계약에서 정한 용역을 직접 수행한다. 다만, 수급사업자는 원사업자의 동의를 받아 용역의 일부를 제3자에게 재하도급할 수 있다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}, {\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제60조제1항(SW)\", \"quote\": \"계약상대자는 해당 소프트웨어사업의 일부를 제3자에게 하도급하거나, 승인을 받은 하도급 조건을 변경하고자 하는 경우에는 「하도급거래 공정화에 관한 법률」 제3조의2에 의한 소프트웨어사업표준하도급계약서 등 관련 자료를 첨부하여 계약담당공무원에게 사전승인을 요청하여야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"CORE-08\", \"module\": \"X-FINOUT\", \"check\": \"재위탁 시 감독원장(감독당국)에 대한 보고의 주체가 원위탁 금융회사로 정해져 있는가\", \"label\": \"재위탁 보고주체 지정\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재위탁\", \"보고\", \"감독원\", \"금융감독원\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제4항 후문\", \"quote\": \"재위탁시 보고의 주체는 원위탁 금융회사로 한다\", \"verified\": true, \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"financial_outsourcing\"}, {\"id\": \"CORE-09\", \"module\": \"X-FINOUT\", \"check\": \"수탁자의 금융관련법령·업무위수탁기준 위반으로 발생한 손해에 대한 배상·구상 조항이 있는가\", \"label\": \"법규위반 손해 배상·구상\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"연대\", \"배상책임\", \"구상\", \"손해배상\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조(업무위탁 등)\", \"clause\": \"제5항\", \"quote\": \"위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제3조(업무위탁 등) ① 금융기관은 인가등을 받은 업무를 영위함에 있어 제3자에게 업무를 위탁하거나 제3자의 업무를 수탁할 수 있다. 다만, 다음 각 호의 어느 하나에 해당하는 사항은 그러하지 아니하다.<개정 2017. 11. 14.> 1. 인가 등을 받은 금융업 또는 다른 금융업의 본질적 요소를 포함하는 업무를 위탁하는 경우. 다만, 다음 각 목의 어느 하나에 해당하는 업무의 경우에는 위탁할 수 있다. 가. 위탁하고자 하는 업무가 해당 금융업의 본질적 요소가 아니라 다른 금융업의 본질적 요소인 경우로서 법령에서 해당 업무수행을 허용하고 있는 자에 대하여 위탁하는 경우 나. 인가등을 받은 업무를 효율적으로 수행하는 데 필요한 경우로서 해당 업무를 위탁하더라도 금융기관의 건전성 또는 신인도를 저해하거나 금융질서의 문란 또는 금융이용자 피해를 발생시킬 우려가 낮은 것으로 금융위원회가 인정하는 경우 2. 관련 법령에서 금융기관이 수행하도록 의무를 부여하고 있는 경우 3. 업무의 위탁 또는 수탁으로 인하여 당해 금융기관의 건전성 또는 신인도를 크게 저해하거나 금융질서의 문란 또는 금융이용자의 피해 발생이 심히 우려되는 경우 ② 제1항 제1호의 본질적 요소에 해당하는 사항은 <별표 2>과 같다.<개정 2017. 11. 14.> 1. <본호 삭제 2005. 7. 27> 2. <본호 삭제 2005. 7. 27> 3. <본호 삭제 2005. 7. 27> 4. <본호 삭제 2005. 7. 27> ③ 금융기관이 제1항의 규정에 따라 제3자에게 업무를 위탁하거나 제3자로부터 업무를 수탁하는 경우에는 다음 각 호의 사항을 고려하여 동 업무가 적정하게 처리될 수 있도록 하여야 한다.<개정 2017. 11. 14.> 1. 업무위탁 또는 수탁에 따른 비용·편익분석 2. 금융이용자 피해발생 및 금융질서 문란 여부 3. 제3자가 관련 법규(다만, 제3자가 외국인인 경우에는 국제사법 제3조)에 따라 업무수탁이 가능한지의 여부<개정 2017. 11. 14.> 4. 제3자가 수탁업무를 적절히 수행할 수 있는지의 여부 5. 「금융실명거래 및 비밀보장에 관한 법률」 등 관련 법령에의 저촉 여부<개정 2017. 11. 14.> ④ 제1항에 따라 금융기관의 업무를 위탁받은 자는 위탁자의 동의를 얻어 위탁받은 업무를 제3자에게 재위탁할 수 있다. 이 경우 제2조, 본조 제1항·제2항·제3항, 제4조, 제5조, 제6조를 준용하되, 재위탁시 보고의 주체는 원위탁 금융회사로 한다.<신설 2017. 11. 14.> ⑤ 제1항에 따라 업무를 위탁하는 경우(제4항에 따라 재위탁하는 경우를 포함한다) 위탁회사는 수탁회사가 이 규정 등 금융관련법령 및 제3조의2에 따른 업무위수탁기준상의 의무를 위반하여 발생하는 손해에 대해서 수탁회사와 연대하여 배상책임을 진다.<신설 2017. 11. 14.>\", \"status\": \"quote_ok\"}, {\"law\": \"의료자문 표준내부통제기준\", \"article\": \"제4조\", \"clause\": \"제4항\", \"quote\": \"수탁자가 제2항에 따른 업무위수탁기준에서 정하는 의무를 위반하여 발생하는 손해에 대해서 업무위탁 규정 제3조 제5항에 따라 배상책임을 진다\", \"verified\": true, \"source_type\": \"self_regulation\", \"text\": \"제4조(업무 수탁자에 대한 관리책임) ① 보험회사는 「금융기관의 업무위탁 등에 관한 규정」(이하 ‘업무위탁 규정’이라 한다.)에 따라 의료자문 관련 업무를 손해사정업자 등 제3자에게 위탁(수탁자가 재위탁하는 경우를 포함한다)하는 경우 수탁자가 이 기준에 따라 보험회사가 마련한 의료자문 관련 내부통제기준을 준수할 수 있도록 관리하여야 한다.\\n② 보험회사는 제1항에 따른 수탁자를 관리하기 위하여 업무위탁 규정 제3조의2에 따른 업무위수탁운영기준을 마련하고 이를 준수하여야 한다.\\n③ 보험회사가 제2항에 따라 마련한 업무위수탁운영기준에는 다음 각 호의 사항이 포함되어야 하며, 수탁자가 이를 위반한 경우 보험회사는 위수탁계약 해지 등 적절한 조치를 취하여야 한다.\\n1. 위탁자의 내부통제기준에 대한 수탁자의 준수 의무\\n2. 위탁자의 제1호에 따른 의무 위반 여부에 대한 점검 및 관리\\n3. 수탁자의 수탁업무 이행 현황 보고 의무\\n4. 수탁자의 의무 위반시 위탁자의 조치사항\\n④ 보험회사가 제1항에 따라 업무를 위탁하는 경우 보험회사는 수탁자가 제2항에 따른 업무위수탁기준에서 정하는 의무를 위반하여 발생하는 손해에 대해서 업무위탁 규정 제3조 제5항에 따라 배상책임을 진다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"financial_outsourcing\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"수탁자 위반의 대외책임과 내부 구상은 구분되며 배상·구상 문구는 위험배분 사항임\", \"contract_action_curated\": true}, {\"id\": \"CORE-10\", \"module\": \"X-FINOUT\", \"check\": \"위탁자의 점검·관리·시정 요구 또는 수탁자의 협조가 약정되어 있는가\", \"label\": \"점검·관리·시정 협조\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제3조의2\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"implementation_channel\": \"contract_or_internal_control\", \"contract_requirement\": \"derived\", \"triggers\": {\"keywords\": [\"점검\", \"감사\", \"자료 요구\", \"관리감독\"]}, \"evidence_required_groups\": [[\"점검\", \"감사\", \"자료 요구\", \"자료요구\", \"관리감독\"], [\"위탁자\", \"수탁자\", \"위탁업무\", \"위탁 업무\"]], \"absence_check\": true, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제3조의2\", \"quote\": \"<별표 3>에서 정하는 업무위수탁기준에 따라 금융권역 및 위탁대상자의 특성 등을 감안하여 자체 업무위수탁 운영기준을 마련하고 이를 준수하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제3조의2(업무위수탁기준) 금융기관은 제3조에서 정한 업무위탁 등에 따른 리스크의 체계적 관리를 위하여 <별표 3>에서 정하는 업무위수탁기준에 따라 금융권역 및 위탁대상자의 특성 등을 감안하여 자체 업무위수탁 운영기준을 마련하고 이를 준수하여야 한다.<개정 2017. 11. 14.>\", \"status\": \"quote_ok\"}, {\"law\": \"의료자문 표준내부통제기준\", \"article\": \"제4조\", \"clause\": \"제2항\", \"quote\": \"보험회사는 제1항에 따른 수탁자를 관리하기 위하여 업무위탁 규정 제3조의2에 따른 업무위수탁운영기준을 마련하고 이를 준수하여야 한다\", \"verified\": true, \"source_type\": \"self_regulation\", \"text\": \"제4조(업무 수탁자에 대한 관리책임) ① 보험회사는 「금융기관의 업무위탁 등에 관한 규정」(이하 ‘업무위탁 규정’이라 한다.)에 따라 의료자문 관련 업무를 손해사정업자 등 제3자에게 위탁(수탁자가 재위탁하는 경우를 포함한다)하는 경우 수탁자가 이 기준에 따라 보험회사가 마련한 의료자문 관련 내부통제기준을 준수할 수 있도록 관리하여야 한다.\\n② 보험회사는 제1항에 따른 수탁자를 관리하기 위하여 업무위탁 규정 제3조의2에 따른 업무위수탁운영기준을 마련하고 이를 준수하여야 한다.\\n③ 보험회사가 제2항에 따라 마련한 업무위수탁운영기준에는 다음 각 호의 사항이 포함되어야 하며, 수탁자가 이를 위반한 경우 보험회사는 위수탁계약 해지 등 적절한 조치를 취하여야 한다.\\n1. 위탁자의 내부통제기준에 대한 수탁자의 준수 의무\\n2. 위탁자의 제1호에 따른 의무 위반 여부에 대한 점검 및 관리\\n3. 수탁자의 수탁업무 이행 현황 보고 의무\\n4. 수탁자의 의무 위반시 위탁자의 조치사항\\n④ 보험회사가 제1항에 따라 업무를 위탁하는 경우 보험회사는 수탁자가 제2항에 따른 업무위수탁기준에서 정하는 의무를 위반하여 발생하는 손해에 대해서 업무위탁 규정 제3조 제5항에 따라 배상책임을 진다.\", \"status\": \"quote_ok\"}], \"note\": \"업무·정보의 점검·관리·자료 요구·시정 협조 중 해당 약정을 확인한다. CORE-13의 독립 질문은 통합하되 감독기관의 계약문언 변경권까지 있다고 추정하지 않는다. 보안약정 제10조도 본건에 적용되면 근거로 인정한다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"financial_outsourcing\", \"decision_question\": \"위탁자의 점검·관리·시정 요구 또는 수탁자의 협조가 약정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"legacy_check_ids\": [\"CORE-13\"], \"text_effect\": \"conditional\", \"action_rationale\": \"관리·감독은 회사 의무이나 자료요구·감사 협조는 계약으로 확보할 필요가 있음\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제11조제2항\", \"quote\": \"계약담당공무원은 계약상대자가 채용한 근로자가 다음 각호의 사유에 해당한다고 판단될 경우 해당 근로자의 교체를 요청할 수 있다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}, {\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제11조제3항\", \"quote\": \"계약상대자가 전항의 요청을 받은 경우 발주기관과 협의하여 해당 근로자의 교체여부를 결정하여야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"CORE-11\", \"module\": \"X-FINOUT\", \"check\": \"감독원장 사전보고(수탁자의 업무 개시 7영업일 이전) 일정·자료 협조가 계약 발효와 연동되어 있는가\", \"label\": \"업무개시 사전보고 연동\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 금융기관의 업무위탁 등에 관한 규정 제4조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"보고\", \"금융감독원\", \"감독원장\", \"7영업일\"]}, \"evidence_required_groups\": [[\"금융감독원\", \"감독원장\", \"사전보고\"], [\"7영업일\", \"업무 개시\", \"업무개시\"]], \"absence_check\": true, \"sources\": [{\"law\": \"금융기관의 업무위탁 등에 관한 규정\", \"article\": \"제4조(보고)\", \"clause\": \"제1항\", \"quote\": \"그 사실을 업무를 위탁받은 자가 그 위탁받은 업무를 실제로 수행하려는 날의 7영업일 이전에 <별지 제1호 서식>에 따라 다음 각호의 서류를 첨부하여 감독원장에게 보고하여야 한다\", \"verified\": true, \"text\": \"제4조(보고) ① 금융기관이 제3조제1항의 규정에 따라 제3자와 업무위탁 계약을 체결하거나 제3자(금융기관 및「자본시장과 금융투자업에 관한 법률」에 따른 금융투자업자, 종합금융회사는 제외한다)와 업무수탁계약을 체결하고자 하는 경우에는 그 사실을 업무를 위탁받은 자가 그 위탁받은 업무를 실제로 수행하려는 날의 7영업일 이전에 <별지 제1호 서식>에 따라 다음 각호의 서류를 첨부하여 감독원장에게 보고하여야 한다.<개정 2017. 11. 14.> 1. 위탁 또는 수탁 관련 계약서(안) 사본 2. 업무위수탁계약이 제3조제3항 각 호의 고려사항에 저촉되지 아니하고 제3조의2에 따른 자체 업무위수탁 운영기준에 위배되지 아니하다는 준법감시인(준법감시인이 없는 경우에는 감사 등 이에 준하는 자를 말한다)의 검토의견 및 관련 자료 사본<개정 2017. 11. 14.> 3. 위탁 또는 수탁의 필요성 및 기대효과 4. 위탁 또는 수탁에 따른 업무처리절차의 주요변경내용 ② 금융기관은 제1항의 규정에 불구하고 다음 각호의 1에 해당하는 경우에는 제1항에 의한 사전보고를 생략하고, <별지 제2호 서식>에 따라 업무위수탁현황을 그 금융기관의 설립근거가 되는 법률 등에 따른 업무보고서에 포함하여 감독원장에게 반기별로 사후보고할 수 있다.<개정 2017. 11. 14.> 1. 당해 금융기관 또는 동일한 금융업을 영위하는 다른 금융기관이 감독원장에게 보고한 내용과 동일한 경우<개정 2017. 11. 14.> 2. 금융기관이 약관 등을 보고하면서 당해 약관 등의 내용과 관련된 위탁 또는 수탁예정업무를 보고한 경우(제1항에 의한 첨부서류를 제출한 경우에 한한다) 3. 해당 금융기관이 이미 보고한 내용을 일부 변경하는 경우로서 변경되는 내용이 경미한 경우<개정 2017. 11. 14.> 4. 동일한 수탁자에게 반복, 지속적으로 업무위탁이 이루어지는 경우로서 최초 업무위탁시에 사전보고가 이루어진 경우. 단, 이 경우 금융회사는 사전보고시에 향후 발생 가능한 추가적인 업무위탁의 대략적인 내용을 작성하여 금감원장에게 제출하여야 한다.<신설 2017. 11. 14.> 5. 금융기관이 제3자로부터 업무를 수탁하는 경우 ③ 감독원장은 제1항 및 제2항의 규정에 의하여 금융기관이 보고한 업무위탁 또는 수탁현황을 매반기 금융위에 보고하여야 한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"financial_outsourcing\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독보고는 회사 의무이고 개시일정·자료 제공에 대한 수탁자 협조가 필요함\", \"contract_action_curated\": true}, {\"id\": \"CORE-14\", \"module\": \"X-FINOUT\", \"check\": \"감독기관의 검사·자료 요구에 대한 협조 약정이 있는가\", \"label\": \"감독기관 검사 협조\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목이나 회사 감독대응 리스크가 큼 — 회사가 감독원 검사·자료요구에 응할 의무를 지므로, 수탁자 협조 계약근거 부재는 회사의 대응불능 리스크. 업무위수탁기준(별표3) 근거.\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"검사\", \"자료제출\", \"감독원\", \"검사에 응\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"감독기관의 검사 또는 자료 요구에 응하는 약정을 확인한다. 금융감독원장이라는 정확한 직함이나 이미 검사에 응했다는 실적을 요구하지 않는다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"financial_outsourcing\", \"decision_question\": \"감독기관의 검사·자료 요구에 대한 협조 약정이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"cooperation_control\", \"action_rationale\": \"감독기관 검사·자료제출 협조는 실무상 유용하나 모든 계약의 획일적 필수문구는 아님\", \"contract_action_curated\": true}, {\"id\": \"CNS-LABOR\", \"module\": \"M-DISPATCH\", \"check\": \"수탁자가 업무 수행과 인사·노무 관리를 독립적으로 담당하고 위탁자의 요청은 지정 책임자를 통해 전달되도록 정해져 있는가\", \"label\": \"수탁자 업무·인력 운영의 독립성\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"지휘\", \"명령\", \"독립적으로\", \"업무 수행 방법\", \"현장 책임자\", \"창구\", \"업무 요청\", \"근태\", \"인력 배치\", \"노무관리\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"직접 지휘·명령 배제, 요청 창구, 인력 배치·근태·노무 권한을 함께 검토한다. 계약 문구만으로 실제 운영의 독립성까지 확인한 것으로 보지 않는다.\", \"decision_question\": \"수탁자가 업무 수행과 인사·노무 관리를 독립적으로 담당하고 위탁자의 요청은 지정 책임자를 통해 전달되도록 정해져 있는가?\", \"pass_guidance\": \"위 설명의 검토 관점에 비추어 본건에서 수정이 불필요하면 선택\", \"opinion_guidance\": \"본건에서 수정·추가 확인이 필요한 내용을 의견으로 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v2\", \"legacy_check_ids\": [\"DIS-01\", \"DIS-02\", \"DIS-03\"], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"직접 지휘·명령 배제, 요청 창구, 인력 배치·근태·노무 권한을 함께 검토한다. 계약 문구만으로 실제 운영의 독립성까지 확인한 것으로 보지 않는다.\", \"contract_action_curated\": true}]}, {\"meta\": {\"type_id\": \"procurement\", \"type_name\": \"조달(물품·용역·시스템·임대차)\", \"detect_keywords\": [\"납품\", \"구매\", \"물품\", \"발주\", \"검수\", \"용역\", \"도급\", \"공급\", \"하도급\", \"렌탈\", \"리스\", \"임대차\", \"설치\", \"제작\", \"공사\", \"설계\", \"감리\", \"인쇄\", \"컨설팅\", \"이용계약\", \"유지보수\", \"시스템 구축\", \"구축\", \"고도화\", \"솔루션\", \"소프트웨어\", \"라이선스\", \"단가계약\", \"광고\", \"렌트\", \"차량\", \"숙박\", \"대관\", \"케이터링\", \"현장 운영\"], \"nature_signals\": [\"행사\", \"설명회\", \"세미나\", \"워크숍\", \"기념식\", \"대관\", \"무대\", \"음향\", \"케이터링\", \"현장 운영\", \"숙박\", \"차량\"], \"suppresses\": [\"outsourcing\", \"channel\"], \"suppress_title_hits\": true, \"suppress_exempt_signals\": [\"보험대리점\", \"보험설계사\", \"GA\", \"모집위탁\", \"모집 위탁\", \"위촉계약\", \"위촉 계약\"], \"modules\": [{\"id\": \"M-UNFAIR\", \"name\": \"부당특약·불공정약관\", \"always_on\": false, \"screening_question\": \"계약조건이 일방(발주자)이 작성한 정형화된 약관이거나 우월적 지위에서 설정되는가?\", \"suggest_keywords\": [\"약관\", \"일반조건\", \"부당특약\", \"우월적 지위\"]}, {\"id\": \"M-DELIVERY\", \"name\": \"납품·검수·하자·위험부담\", \"always_on\": false, \"screening_question\": \"물품 납품 또는 용역·시스템 완성물의 인도·검수가 예정되어 있는가?\", \"suggest_keywords\": [\"납품\", \"검수\", \"검사\", \"인수\", \"하자\", \"지체상금\", \"산출물\", \"SLA\"]}]}, \"checks\": [{\"id\": \"SP-UNF-01\", \"module\": \"M-UNFAIR\", \"check\": \"수급사업자의 이익을 부당하게 침해·제한하는 부당한 특약을 설정하지 않았는가\", \"label\": \"부당특약 금지\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 하도급거래 공정화에 관한 법률 제3조의4\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"부당한 특약\", \"특약\", \"비용 부담\", \"부당 특약\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조의4\", \"clause\": \"제1항\", \"quote\": \"원사업자는 수급사업자의 이익을 부당하게 침해하거나 제한하는 계약조건\", \"verified\": true, \"text\": \"제3조의4(부당한 특약의 금지)\\n① 원사업자는 수급사업자의 이익을 부당하게 침해하거나 제한하는 계약조건(이하 \\\"부당한 특약\\\"이라 한다)을 설정하여서는 아니 된다.\\n② 다음 각 호의 어느 하나에 해당하는 약정은 부당한 특약으로 본다.\\n1.  원사업자가 제3조제1항의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n2.  원사업자가 부담하여야 할 민원처리, 산업재해 등과 관련된 비용을 수급사업자에게 부담시키는 약정\\n3.  원사업자가 입찰내역에 없는 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n4.  그 밖에 이 법에서 보호하는 수급사업자의 이익을 제한하거나 원사업자에게 부과된 의무를 수급사업자에게 전가하는 등 대통령령으로 정하는 약정\\n③ 제2항제1호부터 제3호까지에 해당하는 부당한 특약은 그 부분에 한정하여 무효로 하고, 같은 항 제4호에 해당하는 부당한 특약은 당사자 일방에게 현저하게 불공정한 경우 그 부분에 한정하여 무효로 한다.\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제41조제2항 제1호\", \"quote\": \"원사업자가 기본계약 및 개별약정 등의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-UNF-02\", \"module\": \"M-UNFAIR\", \"check\": \"서면 미기재·입찰내역 외 사항 요구 또는 원사업자 부담 비용(민원·산재 등)을 수급사업자에게 전가하는 약정이 없는가\", \"label\": \"비용전가 부당특약\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"간주규정임(제3조의4 제2항 각 호는 부당특약 간주·해당부분 무효) — 하도급거래 공정화에 관한 법률 제3조의4. 회사(원사업자)가 수범자로서 제재·담보실효 노출.\", \"norm_type\": \"간주\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"서면에 기재되지\", \"비용을 부담\", \"추가 비용\", \"민원처리\", \"산업재해\", \"입찰내역\", \"입찰\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조의4\", \"clause\": \"제2항 제1호\", \"quote\": \"원사업자가 제3조제1항의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\", \"verified\": true, \"text\": \"제3조의4(부당한 특약의 금지)\\n① 원사업자는 수급사업자의 이익을 부당하게 침해하거나 제한하는 계약조건(이하 \\\"부당한 특약\\\"이라 한다)을 설정하여서는 아니 된다.\\n② 다음 각 호의 어느 하나에 해당하는 약정은 부당한 특약으로 본다.\\n1.  원사업자가 제3조제1항의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n2.  원사업자가 부담하여야 할 민원처리, 산업재해 등과 관련된 비용을 수급사업자에게 부담시키는 약정\\n3.  원사업자가 입찰내역에 없는 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n4.  그 밖에 이 법에서 보호하는 수급사업자의 이익을 제한하거나 원사업자에게 부과된 의무를 수급사업자에게 전가하는 등 대통령령으로 정하는 약정\\n③ 제2항제1호부터 제3호까지에 해당하는 부당한 특약은 그 부분에 한정하여 무효로 하고, 같은 항 제4호에 해당하는 부당한 특약은 당사자 일방에게 현저하게 불공정한 경우 그 부분에 한정하여 무효로 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조의4\", \"clause\": \"제2항 제2호\", \"quote\": \"원사업자가 부담하여야 할 민원처리, 산업재해 등과 관련된 비용을 수급사업자에게 부담시키는 약정\", \"verified\": true, \"text\": \"제3조의4(부당한 특약의 금지)\\n① 원사업자는 수급사업자의 이익을 부당하게 침해하거나 제한하는 계약조건(이하 \\\"부당한 특약\\\"이라 한다)을 설정하여서는 아니 된다.\\n② 다음 각 호의 어느 하나에 해당하는 약정은 부당한 특약으로 본다.\\n1.  원사업자가 제3조제1항의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n2.  원사업자가 부담하여야 할 민원처리, 산업재해 등과 관련된 비용을 수급사업자에게 부담시키는 약정\\n3.  원사업자가 입찰내역에 없는 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n4.  그 밖에 이 법에서 보호하는 수급사업자의 이익을 제한하거나 원사업자에게 부과된 의무를 수급사업자에게 전가하는 등 대통령령으로 정하는 약정\\n③ 제2항제1호부터 제3호까지에 해당하는 부당한 특약은 그 부분에 한정하여 무효로 하고, 같은 항 제4호에 해당하는 부당한 특약은 당사자 일방에게 현저하게 불공정한 경우 그 부분에 한정하여 무효로 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"하도급거래 공정화에 관한 법률\", \"article\": \"제3조의4\", \"clause\": \"제2항 제3호\", \"quote\": \"원사업자가 입찰내역에 없는 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\", \"verified\": true, \"text\": \"제3조의4(부당한 특약의 금지)\\n① 원사업자는 수급사업자의 이익을 부당하게 침해하거나 제한하는 계약조건(이하 \\\"부당한 특약\\\"이라 한다)을 설정하여서는 아니 된다.\\n② 다음 각 호의 어느 하나에 해당하는 약정은 부당한 특약으로 본다.\\n1.  원사업자가 제3조제1항의 서면에 기재되지 아니한 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n2.  원사업자가 부담하여야 할 민원처리, 산업재해 등과 관련된 비용을 수급사업자에게 부담시키는 약정\\n3.  원사업자가 입찰내역에 없는 사항을 요구함에 따라 발생된 비용을 수급사업자에게 부담시키는 약정\\n4.  그 밖에 이 법에서 보호하는 수급사업자의 이익을 제한하거나 원사업자에게 부과된 의무를 수급사업자에게 전가하는 등 대통령령으로 정하는 약정\\n③ 제2항제1호부터 제3호까지에 해당하는 부당한 특약은 그 부분에 한정하여 무효로 하고, 같은 항 제4호에 해당하는 부당한 특약은 당사자 일방에게 현저하게 불공정한 경우 그 부분에 한정하여 무효로 한다.\", \"status\": \"quote_ok\"}], \"note\": \"하도급법 적용대상 해당 시. 제3조의4 제2항 각 호는 부당한 특약으로 간주되며 해당 부분에 한하여 무효(제3항). SP-UNF-03·SP-UNF-04 통합(2026-07-29 지식 다이어트) — 비용전가 3유형(서면 미기재·민원 산재·입찰내역 외)은 계약서 1회 스캔으로 한 번에 판정, 각 호 근거는 sources 병기\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-05\", \"module\": \"M-UNFAIR\", \"check\": \"신의성실 원칙을 위반하여 공정성을 잃은 약관 조항(무효 사유)이 계약에 포함되어 있지 않은가\", \"label\": \"신의칙 위반 약관\", \"severity\": \"필수\", \"severity_basis\": \"공정성 상실 약관 조항은 무효(효력강행규정) — 약관의 규제에 관한 법률 제6조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"신의성실\", \"공정성\", \"약관\", \"무효\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제6조\", \"clause\": \"제1항\", \"quote\": \"신의성실의 원칙을 위반하여 공정성을 잃은 약관 조항은 무효이다\", \"verified\": true, \"text\": \"제6조(일반원칙)\\n① 신의성실의 원칙을 위반하여 공정성을 잃은 약관 조항은 무효이다.\\n② 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 공정성을 잃은 것으로 추정된다.\\n1.  고객에게 부당하게 불리한 조항\\n2.  고객이 계약의 거래형태 등 관련된 모든 사정에 비추어 예상하기 어려운 조항\\n3.  계약의 목적을 달성할 수 없을 정도로 계약에 따르는 본질적 권리를 제한하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관(정형화된 계약조건)에 해당하는 경우 적용 — 개별 교섭 조항에는 부적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-06\", \"module\": \"M-UNFAIR\", \"check\": \"고객에게 부당하게 불리하거나 예상하기 어렵거나 본질적 권리를 제한하는 조항이 없는가(공정성 상실 추정 사유)\", \"label\": \"부당불리·불의타 조항\", \"severity\": \"참고\", \"severity_basis\": \"추정규정임 — 약관의 규제에 관한 법률 제6조\", \"norm_type\": \"추정\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"부당하게 불리한\", \"예상하기 어려운\", \"본질적 권리\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제6조\", \"clause\": \"제2항\", \"quote\": \"약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 공정성을 잃은 것으로 추정된다\", \"verified\": true, \"text\": \"제6조(일반원칙)\\n① 신의성실의 원칙을 위반하여 공정성을 잃은 약관 조항은 무효이다.\\n② 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 공정성을 잃은 것으로 추정된다.\\n1.  고객에게 부당하게 불리한 조항\\n2.  고객이 계약의 거래형태 등 관련된 모든 사정에 비추어 예상하기 어려운 조항\\n3.  계약의 목적을 달성할 수 없을 정도로 계약에 따르는 본질적 권리를 제한하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용. 추정규정이므로 사업자가 공정성을 반증하면 유효\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-07\", \"module\": \"M-UNFAIR\", \"check\": \"사업자·이행보조자의 고의·중과실 책임을 배제하는 등 무효인 면책조항이 없는가\", \"label\": \"무효 면책조항\", \"severity\": \"필수\", \"severity_basis\": \"면책조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제7조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"면책\", \"책임을 배제\", \"고의 또는 중대한 과실\", \"담보책임 배제\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제7조\", \"clause\": \"제1호\", \"quote\": \"사업자, 이행 보조자 또는 피고용자의 고의 또는 중대한 과실로 인한 법률상의 책임을 배제하는 조항\", \"verified\": true, \"text\": \"제7조(면책조항의 금지)\\n계약 당사자의 책임에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 무효로 한다.\\n1.  사업자, 이행 보조자 또는 피고용자의 고의 또는 중대한 과실로 인한 법률상의 책임을 배제하는 조항\\n2.  상당한 이유 없이 사업자의 손해배상 범위를 제한하거나 사업자가 부담하여야 할 위험을 고객에게 떠넘기는 조항\\n3.  상당한 이유 없이 사업자의 담보책임을 배제 또는 제한하거나 그 담보책임에 따르는 고객의 권리행사의 요건을 가중하는 조항\\n4.  상당한 이유 없이 계약목적물에 관하여 견본이 제시되거나 품질ㆍ성능 등에 관한 표시가 있는 경우 그 보장된 내용에 대한 책임을 배제 또는 제한하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-08\", \"module\": \"M-UNFAIR\", \"check\": \"고객에게 부당하게 과중한 지연손해금 등 손해배상 의무를 부담시키는 약관 조항이 없는가\", \"label\": \"과중한 손해배상 예정\", \"severity\": \"필수\", \"severity_basis\": \"손해배상액 예정 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제8조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"지연손해금\", \"손해배상 의무\", \"위약금\", \"과중한\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제8조\", \"quote\": \"고객에게 부당하게 과중한 지연 손해금 등의 손해배상 의무를 부담시키는 약관 조항은 무효로 한다\", \"verified\": true, \"text\": \"제8조(손해배상액의 예정)\\n고객에게 부당하게 과중한 지연 손해금 등의 손해배상 의무를 부담시키는 약관 조항은 무효로 한다.\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-09\", \"module\": \"M-UNFAIR\", \"check\": \"고객의 법정 해제·해지권을 배제·제한하거나 사업자에게 부당한 해지권을 부여하는 무효 조항이 없는가\", \"label\": \"해제·해지권 제한\", \"severity\": \"필수\", \"severity_basis\": \"해제·해지 관련 부당 약관 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제9조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"해제권\", \"해지권\", \"원상회복\", \"해지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제9조\", \"quote\": \"계약의 해제ㆍ해지에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당되는 내용을 정하고 있는 조항은 무효로 한다\", \"verified\": true, \"text\": \"제9조(계약의 해제ㆍ해지)\\n계약의 해제ㆍ해지에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당되는 내용을 정하고 있는 조항은 무효로 한다.\\n1.  법률에 따른 고객의 해제권 또는 해지권을 배제하거나 그 행사를 제한하는 조항\\n2.  사업자에게 법률에서 규정하고 있지 아니하는 해제권 또는 해지권을 부여하여 고객에게 부당하게 불이익을 줄 우려가 있는 조항\\n3.  법률에 따른 사업자의 해제권 또는 해지권의 행사 요건을 완화하여 고객에게 부당하게 불이익을 줄 우려가 있는 조항\\n4.  계약의 해제 또는 해지로 인한 원상회복의무를 상당한 이유 없이 고객에게 과중하게 부담시키거나 고객의 원상회복 청구권을 부당하게 포기하도록 하는 조항\\n5.  계약의 해제 또는 해지로 인한 사업자의 원상회복의무나 손해배상의무를 부당하게 경감하는 조항\\n6.  계속적인 채권관계의 발생을 목적으로 하는 계약에서 그 존속기간을 부당하게 단기 또는 장기로 하거나 묵시적인 기간의 연장 또는 갱신이 가능하도록 정하여 고객에게 부당하게 불이익을 줄 우려가 있는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-10\", \"module\": \"M-UNFAIR\", \"check\": \"상당한 이유 없이 급부의 내용을 사업자가 일방적으로 결정·변경하거나 급부를 중지할 수 있게 하는 무효 조항이 없는가\", \"label\": \"급부 일방결정·중지\", \"severity\": \"필수\", \"severity_basis\": \"채무이행 관련 부당 약관 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제10조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"일방적으로 결정\", \"급부\", \"일방적으로 변경\", \"중지\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제10조\", \"clause\": \"제1호\", \"quote\": \"상당한 이유 없이 급부(給付)의 내용을 사업자가 일방적으로 결정하거나 변경할 수 있도록 권한을 부여하는 조항\", \"verified\": true, \"text\": \"제10조(채무의 이행)\\n채무의 이행에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 무효로 한다.\\n1.  상당한 이유 없이 급부(給付)의 내용을 사업자가 일방적으로 결정하거나 변경할 수 있도록 권한을 부여하는 조항\\n2.  상당한 이유 없이 사업자가 이행하여야 할 급부를 일방적으로 중지할 수 있게 하거나 제3자에게 대행할 수 있게 하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-11\", \"module\": \"M-UNFAIR\", \"check\": \"고객의 항변권·상계권 등 권리를 상당한 이유 없이 배제·제한하거나 기한의 이익을 박탈하는 무효 조항이 없는가\", \"label\": \"항변·상계권 배제\", \"severity\": \"필수\", \"severity_basis\": \"고객 권익 관련 부당 약관 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제11조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"항변권\", \"상계권\", \"기한의 이익\", \"권익\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제11조\", \"clause\": \"제1호\", \"quote\": \"법률에 따른 고객의 항변권(抗辯權), 상계권(相計權) 등의 권리를 상당한 이유 없이 배제하거나 제한하는 조항\", \"verified\": true, \"text\": \"제11조(고객의 권익 보호)\\n고객의 권익에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 무효로 한다.\\n1.  법률에 따른 고객의 항변권(抗辯權), 상계권(相計權) 등의 권리를 상당한 이유 없이 배제하거나 제한하는 조항\\n2.  고객에게 주어진 기한의 이익을 상당한 이유 없이 박탈하는 조항\\n3.  고객이 제3자와 계약을 체결하는 것을 부당하게 제한하는 조항\\n4.  사업자가 업무상 알게 된 고객의 비밀을 정당한 이유 없이 누설하는 것을 허용하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-12\", \"module\": \"M-UNFAIR\", \"check\": \"고객의 작위·부작위를 의사표시로 의제하거나 의사표시 형식에 부당한 제한을 두는 무효 조항이 없는가\", \"label\": \"의사표시 의제·제한\", \"severity\": \"필수\", \"severity_basis\": \"의사표시 의제 관련 부당 약관 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제12조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"의사표시\", \"의제\", \"도달된 것으로 본다\", \"표명\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제12조\", \"quote\": \"의사표시에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 무효로 한다\", \"verified\": true, \"text\": \"제12조(의사표시의 의제)\\n의사표시에 관하여 정하고 있는 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 내용을 정하고 있는 조항은 무효로 한다.\\n1.  일정한 작위(作爲) 또는 부작위(不作爲)가 있을 경우 고객의 의사표시가 표명되거나 표명되지 아니한 것으로 보는 조항. 다만, 고객에게 상당한 기한 내에 의사표시를 하지 아니하면 의사표시가 표명되거나 표명되지 아니한 것으로 본다는 뜻을 명확하게 따로 고지한 경우이거나 부득이한 사유로 그러한 고지를 할 수 없는 경우에는 그러하지 아니하다.\\n2.  고객의 의사표시의 형식이나 요건에 대하여 부당하게 엄격한 제한을 두는 조항\\n3.  고객의 이익에 중대한 영향을 미치는 사업자의 의사표시가 상당한 이유 없이 고객에게 도달된 것으로 보는 조항\\n4.  고객의 이익에 중대한 영향을 미치는 사업자의 의사표시 기한을 부당하게 길게 정하거나 불확정하게 정하는 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-UNF-13\", \"module\": \"M-UNFAIR\", \"check\": \"고객에게 부당하게 불리한 재판관할 합의 또는 입증책임을 전가하는 무효 조항이 없는가\", \"label\": \"관할·입증책임 전가\", \"severity\": \"필수\", \"severity_basis\": \"소 제기·관할 관련 부당 약관 조항 무효(효력강행규정) — 약관의 규제에 관한 법률 제14조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"재판관할\", \"소송 제기\", \"입증책임\", \"관할의 합의\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"약관의 규제에 관한 법률\", \"article\": \"제14조\", \"clause\": \"제1호\", \"quote\": \"고객에게 부당하게 불리한 소송 제기 금지 조항 또는 재판관할의 합의 조항\", \"verified\": true, \"text\": \"제14조(소송 제기의 금지 등)\\n소송 제기 등과 관련된 약관의 내용 중 다음 각 호의 어느 하나에 해당하는 조항은 무효로 한다.\\n1.  고객에게 부당하게 불리한 소송 제기 금지 조항 또는 재판관할의 합의 조항\\n2.  상당한 이유 없이 고객에게 입증책임을 부담시키는 약관 조항\", \"status\": \"quote_ok\"}], \"note\": \"약관에 해당하는 경우 적용. 공통 CMN-19(관할 지정)와 달리 부당 관할합의의 무효 여부를 점검\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SP-DEL-01\", \"module\": \"M-DELIVERY\", \"check\": \"검사·검수(산출물 검수·인수 포함)의 기준·방법·기한과 불합격 시 처리(보완·재납품·재검수) 절차가 규정되어 있는가\", \"label\": \"검사·검수 절차\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"검사\", \"검수\", \"인수\", \"합격\", \"불합격\"]}, \"auto_clear\": {\"any_groups\": [[\"검사\", \"검수\", \"인수\"], [\"기준\", \"방법\", \"기한\", \"불합격\", \"보완\", \"재검수\"]]}, \"absence_check\": true, \"sources\": [], \"note\": \"ITDL-03(검수·인수 기준) 통합(2026-07-29 지식 다이어트) — 같은 모듈(M-DELIVERY) 내 완전 동취지 쌍, 코퍼스 판정 이력은 SP-DEL-01로 이관\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"검사·검수 기준과 보완 절차는 납품·용역의 품질위험을 배분하는 거래조건임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제20조제2항\", \"quote\": \"계약담당공무원은 제1항의 통지를 받은 때에는 계약서 기타 관계서류에 의하여 통지를 받은 날부터 14일 이내에 그 이행을 확인하기 위한 검사\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"SP-DEL-03\", \"module\": \"M-DELIVERY\", \"check\": \"목적물 인도 전 당사자 쌍방 무책 멸실·훼손 시 위험부담(대금청구 가부) 처리 조항이 있는가\", \"label\": \"위험부담 처리\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 민법 제537조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"위험부담\", \"멸실\", \"훼손\", \"위험의 이전\"]}, \"evidence_required_groups\": [[\"위험부담\", \"멸실\", \"훼손\", \"위험의 이전\"]], \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제537조\", \"quote\": \"쌍무계약의 당사자 일방의 채무가 당사자쌍방의 책임없는 사유로 이행할 수 없게 된 때에는 채무자는 상대방의 이행을 청구하지 못한다\", \"verified\": true, \"text\": \"제537조(채무자위험부담주의) 제537조(채무자위험부담주의) 쌍무계약의 당사자 일방의 채무가 당사자쌍방의 책임없는 사유로 이행할 수 없게 된 때에는 채무자는 상대방의 이행을 청구하지 못한다.\", \"status\": \"quote_ok\"}], \"note\": \"채무자위험부담주의는 임의규정 — 특약으로 위험이전 시기를 달리 정할 수 있음\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제23조제1항\", \"quote\": \"계약상대자는 계약의 수행 중 용역목적물 및 제3자에 대한 손해를 부담하여야 한다. 다만, 그 손해가 계약상대자의 책임없는 사유로 인하여 발생한 경우에는 발주기관의 부담으로 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}, {\"doc\": \"물품구매(제조)계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제146호)\", \"art\": \"제12조제2항\", \"quote\": \"제1항에 의하여 납품된 물품을 검사ㆍ수령하기까지 발주기관의 책임없는 사유로 인하여 발생된 물품의 망실ㆍ파손 등은 계약상대자의 부담으로 한다.\", \"source_file\": \"mulpum-gumae-ilban-jogeon.txt\"}]}, {\"id\": \"SP-DEL-03-2\", \"module\": \"M-DELIVERY\", \"check\": \"불가항력 조항이 계약이행 책임 면제뿐 아니라 대금정산·해지권·복구비용 분담 등 사후처리까지 규정하고 있는가\", \"label\": \"불가항력 사후처리\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"불가항력\", \"천재지변\", \"force majeure\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"실사례 검토의견(2026-07-28 큐레이션 리포트 SP-DEL-03 표본) — 불가항력 조항이 '계약이행 책임 없음'만 정하고 대금정산·해지·복구비용 분담 등 사후처리는 규정하지 않은 사례 확인. SP-DEL-03(민법§537 위험부담·basis=statute)과 근거·쟁점이 달라 원자 분리 — SP-DEL-03은 '위험부담 조항 존재 자체', 본 체크는 '불가항력 조항의 사후처리 완비 여부'. 사후처리 방식은 법령이 특정하지 않아 basis=practice.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"불가항력 후 정산·해지·복구비용은 거래 특성에 따라 선택적으로 정할 사항임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제24조제4항\", \"quote\": \"계약담당공무원은 제3항에 의하여 손해의 상황을 확인하였을 때에는 별도의 약정이 없는 한 용역금액의 변경 또는 손해액의 부담 등에 대하여 계약상대자와 협의하여야 한다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"SP-DEL-05\", \"module\": \"M-DELIVERY\", \"check\": \"하자보수·보수 청구 또는 보수 의무 약정이 있는가\", \"label\": \"하자보수 청구권\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 민법 제667조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"하자보수\", \"하자의 보수\", \"하자 담보\", \"보수 청구\"]}, \"evidence_required_groups\": [[\"하자\", \"하자보수\", \"하자의 보수\", \"하자 담보\"], [\"보수\", \"시정\", \"수정\", \"재수행\"]], \"auto_clear\": {\"any_groups\": [[\"하자\", \"하자보수\", \"하자의 보수\"], [\"보수\", \"시정\", \"수정\", \"재수행\"]]}, \"service_scope\": [\"completion\"], \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제667조\", \"clause\": \"제1항\", \"quote\": \"완성된 목적물 또는 완성전의 성취된 부분에 하자가 있는 때에는 도급인은 수급인에 대하여 상당한 기간을 정하여 그 하자의 보수를 청구할 수 있다\", \"verified\": true, \"text\": \"제667조(수급인의 담보책임) 제667조(수급인의 담보책임) ①완성된 목적물 또는 완성전의 성취된 부분에 하자가 있는 때에는 도급인은 수급인에 대하여 상당한 기간을 정하여 그 하자의 보수를 청구할 수 있다. 그러나 하자가 중요하지 아니한 경우에 그 보수에 과다한 비용을 요할 때에는 그러하지 아니하다. ②도급인은 하자의 보수에 갈음하여 또는 보수와 함께 손해배상을 청구할 수 있다. <개정 2014.12.30> ③전항의 경우에는 제536조의 규정을 준용한다.\", \"status\": \"quote_ok\"}], \"note\": \"하자보수 의무·청구권·무상보수 약정 중 하나를 확인한다. 하자보증 존속기간과 보수 요청 후 시정기한은 다른 값이며 고정 일수나 청구권이라는 어휘를 필수로 하지 않는다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"하자보수·보수 청구 또는 보수 의무 약정이 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"도급 하자구제는 법정 규율이 존재하며 세부 문구는 거래상 필요에 따른 협상사항임\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"범용[용역(역무)업 분야] 표준하도급계약서(공정위)\", \"doc_date\": \"2024-12-24 제정\", \"art\": \"제50조제1항\", \"quote\": \"검사에 합격한 용역에 하자가 있는 경우, 원사업자는 수급사업자에 대해 상당한 기간을 정하여 그 하자의 보수를 청구할 수 있다.\", \"source_file\": \"ftc-std-subcontract-service.txt\"}]}, {\"id\": \"SP-DEL-08\", \"module\": \"M-DELIVERY\", \"check\": \"도급(용역) 하자담보책임의 존속기간(인도·검수완료 기산, 1년 등)과 하자 대응 절차가 규정되어 있고, 유지보수(유상)의 범위·대가가 무상 하자보수와 구분되어 있는가\", \"label\": \"하자담보 존속기간\", \"severity\": \"권장\", \"severity_basis\": \"하자담보 존속기간 임의규정(특약으로 조정 가능) — 민법 제670조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"담보책임 기간\", \"존속기간\", \"하자담보 기간\", \"1년내\", \"유지보수\", \"유지관리\", \"유상\", \"별도계약\", \"하자보수\", \"하자담보\", \"무상\", \"결함\"]}, \"evidence_required_groups\": [[\"하자보수\", \"하자담보\", \"무상보증\", \"결함\"], [\"기간\", \"존속기간\", \"유지보수\", \"유지관리\", \"무상\", \"유상\"]], \"auto_clear\": {\"any_groups\": [[\"하자보수\", \"하자담보\"], [\"기간\", \"존속기간\"], [\"유지보수\", \"유지관리\", \"무상\", \"유상\"]], \"require\": [\"period\"]}, \"auto_verdict\": false, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제670조\", \"clause\": \"제1항\", \"quote\": \"전3조의 규정에 의한 하자의 보수, 손해배상의 청구 및 계약의 해제는 목적물의 인도를 받은 날로부터 1년내에 하여야 한다\", \"verified\": true, \"text\": \"제670조(담보책임의 존속기간) 제670조(담보책임의 존속기간) ①전3조의 규정에 의한 하자의 보수, 손해배상의 청구 및 계약의 해제는 목적물의 인도를 받은 날로부터 1년내에 하여야 한다. ②목적물의 인도를 요하지 아니하는 경우에는 전항의 기간은 일의 종료한 날로부터 기산한다.\", \"status\": \"quote_ok\"}], \"note\": \"하자담보 제척기간은 임의규정 — 특약으로 연장·단축 가능. 유지보수(유상) 범위·대가·별도계약 여부와 무상 하자보수의 구분은 ITDL-05 병기 강등분, ITDL-04(하자담보 기간·절차)는 동일 모듈 내 중복으로 통합·코퍼스 이력 병합(2026-07-29 지식 다이어트)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"std_refs\": [{\"doc\": \"용역계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제149호)\", \"art\": \"제58조제1항\", \"quote\": \"계약상대자는 계약담당공무원이 제21조 및 제22조의 인수에 의하여 사업의 종료를 확인한 후 1년간(별도의 관련 법률에서 따로 정하고 있는 경우는 제외) 계약목적물의 하자에 대한 보수책임이 있다.\", \"source_file\": \"yongyeok-ilban-jogeon.txt\"}]}, {\"id\": \"SP-DEL-12\", \"module\": \"M-DELIVERY\", \"check\": \"사무처리형(위임형) 용역에서 수임인의 선관주의 의무와 불완전이행 시 구제(시정·재수행 요구, 손해배상, 해지)가 규정되어 있는가\", \"label\": \"위임형 불완전이행 구제\", \"severity\": \"권장\", \"severity_basis\": \"위임의 기본 의무 조문(임의규정) — 민법 제681조 선관주의. 위반 시 채무불이행(제390조) 손해배상·해지(제689조) 체계\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"선량한 관리자\", \"선관주의\", \"재수행\", \"시정 요구\", \"재이행\", \"주의의무\"]}, \"service_scope\": [\"mandate\"], \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제681조\", \"quote\": \"수임인은 위임의 본지에 따라 선량한 관리자의 주의로써 위임사무를 처리하여야 한다\", \"verified\": true, \"text\": \"제681조(수임인의 선관의무)\\n수임인은 위임의 본지에 따라 선량한 관리자의 주의로써 위임사무를 처리하여야 한다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제689조\", \"clause\": \"제1항\", \"quote\": \"위임계약은 각 당사자가 언제든지 해지할 수 있다\", \"verified\": true, \"text\": \"제689조(위임의 상호해지의 자유)\\n①위임계약은 각 당사자가 언제든지 해지할 수 있다.\\n②당사자 일방이 부득이한 사유없이 상대방의 불리한 시기에 계약을 해지한 때에는 그 손해를 배상하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"korean-law MCP 현행 원문 대조(민법 MST 284415, 시행 2026-03-17) — §681·§689 스냅샷 seed 전문 적재. 하자담보책임과 채무불이행책임은 별개 권원으로 경합(대법원 2020다201156 — 판례 전문 재대조는 미결).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"위임형 선관주의·구제는 법정 의무를 계약에서 구체화하는 선택사항임\", \"contract_action_curated\": true}, {\"id\": \"CNS-SALEDEFECT\", \"module\": \"M-DELIVERY\", \"check\": \"매매 목적물의 하자에 대한 구제수단과 권리행사기간이 거래 성격에 맞게 정해져 있는가\", \"label\": \"매매 목적물의 하자 구제\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 민법 제580조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"매도인\", \"하자담보\", \"물품 하자\", \"담보책임\", \"종류\", \"완전물\", \"하자없는 물건\", \"대체물\", \"안 날로부터\", \"권리행사기간\", \"6월내\", \"담보책임 기간\"]}, \"absence_check\": true, \"absence_precondition\": [\"매도인\", \"매수인\", \"물품의 소유권\", \"소유권 이전\"], \"sources\": [{\"law\": \"민법\", \"article\": \"제580조\", \"clause\": \"제1항\", \"quote\": \"매매의 목적물에 하자가 있는 때에는 제575조제1항의 규정을 준용한다\", \"verified\": true, \"text\": \"제580조(매도인의 하자담보책임) 제580조(매도인의 하자담보책임) ①매매의 목적물에 하자가 있는 때에는 제575조제1항의 규정을 준용한다. 그러나 매수인이 하자있는 것을 알았거나 과실로 인하여 이를 알지 못한 때에는 그러하지 아니하다. ②전항의 규정은 경매의 경우에 적용하지 아니한다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제581조\", \"clause\": \"제2항\", \"quote\": \"매수인은 계약의 해제 또는 손해배상의 청구를 하지 아니하고 하자없는 물건을 청구할 수 있다\", \"verified\": true, \"text\": \"제581조(종류매매와 매도인의 담보책임) 제581조(종류매매와 매도인의 담보책임) ①매매의 목적물을 종류로 지정한 경우에도 그 후 특정된 목적물에 하자가 있는 때에는 전조의 규정을 준용한다. ②전항의 경우에 매수인은 계약의 해제 또는 손해배상의 청구를 하지 아니하고 하자없는 물건을 청구할 수 있다.\", \"status\": \"quote_ok\"}, {\"law\": \"민법\", \"article\": \"제582조\", \"quote\": \"전2조에 의한 권리는 매수인이 그 사실을 안 날로부터 6월내에 행사하여야 한다\", \"verified\": true, \"text\": \"제582조(전2조의 권리행사기간) 제582조(전2조의 권리행사기간) 전2조에 의한 권리는 매수인이 그 사실을 안 날로부터 6월내에 행사하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"하자담보책임, 필요한 경우 교환·완전물 급부 및 권리행사기간을 함께 검토한다. 특정물·종류물의 차이를 고려하고 모든 매매에 동일한 교환 약정을 요구하지 않는다. 도급·위임의 하자·불완전이행과 구별한다.\", \"decision_question\": \"매매 목적물의 하자에 대한 구제수단과 권리행사기간이 거래 성격에 맞게 정해져 있는가?\", \"pass_guidance\": \"위 설명의 검토 관점에 비추어 본건에서 수정이 불필요하면 선택\", \"opinion_guidance\": \"본건에서 수정·추가 확인이 필요한 내용을 의견으로 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v2\", \"legacy_check_ids\": [\"SP-DEL-09\", \"SP-DEL-10\", \"SP-DEL-11\"], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"하자담보책임, 필요한 경우 교환·완전물 급부 및 권리행사기간을 함께 검토한다. 특정물·종류물의 차이를 고려하고 모든 매매에 동일한 교환 약정을 요구하지 않는다. 도급·위임의 하자·불완전이행과 구별한다.\", \"contract_action_curated\": true, \"std_refs\": [{\"doc\": \"물품구매(제조)계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제146호)\", \"art\": \"제21조제2항\", \"quote\": \"계약담당공무원은 납품후 1년이내 납품한 물품의 규격과 품질이 계약내용과 상이함을 발견한 때에는 그 사실을 계약상대자에게 통지하고 해당물품의 대체납품 또는 해당 물품대금을 반환하도록 청구할 수 있다.\", \"source_file\": \"mulpum-gumae-ilban-jogeon.txt\"}, {\"doc\": \"물품구매(제조)계약일반조건(계약예규)\", \"doc_date\": \"시행 2026-04-30(제146호)\", \"art\": \"제21조제2항\", \"quote\": \"계약담당공무원은 납품후 1년이내 납품한 물품의 규격과 품질이 계약내용과 상이함을 발견한 때에는 그 사실을 계약상대자에게 통지하고 해당물품의 대체납품 또는 해당 물품대금을 반환하도록 청구할 수 있다.\", \"source_file\": \"mulpum-gumae-ilban-jogeon.txt\"}]}, {\"id\": \"ITDL-06\", \"module\": \"M-DELIVERY\", \"check\": \"서비스수준(SLA)·가동률 기준과 장애 발생 시 대응·보상·손해배상 조항이 있는가\", \"label\": \"SLA·장애 손해배상\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목이나 회사(발주자·전자금융 이용주체) 리스크가 큼 — 시스템 장애 시 회사가 대외 배상·감독제재를 먼저 지므로 상대방 구상근거 확보 필요. 전자금융감독규정 제60조 품질평가 의무는 회사가 수범자.\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"SLA\", \"서비스수준\", \"가동률\", \"장애\", \"서비스 지연\"]}, \"evidence_required_groups\": [[\"SLA\", \"서비스수준\", \"서비스 수준\", \"가동률\", \"장애\"], [\"보상\", \"손해배상\", \"감액\", \"복구\", \"대응\"]], \"auto_clear\": {\"any_groups\": [[\"SLA\", \"서비스수준\", \"서비스 수준\", \"가동률\"], [\"장애\", \"대응\", \"복구\"], [\"보상\", \"손해배상\", \"감액\"]]}, \"auto_verdict\": false, \"absence_check\": true, \"absence_precondition\": [\"SLA\", \"서비스수준\", \"서비스 수준\", \"장애\"], \"sources\": [], \"note\": \"전자금융감독규정 제60조 제1항 제11호는 품질수준 연1회 평가 의무만 규정 — SLA 배상 수준은 계약 재량\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"SLA와 장애 보상은 서비스 위험을 배분하는 실무 협상사항임\", \"contract_action_curated\": true}]}, {\"meta\": {\"type_id\": \"settlement\", \"type_name\": \"화해·합의계약\", \"detect_keywords\": [\"화해\", \"화해계약\", \"화해합의\", \"부제소\", \"부제소특약\", \"상호 양보\", \"상호양보\", \"분쟁의 종결\", \"분쟁을 종지\", \"청구권 포기\", \"권리 포기\", \"소를 제기하지\", \"이의를 제기하지 않\", \"민형사상 제소권\", \"화해금\", \"합의금\"], \"nature_signals\": [\"화해\", \"화해계약\", \"화해합의\", \"부제소\", \"상호 양보\", \"상호양보\", \"분쟁의 종결\", \"분쟁을 종지\", \"청구권 포기\", \"민형사상 제소권\"], \"suppresses\": [\"shareholders\"], \"modules\": [{\"id\": \"M-SETTLE\", \"name\": \"화해 기본\", \"always_on\": true, \"screening_question\": null, \"suggest_keywords\": []}, {\"id\": \"M-SETTLE-PAY\", \"name\": \"화해금 지급\", \"always_on\": false, \"screening_question\": \"화해금·합의금 등 금전 지급 의무가 포함되는가?\", \"suggest_keywords\": [\"화해금\", \"합의금\", \"정산금\", \"분할 지급\", \"지급기한\"]}, {\"id\": \"M-SETTLE-CAP\", \"name\": \"당사자·처분권한\", \"always_on\": false, \"screening_question\": \"대리인 체결·법인 대표·미성년자 등 당사자 자격이나 처분권한이 문제되는가?\", \"suggest_keywords\": [\"대리\", \"대리인\", \"위임\", \"법정대리\", \"대표이사\", \"처분권한\", \"후견\"]}]}, \"checks\": [{\"id\": \"SETTLE-01\", \"module\": \"M-SETTLE\", \"check\": \"화해의 대상인 분쟁(무엇에 관한 화해인지)이 구체적으로 특정되어 있는가\", \"label\": \"분쟁대상 특정\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"화해 성립요건(§731) — 분쟁이 특정되지 않으면 창설적 효력 범위·착오취소 제한 범위가 불확정. 성립요건 지표라 필수(도출규칙상 실무=참고이나 성립요건이므로 override)\", \"norm_type\": \"실무\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"분쟁\", \"다툼\", \"사건\", \"관하여\", \"관련하여\", \"이 사건\", \"손해배상\", \"분쟁의 대상\", \"화해\", \"상호양보\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제731조\", \"quote\": \"화해는 당사자가 상호양보하여 당사자간의 분쟁을 종지할 것을 약정함으로써 그 효력이 생긴다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제731조(화해의 의의) 제731조(화해의 의의) 화해는 당사자가 상호양보하여 당사자간의 분쟁을 종지할 것을 약정함으로써 그 효력이 생긴다.\", \"status\": \"quote_ok\"}], \"note\": \"화해의 창설적 효력·부제소 효과는 '분쟁이 된 법률관계'의 범위에 미침. 대상 분쟁이 불특정이면 효력 범위 다툼이 발생. 묵시적 화해는 엄격해석됨 — 대법원 2021. 9. 9. 선고 2016다203933 판결(원문확인): '화해계약이 성립하기 위해서는 분쟁이 된 법률관계에 관하여 당사자 쌍방이 서로 양보함으로써 분쟁을 끝내기로 하는 의사의 합치가 있어야 하는데, 화해계약이 성립한 이후에는 그 목적이 된 사항에 관하여 나중에 다시 이행을 구하는 등으로 다툴 수 없는 것이 원칙'. 대상·범위의 명시가 중요. 주주간계약의 SH-SET-01(화해 상호양보·종결) 흡수(2026-07-29 지식 다이어트 G10) — §731 성립요건 판정은 본 항·SETTLE-02가 커버.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"화해 대상 분쟁의 특정은 합의 범위와 효력을 정하는 본질적 문구임\", \"contract_action_curated\": true}, {\"id\": \"SETTLE-02\", \"module\": \"M-SETTLE\", \"check\": \"당사자 상호의 양보 내용(각자 무엇을 포기·인정하는지)이 기재되어 있는가\", \"label\": \"상호양보 명시\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"화해 성립요건(§731 '상호양보') — 일방 양보만 있으면 화해가 아니라 단순 포기·면제로 성질이 달라짐. 성립요건 지표라 필수(실무=참고 도출규칙 override)\", \"norm_type\": \"실무\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"상호 양보\", \"상호양보\", \"양보\", \"포기\", \"감액\", \"인정\", \"서로\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"민법\", \"article\": \"제731조\", \"quote\": \"화해는 당사자가 상호양보하여 당사자간의 분쟁을 종지할 것을 약정함으로써 그 효력이 생긴다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제731조(화해의 의의) 제731조(화해의 의의) 화해는 당사자가 상호양보하여 당사자간의 분쟁을 종지할 것을 약정함으로써 그 효력이 생긴다.\", \"status\": \"quote_ok\"}], \"note\": \"'상호양보'가 없으면 §731의 화해가 아니라 편면적 채무면제(§506)·권리포기로 성질결정될 수 있어 창설적 효력·착오취소 제한 법리가 적용되지 않을 수 있음.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"express\", \"text_effect\": \"required_present\", \"implementation_channel\": \"contract\", \"action_rationale\": \"상호 양보 내용은 화해의 성립과 효력 범위를 정하는 본질적 문구임\", \"contract_action_curated\": true}, {\"id\": \"SETTLE-03\", \"module\": \"M-SETTLE\", \"check\": \"화해로 종전 권리관계가 소멸하고 새 법률관계가 창설된다는 취지(창설적 효력)가 반영되어 정산 범위가 특정되어 있는가\", \"label\": \"창설적 효력·정산범위\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"창설적 효력(§732) — 화해 성립 시 종전 권리의무 소멸·재구성. 범위 불명확 시 소멸되는 권리 범위 다툼(실무=참고 도출규칙 override)\", \"norm_type\": \"실무\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"창설적 효력\", \"권리 소멸\", \"종전\", \"소멸\", \"정산\", \"새로운\", \"대체\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제732조\", \"quote\": \"화해계약은 당사자 일방이 양보한 권리가 소멸되고 상대방이 화해로 인하여 그 권리를 취득하는 효력이 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제732조(화해의 창설적효력) 제732조(화해의 창설적효력) 화해계약은 당사자 일방이 양보한 권리가 소멸되고 상대방이 화해로 인하여 그 권리를 취득하는 효력이 있다.\", \"status\": \"quote_ok\"}], \"note\": \"화해 성립 후에는 종전 법률관계를 다시 다툴 수 없음(창설적 효력) — 대법원 2020. 10. 15. 선고 2020다227523,227530 판결(원문확인): '화해계약이 성립되면 특별한 사정이 없는 한 그 창설적 효력에 따라 종전의 법률관계를 바탕으로 한 권리의무관계는 소멸하고, 계약 당사자 사이에 종전의 법률관계가 어떠하였는지를 묻지 않고 화해계약에 따라 새로운 법률관계가 생긴다'. 정산 범위를 명확히 특정하지 않으면 어느 권리가 소멸했는지 분쟁 재발. 주주간계약의 SH-SET-02(화해 창설적 효력) 흡수(2026-07-29 지식 다이어트 G10, cos 0.40).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"SETTLE-04\", \"module\": \"M-SETTLE\", \"check\": \"착오취소 제한(§733)을 고려하여, 화해의 전제·기초가 된 사실(분쟁 외 사항)을 명확히 기재하였는가\", \"label\": \"착오취소 제한 대응\", \"severity\": \"권장\", \"severity_basis\": \"§733은 화해의 착오취소를 원칙 배제(단서 예외). 전제사실 명시로 분쟁 외 사항 착오 리스크를 관리하는 권장 항목\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"착오\", \"취소\", \"전제\", \"기초\", \"사실관계\", \"다툼이 없는\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제733조\", \"quote\": \"화해계약은 착오를 이유로 하여 취소하지 못한다. 그러나 화해당사자의 자격 또는 화해의 목적인 분쟁 이외의 사항에 착오가 있는 때에는 그러하지 아니하다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제733조(화해의 효력과 착오) 제733조(화해의 효력과 착오) 화해계약은 착오를 이유로 하여 취소하지 못한다. 그러나 화해당사자의 자격 또는 화해의 목적인 분쟁 이외의 사항에 착오가 있는 때에는 그러하지 아니하다.\", \"status\": \"quote_ok\"}], \"note\": \"분쟁 자체(화해 목적)에 관한 착오는 취소 불가(§733 본문). 다만 '분쟁의 전제·기초로서 다툼 없이 양해된 사항'의 착오는 취소 가능(단서) — 대법원 2020. 10. 15. 선고 2020다227523,227530 판결(원문확인): '화해의 목적인 분쟁 이외의 사항이라 함은 분쟁의 대상이 아니라 분쟁의 전제 또는 기초가 된 사항으로서, 쌍방 당사자가 예정한 것이어서 상호 양보의 내용으로 되지 않고 다툼이 없는 사실로 양해된 사항을 말한다'. 전제사실을 명시하면 분쟁 외 사항 착오 다툼을 줄임. 주주간계약의 SH-SET-03(화해 착오취소 제한, 필수) 흡수(2026-07-29 지식 다이어트 G10) — 흡수 후 본 항의 권장 유지(사용자 결정: §733 착오취소는 임의규정 법리로 강행 이행체크가 아니므로 필수→권장이 정합).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"SETTLE-05\", \"module\": \"M-SETTLE\", \"check\": \"부제소특약(합의 후 소 제기 금지)의 대상 범위·기준시점이 특정되어 있는가(포괄적·전면적 부제소는 효력이 제한될 수 있음)\", \"label\": \"부제소 범위특정\", \"severity\": \"필수\", \"severity_override\": true, \"severity_basis\": \"부제소합의는 재판청구권 포기와 같은 중대한 소송법상 효과(2024다256932). 범위 불명확 시 계속 중 소송 포함 여부 등 다툼 발생 — 특정성이 핵심(practice=참고 도출규칙 override, 판례법리)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"부제소\", \"부제소특약\", \"소를 제기하지\", \"제소하지 아니\", \"이의를 제기하지 않\", \"민형사상\", \"청구권 포기\"]}, \"absence_check\": true, \"absence_precondition\": [\"부제소\", \"부제소특약\", \"소를 제기하지\", \"제소하지 아니\", \"이의를 제기하지 않\", \"민형사상\", \"청구권 포기\"], \"sources\": [], \"note\": \"부제소특약의 문언이 불명확하면 그 범위(합의 이전 사유·계속 중 소송 포함 여부 등)를 엄격히 해석함 — 대법원 2025. 5. 29. 선고 2024다256932 판결(원문확인): \\\"부제소합의는 소송당사자에게 헌법상 보장된 재판청구권의 포기와 같은 중대한 소송법상의 효과를 발생시키는 것이다\\\"(합의 당시 계속 중이던 소송에까지 효력이 미친다고 보기 어렵다고 판시). 대상 청구·기준시점·계속 중 소송 포함 여부를 명확히 특정할 것. 부제소 의무가 회사에만(또는 회사에 광범위하게) 부과되는 편면 구조인지도 확인(회사 리스크 관점).\\n※ '부제소합의는 특정한 법률관계에 한정되고 당사자가 예상할 수 있는 상황이어야 유효하다'는 확립된 법리가 있으나, 본 지식화 시점에 원문 대조를 완료하지 못하여 판례 source로 등재하지 않음(미확인).\\n주주간계약의 SH-SET-04(부제소 특약 범위) 흡수(2026-07-29 지식 다이어트 G10) — 부제소·청구권 포기 범위 특정은 본 항·SETTLE-06이 커버.\\n\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"부제소 합의의 범위는 유효성 위험을 줄이기 위한 협상·명확화 사항임\", \"contract_action_curated\": true}, {\"id\": \"SETTLE-06\", \"module\": \"M-SETTLE\", \"check\": \"청구권 포기(권리 포기)의 대상과 범위가 특정되어 있는가(포괄적 포기는 해석상 제한될 수 있음)\", \"label\": \"청구권 포기 특정\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"채권 포기·채무면제는 채권자 의사표시 해석을 엄격히 하여 인정(2020다227523). 포괄·묵시적 포기는 함부로 인정되지 않아 범위 특정 필요(practice=참고 도출규칙 override, 판례법리)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"청구권 포기\", \"권리 포기\", \"일체의 청구\", \"채권 포기\", \"면제\", \"더 이상\", \"이의 없\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"포괄적·전면적 청구권 포기는 그 범위를 두고 다툼이 생기며, 채권 포기 인정은 엄격 해석됨 — 대법원 2020. 10. 15. 선고 2020다227523,227530 판결(원문확인): '채무의 면제는 반드시 명시적인 의사표시만에 의하여야 하는 것이 아니고 채권자의 어떠한 행위 내지 의사표시의 해석에 의하여 그것이 채권의 포기라고 볼 수 있는 경우에도 이를 인정하여야 하나, 그와 같이 인정하기 위해서는 당해 권리관계의 내용에 따라 이에 대한 채권자의 행위 내지 의사표시의 해석을 엄격히 하여 적용 여부를 결정하여야 한다'. 포기 대상 채권·범위를 열거·특정할 것. 주주간계약의 SH-SET-04(부제소 특약 범위) 흡수분의 청구권 포기 측면은 본 항이 커버(2026-07-29 지식 다이어트 G10).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"SETTLE-07\", \"module\": \"M-SETTLE-PAY\", \"check\": \"화해금(합의금)의 금액·지급기한·지급방법이 특정되어 있는가\", \"label\": \"화해금 지급조건\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목(법령 강제 아님). 지급조건 불명확 시 이행 분쟁 발생(practice=참고 도출규칙 override — 지급이 화해 이행조건이면 권장)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"화해금\", \"합의금\", \"지급\", \"지급기한\", \"지급방법\", \"계좌\", \"원\", \"정산금\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"화해가 금전지급을 수반하면 금액·기한·방법·분할여부를 특정. 지급이 화해의 이행조건이면 미이행 시 효과(SETTLE-08)와 연계.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"화해금 지급조건은 거래 이행을 위한 중요 조건이나 법정 획일문구는 아님\", \"contract_action_curated\": true}, {\"id\": \"SETTLE-08\", \"module\": \"M-SETTLE-PAY\", \"check\": \"화해금 불이행 시 효과(기한이익 상실·지연손해금·해제·부제소 효력 유지 여부 등)가 규정되어 있는가\", \"label\": \"불이행 시 효과\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님). 미이행 시 화해 존속 여부·강제 방법을 사전 정리하는 관리 항목\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"불이행\", \"기한이익 상실\", \"지연손해금\", \"지연이자\", \"해제\", \"미지급 시\", \"강제집행\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"화해금 미지급이 화해 자체의 해제사유인지, 아니면 화해는 유지되고 지급의무만 강제되는지를 명확히 할 것. 공정증서(집행권원) 작성 여부도 실무상 고려.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\"}, {\"id\": \"SETTLE-09\", \"module\": \"M-SETTLE-CAP\", \"check\": \"당사자의 자격·대리권·처분권한(법인 대표권, 대리인 위임범위 등)이 확인·특정되어 있는가\", \"label\": \"당사자·대리권\", \"severity\": \"권장\", \"severity_basis\": \"§733 단서상 '화해당사자의 자격' 착오는 취소 가능. 자격·처분권한 흠결은 화해 효력에 직결 — 리스크 관리 권장\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"대리\", \"대리인\", \"위임\", \"대표이사\", \"법정대리\", \"처분권한\", \"자격\", \"후견\", \"권한\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"민법\", \"article\": \"제733조\", \"quote\": \"그러나 화해당사자의 자격 또는 화해의 목적인 분쟁 이외의 사항에 착오가 있는 때에는 그러하지 아니하다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제733조(화해의 효력과 착오) 제733조(화해의 효력과 착오) 화해계약은 착오를 이유로 하여 취소하지 못한다. 그러나 화해당사자의 자격 또는 화해의 목적인 분쟁 이외의 사항에 착오가 있는 때에는 그러하지 아니하다.\", \"status\": \"quote_ok\"}], \"note\": \"화해당사자의 자격에 관한 착오는 §733 단서상 취소 가능 사유. 대리인 체결 시 위임범위(화해·청구권 포기 권한 포함 여부), 법인은 대표권·내부수권을 확인. 처분권한 없는 자의 권리 포기는 효력 문제 발생.\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"RISK-SET-01\", \"module\": \"M-SETTLE\", \"check\": \"회사가 포기하는 청구권·권리의 범위가 화해 대상 분쟁으로 한정되지 않고 \\\"일체의 청구권\\\" 등 포괄적으로 규정되어, 회사가 장래 행사할 다른 권리(별개 채권·구상권·미확정 손해)까지 상실하는 구조는 아닌가\", \"label\": \"회사 청구권 포기범위 과다\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"회사 권리상실 직결 리스크 — practice이나 포괄적 청구권 포기는 회사가 회수할 권리를 잃게 함(화해 최대 리스크). 권장 승격(의도적 예외)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"일체의 청구\", \"일체의 권리\", \"모든 청구권\", \"향후 어떠한\", \"이의를 제기하지 않\", \"민형사상\", \"청구권 포기\", \"더 이상\", \"어떠한 이의도\"]}, \"absence_check\": false, \"sources\": [], \"note\": \"회사가 포기측이면 '일체의 청구권 포기'는 화해대상 외 별개 채권·구상권·미확정 손해까지 상실시킬 수 있음(창설적 효력·부제소 효과가 포괄범위에 미침). 포기대상을 화해 분쟁으로 한정·열거하고, 회사가 보유·유보할 권리(별건 구상권 등)를 명시적으로 제외할 것. SETTLE-06과 방향 반대(SETTLE-06은 상대방 포기의 특정성, 본항은 회사 포기의 과다 방지).\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}]}, {\"meta\": {\"type_id\": \"shareholders\", \"type_name\": \"주주간계약\", \"detect_keywords\": [\"주주간\", \"주주간계약\", \"주식양도\", \"지분양도\", \"의결권\", \"우선매수\", \"동반매도\", \"태그얼롱\", \"드래그\", \"주식양수도\", \"지분매매\", \"출자전환\", \"신주인수\"], \"modules\": [{\"id\": \"M-SHARE\", \"name\": \"주식 처분 통제(양도제한·우선매수·동반매도)\", \"always_on\": true, \"screening_question\": null, \"suggest_keywords\": []}, {\"id\": \"M-GOV\", \"name\": \"지배구조·경영(이사지명·의결권·정보접근·교착)\", \"always_on\": true, \"screening_question\": null, \"suggest_keywords\": []}, {\"id\": \"M-FIN\", \"name\": \"자본·지분(신주인수·희석방지·배당)\", \"always_on\": false, \"screening_question\": \"신주발행·증자·배당 등 자본·지분 변동 사항이 포함되는가?\", \"suggest_keywords\": [\"신주\", \"증자\", \"유상증자\", \"희석\", \"배당\", \"종류주식\", \"우선주\"]}, {\"id\": \"M-EXIT\", \"name\": \"이탈·경업(경업금지·전업·이탈정산·진술보장)\", \"always_on\": false, \"screening_question\": \"주주의 경업금지·전업의무·이탈 시 지분 정산이 포함되는가?\", \"suggest_keywords\": [\"경업금지\", \"전업\", \"겸직\", \"콜옵션\", \"풋옵션\", \"진술 및 보장\"]}]}, \"checks\": [{\"id\": \"SH-SHARE-01\", \"module\": \"M-SHARE\", \"check\": \"계약상 주식양도 제한이 정관에 근거한 이사회 승인 방식으로 뒷받침되는가(정관 근거 없는 순수 채권적 제한인지 확인)\", \"label\": \"양도제한 정관근거\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 상법 제335조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"양도제한\", \"양도의 제한\", \"이사회의 승인\", \"정관\"]}, \"absence_check\": true, \"absence_precondition\": [\"양도\", \"양도제한\", \"처분\", \"매각\"], \"sources\": [{\"law\": \"상법\", \"article\": \"제335조\", \"clause\": \"제1항 단서\", \"quote\": \"회사는 정관으로 정하는 바에 따라 그 발행하는 주식의 양도에 관하여 이사회의 승인을 받도록 할 수 있다\", \"verified\": true, \"text\": \"제335조(주식의 양도성) 제335조(주식의 양도성) ① 주식은 타인에게 양도할 수 있다. 다만, 회사는 정관으로 정하는 바에 따라 그 발행하는 주식의 양도에 관하여 이사회의 승인을 받도록 할 수 있다. <개정 2011.4.14> ②제1항 단서의 규정에 위반하여 이사회의 승인을 얻지 아니한 주식의 양도는 회사에 대하여 효력이 없다. <신설 1995.12.29> ③주권발행전에 한 주식의 양도는 회사에 대하여 효력이 없다. 그러나 회사성립후 또는 신주의 납입기일후 6월이 경과한 때에는 그러하지 아니하다. <개정 1984.4.10>\", \"status\": \"quote_ok\"}], \"note\": \"정관 근거 없는 계약상 양도제한은 당사자 간 채권적 효력에 그쳐 회사·제3자에 대항 불가\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract_or_internal_control\", \"action_rationale\": \"정관상 승인과 계약상 양도제한은 효력 층위가 달라 정관 확인과 협상이 함께 필요함\", \"contract_action_curated\": true}, {\"id\": \"SH-SHARE-02\", \"module\": \"M-SHARE\", \"check\": \"정관상 이사회 승인 대상 주식을 승인 없이 양도하면 회사에 대해 효력이 없음을 전제로 양도 절차가 규정되어 있는가\", \"label\": \"이사회 미승인 양도무효\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제335조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이사회의 승인\", \"승인 없이\", \"양도\", \"효력\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제335조\", \"clause\": \"제2항\", \"quote\": \"제1항 단서의 규정에 위반하여 이사회의 승인을 얻지 아니한 주식의 양도는 회사에 대하여 효력이 없다\", \"verified\": true, \"text\": \"제335조(주식의 양도성) 제335조(주식의 양도성) ① 주식은 타인에게 양도할 수 있다. 다만, 회사는 정관으로 정하는 바에 따라 그 발행하는 주식의 양도에 관하여 이사회의 승인을 받도록 할 수 있다. <개정 2011.4.14> ②제1항 단서의 규정에 위반하여 이사회의 승인을 얻지 아니한 주식의 양도는 회사에 대하여 효력이 없다. <신설 1995.12.29> ③주권발행전에 한 주식의 양도는 회사에 대하여 효력이 없다. 그러나 회사성립후 또는 신주의 납입기일후 6월이 경과한 때에는 그러하지 아니하다. <개정 1984.4.10>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-SHARE-03\", \"module\": \"M-SHARE\", \"check\": \"주권 미발행 회사에서 회사성립·납입기일 후 6월 경과 전 주식양도의 대(對)회사 효력 제한을 양도 시점 설계에 반영했는가\", \"label\": \"주권미발행 6월 양도제한\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제335조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"주권발행전\", \"주권 미발행\", \"6월\", \"양도\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제335조\", \"clause\": \"제3항\", \"quote\": \"주권발행전에 한 주식의 양도는 회사에 대하여 효력이 없다. 그러나 회사성립후 또는 신주의 납입기일후 6월이 경과한 때에는 그러하지 아니하다\", \"verified\": true, \"text\": \"제335조(주식의 양도성) 제335조(주식의 양도성) ① 주식은 타인에게 양도할 수 있다. 다만, 회사는 정관으로 정하는 바에 따라 그 발행하는 주식의 양도에 관하여 이사회의 승인을 받도록 할 수 있다. <개정 2011.4.14> ②제1항 단서의 규정에 위반하여 이사회의 승인을 얻지 아니한 주식의 양도는 회사에 대하여 효력이 없다. <신설 1995.12.29> ③주권발행전에 한 주식의 양도는 회사에 대하여 효력이 없다. 그러나 회사성립후 또는 신주의 납입기일후 6월이 경과한 때에는 그러하지 아니하다. <개정 1984.4.10>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-SHARE-04\", \"module\": \"M-SHARE\", \"check\": \"정관상 양도승인 대상인 경우 상법상 양도승인청구·매수청구 절차와 계약상 우선매수 절차의 선후관계가 정리되어 있는가\", \"label\": \"승인·우선매수 선후\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 상법 제335조의2\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"양도승인\", \"승인 청구\", \"매수청구\", \"양도의 승인\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제335조의2\", \"clause\": \"제1항\", \"quote\": \"주식을 양도하고자 하는 주주는 회사에 대하여 양도의 상대방 및 양도하고자 하는 주식의 종류와 수를 기재한 서면으로 양도의 승인을 청구할 수 있다\", \"verified\": true, \"text\": \"제335조의2(양도승인의 청구) 제335조의2(양도승인의 청구) ①주식의 양도에 관하여 이사회의 승인을 얻어야 하는 경우에는 주식을 양도하고자 하는 주주는 회사에 대하여 양도의 상대방 및 양도하고자 하는 주식의 종류와 수를 기재한 서면으로 양도의 승인을 청구할 수 있다. ②회사는 제1항의 청구가 있는 날부터 1월 이내에 주주에게 그 승인여부를 서면으로 통지하여야 한다. ③회사가 제2항의 기간내에 주주에게 거부의 통지를 하지 아니한 때에는 주식의 양도에 관하여 이사회의 승인이 있는 것으로 본다. ④제2항의 양도승인거부의 통지를 받은 주주는 통지를 받은 날부터 20일내에 회사에 대하여 양도의 상대방의 지정 또는 그 주식의 매수를 청구할 수 있다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-SHARE-05\", \"module\": \"M-SHARE\", \"check\": \"우선매수권(ROFR) 행사의 통지 절차·행사기간·가격결정 방법이 특정되어 있는가\", \"label\": \"우선매수권(ROFR)\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목(법령 강제 아님). 리스크: 회사=주주 지위에서 ROFR 행사기간·가격결정 미비 시 지분방어·엑싯 통제장치 형해화(severity_override: risk, 지분가치 보호)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"우선매수권\", \"우선매수\", \"ROFR\", \"우선청약\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"우선매수권은 계약자유 영역의 채권적 약정 — 법령상 강제 요건 없음\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"우선매수권은 법정 기본권이 아니라 당사자 협상으로 창설하는 권리임\", \"contract_action_curated\": true}, {\"id\": \"SH-SHARE-06\", \"module\": \"M-SHARE\", \"check\": \"동반매도참여권(tag-along) 행사 시 매수인이 소수주주 지분을 동일 조건으로 인수하도록 하는 의무가 규정되어 있는가\", \"label\": \"동반매도참여권(tag-along)\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목(법령 강제 아님). 리스크: 회사=소수주주 지위에서 tag-along 부재 시 지배주주 단독 엑싯에 고립되어 잔여지분 유동성·지분가치 훼손(severity_override: risk, 엑싯 보호)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"동반매도참여\", \"동반매각참여\", \"태그얼롱\", \"tag-along\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"동반매도참여권(tag-along) 행사 시 매수인이 소수주주 지분을 동일 조건으로 인수하도록 하는 의무가 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"동반매도참여권은 소수주주 보호를 위해 선택적으로 설계하는 계약상 권리임\", \"contract_action_curated\": true}, {\"id\": \"SH-SHARE-07\", \"module\": \"M-SHARE\", \"check\": \"동반매도청구권(drag-along) 행사요건·소수주주 매도의무·공정가격 보장이 규정되어 있는가\", \"label\": \"동반매도청구권(drag-along)\", \"severity\": \"권장\", \"severity_override\": true, \"severity_basis\": \"실무 관행 항목(법령 강제 아님). 리스크: 회사가 소수주주면 drag 행사로 불리한 시점·가격 매도의무 강제 노출, 공정가격·행사요건 보장 확인이 지분가치 방어에 직결(severity_override: risk)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"동반매도청구\", \"동반매각청구\", \"드래그\", \"drag-along\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"동반매도청구권은 채권적 약정 — 소수주주 매도의무의 이행강제·공정성(주주평등) 다툼 소지, 가격산정·보호장치 필요\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"동반매도청구권은 지배주주 회수구조에 따라 선택적으로 설계하는 계약상 권리임\", \"contract_action_curated\": true}, {\"id\": \"SH-SHARE-08\", \"module\": \"M-SHARE\", \"check\": \"주식양도의 이행방법(주권 교부)과 명의개서 협력의무가 규정되어 있는가\", \"label\": \"주권교부·명의개서\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제336조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"주권 교부\", \"명의개서\", \"주주명부\", \"양도방법\"]}, \"absence_check\": true, \"absence_precondition\": [\"양도\", \"양수도\", \"주식양도\", \"지분양도\", \"매각\", \"매매\"], \"sources\": [{\"law\": \"상법\", \"article\": \"제336조\", \"clause\": \"제1항\", \"quote\": \"주식의 양도에 있어서는 주권을 교부하여야 한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제336조(주식의 양도방법) 제336조(주식의 양도방법) ①주식의 양도에 있어서는 주권을 교부하여야 한다. ②주권의 점유자는 이를 적법한 소지인으로 추정한다.\", \"status\": \"quote_ok\"}, {\"law\": \"상법\", \"article\": \"제337조\", \"clause\": \"제1항\", \"quote\": \"주식의 이전은 취득자의 성명과 주소를 주주명부에 기재하지 아니하면 회사에 대항하지 못한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제337조(주식의 이전의 대항요건) 제337조(주식의 이전의 대항요건) ①주식의 이전은 취득자의 성명과 주소를 주주명부에 기재하지 아니하면 회사에 대항하지 못한다. <개정 2014.5.20> ②회사는 정관이 정하는 바에 의하여 명의개서대리인을 둘 수 있다. 이 경우 명의개서대리인이 취득자의 성명과 주소를 주주명부의 복본에 기재한 때에는 제1항의 명의개서가 있는 것으로 본다. <신설 1984.4.10>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"주식양도의 이행방법(주권 교부)과 명의개서 협력의무가 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"derived\", \"text_effect\": \"conditional\", \"implementation_channel\": \"contract\", \"action_rationale\": \"실제 이행·증빙은 확인하지 않고 계약상 의무·협력·위험배분과 거래 조건만 검토함\", \"contract_action_curated\": true}, {\"id\": \"SH-GOV-01\", \"module\": \"M-GOV\", \"check\": \"이사 지명권이 주주총회 선임 절차를 통해 실현되도록 규정되어 있는가(주총 결의 없이 이사 지위를 직접 부여하지 않음)\", \"label\": \"이사 지명권 주총선임\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제382조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"이사 지명\", \"지명권\", \"이사 선임\", \"이사의 선임\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제382조\", \"clause\": \"제1항\", \"quote\": \"이사는 주주총회에서 선임한다\", \"verified\": true, \"text\": \"제382조(이사의 선임, 회사와의 관계 및 사외이사) 제382조(이사의 선임, 회사와의 관계 및 사외이사) ① 이사는 주주총회에서 선임한다. ② 회사와 이사의 관계는 「민법」의 위임에 관한 규정을 준용한다. ③ 사외이사(社外理事)는 해당 회사의 상무(常務)에 종사하지 아니하는 이사로서 다음 각 호의 어느 하나에 해당하지 아니하는 자를 말한다. 사외이사가 다음 각 호의 어느 하나에 해당하는 경우에는 그 직을 상실한다. <개정 2011.4.14> 1. 회사의 상무에 종사하는 이사ㆍ집행임원 및 피용자 또는 최근 2년 이내에 회사의 상무에 종사한 이사ㆍ감사ㆍ집행임원 및 피용자 2. 최대주주가 자연인인 경우 본인과 그 배우자 및 직계 존속ㆍ비속 3. 최대주주가 법인인 경우 그 법인의 이사ㆍ감사ㆍ집행임원 및 피용자 4. 이사ㆍ감사ㆍ집행임원의 배우자 및 직계 존속ㆍ비속 5. 회사의 모회사 또는 자회사의 이사ㆍ감사ㆍ집행임원 및 피용자 6. 회사와 거래관계 등 중요한 이해관계에 있는 법인의 이사ㆍ감사ㆍ집행임원 및 피용자 7. 회사의 이사ㆍ집행임원 및 피용자가 이사ㆍ집행임원으로 있는 다른 회사의 이사ㆍ감사ㆍ집행임원 및 피용자\", \"status\": \"quote_ok\"}], \"note\": \"이사 선임은 주주총회 전속권한(강행) — 계약상 지명권은 지명주주가 주총에서 찬성의결할 의무로 구성해야 함\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-GOV-02\", \"module\": \"M-GOV\", \"check\": \"의결권 구속약정(voting agreement)이 1주 1의결권 원칙 범위 내에서 채권적 약정 형태로 규정되어 있는가\", \"label\": \"의결권 구속약정\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제369조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"의결권 구속\", \"의결권 행사\", \"의결권 공동행사\", \"voting\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제369조\", \"clause\": \"제1항\", \"quote\": \"의결권은 1주마다 1개로 한다\", \"verified\": true, \"text\": \"제369조(의결권) 제369조(의결권) ①의결권은 1주마다 1개로 한다. ②회사가 가진 자기주식은 의결권이 없다. ③회사, 모회사 및 자회사 또는 자회사가 다른 회사의 발행주식의 총수의 10분의 1을 초과하는 주식을 가지고 있는 경우 그 다른 회사가 가지고 있는 회사 또는 모회사의 주식은 의결권이 없다. <신설 1984.4.10>\", \"status\": \"quote_ok\"}], \"note\": \"1주 1의결권은 강행 — 의결권 구속약정은 당사자 간 채권적 효력에 그쳐 회사·제3자 구속·직접 이행강제가 곤란(판례)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-GOV-03\", \"module\": \"M-GOV\", \"check\": \"주요경영사항에 대한 사전 동의권의 대상이 약정되어 있는가\", \"label\": \"사전동의권(veto) 열거\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"사전 동의\", \"동의권\", \"협의 사항\", \"거부권\", \"veto\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"사전 동의권의 대상이 실제로 지정되어 있는지 확인한다. 권한이라는 제목만으로 통과하지 않으며 법정 기관 권한 침해 등 적정성 질문까지 승인한 것으로 표시하지 않는다.\", \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"주요경영사항에 대한 사전 동의권의 대상이 약정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"사전동의권 대상은 투자자 보호와 경영자율성 사이에서 선택적으로 설계하는 권리임\", \"contract_action_curated\": true}, {\"id\": \"SH-GOV-04\", \"module\": \"M-GOV\", \"check\": \"계약상 정보접근권이 상법상 소수주주 회계장부열람권·이사회의사록 열람권을 보완하도록 규정되어 있는가\", \"label\": \"정보접근권 보완\", \"severity\": \"권장\", \"severity_basis\": \"근거 조문이 임의규정임 — 상법 제466조\", \"norm_type\": \"임의\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"정보접근\", \"열람\", \"회계장부\", \"자료 제공\", \"정보 제공\"]}, \"absence_check\": true, \"absence_precondition\": [\"정보접근\", \"열람\", \"회계장부\", \"자료 제공\", \"정보 제공\"], \"sources\": [{\"law\": \"상법\", \"article\": \"제466조\", \"clause\": \"제1항\", \"quote\": \"발행주식의 총수의 100분의 3 이상에 해당하는 주식을 가진 주주는 이유를 붙인 서면으로 회계의 장부와 서류의 열람 또는 등사를 청구할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제466조(주주의 회계장부열람권) 제466조(주주의 회계장부열람권) ①발행주식의 총수의 100분의 3 이상에 해당하는 주식을 가진 주주는 이유를 붙인 서면으로 회계의 장부와 서류의 열람 또는 등사를 청구할 수 있다. <개정 1998.12.28> ②회사는 제1항의 주주의 청구가 부당함을 증명하지 아니하면 이를 거부하지 못한다. <개정 1998.12.28>\", \"status\": \"quote_ok\"}, {\"law\": \"상법\", \"article\": \"제391조의3\", \"clause\": \"제3항\", \"quote\": \"주주는 영업시간내에 이사회의사록의 열람 또는 등사를 청구할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제391조의3(이사회의 의사록) 제391조의3(이사회의 의사록) ①이사회의 의사에 관하여는 의사록을 작성하여야 한다. ②의사록에는 의사의 안건, 경과요령, 그 결과, 반대하는 자와 그 반대이유를 기재하고 출석한 이사 및 감사가 기명날인 또는 서명하여야 한다. <개정 1995.12.29, 1999.12.31> ③주주는 영업시간내에 이사회의사록의 열람 또는 등사를 청구할 수 있다. <신설 1999.12.31> ④회사는 제3항의 청구에 대하여 이유를 붙여 이를 거절할 수 있다. 이 경우 주주는 법원의 허가를 얻어 이사회의사록을 열람 또는 등사할 수 있다. <신설 1999.12.31>\", \"status\": \"quote_ok\"}], \"note\": \"상법상 회계장부열람권은 3% 이상 지분 요건 — 계약상 정보권으로 지분 미달 주주의 접근을 보완\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"계약상 정보접근권이 상법상 소수주주 회계장부열람권·이사회의사록 열람권을 보완하도록 규정되어 있는가?\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"법정 열람권을 넘는 정보접근권은 투자조건에 따라 회사 유불리를 보고 정할 협의사항임\", \"contract_action_curated\": true}, {\"id\": \"SH-GOV-05\", \"module\": \"M-GOV\", \"check\": \"교착상태를 해소하는 절차가 약정되어 있는가\", \"label\": \"교착상태(deadlock) 해소\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"교착\", \"deadlock\", \"러시안룰렛\", \"매수매도선택권\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"교착상태를 해소하는 절차가 약정되어 있는가?\", \"note\": \"교착 해소를 위한 매수·매도 선택권, 제3자 결정, 해산 등 계약에 정한 절차 중 하나를 확인한다. 모든 대안을 동시에 요구하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"교착해소 방식은 주주구성과 회수전략에 따라 선택하는 계약상 절차임\", \"contract_action_curated\": true}, {\"id\": \"SH-GOV-06\", \"module\": \"M-GOV\", \"check\": \"지명이사도 지명주주가 아닌 회사에 대한 충실의무를 부담함을 전제로 이사 행위 지시 조항이 구성되어 있는가\", \"label\": \"지명이사 충실의무\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제382조의3\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"충실의무\", \"이사의 의무\", \"지명이사\", \"선관주의\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제382조의3\", \"clause\": \"제1항\", \"quote\": \"이사는 법령과 정관의 규정에 따라 회사 및 주주를 위하여 그 직무를 충실하게 수행하여야 한다\", \"verified\": true, \"text\": \"제382조의3(이사의 충실의무 등) 제382조의3(이사의 충실의무 등) ① 이사는 법령과 정관의 규정에 따라 회사 및 주주를 위하여 그 직무를 충실하게 수행하여야 한다. ② 이사는 그 직무를 수행함에 있어 총주주의 이익을 보호하여야 하고, 전체 주주의 이익을 공평하게 대우하여야 한다.\", \"status\": \"quote_ok\"}], \"note\": \"지명이사에게 지명주주 지시에 무조건 따를 의무를 지우는 조항은 충실의무(강행)와 충돌 소지 — 개정 상법은 충실의무 대상에 '주주'를 포함하고 전체 주주 공평대우를 요구(제2항)\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-GOV-07\", \"module\": \"M-GOV\", \"check\": \"주요주주·지명이사와 회사 간 거래가 이사회 승인(이사 3분의 2) 및 공정성 요건을 거치도록 규정되어 있는가\", \"label\": \"이해관계자 거래승인\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제398조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"자기거래\", \"이해상충\", \"관계자 거래\", \"이사회의 승인\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제398조\", \"quote\": \"미리 이사회에서 해당 거래에 관한 중요사실을 밝히고 이사회의 승인을 받아야 한다\", \"verified\": true, \"text\": \"제398조(이사 등과 회사 간의 거래) 제398조(이사 등과 회사 간의 거래) 다음 각 호의 어느 하나에 해당하는 자가 자기 또는 제3자의 계산으로 회사와 거래를 하기 위하여는 미리 이사회에서 해당 거래에 관한 중요사실을 밝히고 이사회의 승인을 받아야 한다. 이 경우 이사회의 승인은 이사 3분의 2 이상의 수로써 하여야 하고, 그 거래의 내용과 절차는 공정하여야 한다. 1. 이사 또는 제542조의8제2항제6호에 따른 주요주주 2. 제1호의 자의 배우자 및 직계존비속 3. 제1호의 자의 배우자의 직계존비속 4. 제1호부터 제3호까지의 자가 단독 또는 공동으로 의결권 있는 발행주식 총수의 100분의 50 이상을 가진 회사 및 그 자회사 5. 제1호부터 제3호까지의 자가 제4호의 회사와 합하여 의결권 있는 발행주식총수의 100분의 50 이상을 가진 회사\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-FIN-01\", \"module\": \"M-FIN\", \"check\": \"주주의 지분비율에 따른 신주인수권(pre-emptive right)이 보장되도록 규정되어 있는가\", \"label\": \"신주인수권 보장\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제418조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"신주인수권\", \"신주 배정\", \"지분비율\", \"우선청약\"]}, \"absence_check\": true, \"sources\": [{\"law\": \"상법\", \"article\": \"제418조\", \"clause\": \"제1항\", \"quote\": \"주주는 그가 가진 주식 수에 따라서 신주의 배정을 받을 권리가 있다\", \"verified\": true, \"text\": \"제418조(신주인수권의 내용 및 배정일의 지정ㆍ공고) 제418조(신주인수권의 내용 및 배정일의 지정ㆍ공고) ①주주는 그가 가진 주식 수에 따라서 신주의 배정을 받을 권리가 있다. <개정 2001.7.24> ②회사는 제1항의 규정에 불구하고 정관에 정하는 바에 따라 주주 외의 자에게 신주를 배정할 수 있다. 다만, 이 경우에는 신기술의 도입, 재무구조의 개선 등 회사의 경영상 목적을 달성하기 위하여 필요한 경우에 한한다. <신설 2001.7.24> ③회사는 일정한 날을 정하여 그 날에 주주명부에 기재된 주주가 제1항의 권리를 가진다는 뜻과 신주인수권을 양도할 수 있을 경우에는 그 뜻을 그 날의 2주간전에 공고하여야 한다. 그러나 그 날이 제354조제1항의 기간 중인 때에는 그 기간의 초일의 2주간전에 이를 공고하여야 한다. <신설 1984.4.10> ④ 제2항에 따라 주주 외의 자에게 신주를 배정하는 경우 회사는 제416조제1호, 제2호, 제2호의2, 제3호 및 제4호에서 정하는 사항을 그 납입기일의 2주 전까지 주주에게 통지하거나 공고하여야 한다. <신설 2011.4.14>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"none\", \"text_effect\": \"none\", \"implementation_channel\": \"statutory_duty\", \"action_rationale\": \"주주의 신주인수권은 법률에서 직접 발생하며 계약문구 부재만으로 권리가 사라지지 않음\", \"contract_action_curated\": true}, {\"id\": \"SH-FIN-02\", \"module\": \"M-FIN\", \"check\": \"제3자 신주배정이 정관 근거와 경영상 목적 요건을 충족하는 범위로 제한되어 있는가\", \"label\": \"제3자 신주배정 제한\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제418조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"제3자 배정\", \"제3자 신주\", \"경영상 목적\", \"신주 발행\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제418조\", \"clause\": \"제2항 단서\", \"quote\": \"신기술의 도입, 재무구조의 개선 등 회사의 경영상 목적을 달성하기 위하여 필요한 경우에 한한다\", \"verified\": true, \"text\": \"제418조(신주인수권의 내용 및 배정일의 지정ㆍ공고) 제418조(신주인수권의 내용 및 배정일의 지정ㆍ공고) ①주주는 그가 가진 주식 수에 따라서 신주의 배정을 받을 권리가 있다. <개정 2001.7.24> ②회사는 제1항의 규정에 불구하고 정관에 정하는 바에 따라 주주 외의 자에게 신주를 배정할 수 있다. 다만, 이 경우에는 신기술의 도입, 재무구조의 개선 등 회사의 경영상 목적을 달성하기 위하여 필요한 경우에 한한다. <신설 2001.7.24> ③회사는 일정한 날을 정하여 그 날에 주주명부에 기재된 주주가 제1항의 권리를 가진다는 뜻과 신주인수권을 양도할 수 있을 경우에는 그 뜻을 그 날의 2주간전에 공고하여야 한다. 그러나 그 날이 제354조제1항의 기간 중인 때에는 그 기간의 초일의 2주간전에 이를 공고하여야 한다. <신설 1984.4.10> ④ 제2항에 따라 주주 외의 자에게 신주를 배정하는 경우 회사는 제416조제1호, 제2호, 제2호의2, 제3호 및 제4호에서 정하는 사항을 그 납입기일의 2주 전까지 주주에게 통지하거나 공고하여야 한다. <신설 2011.4.14>\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-FIN-03\", \"module\": \"M-FIN\", \"check\": \"후속 라운드 저가 발행 시 지분희석 방지(anti-dilution) 조정 방식(전환가·추가배정 등)이 규정되어 있는가\", \"label\": \"지분희석 방지(anti-dilution)\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"희석방지\", \"지분희석\", \"anti-dilution\", \"전환가 조정\", \"리픽싱\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"희석방지는 신주인수권(상법 제418조)·종류주식 설계와 정합해야 하며 정관 반영이 필요할 수 있음\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"희석방지 조항은 투자조건과 후속 자금조달 계획에 따라 선택하는 권리임\", \"contract_action_curated\": true}, {\"id\": \"SH-FIN-04\", \"module\": \"M-FIN\", \"check\": \"우선주·전환주·상환주 등 종류주식에 결부된 권리가 정관상 종류주식 규정에 근거하는가\", \"label\": \"종류주식 정관근거\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제344조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"종류주식\", \"우선주\", \"전환주\", \"상환주\", \"우선배당\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제344조\", \"clause\": \"제2항\", \"quote\": \"제1항의 경우에는 정관으로 각 종류주식의 내용과 수를 정하여야 한다\", \"verified\": true, \"text\": \"제344조(종류주식) 제344조(종류주식) ① 회사는 이익의 배당, 잔여재산의 분배, 주주총회에서의 의결권의 행사, 상환 및 전환 등에 관하여 내용이 다른 종류의 주식(이하 \\\"종류주식\\\"이라 한다)을 발행할 수 있다. ② 제1항의 경우에는 정관으로 각 종류주식의 내용과 수를 정하여야 한다. ③ 회사가 종류주식을 발행하는 때에는 정관에 다른 정함이 없는 경우에도 주식의 종류에 따라 신주의 인수, 주식의 병합ㆍ분할ㆍ소각 또는 회사의 합병ㆍ분할로 인한 주식의 배정에 관하여 특수하게 정할 수 있다. ④ 종류주식 주주의 종류주주총회의 결의에 관하여는 제435조제2항을 준용한다.\", \"status\": \"quote_ok\"}], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-FIN-05\", \"module\": \"M-FIN\", \"check\": \"배당정책 합의가 상법상 배당가능이익 한도와 주주총회 결의 요건 내에서 규정되어 있는가\", \"label\": \"배당정책 합의\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제462조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"배당\", \"배당정책\", \"이익배당\", \"배당가능이익\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제462조\", \"clause\": \"제1항\", \"quote\": \"회사는 대차대조표의 순자산액으로부터 다음의 금액을 공제한 액을 한도로 하여 이익배당을 할 수 있다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제462조(이익의 배당) 제462조(이익의 배당) ① 회사는 대차대조표의 순자산액으로부터 다음의 금액을 공제한 액을 한도로 하여 이익배당을 할 수 있다. 1. 자본금의 액 2. 그 결산기까지 적립된 자본준비금과 이익준비금의 합계액 3. 그 결산기에 적립하여야 할 이익준비금의 액 4. 대통령령으로 정하는 미실현이익 ② 이익배당은 주주총회의 결의로 정한다. 다만, 제449조의2제1항에 따라 재무제표를 이사회가 승인하는 경우에는 이사회의 결의로 정한다. ③ 제1항을 위반하여 이익을 배당한 경우에 회사채권자는 배당한 이익을 회사에 반환할 것을 청구할 수 있다. ④ 제3항의 청구에 관한 소에 대하여는 제186조를 준용한다.\", \"status\": \"quote_ok\"}, {\"law\": \"상법\", \"article\": \"제462조\", \"clause\": \"제2항\", \"quote\": \"이익배당은 주주총회의 결의로 정한다\", \"verified\": true, \"source_type\": \"law\", \"text\": \"제462조(이익의 배당) 제462조(이익의 배당) ① 회사는 대차대조표의 순자산액으로부터 다음의 금액을 공제한 액을 한도로 하여 이익배당을 할 수 있다. 1. 자본금의 액 2. 그 결산기까지 적립된 자본준비금과 이익준비금의 합계액 3. 그 결산기에 적립하여야 할 이익준비금의 액 4. 대통령령으로 정하는 미실현이익 ② 이익배당은 주주총회의 결의로 정한다. 다만, 제449조의2제1항에 따라 재무제표를 이사회가 승인하는 경우에는 이사회의 결의로 정한다. ③ 제1항을 위반하여 이익을 배당한 경우에 회사채권자는 배당한 이익을 회사에 반환할 것을 청구할 수 있다. ④ 제3항의 청구에 관한 소에 대하여는 제186조를 준용한다.\", \"status\": \"quote_ok\"}], \"note\": \"최소배당 약정 등도 배당가능이익 한도(강행) 초과 시 이행 불가 — 한도 초과 배당은 반환 대상\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-FIN-06\", \"module\": \"M-FIN\", \"check\": \"추가 자본조달 시 주주의 참여 의무·비율이 약정되어 있는가\", \"label\": \"후속 출자 약정\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"추가 출자\", \"자금조달\", \"후속 투자\", \"증자 참여\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"reword\", \"meaning_revision\": \"1.88.1\", \"judgment_level\": \"presence\", \"judgment_scope\": \"module\", \"decision_question\": \"추가 자본조달 시 주주의 참여 의무·비율이 약정되어 있는가?\", \"note\": \"후속 출자·증자에 관한 참여 의무와 비율 또는 그 산정 기준을 확인한다. 경제적 조건의 유불리나 실제 납입 이행은 판정하지 않는다.\", \"pass_guidance\": \"이 질문의 약정 내용이 확인되고 구체적인 반대 내용이 없는 경우\", \"opinion_guidance\": \"본건에서 확인된 구체적인 문제와 근거를 작성\", \"checklist_revision\": \"content-v3\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"후속 출자의무는 법정 기본의무가 아니라 자금조달 합의에 따라 창설하는 의무임\", \"contract_action_curated\": true}, {\"id\": \"CNS-SHCOMMIT\", \"module\": \"M-EXIT\", \"check\": \"주요주주의 경업·겸직 제한과 필요한 전업 의무의 범위 및 위반 시 효과가 계약 목적에 비추어 합리적인가\", \"label\": \"핵심주주 경업·전업 의무\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"경업금지\", \"경업\", \"겸직 금지\", \"동종 영업\", \"전업\", \"전념 의무\", \"상근\", \"핵심 인력\"]}, \"absence_check\": true, \"sources\": [], \"note\": \"적용 주주, 금지업무·기간·예외 및 전업 의무의 필요성과 위반 효과를 함께 검토한다. 모든 주주에게 동일한 의무를 부과하지 않으며 이탈 시 지분정산은 별도 항목에서 확인한다.\", \"decision_question\": \"주요주주의 경업·겸직 제한과 필요한 전업 의무의 범위 및 위반 시 효과가 계약 목적에 비추어 합리적인가?\", \"pass_guidance\": \"위 설명의 검토 관점에 비추어 본건에서 수정이 불필요하면 선택\", \"opinion_guidance\": \"본건에서 수정·추가 확인이 필요한 내용을 의견으로 작성\", \"auto_verdict\": false, \"checklist_revision\": \"content-v2\", \"legacy_check_ids\": [\"SH-EXIT-01\", \"SH-EXIT-02\"], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"적용 주주, 금지업무·기간·예외 및 전업 의무의 필요성과 위반 효과를 함께 검토한다. 모든 주주에게 동일한 의무를 부과하지 않으며 이탈 시 지분정산은 별도 항목에서 확인한다.\", \"contract_action_curated\": true}, {\"id\": \"SH-EXIT-03\", \"module\": \"M-EXIT\", \"check\": \"이탈(퇴사·중대한 위반) 시 지분 정산 방식(콜·풋옵션, 매도의무, 정산가격)이 규정되어 있는가\", \"label\": \"이탈 시 지분정산\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"이탈\", \"정산\", \"콜옵션\", \"풋옵션\", \"매도의무\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"이탈 시 지분정산은 창업자·투자자 간 위험과 회수구조를 정하는 협상사항임\", \"contract_action_curated\": true}, {\"id\": \"SH-EXIT-04\", \"module\": \"M-EXIT\", \"check\": \"회사가 이탈주주 주식을 자기주식으로 취득해 정산하는 구조라면 배당가능이익 한도·취득 절차 요건을 충족하는가\", \"label\": \"자기주식 취득정산\", \"severity\": \"필수\", \"severity_basis\": \"근거 조문이 강행규정(의무)임 — 상법 제341조\", \"norm_type\": \"강행\", \"basis\": \"statute\", \"triggers\": {\"keywords\": [\"자기주식\", \"자기주식 취득\", \"자사주\", \"취득가액\"]}, \"absence_check\": false, \"sources\": [{\"law\": \"상법\", \"article\": \"제341조\", \"clause\": \"제1항 단서\", \"quote\": \"그 취득가액의 총액은 직전 결산기의 대차대조표상의 순자산액에서 제462조제1항 각 호의 금액을 뺀 금액을 초과하지 못한다\", \"verified\": true, \"text\": \"제341조(자기주식의 취득) 제341조(자기주식의 취득) ① 회사는 다음의 방법에 따라 자기의 명의와 계산으로 자기의 주식을 취득할 수 있다. 다만, 그 취득가액의 총액은 직전 결산기의 대차대조표상의 순자산액에서 제462조제1항 각 호의 금액을 뺀 금액을 초과하지 못한다. 1. 거래소에서 시세(時勢)가 있는 주식의 경우에는 거래소에서 취득하는 방법 2. 제345조제1항의 주식의 상환에 관한 종류주식의 경우 외에 각 주주가 가진 주식 수에 따라 균등한 조건으로 취득하는 것으로서 대통령령으로 정하는 방법 ② 제1항에 따라 자기주식을 취득하려는 회사는 미리 주주총회의 결의로 다음 각 호의 사항을 결정하여야 한다. 다만, 이사회의 결의로 이익배당을 할 수 있다고 정관으로 정하고 있는 경우에는 이사회의 결의로써 주주총회의 결의를 갈음할 수 있다. 1. 취득할 수 있는 주식의 종류 및 수 2. 취득가액의 총액의 한도 3. 1년을 초과하지 아니하는 범위에서 자기주식을 취득할 수 있는 기간 ③ 회사는 해당 영업연도의 결산기에 대차대조표상의 순자산액이 제462조제1항 각 호의 금액의 합계액에 미치지 못할 우려가 있는 경우에는 제1항에 따른 주식의 취득을 하여서는 아니 된다. ④ 해당 영업연도의 결산기에 대차대조표상의 순자산액이 제462조제1항 각 호의 금액의 합계액에 미치지 못함에도 불구하고 회사가 제1항에 따라 주식을 취득한 경우 이사는 회사에 대하여 연대하여 그 미치지 못한 금액을 배상할 책임이 있다. 다만, 이사가 제3항의 우려가 없다고 판단하는 때에 주의를 게을리하지 아니하였음을 증명한 경우에는 그러하지 아니하다.\", \"status\": \"quote_ok\"}], \"note\": \"회사에 의한 지분 매입 정산은 자기주식 취득 규제(배당가능이익 한도·주총 또는 이사회 결의) 적용 — 한도 초과 시 무효 소지\", \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"appropriateness\", \"judgment_scope\": \"module\"}, {\"id\": \"SH-EXIT-05\", \"module\": \"M-EXIT\", \"check\": \"주식·회사 관련 진술 및 보장과 그 위반 시 손해전보(면책·정산) 조항이 규정되어 있는가\", \"label\": \"진술·보장 손해전보\", \"severity\": \"참고\", \"severity_basis\": \"실무 관행 항목(법령 강제 아님)\", \"norm_type\": \"실무\", \"basis\": \"practice\", \"triggers\": {\"keywords\": [\"진술 및 보장\", \"진술보장\", \"표명보장\", \"면책\"]}, \"absence_check\": true, \"sources\": [], \"active\": true, \"disposition\": \"keep\", \"meaning_revision\": \"1.87.0\", \"judgment_level\": \"clarity\", \"judgment_scope\": \"module\", \"contract_requirement\": \"recommended\", \"text_effect\": \"advisory\", \"implementation_channel\": \"contract\", \"action_rationale\": \"진술·보장과 손해전보는 거래 실사와 책임배분에 따라 설계하는 계약상 구제임\", \"contract_action_curated\": true}]}], \"checklist_revision\": {\"version\": \"content-v3\", \"before_count\": 238, \"after_count\": 184, \"replacements\": [{\"id\": \"CNS-DAMAGE\", \"label\": \"책임 배분 약정 확인\", \"legacy_ids\": [\"CMN-05-2\", \"CMN-11\", \"CMN-12\", \"CMN-14\", \"RISK-06\", \"SP-DEL-02\", \"PRIV-08\", \"NDA-15\", \"SP-DEL-06\"]}, {\"id\": \"CNS-SECRET\", \"label\": \"비밀 범위·사용 제한 확인\", \"legacy_ids\": [\"CMN-15\", \"CMN-16\", \"NDA-01\", \"NDA-02\", \"NDA-03\", \"NDA-04\", \"NDA-05\", \"NDA-06\", \"NDA-07\", \"NDA-08\", \"NDA-09\", \"NDA-10\", \"NDA-21\"]}, {\"id\": \"CNS-END\", \"label\": \"해제·해지 약정 확인\", \"legacy_ids\": [\"CMN-08\", \"CMN-09\"]}, {\"id\": \"CNS-PRICE\", \"label\": \"대가·산정 방식 확인\", \"legacy_ids\": [\"CMN-03\", \"CMN-04\", \"CH-01\"]}, {\"id\": \"CNS-TERM\", \"label\": \"효력·기간 확인\", \"legacy_ids\": [\"CMN-06\", \"CMN-07\"]}, {\"id\": \"CNS-IP\", \"label\": \"산출물 권리·사용권 확인\", \"legacy