# Install inside the existing nginx http context (usually conf.d).
# The internal DNS name and organization-issued TLS certificate must exist first.
server {
    listen 443 ssl;
    server_name @SERVER_NAME@;
    ssl_certificate /etc/contract-review/tls/server.crt;
    ssl_certificate_key /etc/contract-review/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/contract-review/current/frontend;
    index index.html;
    server_tokens off;
    client_max_body_size 8m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 60s;
    # The API records actor/action audit events; omit request URLs and credentials here.
    access_log off;
    add_header X-Content-Type-Options nosniff always;

    location ^~ /api/v1/ {
        # No trailing URI: preserve the original /api/v1/ path.
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ /\. { deny all; }
}
